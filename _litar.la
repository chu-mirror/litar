Concepts illustrated in the previous chapters
should be represented before the details of implementation.

@<litarfs@:light@:C Structure@/data type declarations@=
typedef struct archive *Archive;
typedef struct block *Block;
typedef struct file *File;
@

@<litarfs@:light@:C Structure@/data types@=
struct dependency {
    const char *path;
    struct list dependencies_of_archive;
};

struct dependencies {
    struct list *head;
    struct list *end;
    Heap heap;
};

struct archive {
    const char *path;
    struct dependencies dependencies;
    struct bi_list *blocks;
};
@

@<litarfs@:light@:C Structure@/global variables@=
HashTable path_to_archive;
@

@<litarfs@:light@:C Structure@/functions@=
static struct dependencies *build_include_sequance(Archive ar, struct dependencies *deps)
{
    struct list *deps = ar->dependencies.head, *dep;

    FOREACH (dep, deps) {
        struct dependency *r;
        rcd_r = container_of(dep, struct hash_table_record, table);
        build_archive_sequence();
    }
    set_include(seq, ar->path);
}

struct bi_list *total_blocks(Archive ar)
{
    struct bi_list *deps = set_enumerate(ar->dependencies), *dep;
    struct hash_table_record *rcd_r;

    dep = deps;
}
@

@<litarfs@:light@:C Structure@/global variables@=
Set collection_labels;
@

@<litarfs@:light@:C Structure@/data types@=
struct label {
    const char *name;
    struct list labels;
};
struct chunk_ref {
    const char *chunk_name;
    const char *module_name;
    struct list *labels;
};
@

@<litarfs@:light@:C Structure@/data types@=
struct block {
    const char *comment;
    struct chunk_ref chunk_ref;
    struct bi_list *contents;

    struct bi_list blocks_in_archive;
    struct bi_list blocks_of_chunk_with_labels;
    struct bi_list blocks_total;
};
@

@<litarfs@:light@:C Structure@/data types@=
struct content {
    enum {
        CONTENT_TYPE_CHUNK_REF,
        CONTENT_TYPE_RAW_STRING,
    } type;
    union {
        struct chunk_ref chunk_ref;
        const char *raw_string;
    } value;
    struct bi_list contents_in_block;
};
@

@<litarfs@:light@:C Structure@/global variables@=
HashTable modules; /* module name -> chunk name -> labels -> blocks */
@

@<litarfs@:light@:C Structure@/data types@=
struct file {
    const char *path;
    enum {
        FILE_TYPE_CHUNK,
        FILE_TYPE_LINK,
    } type;
    union {
        struct chunk_ref chunk_ref;
        const char *orig_path;
    } value;
};
struct directory {
    const char *path;
    const char *orig_path;
};
@

The complete implementation of litar is divided to two parts, front end and back end.
The front end follows the common pattern of a command line tool.
It parses options and arguments, executes, then exits.
The back end is a server that makes use of libfuse3.

@[litar.c@=
@<litar@:C Structure@/executable@>
@

@[litarfs.c@=
@<litarfs@:light@:C Structure@/executable@>
@

They communicate through the mounted file system.
Other programs can communicate with the back end too by this way.

The back end adopts the framework provided by libfuse3.

@<litarfs@:light@:C Structure@/include flags@=
#define FUSE_USE_VERSION FUSE_MAKE_VERSION(3, 14)
@

@<litarfs@:light@:C Structure@/includes@=
#include <fuse.h>
@

@<litarfs@:light@:C Structure@/data types@=
struct litarfs_options {
    @<litarfs user options@>
};
@

@<litarfs@:light@:C Structure@/global variables@=
static struct litarfs_options user_options;
static struct fuse_opt litarfs_option_specs[] = {
    @<litarfs user option specs@>
};
static const struct fuse_operations litarfs_oper = {
    @<litarfs operations@>
};
@

@<litarfs@:light@:C Structure@/macros@=
#define LITARFS_OPER(op) .op = litarfs_##op
@

@<litarfs@:light@:C Structure@/invocation syntax@=
{
    name => 'litarfs',
    usages => [
        {
            options => [@<command line options for "litarfs"@>],
            arguments => [],
        },
    ],
}
@

@<litarfs user options@=@<Text Processing@/basic perl settings@>
my $syntax = @<litarfs@:light@:C Structure@/invocation syntax@>;

sub option_to_c_decl (_) {
    my $opt = shift;
    my $c_decl = '';
    if ($opt->{argument}) {
        $c_decl .= 'const char *';
    } else {
        $c_decl .= 'int ';
    }
    $c_decl . lc($opt->{long_opt}) . ';'
}

my @usages = @@{$syntax->{usages}};
my $options_decl = join "\n", map option_to_c_decl, @@{$usages[0]->{options}};
print $options_decl;
@|Basics@/evaluate@


@<litarfs user option specs@=@<Text Processing@/basic perl settings@>

my $syntax = @<litarfs@:light@:C Structure@/invocation syntax@>;

sub option_to_opt_spec (_) {
    my $opt = shift;
    my $opt_spec = '';
    my $p_arg = '';
    if ($opt->{argument}) {
        $p_arg = '=%s';
    }
    $opt_spec .=
        "{\"--$opt->{long_opt}$p_arg\", offsetof(struct litarfs_options, $opt->{long_opt}), 1},";

    if ($opt->{argument}) {
        $p_arg = ' %s';
    }
    if ($opt->{opt}) {
        $opt_spec .=
            "\n{\"-$opt->{opt}$p_arg\", offsetof(struct litarfs_options, $opt->{long_opt}), 1},";
    }
    $opt_spec
}

my @usages = @@{$syntax->{usages}};
my $option_specs = join "\n", map option_to_opt_spec, @@{$usages[0]->{options}};
print $option_specs;

@|Basics@/evaluate@

@<command line options for "litarfs"@=
{
    long_opt => "help",
    opt => "h",
    hide => 1,
    description => "Show help",
},
{
    long_opt => "version",
    opt => "V",
    hide => 1,
    description => "Show version",
},
{
    long_opt => "archive",
    opt => "a",
    argument => "ARCHIVE",
    description => "Specify the litar archive",
},
{
    long_opt => "mount_point",
    opt => "m",
    argument => "MOUNT_POINT",
    description => "Specify the mount point",
},
{
    long_opt => "base",
    opt => "b",
    argument => "DIRECTORY",
    description => "The writable directory for storing files",
},
@

@<print version information@=
printf("Version dev, built at <build time>\n");
@|fill in build time information@

@<fill in build time information@=#!/bin/sh
sed -e "s/<build time>/$(date -Iminute)/g"
@

@<litarfs@:Light@/light options@=
#define __light_option_context_size_main_body (1 << 10)
@

@<litarfs@:Light@/main body@=
do {
    struct fuse_args args = FUSE_ARGS_INIT(argc, argv);

    if (fuse_opt_parse(&args, &user_options, litarfs_option_specs, NULL) < 0) {
        fprintf(stderr, "Error when parsing arguments\n");
        returned = 1;
        goto clean_fuse_args;
    }

    int to_mount_file_system = 1;

    if (user_options.help) {
        printf("@<litarfs@:light@:C Structure@/command line usage@>");
        fuse_opt_add_arg(&args, "--help");
        to_mount_file_system = 0;
    }

    if (user_options.version) {
        @<print version information@>
        fuse_opt_add_arg(&args, "--version");
        to_mount_file_system = 0;
    }

    if (to_mount_file_system) {
        int failed;
        @<check or initialize 'user_opitons', set 'failed' if failed@>
        if (failed) {
            returned = 1;
            goto clean_fuse_args;
        }
        fuse_opt_add_arg(&args, user_options.mount_point);
    } else {
        args.argv[0][0] = '\0';
    }

    returned = fuse_main(args.argc, args.argv, &litarfs_oper, NULL);

clean_fuse_args:
    fuse_opt_free_args(&args);
} while (0);
@

@<check or initialize 'user_opitons', set 'failed' if failed@=
do {
    if (!user_options.archive) {
        fprintf(stderr, "Please specify the archive name through -a\n");
        failed = 1;
        break;
    }
    int l = strlen(user_options.archive);
    if (strcmp(user_options.archive+l-3, ".la") != 0) {
        fprintf(stderr, "Illegal file name, the file name of a litar archive should end with .la\n");
        failed = 1;
        break;
    }
    if (!user_options.mount_point) {
        enter_frame();

        char *fn, *p;
        STRDUP(user_options.archive, fn);
        fn[l-3] = '\0';
        p = fn+l-3;
        while (p != fn && *p != '/') --p;
        if (*p == '/') ++p;
        user_options.mount_point = frame_return_string(p);

        assert(exit_frame());
    }
    if (ensure_directory(user_options.mount_point)) {
        fprintf(stderr, "Failed to ensure directory %s", user_options.mount_point);
        failed = 1;
        break;
    }

    if (!user_options.base) {
        enter_frame();

        char *p;
        CALLOC(p, strlen(user_options.mount_point) + 2);
        assert(p);
        p[0] = '.';
        strcat(p, user_options.mount_point);
        user_options.base = frame_return_string(p);

        assert(exit_frame());
    }
    if (ensure_directory(user_options.base)) {
        fprintf(stderr, "Failed to ensure directory %s", user_options.mount_point);
        failed = 1;
        break;
    }
} while (0);
@

@<litarfs@:light@:C Structure@/functions@=
int ensure_directory(const char *path)
{
    struct stat buf;
    if (stat(path, &buf) == -1) {
        if (errno != ENOENT) {
            perror("stat");
            return 1;
        }
        if (mkdir(path, 0777) == -1) {
            perror("mkdir");
            return 1;
        }
        stat(path, &buf);
    }
    if (!S_ISDIR(buf.st_mode)) {
        fprintf(stderr, "%s is not a directory\n", path);
        return 1;
    }
    return 0;
}
@

@<litarfs@:light@:C Structure@/includes@=
#include <stdio.h>
#include <stdlib.h>
#include <errno.h>
#include <sys/stat.h>
#include "_light.h"
@

@. lib/_light.la
