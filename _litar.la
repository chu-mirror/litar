@[litar.c@=
@<litar@:light@:executable@:C Structure@/module@>
@

@<litar@:Light@/light options@=
#ifndef light_option_global_name_number 
#define light_option_global_name_number (10000)
#endif

#ifndef light_option_archive_resoure_number
#define light_option_archive_resoure_number (1000)
#endif
@

@<litar@:light@:C Structure@/invocation syntax@=
{
    name => 'litar',
    usages => [
        {
            name => "show help",
            options => [
                {
                    long_opt => "help",
                    opt => "h",
                    description => "Show help",
                },
                {
                    long_opt => "version",
                    opt => "V",
                    description => "Show version",
                },
            ],
            arguments => [],
        },
        {
            name => "operate archive",
            options => [
                {
                    long_opt => "print",
                    opt => "p",
                    argument => "chunk_ref",
                    description => "Print the content pointed by chunk reference",
                },
                {
                    long_opt => "mount-point",
                    opt => "m",
                    argument => "directory",
                    description => "Specify the mount point for fuse",
                },
                {
                    long_opt => "base",
                    opt => "b",
                    argument => "directory",
                    description => "Specify the base directory for mounted fs",
                },
                {
                    long_opt => "include",
                    opt => "I",
                    argument => "directories",
                    description => "Search paths for archives",
                },
            ],
            arguments => ['archive'],
        },
    ],
}
@

@<print version information@=
printf("Version dev, built at <build time>\n");
@|fill in build time information@

@<fill in build time information@=#!/bin/sh
sed -e "s/<build time>/$(date -Iminute)/g"
@

@<litar@:Light@/main body@=
do {
    light_log(INFO, "litar start");
    switch (command.usage) {
    case COMMAND_USAGE_SHOW_HELP:
        light_log(INFO, "chosen usage 'show help'");

        if (command.options.help) {
            printf("@<litar@:light@:C Structure@/command line usage@>");
            break;
        }

        if (command.options.version) {
            @<print version information@>
            break;
        }

        ret = 1;
        light_log(WARNING, "illegal running");

        break;
    case COMMAND_USAGE_OPERATE_ARCHIVE:
        light_log(INFO, "chosen usage 'operate archive'");
        @<check or initialize relevant arguments@>
        if (ret) {
            break;
        }
        @<operate on archive according to options@>
        break;
    default:
        break;
    }
    light_log(INFO, "litar end with return value %d", ret);
} while (0);
@

@<check or initialize relevant arguments@=
do {
    int l = strlen(command.arguments.archive);
    if (strcmp(command.arguments.archive+l-3, ".la") != 0) {
        fprintf(stderr, "Illegal file name, the name of a litar archive should end with suffix .la\n");
        ret = 1;
        light_log(ERROR, "invalid archive file name '%s'", command.arguments.archive);
        break;
    }
    if (access(command.arguments.archive, R_OK) == -1) {
        ret = 1;
        light_log(ERROR, "can not read file %s", command.arguments.archive);
        break;
    }
    if (!command.options.mount_point) {
        const void *r;
        r = enter_frame();
        assert(r);

        char *fn, *p;
        STRDUP(command.arguments.archive, fn);
        assert(fn);

        fn[l-3] = '\0';
        p = fn+l-3;
        while (p != fn && *p != '/') --p;
        if (*p == '/') ++p;
        command.options.mount_point = frame_return_string(p);

        r = exit_frame();
        assert(r);
    }

    if (ensure_directory(command.options.mount_point)) {
        light_log(ERROR, "Failed to ensure directory %s", command.options.mount_point);
        ret = 1;
        break;
    }

    if (!command.options.base) {
        const void *r;
        r = enter_frame();
        assert(r);

        char *p;
        CALLOC(p, strlen(command.options.mount_point) + 2);
        assert(p);
        p[0] = '.';
        strcat(p, command.options.mount_point);
        command.options.base = frame_return_string(p);

        r = exit_frame();
        assert(r);
    }

    if (ensure_directory(command.options.base)) {
        light_log(ERROR, "Failed to ensure directory %s", command.options.base);
        ret = 1;
        break;
    }
} while (0);
@

@<litar@:light@:executable@:C Structure@/functions@=
int ensure_directory(const char *path)
{
    struct stat buf;
    if (stat(path, &buf) == -1) {
        if (errno != ENOENT) {
            perror("stat");
            return 1;
        }
        if (mkdir(path, 0777) == -1) {
            perror("mkdir");
            return 1;
        }
        stat(path, &buf);
    }
    if (!S_ISDIR(buf.st_mode)) {
        fprintf(stderr, "%s is not a directory\n", path);
        return 1;
    }
    return 0;
}
@

@<litar@:light@:executable@:C Structure@/data types@=
struct label {
    const char *name;
    struct bi_list labels;
};
struct chunk_ref {
    const char *module_name;
    const char *chunk_name;
    struct bi_list *labels;
};
struct file_ref {
    const char *module_name;
    const char *file_path;
};
struct file_set_ref {
    const char *module_name;
    const char *file_set_name;
};
struct file_set {
    enum {
        FILE_SET_ADD_FILE,
        FILE_SET_SUB_FILE,
        FILE_SET_ADD_FILE_SET,
        FILE_SET_SUB_FILE_SET,
    } type;
    union {
        struct file_ref file;
        struct file_set_ref file_set;
    } value;
    struct bi_list chain;
};
struct filter {
    struct chunk_ref chunk;
    struct file_set file_set;
    struct bi_list filters;
};
struct content {
    enum {
        CONTENT_TYPE_CHUNK_REF,
        CONTENT_TYPE_RAW_STRING,
    } type;
    union {
        struct {
            struct chunk_ref chunk;
            struct filter filter;
        } deref;
        const char *raw_string;
    } value;
    struct bi_list contents_in_block;
};
struct block {
    const char *comment;
    struct bi_list *contents;
    struct filter filter;
    struct bi_list blocks_of_chunk_ref;
};
struct file {
    enum {
        FILE_TYPE_CHUNK,
        FILE_TYPE_LINK,
    } type;
    union {
        struct {
            struct chunk_ref chunk;
            struct filter filter;
            int is_executable;
        } deref;
        const char *orig_path;
    } value;
};
struct dependency {
    const char *archive_name;
    struct bi_list dependencies;
};

struct chunk_block {
    struct chunk_ref chunk;
    struct block *block;
};
struct ref_file {
    struct file_ref ref;
    struct file *file;
};
struct ref_file_set {
    struct file_set_ref ref;
    struct file_set *file_set;
};
struct archive {
    Segmented dependencies;
    Segmented blocks;
    Segmented files;
    Segmented file_sets;
};
@

@<litar@:light@:executable@:C Structure@/global variables@=
HashTable archives; /* archive path -> archive */
HashTable blocks; /* module name -> chunk name -> labels -> blocks */
HashTable files; /* module name -> file path -> file */
HashTable file_sets; /* module name -> file set name -> file set */
@

@<operate on archive according to options@=
do {
    const void *r;

    r = enter_frame();
    assert(r);

    archives = new_string_hash_table();
    assert(archives);

    blocks = new_string_hash_table();
    assert(blocks);

    files = new_string_hash_table();
    assert(files);

    file_sets = new_string_hash_table();
    assert(file_sets);

    ret = load_archive(command.arguments.archive);

    if (ret) {
        light_log(ERROR, "failed at parsing archive");
        break;
    }

    @<run fuse server@>
    if (ret) {
        light_log(ERROR, "failed to run fuse server");
        break;
    }

    @<perform operations@>
} while (0);
@

@<litar@:light@:executable@:C Structure@/functions@=
const char *read_file(FILE *in)
{
    char *buffer, *old_buffer;
    int size = 1 << 12, old_size = 0; /* start from 4KB */

    const void *r;
    r = enter_frame();
    assert(r);

    while (1) {
        CALLOC(buffer, size);
        assert(buffer);

        memcpy(buffer, old_buffer, old_size);

        int n;
        n = fread(buffer + old_size, sizeof(char), size-old_size, in);
        if (n == size-old_size) {
            old_buffer = buffer;
            old_size = size;
            size <<= 1;
            buffer = NULL;
        } else {
            buffer[old_size + n] = '\0';
            buffer = frame_return(buffer, size+1);
        }

        if (buffer) {
            break;
        }
    }
    r = exit_frame();
    assert(r);
    return buffer;
}
@

@<litar@:light@:executable@:C Structure@/data types@=
struct token {
    enum {
        TOKEN_CONTROL_CHARACTER,
        TOKEN_NORMAL_CHARACTER,
        TOKEN_EOF,
    } type;
    char value;
};

struct input_frame {
    const char *file;
    FILE *in;
    /* current position, current column, current row */
    int cp, cc, cr;
    /* previous position, previous column, previous row */
    int pp, pc, pr;
};
@

@<litar@:light@:executable@:C Structure@/functions@=
struct token *next_token(struct input_frame *ipt, struct token *tkn)
{
    if (!ipt->in) {
        ipt->in = fopen(ipt->file, "r");
        assert(ipt->in);
    }

    char c;
    int n = 0;

    ipt->pp = ipt->cp;
    ipt->pc = ipt->cc;
    ipt->pr = ipt->cr;

    n += (c = fgetc(ipt->in)) == EOF ? 0 : 1;
    if (c == '\100') {
        n += (c = fgetc(ipt->in)) == EOF ? 0 : 1;
        if (isalpha(c)) {
            n -= ungetc(c, ipt->in) == EOF ? 0 : 1;
            tkn->type = TOKEN_NORMAL_CHARACTER;
            tkn->value = '\100';
        } else if (c == '\100') {
            tkn->type = TOKEN_NORMAL_CHARACTER;
            tkn->value = '\100';
        } else {
            tkn->type = TOKEN_CONTROL_CHARACTER;
            if (c == EOF || c == '\n' || c == '\t' || c == ' ') {
                tkn->value = ' ';
            } else {
                tkn->value = c;
            }
            if (c == '\n') {
                n -= ungetc(c, ipt->in) == EOF ? 0 : 1;
            }
        }
    } else if (c == '\n') {
        tkn->type = TOKEN_NORMAL_CHARACTER;
        tkn->value = '\n';
        ipt->cp += n;
        ++ipt->cr;
        ipt->cc = 0;
        n = 0;
    } else if (c == EOF) {
        tkn->type = TOKEN_EOF;
        tkn->value = EOF;
    } else {
        tkn->type = TOKEN_NORMAL_CHARACTER;
        tkn->value = c;
    }
    ipt->cp += n;
    ipt->cc += n;

    return tkn;
}
@

Search pathes for litar archives, in this order:

- current directory,
- directories specified by command line argument, for example, -I dir1:dir2:dir3, the order
  is reserved,
- directories specified in environment variable LITAR_INCLUDE, the format is same with
  command line argument,
- $install_prefix/lib/litar. (two typical $install_prefix are /usr and /usr/local)

@<litar@:light@:executable@:C Structure@/functions@=
const char *search_in_directories(const char *an, const char *dirs)
{
    char *path;

    const void *r;
    r = enter_frame();
    assert(r);

    CALLOC(path, strlen(an) + strlen(dirs));
    assert(path);
    
    const char *p = dirs;
    int i = 0;
    do {
        if (*p == ':' || *p == '\0') {
            if (path[i-1] != '/') {
                path[i++] = '/';
            }
            strcpy(path+i, an);
            
            if (access(path, R_OK) == 0) {
                path = frame_return_string(path);
                break;
            }
            i = 0;
        } else {
            path[i++] = *p;
        }
        ++p;
    } while (*p);

    r = exit_frame();
    assert(r);

    return path;
}

const char *search_in_order(const char *an)
{
    const char *path = NULL;
    if (access(an, R_OK)) {
        path = an;
    }
    if (an[0] != '/') {
        if (!path && command.options.include) {
            path = search_in_directories(an, command.options.include);
        }
        if (!path && getenv("LITAR_INCLUDE")) {
            path = search_in_directories(an, getenv("LITAR_INCLUDE"));
        }
    }
    return path;
}
@

@<litar@:light@:executable@:C Structure@/functions@=
int load_archive(const char *path)
{
    struct input_frame ipt;
    memset(&ipt, 0, sizeof(ipt));
    ipt.file = path;

    struct archive *ar;
    struct token tkn;
    ar = parse_archive(&ipt, &tkn);
    if (!ar) {
        light_log(ERROR, "failed at parsing archive %s", path);
        return 1;
    } else {
        light_log(INFO, "load archive %s", path);
    }

    const void *r;
    r = hash_table_map(archives, path, ar);
    assert(r);

    return 0;
}

const char *chunk_ref_info(struct chunk_ref *ckr)
{
    char *info;
    int n = 0;

    struct bi_list *lbl_r;
    FOREACH_BI (lbl_r, ckr->labels) {
        n += strlen(container_of(lbl_r, struct label, labels)->name);
        n += 1;
    }

    n += strlen(ckr->module_name);
    n += 1;
    n += strlen(ckr->chunk_name);
    n += 1;

    info = salloc(n);

    info[0] = '\0';
    FOREACH_BI (lbl_r, ckr->labels) {
        strcat(info, container_of(lbl_r, struct label, labels)->name);
        strcat(info, ":");
    }
    strcat(info, ckr->module_name);
    strcat(info, "/");
    strcat(info, ckr->chunk_name);
    return info;
}

void show_archive_info(const char *path)
{
    const void *r;

    r = enter_frame();
    assert(r);

    const struct archive *ar = hash_table_get(archives, path);
    printf("Archive path: %s\n", path);

    const char **deps = segmented_continuous(ar->dependencies);
    int i, n = segmented_size(ar->dependencies) / sizeof(*deps);

    printf("Dependencies:\n");
    for (i = 0; i < n; ++i) {
        printf("\t%d: %s\n", i+1, deps[i]);
    }

    struct chunk_block *blocks = segmented_continuous(ar->blocks);
    n = segmented_size(ar->blocks) / sizeof(*blocks);
    for (i = 0; i < n; ++i) {
        r = enter_frame();
        assert(r);
        const char *ckr_info = chunk_ref_info(&blocks[i].chunk);
        printf("Extending chunk reference: %s", ckr_info);
        r = exit_frame();
        assert(r);
    }
    r = exit_frame();
    assert(r);
}
@

@<litar@:light@:executable@:C Structure@/function declarations@=
@<parse functions@>
@

@<parse functions@=
/* basic elements */
void ignore_spaces(struct input_frame *ipt, struct token *tkn);
const char *parse_string(struct input_frame *ipt, struct token *tkn);
const char *parse_name(struct input_frame *ipt, struct token *tkn);
const char *parse_file_path(struct input_frame *ipt, struct token *tkn);

/* archive elements */
struct archive *parse_archive(struct input_frame *ipt, struct token *tkn);
const char *parse_module_name(struct input_frame *ipt, struct token *tkn);
const char *parse_dependency(struct input_frame *ipt, struct token *tkn);
struct chunk_block parse_block(struct input_frame *ipt, struct token *tkn);
const char *parse_block_comment(struct input_frame *ipt, struct token *tkn);
struct ref_file parse_file_declaration(struct input_frame *ipt, struct token *tkn);
struct ref_file_set parse_file_set_declaration(struct input_frame *ipt, struct token *tkn);
@

@<litar@:light@:executable@:C Structure@/functions@=
void ignore_spaces(struct input_frame *ipt, struct token *tkn)
{
    while (
        next_token(ipt, tkn)->type == TOKEN_NORMAL_CHARACTER
        && isspace(tkn->value)
    )
        ;
}

const char *parse_string(struct input_frame *ipt, struct token *tkn)
{
    char *str;

    const void *r;
    r = enter_frame();
    assert(r);

    char *_str;
    int size = 1 << 10, _size = 0; /* start from 1KB */

    while (1) {
        CALLOC(str, size+1);
        assert(str);

        memcpy(str, _str, _size);

        int i = _size;
        while (tkn->type == TOKEN_NORMAL_CHARACTER) {
            str[i++] = tkn->value;
            next_token(ipt, tkn);
            if (i == size) {
                _str = str;
                _size = size;
                str = NULL;
                size <<= 2;
                break;
            }
        }

        if (str) {
            str[i] = '\0';
            str = frame_return(str, i+1);
            break;
        }
    }

    r = exit_frame();
    assert(r);

    return str;
}

const char *normalize(const char *name)
{
    int i = 0, j = 0, l = strlen(name);
    char *norm = NULL;

    STRDUP(name, norm);

    l = strlen(name);
    while (i < l) {
        if (isspace(name[i])) {
            if (j != 0 && !isspace(norm[j-1])) {
                norm[j++] = ' ';
            }
        } else {
            norm[j++] = name[i];
        }
        ++i;
    }
    if (isspace(norm[j-1])) {
        norm[j-1] = '\0';
    } else {
        norm[j] = '\0';
    }
    return norm;
}

const char *parse_name(struct input_frame *ipt, struct token *tkn)
{
    static Set names;
    if (!names) {
        names = new_string_set();
        set_init(names, light_option_global_name_number);
    }

    const char *name = NULL;
    int new_name = 0;

    const void *r;
    r = enter_frame();
    assert(r);

    int row, col;
    row = ipt->pr;
    col = ipt->pc;

    const char *str = parse_string(ipt, tkn);
    
    if (tkn->type == TOKEN_EOF) {
        fprintf(stderr, "Unended name at end of %s\n", ipt->file);
    } else {
        const char *_name = normalize(str);
        if (strlen(_name) == 0) {
            fprintf(stderr,
                "Name of length 0 is not allowed, found at row %d column %d in %s",
                row+1, col+1, ipt->file
            );
        } else {
            name = set_in(_name, names);
            if (!name) {
                new_name = 1;
                name = frame_return_string(_name);
            }
        }
    }
    r = exit_frame();
    assert(r);

    if (new_name) {
        set_include(names, name);
    }

    return name;
}

const char *parse_file_path(struct input_frame *ipt, struct token *tkn)
{
    char *path = NULL;
    const void *r;
    r = enter_frame();
    assert(r);

    int row, col;
    row = ipt->pr;
    col = ipt->pc;

    const char *_str = parse_string(ipt, tkn);
    char *str = NULL;

    STRDUP(_str, str);
    
    int illegal = 0;
    const char *p;
    for (p = str; *p; ++p) {
        if (*p == '\n') {
            fprintf(stderr,
                "the file path at row %d column %d in %s contains newline\n",
                row+1, col+1, ipt->file
            );
            illegal = 1;
            break;
        }
    }
    if (!illegal) {
        char *h, *t;
        h = str;
        while (isspace(*h))
            ++h;
        t = str + strlen(str);
        while (isspace(*(t-1)))
            --t;
        *t = '\0';
        path = frame_return_string(h);
    }
    r = exit_frame();
    assert(r);
    return path;
}

struct archive *parse_archive(struct input_frame *ipt, struct token *tkn)
{
    struct archive *ar;
    NEW0(ar);
    assert(ar);

    Heap hp = new_heap(
        light_option_archive_resoure_number / 10,
        SEGMENT_SIZE(
            union {
                const char *dep;
                struct chunk_block c_b;
                struct ref_file r_f;
                struct ref_file_set r_fs;
            } elm[10]
        )
    );
    assert(hp);

    ar->dependencies = new_segmented(hp);
    assert(ar->dependencies);

    ar->blocks = new_segmented(hp);
    assert(ar->blocks);

    ar->files = new_segmented(hp);
    assert(ar->files);

    ar->file_sets = new_segmented(hp);
    assert(ar->file_sets);

    const char *current_module_name = "";

    do {
        ignore_spaces(ipt, tkn);
        if (tkn->type == TOKEN_CONTROL_CHARACTER) {
            switch (tkn->value) {
            case '-':
                do {
                    next_token(ipt, tkn);
                    current_module_name = parse_module_name(ipt, tkn);
                    if (!current_module_name) {
                        ar = NULL;
                    }
                    if (tkn->type != TOKEN_CONTROL_CHARACTER || tkn->value != ' ') {
                        ar = NULL;
                        fprintf(
                            stderr,
                            "Unexpected ending of module name at row %d column %d of %s\n",
                            ipt->pr+1, ipt->pc+1, ipt->file
                        );
                    }
                    next_token(ipt, tkn);
                } while (0);
                break;
            case '.':
                do {
                    next_token(ipt, tkn);
                    const char *dep = parse_dependency(ipt, tkn);
                    if (dep) {
                        const void *r;
                        r = segmented_pushback(ar->dependencies, dep);
                        assert(r);
                    } else {
                        ar = NULL;
                    }
                    if (tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == ' ') {
                        next_token(ipt, tkn);
                    } else if (tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == '.') {
                        /* go to parse next dependency */
                    } else {
                        fprintf(stderr,
                            "Unexpected ending of dependency declaration at row %d column %d in %s\n",
                            ipt->pr+1, ipt->pc+1, ipt->file
                        );
                        ar = NULL;
                    }
                } while (0);
                break;
            case '[':
            case '(':
                do {
                    struct ref_file r_f = parse_file_declaration(ipt, tkn);
                    if (r_f.file) {
                        const void *r;
                        r = segmented_pushback(ar->files, r_f);
                        assert(r);
                    } else {
                        ar = NULL;
                    }
                } while (0);
                break;
            case '{':
                break;
            default:
                break;
            }
        } else if (
            tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == '<'
            || tkn->type == TOKEN_EOF
        ) {
            struct chunk_block c_b = parse_block(ipt, tkn);
            if (c_b.block->comment) {
                const void *r;
                r = segmented_pushback(ar->blocks, c_b);
                assert(r);
            } else {
                ar = NULL;
            }
        } else {
            fprintf(stderr,
                "Unexpected token at row %d column %d in %s",
                ipt->pr+1, ipt->pc+1, ipt->file
            );
            ar = NULL;
        }
    } while (ar && tkn->type != TOKEN_EOF);
    return ar;
}

const char *parse_module_name(struct input_frame *ipt, struct token *tkn)
{
    return parse_name(ipt, tkn);
}

const char *parse_dependency(struct input_frame *ipt, struct token *tkn)
{
    return parse_file_path(ipt, tkn);
}

struct chunk_block parse_block(struct input_frame *ipt, struct token *tkn)
{
    struct chunk_block c_b;
    struct block *blk;
    NEW0(blk);
    blk->comment = parse_block_comment(ipt, tkn);
    return c_b;
}

const char *parse_block_comment(struct input_frame *ipt, struct token *tkn)
{
    return parse_string(ipt, tkn);
}

