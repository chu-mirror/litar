@<litar@:light@:C Structure@/data type declarations@=
typedef struct archive *Archive;
typedef struct block *Block;
typedef struct file *File;
@

@<litar@:light@:C Structure@/data types@=
struct archive {
    const char *path;
    const char * const *dependencies;
    int number_dependencies;
    struct bi_list *blocks;
};
struct label {
    const char *name;
    struct list labels;
};
struct chunk_ref {
    const char *chunk_name;
    const char *module_name;
    struct list *labels;
};
struct content {
    enum {
        CONTENT_TYPE_CHUNK_REF,
        CONTENT_TYPE_RAW_STRING,
    } type;
    union {
        struct chunk_ref chunk_ref;
        const char *raw_string;
    } value;
    struct bi_list contents_in_block;
};
struct block {
    const char *comment;
    struct chunk_ref chunk_ref;
    struct bi_list *contents;

    struct bi_list blocks_in_archive;
    struct bi_list blocks_of_chunk_with_labels;
    struct bi_list blocks_total;
};
struct file {
    enum {
        FILE_TYPE_CHUNK,
        FILE_TYPE_LINK,
    } type;
    union {
        struct chunk_ref chunk_ref;
        const char *orig_path;
    } value;
};
@

@<litar@:light@:C Structure@/global variables@=
HashTable archives; /* archive path -> archive */
HashTable blocks; /* module name -> chunk name -> labels -> blocks */
HashTable files; /* file path -> file */
HashTable file_sets; /* file set name -> file set */
@

@[litar.c@=
@<litar@:light@:executable@:C Structure@/executable@>
@

@<litar@:light@:C Structure@/invocation syntax@=
{
    name => 'litar',
    usages => [
        {
            options => [@<command line options for "litar"@>],
            arguments => [],
        },
        {
            options => [@<command line options for "litar ARCHIVE"@>],
            arguments => ['ARCHIVE'],
        },
    ],
}
@

@<command line options for "litar"@=
{
    long_opt => "help",
    opt => "h",
    hide => 1,
    description => "Show help",
},
{
    long_opt => "version",
    opt => "V",
    hide => 1,
    description => "Show version",
},
@

@<print version information@=
printf("Version dev, built at <build time>\n");
@|fill in build time information@

@<fill in build time information@=#!/bin/sh
sed -e "s/<build time>/$(date -Iminute)/g"
@

@<litar@:Light@/main body@=
do {
    if (user_options.help) {
        printf("@<litar@:light@:C Structure@/command line usage@>");
    }

    if (user_options.version) {
        @<print version information@>
        to_mount_file_system = 0;
    }

    if (to_mount_file_system) {
        int failed;
        do { @<check or initialize 'user_opitons', set 'failed' if failed@> } while (0);
        if (failed) {
            returned = 1;
        }
        @<initialize 'path_to_archive', set 'failed' if failed@>
        if (failed) {
            returned = 1;
        }
    } else {
        args.argv[0][0] = '\0';
    }
} while (0);
@

@<litar@:light@:C Structure@/functions@=
int ensure_directory(const char *path)
{
    struct stat buf;
    if (stat(path, &buf) == -1) {
        if (errno != ENOENT) {
            perror("stat");
            return 1;
        }
        if (mkdir(path, 0777) == -1) {
            perror("mkdir");
            return 1;
        }
        stat(path, &buf);
    }
    if (!S_ISDIR(buf.st_mode)) {
        fprintf(stderr, "%s is not a directory\n", path);
        return 1;
    }
    return 0;
}
@

@<check or initialize 'user_opitons', set 'failed' if failed@=
if (!user_options.archive) {
    fprintf(stderr, "Please specify the archive name through -a\n");
    failed = 1;
    break;
}
int l = strlen(user_options.archive);
if (strcmp(user_options.archive+l-3, ".la") != 0) {
    fprintf(stderr, "Illegal file name, the file name of a litar archive should end with .la\n");
    failed = 1;
    break;
}
if (!user_options.mount_point) {
    enter_frame();

    char *fn, *p;
    STRDUP(user_options.archive, fn);
    fn[l-3] = '\0';
    p = fn+l-3;
    while (p != fn && *p != '/') --p;
    if (*p == '/') ++p;
    user_options.mount_point = frame_return_string(p);

    assert(exit_frame());
}
if (ensure_directory(user_options.mount_point)) {
    fprintf(stderr, "Failed to ensure directory %s", user_options.mount_point);
    failed = 1;
    break;
}

if (!user_options.base) {
    enter_frame();

    char *p;
    CALLOC(p, strlen(user_options.mount_point) + 2);
    assert(p);
    p[0] = '.';
    strcat(p, user_options.mount_point);
    user_options.base = frame_return_string(p);

    assert(exit_frame());
}
if (ensure_directory(user_options.base)) {
    fprintf(stderr, "Failed to ensure directory %s", user_options.mount_point);
    failed = 1;
    break;
}
@

Search pathes for litar archives, in this order:

- current directory,
- directories specified by command line argument, for example, -I dir1:dir2:dir3, the order
  is reserved,
- directories specified in environment variable LITAR_INCLUDE, the format is same with
  command line argument,
- $install_prefix/lib/litar. (two typical $install_prefix are /usr and /usr/local)

@<command line options for "litar"@=
{
    long_opt => "include",
    opt => "I",
    argument => "INCLUDE_DIRECTORIES",
    description => "Search paths for archives",
},
@

@<litar@:light@:C Structure@/global variables@=
struct search_paths {
    const char *path;
    struct list paths;
};
struct tail_list search_paths;
@

@<litar@:light@:C Structure@/functions@=
Archive load_archive(const char *path)
{
    if (path[0] != '/') {
    }
}
@

The entry archive must be specified through command line argument.

@<initialize 'path_to_archive', set 'failed' if failed@=
do {
    @<initialize 'search_paths', set 'failed' if failed@>
    if (failed) {
        break;
    }
    char path[PATH_MAX+1];
    char *ptr = realpath(user_option.archive, path);
    if (!ptr) {
        fprintf(stderr, "Error when finding archive '%s': %s", strerror(errno));
        failed = 1;
        break;
    }
    load_archive(path);
} while (0);
@

@<initialize 'search_paths', set 'failed' if failed@=
do {
} while (0);
@

@<litar@:light@:C Structure@/include flags@=
#define FUSE_USE_VERSION FUSE_MAKE_VERSION(3, 17)
@

@<litar@:light@:C Structure@/includes@=
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <errno.h>
#include <sys/stat.h>

#include <fuse.h>

#include "_light.h"
@

