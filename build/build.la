prints_file literal literal.out -f literal/literal.la -l 'label@@:module@@/chunk1'
prints_file depend-1 depend-1.out -f depend/depend.la -d 'chunk 1'
prints_file depend-1b depend-1.out -f depend/depend.la -d 'label 1@@:chunk 1'
prints_file depend-2 depend-2.out -f depend/depend.la -d 'chunk 2'
prints_file depend-2b depend-2.out -f depend/depend.la -d 'label 2@@:chunk 2'
prints none '' -f depend/depend.la -d nope
@| litar command@:UI@/Command Line@/Test@/run case@+binaries@+test fixtures @
