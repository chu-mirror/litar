@<Project@/litar@/find the 'root' of 'w' and group the other nodes by base in 'children'@=
for i := range w.Nodes {
	n := &w.Nodes[i]
	if len(n.Base) == 0 {
		root = n
		continue
	}
	children[formatNodePath(n.Base)] = append(children[formatNodePath(n.Base)], n)
}
@~ Project@/litar@/Go@/functions@/litar.formatNodePath @

Every node is addressable, so every node is a leaf, whatever nodes it has on it.
@<Project@/litar@/build the tree of the node 'n' and the nodes on it@=
path := formatNodePath(nodePath(*n))
t := treeJSON{
	Name:        n.Name,
	Description: n.Description,
	SubTrees:    emptySub(),
	Leaf:        true,
}
for _, c := range children[path] {
	t.SubTrees = append(t.SubTrees, build(c))
}
return t
