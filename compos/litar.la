@<meta test@:litar@:Language@/Go@/File@/functions@+
func listedLine(text, name string) string {
	for _, line := range strings.Split(strings.TrimSuffix(text, "\n"), "\n") {
		if line == name || strings.HasPrefix(line, name+":") {
			return line
		}
	}
	return ""
}

@~ Project@/litar@/Go@/functions@/litar.listedLine @

@<meta test@:litar@:Language@/Go@/File@/functions@+
func splitNamed(line string) (name, desc string, col int, ok bool) {
	label, rest, found := strings.Cut(line, ":")
	if !found {
		return "", "", 0, false
	}
	pos := utf8.RuneCountInString(label) + 1
	for len(rest) > 0 && rest[0] == '\t' {
		pos += 8 - pos%8
		rest = rest[1:]
	}
	if rest == "" || strings.Contains(rest, "\t") {
		return "", "", 0, false
	}
	return label, rest, pos, true
}

@~ Project@/litar@/Go@/functions@/litar.splitNamed @

@<meta test@:litar@:Language@/Go@/File@/functions@+
func findTree(t treeJSON, path ...string) (treeJSON, bool) {
	cur := t
	for _, name := range path {
		found := false
		for _, sub := range cur.SubTrees {
			if sub.Name == name {
				cur = sub
				found = true
				break
			}
		}
		if !found {
			return treeJSON{}, false
		}
	}
	return cur, true
}

@~ Project@/litar@/Go@/functions@/litar.findTree @~ Project@/litar@/Go@/types@/litar.treeJSON @

@<meta test@:litar@:Language@/Go@/File@/functions@+
func findNamed(t treeJSON, name string) (string, bool) {
	if t.Name == name {
		return t.Name, true
	}
	for _, sub := range t.SubTrees {
		if path, ok := findNamed(sub, name); ok {
			if t.Name == "" || t.Name == "/" {
				return path, true
			}
			return t.Name + "/" + path, true
		}
	}
	return "", false
}

@~ Project@/litar@/Go@/functions@/litar.findNamed @~ Project@/litar@/Go@/types@/litar.treeJSON @

@<meta test@:litar@:Language@/Go@/File@/functions@+
func mustTree(t *testing.T, tree treeJSON) string {
	t.Helper()
	raw, err := json.Marshal(tree)
	if err != nil {
		t.Fatal(err)
	}
	return string(raw)
}

