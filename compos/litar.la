The test may itself run in a filter view, which stays mounted for the whole test,
so it counts the views mounted before the evaluation and accepts no more afterwards.
@<filter test@:litar@:Language@/Go@/File@/functions@+
func TestFUSEViewOutlivedByBackgroundProcess(t *testing.T) {
if _, err := os.Stat("/dev/fuse"); err != nil {
	t.Skip("no /dev/fuse")
}
src := "" +
	"@@<leave@@=\n" +
	"#!/bin/sh\n" +
	"(sleep 3 </dev/null >/dev/null 2>&1 &)\n" +
	"echo hi\n" +
	"@@\n" +
	"@@<msg@@=\n" +
	"@@|leave@@\n"
blocks := mustArch(t, src)
ev := NewEvaluator(blocks, nil, nil)
before, _ := os.ReadFile("/proc/self/mounts")
@<Project@/litar@/check that 'ev' returns msg before the background process ends@>
mounts, err := os.ReadFile("/proc/self/mounts")
if err == nil && strings.Count(string(mounts), "fuse.litar") > strings.Count(string(before), "fuse.litar") {
	t.Fatalf("a filter view is still mounted:\n%s", mounts)
}
}

@~ Project@/litar@/Go@/functions@/litar.NewEvaluator @~ Project@/litar@/Go@/functions@/litar.mustArch @

The background process sleeps 3 seconds; waiting at most 2 shows that evaluation does not wait for it.
@<Project@/litar@/check that 'ev' returns msg before the background process ends@=
type result struct {
	text string
	err  error
}
done := make(chan result, 1)
go func() {
	text, err := ev.Eval(mustRef(t, "msg"), nil)
	done <- result{text, err}
}()
select {
case r := <-done:
	if r.err != nil || r.text != "hi\n" {
		t.Fatalf("%v %q", r.err, r.text)
	}
case <-time.After(2 * time.Second):
	t.Fatal("evaluation waits for the background process")
}
@~ Project@/litar@/Go@/functions@/litar.mustRef @~ Project@/litar@/Go@/methods@/litar.Evaluator.Eval @

