@<parse@:litar@:Go Structure@/methods@+
func (p *parser) fail(msg string) error {
	if p.expr {
		return &ParseError{Msg: msg, Expr: true}
	}
	return &ParseError{Msg: msg, File: p.file, Line: p.line()}
}

