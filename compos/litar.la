func (p *parser) consumeLayout() {
	if p.i < len(p.src) && p.src[p.i] == '\r' {
		p.i++
		if p.i < len(p.src) && p.src[p.i] == '\n' {
			p.i++
		}
		return
	}
	if p.i < len(p.src) && p.src[p.i] == '\n' {
		p.i++
	}
}

