@<list@:litar@:Language@/Go@/File@/functions@+
// Chunks lists chunk names whose module equals mod.
// Chunks in a reserved namespace are omitted.
func Chunks(blocks []Block, mod ModulePath, meta metaInfo) string {
	seen := map[Name]bool{}
	var rows []namedLine
	for _, b := range blocks {
		if _, reserved := reservedNamespace(b.Ref.Module); reserved {
			continue
		}
		if b.Ref.Chunk == "" || !modulesEqual(b.Ref.Module, mod) {
			continue
		}
		if seen[b.Ref.Chunk] {
			continue
		}
		seen[b.Ref.Chunk] = true
		name := string(b.Ref.Chunk)
		rows = append(rows, namedLine{name, meta.chunks[pathKey(joinPath(mod, name))]})
	}
	return formatNamed(rows)
}

@~ Project@/litar@/Go@/functions@/litar.Chunks @~ Project@/litar@/Go@/functions@/litar.formatNamed @~ Project@/litar@/Go@/functions@/litar.joinPath @~ Project@/litar@/Go@/functions@/litar.modulesEqual @~ Project@/litar@/Go@/functions@/litar.pathKey @~ Project@/litar@/Go@/functions@/litar.reservedNamespace @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ModulePath @~ Project@/litar@/Go@/types@/litar.Name @~ Project@/litar@/Go@/types@/litar.metaInfo @~ Project@/litar@/Go@/types@/litar.namedLine @

