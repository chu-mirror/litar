@<Project@/litar@/archive text of a file with a set, filters and items, an executable file, and a chunk invoking a pipeline@=
"@@[hello.c@@`source files@@=\n" +
"int x;\n" +
"@@|upper@@+docs@@,hello.c\n" +
"@@~C@@/variables@@/times@@~C@@/functions@@/main@@\n" +
"@@(run.sh@@=\n" +
"echo\n" +
"@@\n" +
"@@<chunk@@=\n" +
"@@<@@|list files@@+source files@@>\n" +
"@@@@~\n" +
"@@\n" +
@

@<Project@/litar@/check the file block of 'arch' with its set, filters and items@=
