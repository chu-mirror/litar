@~ Project@/litar@/Go@/functions@/litar.ParseArchive @~ Project@/litar@/Go@/methods@/litar.Archive.Text @

The last block is commented, and the tail follows it.
@<Project@/litar@/archive text of two chunks of module and a label extending one, between a lead and a tail@=
"lead\n" +
"@@<module@@/chunk1@@=\n" +
"@@<substructure 1@@>\n" +
"@@\n" +
"\n" +
"@@<module@@/chunk2@@=\n" +
"@@<substructure 2@@>\n" +
"@@\n" +
"\n" +
"Extend chunk through label.\n" +
"@@<label@@:module@@/chunk1@@=\n" +
"@@<substructure 3@@>\n" +
"@@\n" +
"tail\n" +
@

@<Project@/litar@/check the blocks and the trailing text of 'arch'@=
if len(arch.Blocks) != 3 {
t.Fatalf("blocks %d", len(arch.Blocks))
}
if arch.Blocks[0].Ref.String() != "module@@/chunk1" {
t.Fatal(arch.Blocks[0].Ref.String())
}
if arch.Blocks[2].Ref.String() != "label@@:module@@/chunk1" {
t.Fatal(arch.Blocks[2].Ref.String())
}
if arch.Trailing != "tail\n" {
t.Fatalf("trailing %q", arch.Trailing)
}
part := arch.Blocks[0].Parts
if len(part) != 1 || part[0].Ref == nil || part[0].Ref.Chunk != "substructure 1" || !arch.Blocks[0].EndsLine {
t.Fatalf("parts %+v", part)
}
@~ Project@/litar@/Go@/methods@/litar.ChunkRef.String @

@<parse test@:litar@:Language@/Go@/File@/functions@+
func textOf(t *testing.T, b Block) string {
	t.Helper()
	var sb strings.Builder
	for _, p := range b.Parts {
		if p.Ref != nil {
			t.Fatal("expected text")
		}
		sb.WriteString(p.Text)
	}
	return sb.String()
}

@~ Project@/litar@/Go@/functions@/litar.textOf @~ Project@/litar@/Go@/types@/litar.Block @

@<parse test@:litar@:Language@/Go@/File@/functions@+
func TestLayoutNewline(t *testing.T) {
	cases := []struct {
		src      string
		body     string
		endsLine bool
	}{
		{"@@<msg@@=\nHello\n@@", "Hello", true},
		{"@@<msg@@=\nHello\r\n@@", "Hello", true},
		{"@@<msg@@=\nHello\n\n@@", "Hello\n", true},
		{"@@<msg@@=\nHello\r@@", "Hello\r", false},
		{"@@<msg@@=\nHello\n@@|f@@", "Hello", true},
		{"@@<msg@@=\nHello\n@@~ a @@", "Hello", true},
		{"@@<msg@@=Hello@@", "Hello", false},
		{"@@<msg@@=\r\nHello@@", "Hello", false},
		{"@@<msg@@=\rHello@@", "Hello", false},
		{"@@<msg@@=\n\rHello@@", "\rHello", false},
		{"@@<msg@@=@@@@<kept@@@@>@@", "@@<kept@@>", false},
		{"@@<msg@@=\n\n@@", "", true},
	}
	for _, tc := range cases {
		arch, err := ParseArchive([]byte(tc.src), "a.la")
		if err != nil {
			t.Fatalf("%q: %v", tc.src, err)
		}
		if arch.Text() != tc.src {
			t.Fatalf("%q round trip %q", tc.src, arch.Text())
		}
		if got := textOf(t, arch.Blocks[0]); got != tc.body {
			t.Fatalf("%q body %q want %q", tc.src, got, tc.body)
		}
		if arch.Blocks[0].EndsLine != tc.endsLine {
			t.Fatalf("%q ends line %v", tc.src, arch.Blocks[0].EndsLine)
		}
	}
}

@~ Project@/litar@/Go@/functions@/litar.ParseArchive @~ Project@/litar@/Go@/functions@/litar.textOf @~ Project@/litar@/Go@/methods@/litar.Archive.Text @

