@<parse@:litar@:Language@/Go@/File@/types@+
// ParseError is a scan or parse failure.
// Archive errors name the file and line.
// Command-line errors are marked Expr and read "… in expression".
type ParseError struct {
	Msg  string
	File string
	Line int
	Expr bool
}

@~ Project@/litar@/Go@/types@/litar.ParseError @

@<parse@:litar@:Language@/Go@/File@/methods@+
func (e *ParseError) Error() string {
	if e.Expr {
		return e.Msg + " in expression"
	}
	if e.File != "" {
		return fmt.Sprintf("%s at line %d in '%s'", e.Msg, e.Line, e.File)
	}
	return e.Msg
}

@~ Project@/litar@/Go@/types@/litar.ParseError @

@<parse@:litar@:Language@/Go@/File@/types@+
type parser struct {
	src  []byte
	i    int
	file string
	expr bool
}

@~ Project@/litar@/Go@/types@/litar.parser @

@<parse@:litar@:Language@/Go@/File@/methods@+
func (p *parser) line() int {
	line := 1
	end := p.i
	if end > len(p.src) {
		end = len(p.src)
	}
	for i := 0; i < end; i++ {
		if p.src[i] == '\n' {
			line++
		}
	}
	return line
}

@~ Project@/litar@/Go@/methods@/litar.parser.line @~ Project@/litar@/Go@/types@/litar.parser @

@<parse@:litar@:Language@/Go@/File@/methods@+
func (p *parser) fail(msg string) error {
	if p.expr {
		return &ParseError{Msg: msg, Expr: true}
	}
	return &ParseError{Msg: msg, File: p.file, Line: p.line()}
}

@~ Project@/litar@/Go@/methods@/litar.parser.fail @~ Project@/litar@/Go@/methods@/litar.parser.line @~ Project@/litar@/Go@/types@/litar.ParseError @~ Project@/litar@/Go@/types@/litar.parser @

@<parse@:litar@:Language@/Go@/File@/functions@+
func isLetter(b byte) bool {
	return (b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z')
}

@~ Project@/litar@/Go@/functions@/litar.isLetter @

@<parse@:litar@:Language@/Go@/File@/functions@+
func isWS(b byte) bool {
	return b == ' ' || b == '\t' || b == '\n' || b == '\r'
}

@~ Project@/litar@/Go@/functions@/litar.isWS @

@<parse@:litar@:Language@/Go@/File@/methods@+
// atControl reports a control at p.i.
// n == 1 is a final "@@" at end of input.
// n == 2 is "@@" plus the returned kind.
// "@@" followed by a letter or a byte >= 128 is text, not a control.
func (p *parser) atControl() (kind byte, n int, ok bool) {
	if p.i >= len(p.src) || p.src[p.i] != '@@' {
		return 0, 0, false
	}
	if p.i+1 >= len(p.src) {
		return 0, 1, true
	}
	next := p.src[p.i+1]
	if isLetter(next) || next >= 128 {
		return 0, 0, false
	}
	return next, 2, true
}

@~ Project@/litar@/Go@/functions@/litar.isLetter @~ Project@/litar@/Go@/methods@/litar.parser.atControl @~ Project@/litar@/Go@/types@/litar.parser @

@<parse@:litar@:Language@/Go@/File@/functions@+
func isEndControl(kind byte, n int) bool {
	if n == 1 {
		return true
	}
	if n != 2 {
		return false
	}
	return kind == ' ' || kind == '\t' || kind == '\n' || kind == '\r'
}

@~ Project@/litar@/Go@/functions@/litar.isEndControl @

@<parse@:litar@:Language@/Go@/File@/functions@+
func ctrlText(kind byte, n int) string {
	if n == 1 {
		return "@@"
	}
	return "@@" + string(rune(kind))
}

@~ Project@/litar@/Go@/functions@/litar.ctrlText @

@<parse@:litar@:Language@/Go@/File@/methods@+
func (p *parser) unexpected(kind byte, n int) error {
	return p.fail(fmt.Sprintf("unexpected control '%s'", ctrlText(kind, n)))
}

@~ Project@/litar@/Go@/functions@/litar.ctrlText @~ Project@/litar@/Go@/methods@/litar.parser.fail @~ Project@/litar@/Go@/methods@/litar.parser.unexpected @~ Project@/litar@/Go@/types@/litar.parser @

@<parse@:litar@:Language@/Go@/File@/functions@+
func trimWS(b []byte) []byte {
	i := 0
	j := len(b)
	for i < j && isWS(b[i]) {
		i++
	}
	for j > i && isWS(b[j-1]) {
		j--
	}
	return b[i:j]
}

@~ Project@/litar@/Go@/functions@/litar.isWS @~ Project@/litar@/Go@/functions@/litar.trimWS @

@<parse@:litar@:Language@/Go@/File@/functions@+
// decodeAt replaces "@@@@" with "@@". The caller trims first.
func decodeAt(b []byte) string {
	var sb strings.Builder
	for i := 0; i < len(b); i++ {
		if b[i] == '@@' && i+1 < len(b) && b[i+1] == '@@' {
			sb.WriteByte('@@')
			i++
			continue
		}
		sb.WriteByte(b[i])
	}
	return sb.String()
}

@~ Project@/litar@/Go@/functions@/litar.decodeAt @

@<parse@:litar@:Language@/Go@/File@/methods@+
// readName reads bytes up to the next control.
// "@@@@" stays inside the name and decodes to one "@@".
// Trim happens before that decode.
// allowEOF lets a command-line name end at end of input.
// kind, n describe the control that stopped the name; they are zero at EOF.
func (p *parser) readName(allowEOF bool) (Name, byte, int, error) {
	start := p.i
	for p.i < len(p.src) {
		kind, n, ok := p.atControl()
		if !ok {
			p.i++
			continue
		}
		if n == 2 && kind == '@@' {
			p.i += 2
			continue
		}
		raw := p.src[start:p.i]
		return Name(decodeAt(trimWS(raw))), kind, n, nil
	}
	if !allowEOF {
		return "", 0, 0, p.fail("unterminated name")
	}
	return Name(decodeAt(trimWS(p.src[start:p.i]))), 0, 0, nil
}

@~ Project@/litar@/Go@/functions@/litar.decodeAt @~ Project@/litar@/Go@/functions@/litar.trimWS @~ Project@/litar@/Go@/methods@/litar.parser.atControl @~ Project@/litar@/Go@/methods@/litar.parser.fail @~ Project@/litar@/Go@/methods@/litar.parser.readName @~ Project@/litar@/Go@/types@/litar.Name @~ Project@/litar@/Go@/types@/litar.parser @

@<parse@:litar@:Language@/Go@/File@/types@+
type qOpt struct {
	dotOK    bool
	allowEOF bool
}

@~ Project@/litar@/Go@/types@/litar.qOpt @

@<parse@:litar@:Language@/Go@/File@/methods@+
// parseQName reads labels, a module path, and a chunk.
// The terminating control is not consumed.
// An empty chunk is returned to the caller; it is not an error here.
func (p *parser) parseQName(opt qOpt) (ChunkRef, byte, int, error) {
var labels []Name
var module ModulePath
moduleStarted := false
name, kind, n, err := p.readName(opt.allowEOF)
if err != nil {
return ChunkRef{}, 0, 0, err
}
for n == 2 && (kind == ':' || kind == '/') {
@<Project@/litar@/add 'name' to 'labels' or to 'module', as the control 'kind' after it says@>
p.i += n
name, kind, n, err = p.readName(opt.allowEOF)
if err != nil {
return ChunkRef{}, 0, 0, err
}
}
if name != "" && !opt.dotOK && isRelName(name) {
return ChunkRef{}, 0, 0, p.fail("relative module name")
}
return ChunkRef{Labels: labels, Module: module, Chunk: name}, kind, n, nil
}

@~ Project@/litar@/Go@/functions@/litar.isRelName @~ Project@/litar@/Go@/methods@/litar.parser.fail @~ Project@/litar@/Go@/methods@/litar.parser.parseQName @~ Project@/litar@/Go@/methods@/litar.parser.readName @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.ModulePath @~ Project@/litar@/Go@/types@/litar.Name @~ Project@/litar@/Go@/types@/litar.parser @~ Project@/litar@/Go@/types@/litar.qOpt @

Labels come before the module path, and the cases overlap, so their order matters.
An empty name before the first '/' names the root explicitly.
@<Project@/litar@/add 'name' to 'labels' or to 'module', as the control 'kind' after it says@=
switch {
case kind == ':' && moduleStarted:
return ChunkRef{}, 0, 0, p.fail("label after module name")
case name == "" && kind == '/' && !moduleStarted:
moduleStarted = true
case name == "":
return ChunkRef{}, 0, 0, p.fail("empty name")
case !opt.dotOK && isRelName(name):
return ChunkRef{}, 0, 0, p.fail("relative module name")
case kind == ':':
labels = append(labels, name)
default:
moduleStarted = true
module = append(module, name)
}
@

@<parse@:litar@:Language@/Go@/File@/functions@+
func isViewOp(kind byte, n int) bool {
	return n == 2 && (kind == '+' || kind == '-' || kind == ',' || kind == '!')
}

@~ Project@/litar@/Go@/functions@/litar.isViewOp @

@<parse@:litar@:Language@/Go@/File@/functions@+
func viewKind(kind byte) ViewOpKind {
	switch kind {
	case '+':
		return AddSet
	case '-':
		return SubSet
	case ',':
		return AddFile
	default:
		return DelFile
	}
}

