if !f.IsFile || f.Executable || f.Path != "hello.c" || len(f.Sets) != 1 || f.Sets[0] != "source files" {
t.Fatalf("file %+v", f)
}
if len(f.Filters) != 1 || f.Filters[0].Ref.Chunk != "upper" || len(f.Filters[0].View) != 2 {
