@<compose@:litar@:Go Structure@/methods@+
// lookup finds a node by its full path, the names from the root joined by "/".
func (w *World) lookup(ref string) (*Node, error) {
	i, err := w.findIndex(ref)
	if err != nil {
		return nil, err
	}
	return &w.Nodes[i], nil
}

