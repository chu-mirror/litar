@<list@:litar@:Go Structure@/functions@+
func matchingBlocks(blocks []Block, ref ChunkRef) []Block {
	var out []Block
	for _, b := range blocks {
		if matchRef(b.Ref, ref) {
			out = append(out, b)
		}
	}
	return out
}

@~ Go@/functions@/litar.matchRef @~ Go@/functions@/litar.matchingBlocks @~ Go@/types@/litar.Block @~ Go@/types@/litar.ChunkRef @

@<list@:litar@:Go Structure@/functions@+
func effectiveBlocks(blocks []Block, ref ChunkRef) (eff []Block, ok bool) {
	for _, b := range blocks {
		if !matchRef(b.Ref, ref) {
			continue
		}
		ok = true
		if b.Op == OpSet {
			eff = []Block{b}
		} else {
			eff = append(eff, b)
		}
	}
	return eff, ok
}

@~ Go@/constants@/litar.OpSet @~ Go@/functions@/litar.effectiveBlocks @~ Go@/functions@/litar.matchRef @~ Go@/types@/litar.Block @~ Go@/types@/litar.ChunkRef @

@<list@:litar@:Go Structure@/functions@+
// Literal is the -l listing. A reference with no block is an error.
func Literal(blocks []Block, ref ChunkRef) (string, error) {
	got := matchingBlocks(blocks, ref)
	if len(got) == 0 {
		return "", fmt.Errorf("chunk '%s' is not defined", ref.String())
	}
	return FormatBlocks(got), nil
}

@~ Go@/functions@/litar.FormatBlocks @~ Go@/functions@/litar.Literal @~ Go@/functions@/litar.matchingBlocks @~ Go@/methods@/litar.ChunkRef.String @~ Go@/types@/litar.Block @~ Go@/types@/litar.ChunkRef @

@<list@:litar@:Go Structure@/functions@+
// Effective is the -e listing.
func Effective(blocks []Block, ref ChunkRef) (string, error) {
	got, ok := effectiveBlocks(blocks, ref)
	if !ok {
		return "", fmt.Errorf("chunk '%s' is not defined", ref.String())
	}
	return FormatBlocks(got), nil
}

@~ Go@/functions@/litar.Effective @~ Go@/functions@/litar.FormatBlocks @~ Go@/functions@/litar.effectiveBlocks @~ Go@/methods@/litar.ChunkRef.String @~ Go@/types@/litar.Block @~ Go@/types@/litar.ChunkRef @

@<list@:litar@:Go Structure@/functions@+
func useMatches(use ChunkRef, query ChunkRef, header ModulePath) bool {
	mod := use.Module
	if hasRel(mod) {
		mod = resolveModule(header, mod)
	}
	if use.Chunk != query.Chunk || !modulesEqual(mod, query.Module) {
		return false
	}
	return isSuffix(query.Labels, use.Labels)
}

@~ Go@/functions@/litar.hasRel @~ Go@/functions@/litar.isSuffix @~ Go@/functions@/litar.modulesEqual @~ Go@/functions@/litar.resolveModule @~ Go@/functions@/litar.useMatches @~ Go@/types@/litar.ChunkRef @~ Go@/types@/litar.ModulePath @

@<list@:litar@:Go Structure@/functions@+
func blockDepends(b Block, query ChunkRef) bool {
	check := func(use ChunkRef) bool {
		return useMatches(use, query, b.Ref.Module)
	}
	for _, part := range b.Parts {
		if part.Ref == nil {
			continue
		}
		if check(part.Ref.ChunkRef) {
			return true
		}
		for _, f := range part.Ref.Filters {
			if check(f.Ref) {
				return true
			}
		}
	}
	for _, f := range b.Filters {
		if check(f.Ref) {
			return true
		}
	}
	return false
}

@~ Go@/functions@/litar.blockDepends @~ Go@/functions@/litar.useMatches @~ Go@/types@/litar.Block @~ Go@/types@/litar.ChunkRef @

@<list@:litar@:Go Structure@/functions@+
// Depend is the -d listing. No match is an empty string, not an error.
func Depend(blocks []Block, query ChunkRef) string {
	var got []Block
	for _, b := range blocks {
		if blockDepends(b, query) {
			got = append(got, b)
		}
	}
	return FormatBlocks(got)
}

@~ Go@/functions@/litar.Depend @~ Go@/functions@/litar.FormatBlocks @~ Go@/functions@/litar.blockDepends @~ Go@/types@/litar.Block @~ Go@/types@/litar.ChunkRef @

@<list@:litar@:Go Structure@/functions@+
// Refer is the -r listing.
func Refer(blocks []Block, item Item) string {
	var got []Block
	for _, b := range blocks {
		for _, it := range b.Items {
			if sameItem(it, item) {
				got = append(got, b)
				break
			}
		}
	}
	return FormatBlocks(got)
}

@~ Go@/functions@/litar.FormatBlocks @~ Go@/functions@/litar.Refer @~ Go@/functions@/litar.sameItem @~ Go@/types@/litar.Block @~ Go@/types@/litar.Item @

@<list@:litar@:Go Structure@/functions@+
func nodeMeta(world *World, node string, chain []Block) (metaInfo, error) {
	maps, err := world.Mappings(node)
	if err != nil {
		return metaInfo{}, err
	}
	return describe(chain, maps)
}

