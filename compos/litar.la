A process killed by a signal gets the status a shell reports for it.
@<filter@:litar@:Language@/Go@/File@/functions@+
// exitStatus is the status of a failed wait: the exit code,
// or 128 plus the signal for a process killed by a signal.
func exitStatus(err error) int {
	code := 1
	if ee, ok := err.(*exec.ExitError); ok {
		code = ee.ExitCode()
		if code < 0 {
			if ws, ok := ee.Sys().(syscall.WaitStatus); ok && ws.Signaled() {
				code = 128 + int(ws.Signal())
			} else {
				code = 1
			}
		}
	}
	return code
}

@~ Project@/litar@/Go@/functions@/litar.exitStatus @
@<Project@/litar@/run 'args' in the view mounted at 'mnt' with 'input' on stdin@=
// The child must not enter the mount before exec. Until exec it shares
// memory with this process, whose FUSE server answers the chdir;
// a stop-the-world in between waits for the forking thread forever.
cmd := exec.Command("/bin/sh", append([]string{"-c", `cd "$0" && exec "$@@"`, mnt.dir}, args...)...)
cmd.Env = filterEnv()
cmd.Stderr = ev.stderr
stderr := &countingWriter{w: ev.stderr}
if keyed {
	cmd.Stderr = stderr
}
stdin, err := cmd.StdinPipe()
if err != nil {
	return "", fmt.Errorf("filter '%s' exited with status 1", ref.String())
}
stdout, err := cmd.StdoutPipe()
if err != nil {
	return "", fmt.Errorf("filter '%s' exited with status 1", ref.String())
}
@<.@/start 'cmd', with status 127 if the interpreter is missing@>
@<.@/send 'input' to 'stdin' and return what 'cmd' writes to 'stdout'@>
