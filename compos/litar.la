Line numbers are generated by a CSS counter, so copied text has none.
@<Project@/litar@/Web@/style rules@+
pre.lines { counter-reset: line; padding-left: 0; }
pre.lines span { display: block; padding-left: 4.5em; text-indent: -4.5em; }
pre.lines span::before { counter-increment: line; content: counter(line);
  display: inline-block; width: 3.5em; margin-right: 1em; text-align: right; color: var(--muted); }
.error { color: var(--header); white-space: pre-wrap; }
.note { color: var(--muted); }
select.spec { font: inherit; margin: 0 0 8px; }
@

A header holds the composition picker and the expression box;
below it the sidebar lists nodes, and the main area shows the tabs of a node,
a tree of chunks, files, or items, and the detail of one entry.
@<Project@/litar@/Web@/page layout@=
<header>
  <h1>litar</h1>
  <select id="composition" title="composition"></select>
  <input id="import-path" placeholder="composition directory to import">
  <button id="import">Import</button>
  <input id="expression" class="grow" placeholder="expression to evaluate in this node, e.g. hello.c">
  <button id="evaluate">Evaluate</button>
</header>
<nav id="sidebar"></nav>
<section id="main">
  <nav id="tabs"></nav>
  <div id="body"><div id="list"></div><div id="detail"></div></div>
</section>
@
@<Project@/litar@/Web@/resource access@=
// Resource access: the server forwards these to the MCP server of litar.
async function answer(response) {
  const text = await response.text();
  if (!response.ok) throw new Error(text.trim().replace(/^calling "[^"]*": /, ''));
  return text;
}
async function resource(uri) {
  return answer(await fetch('/api/resource?uri=' + encodeURIComponent(uri)));
}
async function tool(name, args) {
  return answer(await fetch('/api/tool', {
    method: 'POST', headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({name, arguments: args}),
  }));
}
@

@<Project@/litar@/Web@/resource access@+
// Ids stay valid while nothing changes the composition, so trees are cached per node.
const cache = new Map();
async function tree(kind, c, n, extra) {
  const uri = 'tree://' + kind + '/' + [c, n, extra].filter(x => x !== undefined).join('/');
  if (!cache.has(uri)) cache.set(uri, resource(uri).then(JSON.parse));
  return cache.get(uri);
}
@

@<Project@/litar@/Web@/trees@=
// Trees: every tree has a root; the leaves are the chunks, files, or items.
const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'}[c]));
const subs = t => t['sub-trees'];
function walk(t, fn, path = []) {
  for (const s of subs(t)) {
    const p = path.concat(s.name);
    fn(s, p);
    walk(s, fn, p);
  }
}
function leafIndex(t) {
  const byPath = new Map(), byId = new Map();
  walk(t, (s, p) => {
    if (subs(s).length === 0) { byPath.set(JSON.stringify(p), s.id); byId.set(s.id, p); }
  });
  return {byPath, byId};
}
@

A branch folds. While filtering, every branch is open. Otherwise a branch the reader opened or folded
keeps that state, for each node and kind of tree, and any other branch is open when it holds the selected leaf.
A tree lists its sub-trees before its leaves, each group in name order.
@<Project@/litar@/Web@/trees@+
// A subtree is shown when the filter matches its path or one of its leaves.
const folds = new Map();
const foldKey = (kind, path) => state.c + '/' + state.n + '/' + kind + '/' + JSON.stringify(path);
const bySubTreesThenName = (a, b) =>
  (subs(b).length > 0) - (subs(a).length > 0) || (a.name < b.name ? -1 : a.name > b.name ? 1 : 0);
function treeHTML(t, href, selected, filter, kind, path = []) {
  const items = [];
  let holds = false;
  for (const s of subs(t).slice().sort(bySubTreesThenName)) {
    const p = path.concat(s.name);
    const desc = s.description ? '<span class="desc">' + esc(s.description) + '</span>' : '';
    if (subs(s).length === 0) {
      if (filter && !p.join('/').toLowerCase().includes(filter)) continue;
      holds = holds || s.id === selected;
      items.push('<li class="leaf"><a href="' + href(s, p) + '"' + (s.id === selected ? ' class="sel"' : '') + '>'
        + esc(s.name) + '</a>' + desc + '</li>');
    } else {
      const inner = treeHTML(s, href, selected, filter, kind, p);
      if (!inner.html) continue;
      holds = holds || inner.holds;
      const key = foldKey(kind, p);
      const open = filter || (folds.has(key) ? folds.get(key) : inner.holds);
      items.push('<li><details data-fold="' + esc(key) + '"' + (open ? ' open' : '') + '><summary><span class="mod">'
        + esc(s.name) + '</span>' + desc + '</summary>' + inner.html + '</details></li>');
    }
  }
  return {html: items.length ? '<ul class="tree">' + items.join('') + '</ul>' : '', holds};
}
@

The filter box redraws the tree on every keystroke, without fetching it again.
Folding while filtering is not remembered, since the filter opens every branch.
@<Project@/litar@/Web@/trees@+
function showTree(t, href, selected, kind) {
  const list = $('list');
  list.innerHTML = '<div class="tools"><input class="filter" placeholder="filter ' + esc(kind) + '">'
    + '<button data-open="1" title="unfold every branch">Unfold all</button>'
    + '<button data-open="" title="fold every branch">Fold all</button></div>'
    + '<div class="items"></div>';
  const input = list.querySelector('input'), items = list.querySelector('.items');
  const filter = () => input.value.trim().toLowerCase();
  const draw = () => {
    items.innerHTML = treeHTML(t, href, selected, filter(), kind).html
      || '<p class="note">Nothing here.</p>';
  };
  input.addEventListener('input', draw);
  items.addEventListener('toggle', e => {
    if (!filter()) folds.set(e.target.dataset.fold, e.target.open);
  }, true);
  for (const button of list.querySelectorAll('button')) {
    button.addEventListener('click', () => {
      walk(t, (s, p) => { if (subs(s).length) folds.set(foldKey(kind, p), Boolean(button.dataset.open)); });
      input.value = '';
      draw();
    });
  }
  draw();
}
@
@<Project@/litar@/Web@/names@=
// Names: '@@@@' is a literal '@@', so a separator is a control not preceded by another '@@'.
function splitControl(raw, c) {
  const parts = [];
  let cur = '';
  for (let i = 0; i < raw.length; i++) {
    if (raw[i] === '@@' && raw[i + 1] === '@@') { cur += '@@@@'; i++; }
    else if (raw[i] === '@@' && raw[i + 1] === c) { parts.push(cur); cur = ''; i++; }
    else cur += raw[i];
  }
  parts.push(cur);
  return parts;
}
const decode = s => s.replace(/@@@@/g, '@@').trim();
const encode = s => s.replace(/@@/g, '@@@@');
@

@<Project@/litar@/Web@/names@+
// A reference without labels takes the labels of scope, the reference that applies its block,
// and a module path starting with . or .. is relative to the module of scope, its block's header.
function parseRef(raw, scope) {
  const parts = splitControl(raw, ':');
  const path = splitControl(parts.pop(), '/').map(decode);
  const chunk = path.pop();
  let labels = parts.map(decode);
  let mods = path;
  if (scope && scope.mods && (mods[0] === '.' || mods[0] === '..')) {
    mods = scope.mods.slice();
    for (const m of path) {
      if (m === '..') mods.pop(); else if (m !== '.') mods.push(m);
    }
  }
  if (scope && labels.length === 0) labels = scope.labels;
  return {labels, mods, chunk};
}
function refText(ref) {
  return ref.labels.map(l => encode(l) + '@@:').join('') + ref.mods.map(m => encode(m) + '@@/').join('')
    + encode(ref.chunk);
}

@

@<Project@/litar@/Web@/names@+
// Meta chunks live in reserved modules that the chunk tree leaves out.
// Chunk, File, and Index blocks link to what they describe; the others stay plain.
const reserved = ['Chunk', 'Specialization', 'File', 'Index'];
function metaLink(ref, raw, link) {
  if (ref.labels.length || !reserved.includes(ref.mods[0])) return link('ref', ref, raw);
  const path = ref.mods.slice(1).concat(ref.chunk);
  if (ref.mods[0] === 'Index') return link('item', path, raw);
  if (ref.mods[0] === 'File') return link('file', path.join('/'), raw);
  if (ref.mods[0] === 'Chunk') return link('ref', {labels: [], mods: path.slice(0, -1), chunk: path[path.length - 1]}, raw);
  return esc(raw);
}
// The chunk tree lists a file chunk below File, one name for each part of its path.
function pathRef(path, labels) {
  if (path[0] === 'File' && path.length > 1) return {labels, mods: [], chunk: path.slice(1).join('/')};
  return {labels, mods: path.slice(0, -1), chunk: path[path.length - 1]};
}
@

@<Project@/litar@/Web@/block rendering@=
// Block rendering: a small scanner of the archive syntax that links names to their pages.
// Blocks apply with labels, the labels of the reference being viewed, or else with the labels of their headers.
const isLetter = c => /[A-Za-z]/.test(c) || c > '\x7f';
const isSpace = c => c === undefined || c === ' ' || c === '\t' || c === '\r' || c === '\n';
function renderBlocks(text, base, labels) {
  let i = 0, html = '', comment = '';
  const link = (kind, target, label) =>
    '<a href="' + base + '/' + kind + '/' + encodeURIComponent(JSON.stringify(target)) + '">' + esc(label) + '</a>';
@<.@/scanners 'name' and 'ctl' of the names and controls of 'text' at 'i'@>
  const blocks = [];
  while (i < text.length) {
    const open = text[i] === '@@' ? text[i + 1] : null;
    if (open !== '<' && open !== '[' && open !== '(') { comment += text[i++]; continue; }
@<.@/render into 'blocks' the block opened by 'open', after its 'comment'@>
  }
  return blocks.join('') || '<p class="note">No blocks.</p>';
}
function linesHTML(text) {
  if (text.endsWith('\n')) text = text.slice(0, -1);
  return '<pre class="lines">' + text.split('\n').map(l => '<span>' + esc(l) + '</span>').join('') + '</pre>';
}
@

The text before a block is its comment, shown above it.
@<Project@/litar@/Web@/render into 'blocks' the block opened by 'open', after its 'comment'@=
    i += 2;
    let head = '', header = null;
@<.@/render into 'head' the header of the block opened by 'open', and parse it into 'header'@>
    const scope = {labels: labels || header.labels, mods: header.mods};
    i += 2;
    let body = '';
@<.@/render into 'body' the content of the block, resolving its references in 'scope'@>
    blocks.push('<div class="block">' + (comment.trim() ? '<div class="comment">' + esc(comment.trim()) + '</div>' : '')
      + '<pre>' + head + body + '</pre></div>');
    comment = '';
@

A stop of ' ' stands for any white space, and so for the end of the text.
@<Project@/litar@/Web@/scanners 'name' and 'ctl' of the names and controls of 'text' at 'i'@=
  // Read a name up to a control in stops; '@@@@', '@@:' and '@@/' belong to names.
  const name = stops => {
    const start = i;
    while (i < text.length) {
      if (text[i] === '@@') {
        const c = text[i + 1];
        if (c === '@@' || c === ':' || c === '/') { i += 2; continue; }
        if (stops.includes(c) || (stops.includes(' ') && isSpace(c))) break;
      }
      i++;
    }
