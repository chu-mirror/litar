The output is read concurrently, so a filter that writes before reading all its input does not block.
A keyed run that succeeds without writing to stderr keeps its output in the filter cache.
@<Project@/litar@/send 'input' to 'stdin' and return what 'cmd' writes to 'stdout'@=
var out bytes.Buffer
copyDone := make(chan struct{})
go func() {
	_, _ = io.Copy(&out, stdout)
	close(copyDone)
}()
_, _ = io.Copy(stdin, strings.NewReader(input))
_ = stdin.Close()
waitErr := cmd.Wait()
<-copyDone
if waitErr != nil {
	return "", fmt.Errorf("filter '%s' exited with status %d", ref.String(), exitStatus(waitErr))
}
if keyed && stderr.n == 0 {
	writeCachedOutput(key, out.String())
}
return out.String(), nil
