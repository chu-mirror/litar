@<compose@:litar@:Language@/Go@/File@/methods@+
func (w *World) rootIndex() (int, error) {
	found := -1
	for i := range w.Nodes {
		if len(w.Nodes[i].Base) == 0 {
			if found >= 0 {
				return 0, fmt.Errorf("composer has more than one root")
			}
			found = i
		}
	}
	if found < 0 {
		return 0, fmt.Errorf("composer has no root")
	}
	return found, nil
}

