@<filter@:litar@:Go Structure@/types@+
type catFile struct {
	sets       map[string]struct{}
	executable bool
	archive    bool
	mapping    bool
	origin     string
}

@~ Go@/types@/litar.catFile @

@<filter@:litar@:Go Structure@/types@+
type catalog struct {
	order     []string
	files     map[string]*catFile
	conflicts map[string]bool
}

@~ Go@/types@/litar.catFile @~ Go@/types@/litar.catalog @

@<filter@:litar@:Go Structure@/functions@+
func buildCatalog(chain []Block, mappings []Mapping) *catalog {
	c := &catalog{
		files:     map[string]*catFile{},
		conflicts: map[string]bool{},
	}
	touch := func(path string) *catFile {
		f := c.files[path]
		if f == nil {
			f = &catFile{sets: map[string]struct{}{}}
			c.files[path] = f
			c.order = append(c.order, path)
		}
		return f
	}
	for _, b := range chain {
		if !b.IsFile {
			continue
		}
		f := touch(string(b.Path))
		f.archive = true
		f.executable = b.Executable
		for _, set := range b.Sets {
			f.sets[string(set)] = struct{}{}
		}
	}
	for _, m := range mappings {
		f := touch(m.Path)
		if f.archive {
			c.conflicts[m.Path] = true
		}
		f.mapping = true
		f.origin = m.Origin
		for _, set := range m.FileSet {
			f.sets[set] = struct{}{}
		}
	}
	return c
}

