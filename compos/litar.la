@<mcp@:litar@:Go Structure@/methods@+
func (a *agent) createNode(ctx context.Context, _ *mcp.CallToolRequest, in createIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	w, err := a.compositionByID(in.Composition)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	var base []string
	if in.Base != nil {
		parent, err := nodeByID(w, *in.Base)
		if err != nil {
			a.mu.Unlock()
			return toolErr(err)
		}
		base = nodePath(*parent)
	}
	if err := w.CreateNode(in.Name, in.Archive, in.Description, base); err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	id, err := nodeID(w, formatNodePath(append(base, in.Name)))
	a.mu.Unlock()
	if err != nil {
		return toolErr(err)
	}
	a.refresh()
	return toolText(strconv.Itoa(id))
}

@~ Go@/functions@/litar.formatNodePath @~ Go@/functions@/litar.nodeByID @~ Go@/functions@/litar.nodeID @~ Go@/functions@/litar.nodePath @~ Go@/functions@/litar.toolErr @~ Go@/functions@/litar.toolText @~ Go@/methods@/litar.World.CreateNode @~ Go@/methods@/litar.agent.compositionByID @~ Go@/methods@/litar.agent.createNode @~ Go@/methods@/litar.agent.refresh @~ Go@/types@/litar.agent @~ Go@/types@/litar.createIn @

@<mcp@:litar@:Go Structure@/methods@+
func (a *agent) deleteNode(ctx context.Context, _ *mcp.CallToolRequest, in deleteNodeIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	w, n, err := a.worldNode(in.Composition, in.Node)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	if err := w.DeleteNode(formatNodePath(nodePath(*n))); err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	a.mu.Unlock()
	a.refresh()
	return toolText(strconv.Itoa(in.Node))
}

@~ Go@/functions@/litar.formatNodePath @~ Go@/functions@/litar.nodePath @~ Go@/functions@/litar.toolErr @~ Go@/functions@/litar.toolText @~ Go@/methods@/litar.World.DeleteNode @~ Go@/methods@/litar.agent.deleteNode @~ Go@/methods@/litar.agent.refresh @~ Go@/methods@/litar.agent.worldNode @~ Go@/types@/litar.agent @~ Go@/types@/litar.deleteNodeIn @

@<mcp@:litar@:Go Structure@/methods@+
func (a *agent) deleteChunk(ctx context.Context, _ *mcp.CallToolRequest, in deleteChunkIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	w, n, err := a.worldNode(in.Composition, in.Node)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	np := formatNodePath(nodePath(*n))
	chain, err := w.Chain(np)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	maps, err := w.Mappings(np)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	ref, err := chunkByID(chain, maps, in.Chunk)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	if err := w.DeleteChunkAll(np, ref); err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	a.mu.Unlock()
	a.refresh()
	return toolText(strconv.Itoa(in.Chunk))
}

