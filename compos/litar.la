@<filter test@:litar@:Go Structure@/functions@+
func TestFilterIO(t *testing.T) {
	if _, err := os.Stat("/bin/sh"); err != nil {
		t.Skip(err)
	}
	src := "" +
		"@@<upper@@=\n" +
		"#!/bin/sh\n" +
		"tr '[:lower:]' '[:upper:]'\n" +
		"@@\n" +
		"@@<msg@@=\n" +
		"hello\n" +
		"@@|upper@@\n" +
		"@@<bad@@=\n" +
		"echo hi\n" +
		"@@\n" +
		"@@<die@@=\n" +
		"#!/bin/sh\n" +
		"exit 3\n" +
		"@@\n" +
		"@@<copy@@=\n" +
		"#!/bin/sh\n" +
		"cat\n" +
		"@@\n"
	blocks := mustArch(t, src)
	ev := NewEvaluator(blocks, nil, nil)
	got, err := ev.Eval(mustRef(t, "msg"), nil)
	if err != nil || got != "HELLO" {
		t.Fatalf("%v %q", err, got)
	}
	// A chunk body is not a filter until a pipeline names it.
	src2 := src + "@@<use@@=\n" +
		"hi\n" +
		"@@|bad@@\n" +
		"@@<use2@@=\n" +
		"hi\n" +
		"@@|die@@\n" +
		"@@<use3@@=\n" +
		"hi\n" +
		"@@|copy@@\n"
	blocks = mustArch(t, src2)
	ev = NewEvaluator(blocks, nil, nil)
	_, err = ev.Eval(mustRef(t, "use"), nil)
	if err == nil || !strings.Contains(err.Error(), "filter 'bad' has no shebang") {
		t.Fatal(err)
	}
	_, err = ev.Eval(mustRef(t, "use2"), nil)
	if err == nil || !strings.Contains(err.Error(), "filter 'die' exited with status 3") {
		t.Fatal(err)
	}
	got, err = ev.Eval(mustRef(t, "use3"), nil)
	if err != nil || got != "hi" {
		t.Fatalf("copy %v %q", err, got)
	}
	_, err = ev.Eval(mustRef(t, "missing"), nil)
	if err == nil || !strings.Contains(err.Error(), "not defined") {
		t.Fatal(err)
	}
}

@~ Go@/functions@/litar.NewEvaluator @~ Go@/functions@/litar.mustArch @~ Go@/functions@/litar.mustRef @~ Go@/methods@/litar.Evaluator.Eval @

@<filter test@:litar@:Go Structure@/functions@+
func TestFUSEView(t *testing.T) {
	if _, err := os.Stat("/dev/fuse"); err != nil {
		t.Skip("no /dev/fuse")
	}
	src := "" +
		"@@[hello.txt@@`docs@@=\n" +
		"hello world\n" +
		"@@\n" +
		"@@(run.sh@@`docs@@=\n" +
		"echo run\n" +
		"@@\n" +
		"@@<show@@=\n" +
		"#!/bin/sh\n" +
		"cat hello.txt\n" +
		"@@\n" +
		"@@<size@@=\n" +
		"#!/bin/sh\n" +
		"stat -c %s hello.txt\n" +
		"@@\n" +
		"@@<sized@@=\n" +
		"@@|size@@,hello.txt@@\n" +
		"@@<msg@@=\n" +
		"@@|show@@+docs@@\n" +
		"@@<exe@@=\n" +
		"#!/bin/sh\n" +
		"if test -x run.sh; then echo yes; else echo no; fi\n" +
		"@@\n" +
		"@@<ask@@=\n" +
		"@@|exe@@+docs@@\n" +
		"@@<make@@=\n" +
		"#!/bin/sh\n" +
		"printf overlay > created.txt\n" +
		"cat created.txt\n" +
		"@@\n" +
		"@@<made@@=\n" +
		"@@|make@@\n" +
		"@@<ro@@=\n" +
		"#!/bin/sh\n" +
		"echo x > hello.txt\n" +
		"@@\n" +
		"@@<row@@=\n" +
		"@@|ro@@,hello.txt@@\n"
	blocks := mustArch(t, src)
	ev := NewEvaluator(blocks, nil, nil)
	got, err := ev.Eval(mustRef(t, "msg"), nil)
	if err != nil || got != "hello world" {
		t.Fatalf("view %v %q", err, got)
	}
	got, err = ev.Eval(mustRef(t, "sized"), nil)
	if err != nil || strings.TrimSpace(got) != "11" {
		t.Fatalf("size %v %q", err, got)
	}
	got, err = ev.Eval(mustRef(t, "ask"), nil)
	if err != nil || got != "yes\n" {
		t.Fatalf("exec %v %q", err, got)
	}
	got, err = ev.Eval(mustRef(t, "made"), nil)
	if err != nil || got != "overlay" {
		t.Fatalf("overlay %v %q", err, got)
	}
	_, err = ev.Eval(mustRef(t, "row"), nil)
	if err == nil || !strings.Contains(err.Error(), "exited with status") {
		t.Fatal(err)
	}
	ref, filters := mustPrint(t, "@@|show@@,missing")
	_, err = ev.Eval(ref, filters)
	if err == nil || !strings.Contains(err.Error(), "file 'missing' is not defined") {
		t.Fatal(err)
	}
	ref, filters = mustPrint(t, "@@|show@@,../x")
	_, err = ev.Eval(ref, filters)
	if err == nil || !strings.Contains(err.Error(), "invalid file path '../x'") {
		t.Fatal(err)
	}
}

@~ Go@/functions@/litar.NewEvaluator @~ Go@/functions@/litar.mustArch @~ Go@/functions@/litar.mustPrint @~ Go@/functions@/litar.mustRef @~ Go@/methods@/litar.Evaluator.Eval @

@<filter test@:litar@:Go Structure@/functions@+
func TestFUSEViewOutlivedByBackgroundProcess(t *testing.T) {
	if _, err := os.Stat("/dev/fuse"); err != nil {
		t.Skip("no /dev/fuse")
	}
	src := "" +
		"@@<leave@@=\n" +
		"#!/bin/sh\n" +
		"(sleep 3 </dev/null >/dev/null 2>&1 &)\n" +
		"echo hi\n" +
		"@@\n" +
		"@@<msg@@=\n" +
		"@@|leave@@\n"
	blocks := mustArch(t, src)
	ev := NewEvaluator(blocks, nil, nil)
	type result struct {
		text string
		err  error
	}
	done := make(chan result, 1)
	go func() {
		text, err := ev.Eval(mustRef(t, "msg"), nil)
		done <- result{text, err}
	}()
	select {
	case r := <-done:
		if r.err != nil || r.text != "hi\n" {
			t.Fatalf("%v %q", r.err, r.text)
		}
	case <-time.After(2 * time.Second):
		t.Fatal("evaluation waits for the background process")
	}
	mounts, err := os.ReadFile("/proc/self/mounts")
	if err == nil && strings.Contains(string(mounts), "fuse.litar") {
		t.Fatalf("a filter view is still mounted:\n%s", mounts)
	}
}

