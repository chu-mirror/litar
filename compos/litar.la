Only one action is allowed. Two actions are reported in the order of modeOrder,
so the message does not depend on the order of the arguments.
@<Project@/litar@/choose 'mode' and 'operand' from the actions given in 'opts'@=
operands := map[string]string{
	"print":     opts.Print,
	"literal":   opts.Literal,
	"effective": opts.Effective,
	"depend":    opts.Depend,
	"reference": opts.Reference,
}
for _, name := range modeOrder {
	given := operands[name] != ""
	if name == "agent" {
		given = opts.Agent
	}
	if !given {
		continue
	}
	if mode != "" {
		return fail("cannot combine %s and %s", mode, name)
	}
	mode, operand = name, operands[name]
}
if mode == "" {
	return fail("%s", missingAction)
}
