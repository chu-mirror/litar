}

@~ Project@/litar@/Go@/types@/litar.viewFile @

@<filter@:litar@:Language@/Go@/File@/methods@+
func (c *catalog) apply(ops []ViewOp) ([]viewFile, error) {
in := map[string]bool{}
var order []string
add := func(path string) error {
	@<Project@/litar@/add 'path' to 'in' and 'order' if it names one defined file@>
}
for _, op := range ops {
	switch op.Kind {
	@<Project@/litar@/cases of 'op' in 'catalog.apply'@>
	}
}
@<Project@/litar@/return the files of 'order' still in 'in' as view files@>
}

@~ Project@/litar@/Go@/methods@/litar.catalog.apply @~ Project@/litar@/Go@/types@/litar.ViewOp @~ Project@/litar@/Go@/types@/litar.catalog @~ Project@/litar@/Go@/types@/litar.viewFile @

A file must be defined either by an archive or by a mapping, not both.
@<Project@/litar@/add 'path' to 'in' and 'order' if it names one defined file@=
if err := validFilePath(path); err != nil {
	return err
}
f := c.files[path]
if f == nil || (!f.archive && !f.mapping) {
	return fmt.Errorf("file '%s' is not defined", path)
}
if f.archive && f.mapping || c.conflicts[path] {
	return fmt.Errorf("file '%s' is defined as both an archive file and a mapping", path)
}
if !in[path] {
	in[path] = true
	order = append(order, path)
}
return nil
@~ Project@/litar@/Go@/functions@/litar.validFilePath @

A set adds its files in catalog order, so the first block or mapping of a file decides its place.
@<Project@/litar@/cases of 'op' in 'catalog.apply'@=
case AddSet:
	name := string(op.Name)
	for _, path := range c.order {
		f := c.files[path]
		if _, ok := f.sets[name]; !ok {
			continue
		}
		if err := add(path); err != nil {
			return nil, err
		}
	}
@~ Project@/litar@/Go@/constants@/litar.AddSet @

Removing a set does not check its files; a set that matches nothing removes nothing.
@<Project@/litar@/cases of 'op' in 'catalog.apply'@+
case SubSet:
	name := string(op.Name)
	for _, path := range c.order {
		f := c.files[path]
		if _, ok := f.sets[name]; ok {
			delete(in, path)
		}
	}
@~ Project@/litar@/Go@/constants@/litar.SubSet @

A removed file only needs a valid path; it need not be defined or in the view.
@<Project@/litar@/cases of 'op' in 'catalog.apply'@+
case AddFile:
	if err := add(string(op.Name)); err != nil {
		return nil, err
	}
case DelFile:
	path := string(op.Name)
	if err := validFilePath(path); err != nil {
		return nil, err
	}
	delete(in, path)
@~ Project@/litar@/Go@/constants@/litar.AddFile @~ Project@/litar@/Go@/constants@/litar.DelFile @~ Project@/litar@/Go@/functions@/litar.validFilePath @

A file removed and added again appears once, at its first place in order.
Only an archive file can be executable.
@<Project@/litar@/return the files of 'order' still in 'in' as view files@=
var out []viewFile
seen := map[string]bool{}
for _, path := range order {
	if !in[path] || seen[path] {
		continue
	}
	seen[path] = true
	f := c.files[path]
	out = append(out, viewFile{
		path:       path,
		executable: f.executable && f.archive,
		origin:     f.origin,
		archive:    f.archive,
		dir:        f.dir && !f.archive,
	})
}
return out, nil
@~ Project@/litar@/Go@/types@/litar.viewFile @

@<filter@:litar@:Language@/Go@/File@/methods@+
// tangle writes each view file's bytes before the filter process starts.
// An archive file is the root-module chunk named by its path.
// A mapped file is the contents of origin. A mapped directory is created
// when it is missing, so a build can write into a fresh tree.
func (e *Evaluator) tangle(files []viewFile) error {
	for i := range files {
		var (
			data []byte
			err  error
		)
		switch {
		case files[i].archive:
			data, err = e.readChunk(Name(files[i].path))
		case files[i].dir:
			if err = os.MkdirAll(files[i].origin, 0o755); err != nil {
				err = fmt.Errorf("could not create '%s'", files[i].origin)
				e.noteErr(err)
			}
		default:
			data, err = os.ReadFile(files[i].origin)
			if err != nil {
				err = fmt.Errorf("could not read '%s'", files[i].origin)
				e.noteErr(err)
			}
		}
		if err != nil {
			return err
		}
		files[i].body = data
	}
	return nil
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.noteErr @~ Project@/litar@/Go@/methods@/litar.Evaluator.readChunk @~ Project@/litar@/Go@/methods@/litar.Evaluator.tangle @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.Name @~ Project@/litar@/Go@/types@/litar.viewFile @

