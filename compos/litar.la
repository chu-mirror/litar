@<mcp@:litar@:Language@/Go@/File@/functions@+
// nullableStringSchema is the inferred object schema with field rewritten.
// A *string infers "type": ["null", "string"]. Some clients accept only
// one type per schema, so null and string are separate anyOf branches.
func nullableStringSchema[T any](field string) *jsonschema.Schema {
	s, err := jsonschema.For[T](nil)
	if err != nil {
		panic(err)
	}
	prop := s.Properties[field]
	s.Properties[field] = &jsonschema.Schema{
		Description: prop.Description,
		AnyOf: []*jsonschema.Schema{
			{Type: "null"},
			{Type: "string"},
		},
	}
	return s
}

@~ Project@/litar@/Go@/functions@/litar.nullableStringSchema @

@<mcp@:litar@:Language@/Go@/File@/functions@+
// nullableIntegerSchema publishes field as null or an integer.
// A *int infers "type": ["null", "integer"]. Some clients accept only
// one type per schema, so null and integer are separate anyOf branches.
func nullableIntegerSchema[T any](field string) *jsonschema.Schema {
	s, err := jsonschema.For[T](nil)
	if err != nil {
		panic(err)
	}
	prop := s.Properties[field]
	s.Properties[field] = &jsonschema.Schema{
		Description: prop.Description,
		AnyOf: []*jsonschema.Schema{
			{Type: "null"},
			{Type: "integer"},
		},
	}
	return s
}

@~ Project@/litar@/Go@/functions@/litar.nullableIntegerSchema @

@<mcp@:litar@:Language@/Go@/File@/functions@+
func toolErr(err error) (*mcp.CallToolResult, any, error) {
	return &mcp.CallToolResult{
		IsError: true,
		Content: []mcp.Content{&mcp.TextContent{Text: err.Error()}},
	}, nil, nil
}

@~ Project@/litar@/Go@/functions@/litar.toolErr @

@<mcp@:litar@:Language@/Go@/File@/functions@+
func toolText(text string) (*mcp.CallToolResult, any, error) {
	return &mcp.CallToolResult{
		Content: []mcp.Content{&mcp.TextContent{Text: text}},
	}, map[string]any{"text": text}, nil
}

@~ Project@/litar@/Go@/functions@/litar.toolText @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) addWorldLocked(w *World) {
	if _, ok := a.worlds[w.Dir]; !ok {
		a.order = append(a.order, w.Dir)
	}
	a.worlds[w.Dir] = w
}

@~ Project@/litar@/Go@/methods@/litar.agent.addWorldLocked @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) addWorld(w *World) {
	a.mu.Lock()
	a.addWorldLocked(w)
	a.mu.Unlock()
}

@~ Project@/litar@/Go@/methods@/litar.agent.addWorld @~ Project@/litar@/Go@/methods@/litar.agent.addWorldLocked @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) useWorld(w *World) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	a.addWorldLocked(w)
	id := -1
	for i, c := range a.compositions() {
		if c.Dir == w.Dir {
			id = i
			break
		}
	}
	a.mu.Unlock()
	a.refresh()
	if id < 0 {
		return toolErr(errString("unknown composition"))
	}
	return toolText(strconv.Itoa(id))
}

@~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/functions@/litar.toolText @~ Project@/litar@/Go@/methods@/litar.agent.addWorldLocked @~ Project@/litar@/Go@/methods@/litar.agent.compositions @~ Project@/litar@/Go@/methods@/litar.agent.refresh @~ Project@/litar@/Go@/methods@/litar.agent.useWorld @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.errString @

@<mcp@:litar@:Language@/Go@/File@/methods@+
// compositions is the imported compositions in list order.
// The caller holds a.mu.
func (a *agent) compositions() []*World {
	out := make([]*World, 0, len(a.order))
	for _, dir := range a.order {
		if w := a.worlds[dir]; w != nil {
			out = append(out, w)
		}
	}
	return out
}

@~ Project@/litar@/Go@/methods@/litar.agent.compositions @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @

@<mcp@:litar@:Language@/Go@/File@/methods@+
// compositionByID resolves an id from list://composition.
// The caller holds a.mu.
func (a *agent) compositionByID(id int) (*World, error) {
	comps := a.compositions()
	if id < 0 || id >= len(comps) {
		return nil, fmt.Errorf("unknown composition %d", id)
	}
	return comps[id], nil
}

@~ Project@/litar@/Go@/methods@/litar.agent.compositionByID @~ Project@/litar@/Go@/methods@/litar.agent.compositions @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) importComposition(ctx context.Context, _ *mcp.CallToolRequest, in importIn) (*mcp.CallToolResult, any, error) {
	if in.Path == "" {
		return toolErr(errString("missing path"))
	}
	w, err := SpecifyComposer(in.Path)
	if err != nil {
		return toolErr(err)
	}
	return a.useWorld(w)
}

@~ Project@/litar@/Go@/functions@/litar.SpecifyComposer @~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/methods@/litar.agent.importComposition @~ Project@/litar@/Go@/methods@/litar.agent.useWorld @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.errString @~ Project@/litar@/Go@/types@/litar.importIn @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) createComposition(ctx context.Context, _ *mcp.CallToolRequest, in createArchiveIn) (*mcp.CallToolResult, any, error) {
	if in.Path == "" {
		return toolErr(errString("missing path"))
	}
	ground := ""
	if in.Ground != nil {
		ground = *in.Ground
	}
	w, err := CreateComposedArchive(in.Path, ground)
	if err != nil {
		return toolErr(err)
	}
	if in.Description != "" {
		w.Description = in.Description
		if err := w.save(); err != nil {
			return toolErr(err)
		}
	}
	return a.useWorld(w)
}

@~ Project@/litar@/Go@/functions@/litar.CreateComposedArchive @~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/methods@/litar.World.save @~ Project@/litar@/Go@/methods@/litar.agent.createComposition @~ Project@/litar@/Go@/methods@/litar.agent.useWorld @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.createArchiveIn @~ Project@/litar@/Go@/types@/litar.errString @

