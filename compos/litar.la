// Chain is the base chain followed by the node's own blocks.
func (w *World) Chain(name string) ([]Block, error) {
	rev, err := w.ancestry(name)
	if err != nil {
		return nil, err
	}
	var blocks []Block
	for i := len(rev) - 1; i >= 0; i-- {
		blocks = append(blocks, rev[i].Own...)
	}
	return blocks, nil
}

