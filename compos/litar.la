The names in a block take the color of their kind, and links inside them keep it.
@<Project@/litar@/Web@/style rules@+
.block { border: 1px solid var(--line); border-radius: 6px; margin: 0 0 12px; overflow: hidden; }
.block .comment { padding: 6px 10px; background: var(--panel); white-space: pre-wrap; color: var(--muted); }
pre { margin: 0; padding: 8px 10px; font: 13px/1.45 ui-monospace, monospace; overflow: auto; }
pre a { text-decoration: none; }
.h { color: var(--header); font-weight: 600; } .h a { color: inherit; }
.r { color: var(--ref); } .r a { color: inherit; }
.p { color: var(--pipe); } .p a { color: inherit; }
.i { color: var(--item); } .i a { color: inherit; }
.ctl { color: var(--muted); }
