@<mcp@:litar@:Go Structure@/functions@+
func fileTree(blocks []Block, mappings []Mapping) treeJSON {
	cat := buildCatalog(blocks, mappings)
	root := newNest()
	for _, path := range cat.order {
		parts := strings.Split(path, "/")
		cur := root
		for i, part := range parts {
			if i == len(parts)-1 {
				cur.addLeaf(part)
				break
			}
			cur = cur.addSub(part)
		}
	}
	return root.treeWith("/", "", nil, nil, nil)
}

@~ Go@/functions@/litar.buildCatalog @~ Go@/functions@/litar.fileTree @~ Go@/functions@/litar.newNest @~ Go@/methods@/litar.nest.addLeaf @~ Go@/methods@/litar.nest.addSub @~ Go@/methods@/litar.nest.treeWith @~ Go@/types@/litar.Block @~ Go@/types@/litar.Mapping @~ Go@/types@/litar.treeJSON @

@<mcp@:litar@:Go Structure@/functions@+
func itemTree(blocks []Block, maps []Mapping) (treeJSON, error) {
	meta, err := describe(blocks, maps)
	if err != nil {
		return treeJSON{}, err
	}
	root := newNest()
	for _, b := range blocks {
		for _, it := range b.Items {
			cur := root
			for i, name := range it {
				if i == len(it)-1 {
					cur.addLeaf(string(name))
					break
				}
				cur = cur.addSub(string(name))
			}
		}
	}
	return root.treeWith("/", meta.domains[pathKey(nil)], nil,
		func(path []Name) string { return meta.domains[pathKey(path)] },
		func(path []Name, name string) string { return meta.items[leafKey(path, name)] },
	), nil
}

@~ Go@/functions@/litar.describe @~ Go@/functions@/litar.itemTree @~ Go@/functions@/litar.leafKey @~ Go@/functions@/litar.newNest @~ Go@/functions@/litar.pathKey @~ Go@/methods@/litar.nest.addLeaf @~ Go@/methods@/litar.nest.addSub @~ Go@/methods@/litar.nest.treeWith @~ Go@/types@/litar.Block @~ Go@/types@/litar.Mapping @~ Go@/types@/litar.Name @~ Go@/types@/litar.treeJSON @

@<mcp@:litar@:Go Structure@/functions@+
func nodeTree(w *World) treeJSON {
	children := map[string][]*Node{}
	var root *Node
	for i := range w.Nodes {
		n := &w.Nodes[i]
		if len(n.Base) == 0 {
			root = n
			continue
		}
		children[formatNodePath(n.Base)] = append(children[formatNodePath(n.Base)], n)
	}
	if root == nil {
		return treeJSON{SubTrees: emptySub()}
	}
	var build func(*Node) treeJSON
	build = func(n *Node) treeJSON {
		path := formatNodePath(nodePath(*n))
		t := treeJSON{
			Name:        n.Name,
			Description: n.Description,
			SubTrees:    emptySub(),
			Leaf:        true,
		}
		for _, c := range children[path] {
			t.SubTrees = append(t.SubTrees, build(c))
		}
		return t
	}
	return build(root)
}

