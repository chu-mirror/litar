A module with no block of its own still appears when a submodule has one.
@<Project@/litar@/collect in 'seen' each module of 'blocks' and its prefixes, in first order@=
for _, b := range blocks {
	mod := b.Ref.Module
	for i := 1; i <= len(mod); i++ {
		pre := mod[:i]
		if moduleSeen(seen, pre) {
			continue
		}
		seen = append(seen, copyModule(pre))
	}
}
@~ Project@/litar@/Go@/functions@/litar.copyModule @~ Project@/litar@/Go@/functions@/litar.moduleSeen @

@<Project@/litar@/add to 'rows' the modules of 'seen' strictly under 'parent'@=
for _, m := range seen {
	if _, reserved := reservedNamespace(m); reserved {
		continue
	}
	if len(m) <= len(parent) || !modulesEqual(m[:len(parent)], parent) {
		continue
	}
	line := formatModule(m)
	rows = append(rows, namedLine{line, meta.chunks[line]})
}
