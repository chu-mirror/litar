@~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.frame @

@<eval@:litar@:Language@/Go@/File@/types@+
// Evaluator expands chunk references on one node chain.
// The mutex is held across in-memory expansion and released around
// filter execution, which may mount a filesystem and block.
// deps holds the dependencies of each file being expanded, innermost last.
type Evaluator struct {
	mu      sync.Mutex
	chain   []Block
	cat     *catalog
	stack   []frame
	deps    []map[string]dependency
	fuseErr error
	stderr  io.Writer
}

@~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.catalog @~ Project@/litar@/Go@/types@/litar.dependency @~ Project@/litar@/Go@/types@/litar.frame @

An evaluated file is kept for the rest of the process,
so a file is evaluated again only when something it depends on changes.
Filters and mapped files are assumed to give the same output for the same blocks:
a file whose filter reads the outside world keeps its first output.
@<eval@:litar@:Language@/Go@/File@/variables@+
// fileCache holds the files evaluated in this process, by path.
var fileCache = struct {
	sync.Mutex
	files map[string]cachedFile
}{files: map[string]cachedFile{}}

@~ Project@/litar@/Go@/types@/litar.cachedFile @~ Project@/litar@/Go@/variables@/litar.fileCache @

@<eval@:litar@:Language@/Go@/File@/types@+
