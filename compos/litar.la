@~ Project@/litar@/Go@/types@/litar.dirNode @~ Project@/litar@/Go@/types@/litar.vdir @

A mapped directory is a loopback of its origin, for reading and writing.
Its inode number is fixed at mount time, so a later lookup gets back the inode
of the first one, and the fresh loopback node is dropped.
@<fuse@:litar@:Language@/Go@/File@/methods@+
func (d *dirNode) lookupHost(ctx context.Context, ch *ventry, out *fuse.EntryOut) (*fs.Inode, syscall.Errno) {
	var st syscall.Stat_t
	if err := syscall.Stat(ch.host, &st); err != nil {
		return nil, fs.ToErrno(err)
	}
	out.Attr.FromStat(&st)
	return d.NewInode(ctx, hostNode(ch.host), fs.StableAttr{Mode: syscall.S_IFDIR, Ino: ch.ino}), 0
}

@~ Project@/litar@/Go@/functions@/litar.hostNode @~ Project@/litar@/Go@/methods@/litar.dirNode.lookupHost @~ Project@/litar@/Go@/types@/litar.dirNode @~ Project@/litar@/Go@/types@/litar.ventry @

A loopback node of go-fuse resolves its paths from the root node of its data;
making the node that root lets it sit anywhere below the root of the view.
The device of the data is left zero, so the inode numbers of host files keep
their device in the high bits, apart from the small numbers of the view.
@<fuse@:litar@:Language@/Go@/File@/functions@+
func hostNode(dir string) *fs.LoopbackNode {
	data := &fs.LoopbackRoot{Path: dir}
	node := &fs.LoopbackNode{RootData: data}
	data.RootNode = node
	return node
}

@~ Project@/litar@/Go@/functions@/litar.hostNode @

