@<mcp@:litar@:Go Structure@/functions@+
func assignIDs(t *treeJSON) {
	n := 0
	var walk func(*treeJSON)
	walk = func(t *treeJSON) {
		t.ID = n
		n++
		for i := range t.SubTrees {
			walk(&t.SubTrees[i])
		}
	}
	walk(t)
}

