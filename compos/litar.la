opts.Name = "litar"
@<.@/mount 'root' at 'dir' with 'opts', directly if allowed, else through fusermount@>
@~ Project@/litar@/Go@/types@/litar.dirNode @

A direct mount needs privileges. Without them the mount is tried again through
fusermount, in a fresh directory and with a fresh root node.
@<Project@/litar@/mount 'root' at 'dir' with 'opts', directly if allowed, else through fusermount@=
opts.DirectMount = true
server, err = fs.Mount(dir, root, opts)
direct = err == nil
if err != nil {
	os.RemoveAll(dir)
	dir, err = os.MkdirTemp("", "litar-mnt-*")
	if err != nil {
		os.RemoveAll(overlay)
		return nil, fmtMount(err)
	}
	opts.DirectMount = false
	root = &dirNode{rel: "", spec: tree, overlay: overlay}
	server, err = fs.Mount(dir, root, opts)
}
if err != nil {
	os.RemoveAll(dir)
	os.RemoveAll(overlay)
	return nil, fmtMount(err)
}
