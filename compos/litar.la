@<eval@:litar@:Language@/Go@/File@/functions@+
func NewEvaluator(chain []Block, mappings []Mapping, stderr io.Writer) *Evaluator {
	if stderr == nil {
		stderr = io.Discard
	}
	return &Evaluator{
		chain:  chain,
		cat:    buildCatalog(chain, mappings),
		stderr: stderr,
	}
}

@~ Project@/litar@/Go@/functions@/litar.NewEvaluator @~ Project@/litar@/Go@/functions@/litar.buildCatalog @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.Mapping @

@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) noteErr(err error) {
	e.mu.Lock()
	defer e.mu.Unlock()
	if e.fuseErr == nil && err != nil {
		e.fuseErr = err
	}
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.noteErr @~ Project@/litar@/Go@/types@/litar.Evaluator @

@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) takeFuseErr() error {
	err := e.fuseErr
	e.fuseErr = nil
	return err
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.takeFuseErr @~ Project@/litar@/Go@/types@/litar.Evaluator @

@<eval@:litar@:Language@/Go@/File@/methods@+
// Eval evaluates a print expression. A missing chunk is an error.
// An empty chunk with a pipeline is the empty input of that pipeline.
func (e *Evaluator) Eval(ref ChunkRef, filters []Filter) (string, error) {
	e.mu.Lock()
	defer e.mu.Unlock()
	return e.evalLocked(ref, filters)
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.Eval @~ Project@/litar@/Go@/methods@/litar.Evaluator.evalLocked @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.Filter @

@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) evalLocked(ref ChunkRef, filters []Filter) (string, error) {
	var (
		text string
		err  error
	)
	if ref.Chunk == "" {
		text = ""
	} else {
		text, err = e.expandLocked(ref, true)
		if err != nil {
			return "", err
		}
	}
	if len(filters) == 0 {
		return text, nil
	}
	return e.runFiltersLocked(text, filters, ref)
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.evalLocked @~ Project@/litar@/Go@/methods@/litar.Evaluator.expandLocked @~ Project@/litar@/Go@/methods@/litar.Evaluator.runFiltersLocked @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.Filter @

A file of the root module, referred to without labels, comes from fileCache
while its dependencies are unchanged; otherwise it is expanded and kept.
@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) expandLocked(ref ChunkRef, missingErr bool) (string, error) {
	if !e.isArchiveFile(ref) {
		return e.expandChunkLocked(ref, missingErr)
	}
	fileCache.Lock()
	cached, ok := fileCache.files[string(ref.Chunk)]
	fileCache.Unlock()
	if ok && e.unchanged(cached.deps) {
		e.addDeps(cached.deps)
		return cached.text, nil
	}
	return e.expandFileLocked(ref, missingErr)
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.addDeps @~ Project@/litar@/Go@/methods@/litar.Evaluator.expandChunkLocked @~ Project@/litar@/Go@/methods@/litar.Evaluator.expandFileLocked @~ Project@/litar@/Go@/methods@/litar.Evaluator.expandLocked @~ Project@/litar@/Go@/methods@/litar.Evaluator.isArchiveFile @~ Project@/litar@/Go@/methods@/litar.Evaluator.unchanged @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/variables@/litar.fileCache @

The dependencies of a file are also dependencies of the file that includes it
or shows it to a filter. A failed expansion is not kept.
@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) expandFileLocked(ref ChunkRef, missingErr bool) (string, error) {
	e.deps = append(e.deps, map[string]dependency{})
	text, err := e.expandChunkLocked(ref, missingErr)
	deps := e.deps[len(e.deps)-1]
	e.deps = e.deps[:len(e.deps)-1]
	if err != nil {
		return "", err
	}
	e.addDeps(deps)
	fileCache.Lock()
	fileCache.files[string(ref.Chunk)] = cachedFile{text: text, deps: deps}
	fileCache.Unlock()
	return text, nil
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.addDeps @~ Project@/litar@/Go@/methods@/litar.Evaluator.expandChunkLocked @~ Project@/litar@/Go@/methods@/litar.Evaluator.expandFileLocked @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.cachedFile @~ Project@/litar@/Go@/types@/litar.dependency @~ Project@/litar@/Go@/variables@/litar.fileCache @

@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) expandChunkLocked(ref ChunkRef, missingErr bool) (string, error) {
key := ref.key()
@<Project@/litar@/fail if 'key' is already on the visit stack@>
e.recordChunk(key, ref)
e.stack = append(e.stack, frame{key: key, ref: ref})
defer func() { e.stack = e.stack[:len(e.stack)-1] }()

var acc string
matched := false
@<Project@/litar@/add the expansion of each block matching 'ref' to 'acc'@>
if !matched {
	if missingErr {
		return "", fmt.Errorf("chunk '%s' is not defined", ref.String())
	}
	return "", nil
}
return acc, nil
}

@~ Project@/litar@/Go@/methods@/litar.ChunkRef.String @~ Project@/litar@/Go@/methods@/litar.ChunkRef.key @~ Project@/litar@/Go@/methods@/litar.Evaluator.expandChunkLocked @~ Project@/litar@/Go@/methods@/litar.Evaluator.recordChunk @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.frame @

@<eval@:litar@:Language@/Go@/File@/methods@+
// isArchiveFile reports whether ref names a file of the archive:
// a chunk of the root module, without labels, that a file block defines.
func (e *Evaluator) isArchiveFile(ref ChunkRef) bool {
	if len(ref.Labels) > 0 || len(ref.Module) > 0 {
		return false
	}
	f := e.cat.files[string(ref.Chunk)]
	return f != nil && f.archive
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.isArchiveFile @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.catFile @

@<eval@:litar@:Language@/Go@/File@/methods@+
// recording is the dependencies of the innermost file being expanded,
// or nil when no file is.
func (e *Evaluator) recording() map[string]dependency {
	if len(e.deps) == 0 {
		return nil
	}
	return e.deps[len(e.deps)-1]
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.recording @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.dependency @

@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) addDeps(deps map[string]dependency) {
	into := e.recording()
	if into == nil {
		return
	}
	for key, dep := range deps {
		into[key] = dep
	}
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.addDeps @~ Project@/litar@/Go@/methods@/litar.Evaluator.recording @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.dependency @

@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) recordChunk(key string, ref ChunkRef) {
	if deps := e.recording(); deps != nil {
		deps["chunk "+key] = dependency{ref: ref, sum: e.chunkSum(ref)}
	}
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.chunkSum @~ Project@/litar@/Go@/methods@/litar.Evaluator.recordChunk @~ Project@/litar@/Go@/methods@/litar.Evaluator.recording @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.dependency @

A view is keyed by its operations in order, since the order decides which files it holds.
@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) recordView(view []ViewOp) {
	deps := e.recording()
	if deps == nil {
		return
	}
	var key strings.Builder
	key.WriteString("view")
	for _, op := range view {
		fmt.Fprintf(&key, " %d:%q", op.Kind, op.Name)
	}
	deps[key.String()] = dependency{view: view, isView: true, sum: e.viewSum(view)}
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.recordView @~ Project@/litar@/Go@/methods@/litar.Evaluator.recording @~ Project@/litar@/Go@/methods@/litar.Evaluator.viewSum @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.ViewOp @~ Project@/litar@/Go@/types@/litar.dependency @

@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) unchanged(deps map[string]dependency) bool {
	for _, dep := range deps {
		var sum [sha256.Size]byte
		if dep.isView {
			sum = e.viewSum(dep.view)
		} else {
			sum = e.chunkSum(dep.ref)
		}
		if sum != dep.sum {
			return false
		}
	}
	return true
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.chunkSum @~ Project@/litar@/Go@/methods@/litar.Evaluator.unchanged @~ Project@/litar@/Go@/methods@/litar.Evaluator.viewSum @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.dependency @

A block's Raw is the expression as written, so any edit of a matching block,
or a block added or removed, changes the digest of the chunk.
@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) chunkSum(ref ChunkRef) [sha256.Size]byte {
	h := sha256.New()
	for _, b := range e.chain {
		if matchRef(b.Ref, ref) {
			fmt.Fprintf(h, "%d:%s", len(b.Raw), b.Raw)
		}
	}
	var sum [sha256.Size]byte
	copy(sum[:], h.Sum(nil))
	return sum
}

@~ Project@/litar@/Go@/functions@/litar.matchRef @~ Project@/litar@/Go@/methods@/litar.Evaluator.chunkSum @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Evaluator @

The digest of a view covers what the filter sees of each file besides its bytes,
and the error of a view that cannot be built.
@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) viewSum(view []ViewOp) [sha256.Size]byte {
	h := sha256.New()
	files, err := e.cat.apply(view)
	if err != nil {
		fmt.Fprintf(h, "error %s\n", err)
	}
	for _, f := range files {
		fmt.Fprintf(h, "%q %t %t %t %q\n", f.path, f.archive, f.executable, f.dir, f.origin)
	}
	var sum [sha256.Size]byte
	copy(sum[:], h.Sum(nil))
	return sum
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.viewSum @~ Project@/litar@/Go@/methods@/litar.catalog.apply @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.ViewOp @

The cycle is reported from the first visit of the chunk to the reference that repeats it.
@<Project@/litar@/fail if 'key' is already on the visit stack@=
for i, fr := range e.stack {
	if fr.key == key {
		chain := make([]ChunkRef, 0, len(e.stack)-i+1)
		for _, older := range e.stack[i:] {
			chain = append(chain, older.ref)
		}
		chain = append(chain, ref)
		return "", &cycleError{chain: chain}
	}
}
@~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.cycleError @

A set block replaces what came before. An extension whose content ended with a line break
is joined with a line feed, unless nothing came before; otherwise it is concatenated.
@<Project@/litar@/add the expansion of each block matching 'ref' to 'acc'@=
for _, b := range e.chain {
	if !matchRef(b.Ref, ref) {
		continue
	}
	matched = true
	text, err := e.expandBlock(b, ref)
	if err != nil {
		return "", err
	}
	switch {
	case b.Op == OpSet:
		acc = text
	case b.EndsLine && acc != "":
		acc += "\n" + text
	default:
		acc += text
	}
}
@~ Project@/litar@/Go@/constants@/litar.OpSet @~ Project@/litar@/Go@/functions@/litar.matchRef @~ Project@/litar@/Go@/methods@/litar.Evaluator.expandBlock @

@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) expandBlock(b Block, applied ChunkRef) (string, error) {
var sb strings.Builder
@<Project@/litar@/write each part of 'b' to 'sb', expanding its references@>
text := sb.String()
if len(b.Filters) > 0 {
	var err error
	text, err = e.runFiltersLocked(text, b.Filters, applied)
	if err != nil {
		return "", err
	}
}
return text, nil
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.expandBlock @~ Project@/litar@/Go@/methods@/litar.Evaluator.runFiltersLocked @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Evaluator @

An inner reference takes the labels of the reference being expanded when it has none,
and its relative module is resolved against the block's header.
A missing inner chunk expands to nothing.
@<Project@/litar@/write each part of 'b' to 'sb', expanding its references@=
for _, part := range b.Parts {
	if part.Ref == nil {
		sb.WriteString(part.Text)
		continue
	}
	inner := resolveBody(part.Ref.ChunkRef, applied.Labels, b.Ref.Module)
	text, err := e.expandLocked(inner, false)
	if err != nil {
		return "", err
	}
	if len(part.Ref.Filters) > 0 {
		text, err = e.runFiltersLocked(text, part.Ref.Filters, inner)
		if err != nil {
			return "", err
		}
	}
	sb.WriteString(text)
}
@~ Project@/litar@/Go@/functions@/litar.resolveBody @~ Project@/litar@/Go@/methods@/litar.Evaluator.expandLocked @~ Project@/litar@/Go@/methods@/litar.Evaluator.runFiltersLocked @

@<eval@:litar@:Language@/Go@/File@/functions@+
func resolveBody(ref ChunkRef, outerLabels []Name, header ModulePath) ChunkRef {
	labels := ref.Labels
	if len(labels) == 0 {
		labels = copyLabels(outerLabels)
	} else {
		labels = copyLabels(labels)
	}
	var mod ModulePath
	if hasRel(ref.Module) {
		mod = resolveModule(header, ref.Module)
	} else {
		mod = copyModule(ref.Module)
	}
	return ChunkRef{Labels: labels, Module: mod, Chunk: ref.Chunk}
}

@~ Project@/litar@/Go@/functions@/litar.copyLabels @~ Project@/litar@/Go@/functions@/litar.copyModule @~ Project@/litar@/Go@/functions@/litar.hasRel @~ Project@/litar@/Go@/functions@/litar.resolveBody @~ Project@/litar@/Go@/functions@/litar.resolveModule @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.ModulePath @~ Project@/litar@/Go@/types@/litar.Name @

@<eval@:litar@:Language@/Go@/File@/functions@+
func resolveFilter(ref ChunkRef, outerLabels []Name) ChunkRef {
	labels := ref.Labels
	if len(labels) == 0 {
		labels = copyLabels(outerLabels)
	} else {
		labels = copyLabels(labels)
	}
	return ChunkRef{Labels: labels, Module: copyModule(ref.Module), Chunk: ref.Chunk}
}

@~ Project@/litar@/Go@/functions@/litar.copyLabels @~ Project@/litar@/Go@/functions@/litar.copyModule @~ Project@/litar@/Go@/functions@/litar.resolveFilter @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Name @

@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) runFiltersLocked(text string, filters []Filter, attached ChunkRef) (string, error) {
	for _, f := range filters {
		resolved := resolveFilter(f.Ref, attached.Labels)
		script, err := e.expandLocked(resolved, true)
		if err != nil {
			return "", err
		}
		e.recordView(f.View)
		e.mu.Unlock()
		out, runErr := executeFilter(e, script, text, resolved, f.View)
		e.mu.Lock()
		if fuse := e.takeFuseErr(); fuse != nil {
			return "", fuse
		}
		if runErr != nil {
			return "", runErr
		}
		text = out
	}
	return text, nil
}

