@<mcp@:litar@:Language@/Go@/File@/methods@+
// idParts splits a URI tail of n decimal ids and resolves the composition.
// The caller holds a.mu.
func (a *agent) idParts(rest string, n int) (*World, []int, error) {
	segs := strings.Split(rest, "/")
	if rest == "" || len(segs) != n {
		return nil, nil, errString("unknown resource")
	}
	ids := make([]int, n)
	for i, s := range segs {
		id, err := strconv.Atoi(s)
		if err != nil || id < 0 || strconv.Itoa(id) != s {
			return nil, nil, errString("unknown resource")
		}
		ids[i] = id
	}
	w, err := a.compositionByID(ids[0])
	if err != nil {
		return nil, nil, err
	}
	return w, ids, nil
}

@~ Project@/litar@/Go@/methods@/litar.agent.compositionByID @~ Project@/litar@/Go@/methods@/litar.agent.idParts @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.errString @

@<mcp@:litar@:Language@/Go@/File@/methods@+
// nodeChain loads the block chain and mappings of a node id.
// The caller holds a.mu.
func (a *agent) nodeChain(w *World, id int) ([]Block, []Mapping, error) {
	n, err := nodeByID(w, id)
	if err != nil {
		return nil, nil, err
	}
	np := formatNodePath(nodePath(*n))
	chain, err := w.Chain(np)
	if err != nil {
		return nil, nil, err
	}
	maps, err := w.Mappings(np)
	if err != nil {
		return nil, nil, err
	}
	return chain, maps, nil
}

@~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodeByID @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/methods@/litar.World.Chain @~ Project@/litar@/Go@/methods@/litar.World.Mappings @~ Project@/litar@/Go@/methods@/litar.agent.nodeChain @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Mapping @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @

