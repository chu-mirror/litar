The page is one HTML file with its style and script inline,
so litar-web embeds a single file and needs no other assets.
@<Project@/litar@/Web@/page@=
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>litar</title>
<style>
@<.@/style rules@>
</style>
</head>
<body>
@<.@/page layout@>
<script>
'use strict';

@<.@/resource access@>

@<.@/trees@>

@<.@/names@>

@<.@/block rendering@>

@<.@/views@>

@<.@/routing@>
</script>
</body>
</html>
