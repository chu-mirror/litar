@<list@:litar@:Language@/Go@/File@/functions@+
// Items lists item paths whose prefix before the last name is domain.
func Items(blocks []Block, domain []Name, meta metaInfo) string {
	seen := map[string]bool{}
	var rows []namedLine
	for _, b := range blocks {
		for _, it := range b.Items {
			if len(it) != len(domain)+1 || !namePrefix(it, domain) {
				continue
			}
			line := formatItem(it)
			if seen[line] {
				continue
			}
			seen[line] = true
			rows = append(rows, namedLine{line, meta.items[pathKey(it)]})
		}
	}
	return formatNamed(rows)
}

@~ Project@/litar@/Go@/functions@/litar.Items @~ Project@/litar@/Go@/functions@/litar.formatItem @~ Project@/litar@/Go@/functions@/litar.formatNamed @~ Project@/litar@/Go@/functions@/litar.namePrefix @~ Project@/litar@/Go@/functions@/litar.pathKey @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Name @~ Project@/litar@/Go@/types@/litar.metaInfo @~ Project@/litar@/Go@/types@/litar.namedLine @

