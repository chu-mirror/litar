	"print", "literal", "effective", "depend", "reference", "agent",
}

@~ Go@/variables@/litar.modeOrder @

@<cli@:litar@:Go Structure@/functions@+
func modeIndex(name string) int {
	for i, m := range modeOrder {
		if m == name {
			return i
		}
	}
	return -1
}

@~ Go@/functions@/litar.modeIndex @~ Go@/variables@/litar.modeOrder @

@<cli@:litar@:Go Structure@/functions@+
func run(args []string, stdout, stderr io.Writer) int {
	prog := "litar"
	rest := args
	if len(args) > 0 {
		prog = args[0]
		rest = args[1:]
	}
	for _, a := range rest {
		if a == "--help" {
			if _, err := io.WriteString(stdout, usage(prog)); err != nil {
				fmt.Fprintf(stderr, "Error: could not write output\n")
				return 1
			}
			return 0
		}
	}

	var (
		mode    string
		archive string
		operand string
		sawFile bool
	)
	fail := func(format string, a ...any) int {
		fmt.Fprintf(stderr, "Error: "+format+"\n", a...)
		return 1
	}
	setMode := func(next string) int {
		if mode == next {
			return fail("duplicate %s option", next)
		}
		if mode != "" {
			first, second := mode, next
			if modeIndex(first) > modeIndex(second) {
				first, second = second, first
			}
			return fail("cannot combine %s and %s", first, second)
		}
		mode = next
		return 0
	}
	need := func(opt, what string, i *int) (string, int) {
		if *i+1 >= len(rest) {
			return "", fail("%s requires %s", opt, what)
		}
		*i++
		return rest[*i], 0
	}

	for i := 0; i < len(rest); i++ {
		a := rest[i]
		opt := a
		val := ""
		hasVal := false
		switch {
		case a == "--":
			return fail("unknown option '%s'", a)
		case strings.HasPrefix(a, "--"):
			name, v, ok := strings.Cut(a, "=")
			opt = name
			if ok {
				val = v
				hasVal = true
			}
		case strings.HasPrefix(a, "-") && len(a) > 1:
			if len(a) > 2 {
				// Attached value for an option that takes one.
				opt = a[:2]
				val = a[2:]
				hasVal = true
			}
		default:
			return fail("unexpected argument '%s'", a)
		}

		takes := func(what string) (string, int) {
			if hasVal {
				return val, 0
			}
			return need(opt, what, &i)
		}
		// A short cluster that does not take a value is not an option.
		if hasVal && !optionTakesValue(opt) {
			return fail("unknown option '%s'", a)
		}

		var code int
		switch opt {
		case "-f", "--file":
			if sawFile {
				return fail("duplicate file option")
			}
			archive, code = takes("an archive")
			if code != 0 {
				return code
			}
			sawFile = true
		case "-p", "--print":
			if code = setMode("print"); code != 0 {
				return code
			}
			operand, code = takes("an expression")
		case "-l", "--literal":
			if code = setMode("literal"); code != 0 {
				return code
			}
			operand, code = takes("a chunk reference")
		case "-e", "--effective":
			if code = setMode("effective"); code != 0 {
				return code
			}
			operand, code = takes("a chunk reference")
		case "-d", "--depend":
			if code = setMode("depend"); code != 0 {
				return code
			}
			operand, code = takes("a chunk reference")
		case "-r", "--reference":
			if code = setMode("reference"); code != 0 {
				return code
			}
			operand, code = takes("an item")
		case "-a", "--agent":
			if hasVal {
				return fail("unknown option '%s'", a)
			}
			code = setMode("agent")
		default:
			return fail("unknown option '%s'", a)
		}
		if code != 0 {
			return code
		}
	}

	if mode == "" {
		return fail("%s", missingAction)
	}
	if mode != "agent" && !sawFile {
		return fail("missing -f, --file")
	}

	var (
		world *World
		node  string
	)
	if sawFile {
		var err error
		world, node, err = FindArchive(archive)
		if err != nil {
			return fail("%s", err.Error())
		}
	}

	if mode == "agent" {
		ag := newAgent()
		if world != nil {
			ag.addWorld(world)
			ag.refresh()
		}
		err := ag.serve(context.Background())
		if err != nil && !errors.Is(err, io.EOF) && !errors.Is(err, context.Canceled) {
			return fail("%s", err.Error())
		}
		return 0
	}

	text, err := dispatch(world, node, mode, operand, stderr)
	if err != nil {
		return fail("%s", err.Error())
	}
	if _, err := io.WriteString(stdout, text); err != nil {
		return fail("could not write output")
	}
	return 0
}

@~ Go@/constants@/litar.missingAction @~ Go@/functions@/litar.FindArchive @~ Go@/functions@/litar.dispatch @~ Go@/functions@/litar.modeIndex @~ Go@/functions@/litar.newAgent @~ Go@/functions@/litar.optionTakesValue @~ Go@/functions@/litar.run @~ Go@/functions@/litar.usage @~ Go@/methods@/litar.agent.addWorld @~ Go@/methods@/litar.agent.refresh @~ Go@/methods@/litar.agent.serve @~ Go@/types@/litar.World @

@<cli@:litar@:Go Structure@/functions@+
func optionTakesValue(opt string) bool {
	switch opt {
	case "-f", "--file", "-p", "--print",
		"-l", "--literal", "-e", "--effective", "-d", "--depend",
		"-r", "--reference":
		return true
	default:
		return false
	}
}

@~ Go@/functions@/litar.optionTakesValue @

@<cli@:litar@:Go Structure@/functions@+
func dispatch(world *World, node, mode, operand string, stderr io.Writer) (string, error) {
	if node == "" {
		var err error
		node, err = world.rootName()
		if err != nil {
			return "", err
		}
	}
	chain, err := world.Chain(node)
	if err != nil {
		return "", err
	}
	switch mode {
	case "print":
		ref, filters, err := ParsePrint(operand)
		if err != nil {
			return "", err
		}
		maps, err := world.Mappings(node)
		if err != nil {
			return "", err
		}
		ev := NewEvaluator(chain, maps, stderr)
		return ev.Eval(ref, filters)
	case "literal":
		ref, err := ParseChunkRef(operand)
		if err != nil {
			return "", err
		}
		return Literal(chain, ref)
	case "effective":
		ref, err := ParseChunkRef(operand)
		if err != nil {
			return "", err
		}
		return Effective(chain, ref)
	case "depend":
		ref, err := ParseChunkRef(operand)
		if err != nil {
			return "", err
		}
		return Depend(chain, ref), nil
	case "reference":
		item, err := ParseItem(operand)
		if err != nil {
			return "", err
		}
		return Refer(chain, item), nil
	default:
		return "", fmt.Errorf("unknown option '%s'", mode)
	}
}

