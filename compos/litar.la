@(tests/run.sh@`tests@=
#!/bin/bash
# Run every case under tests/cases.
# A case is a directory with one of:
#   driver.sh    bash driver.sh LITAR ROOT
#   argv         one argument per line, passed to litar; cwd is the case dir
# Successful checks expect empty stderr. A missing out file expects empty
# stdout. The default status is 0. An err file is a substring of stderr.
# The filter cache is off, so every case runs its filters.

set -eu

if [ "$#" -ne 1 ]; then
    echo "usage: run.sh LITAR" >&2
    exit 2
fi

LITAR=$1
ROOT=$(cd "$(dirname "$0")/.." && pwd)
CASEDIR=$ROOT/tests/cases
export LITAR_CACHE=off

if [ ! -x "$LITAR" ]; then
    echo "litar binary is not executable: $LITAR" >&2
    exit 1
fi

passed=0
failed=0

@<Project@/litar@/functions of tests/run.sh that check a case and count it in 'passed' or 'failed'@>

shopt -s nullglob

for dir in "$CASEDIR"/*/; do
    name=$(basename "$dir")
@<Project@/litar@/run the driver.sh of the case 'dir' named 'name', if it has one@>

    case_bad=0
    back=$(pwd)
    cd "$dir"

    if [ -f argv ]; then
@<Project@/litar@/run litar with the argv of the case 'dir' named 'name', and set 'case_bad' on a failure@>
    else
        echo "FAIL $name: no driver.sh or argv" >&2
        case_bad=1
    fi

    cd "$back"
    finish_case "$case_bad" "$name"
done

echo "passed $passed failed $failed"
if [ "$((passed + failed))" -eq 0 ]; then
    echo "no test cases found" >&2
    exit 1
fi
[ "$failed" -eq 0 ]

@

@<Project@/litar@/functions of tests/run.sh that check a case and count it in 'passed' or 'failed'@=
finish_case() {
    if [ "$1" -eq 0 ]; then
        echo "ok $2"
        passed=$((passed + 1))
    else
        echo "FAIL $2" >&2
        failed=$((failed + 1))
    fi
}

@

@<Project@/litar@/functions of tests/run.sh that check a case and count it in 'passed' or 'failed'@+
# check_one name status out-file-or-empty err-file-or-empty cmd...
check_one() {
    _name=$1
    _status=$2
    _out_file=$3
    _err_file=$4
    shift 4
    _got_out=$(mktemp)
    _got_err=$(mktemp)
    _exp_out=$(mktemp)
    set +e
    "$@@" >"$_got_out" 2>"$_got_err"
    _st=$?
    set -e
    _bad=0
@<.@/set '_bad' when the status '_st' or the stdout '_got_out' differs from '_status' and '_out_file'@>
@<.@/set '_bad' when the stderr '_got_err' does not match '_err_file', and show it@>
    rm -f "$_got_out" "$_got_err" "$_exp_out"
    return "$_bad"
}
@

Without an out file, the expected stdout '_exp_out' stays empty.
@<Project@/litar@/set '_bad' when the status '_st' or the stdout '_got_out' differs from '_status' and '_out_file'@=
    if [ "$_st" -ne "$_status" ]; then
        echo "FAIL $_name: exit $_st, expected $_status" >&2
        _bad=1
    fi
    if [ -n "$_out_file" ]; then
        cp "$_out_file" "$_exp_out"
    fi
    if ! cmp -s "$_exp_out" "$_got_out"; then
        echo "FAIL $_name: stdout" >&2
        diff -u "$_exp_out" "$_got_out" >&2 || true
        _bad=1
    fi
@

Only a successful case requires an empty stderr. A failed check shows the stderr
once: the err file check has already shown it.
@<Project@/litar@/set '_bad' when the stderr '_got_err' does not match '_err_file', and show it@=
    if [ -n "$_err_file" ]; then
        _needle=$(cat "$_err_file")
        if ! grep -F -q -e "$_needle" "$_got_err"; then
            echo "FAIL $_name: stderr missing [$_needle]" >&2
            cat "$_got_err" >&2
            _bad=1
        fi
    elif [ "$_status" -eq 0 ] && [ -s "$_got_err" ]; then
        echo "FAIL $_name: unexpected stderr" >&2
        cat "$_got_err" >&2
        _bad=1
    fi
    if [ "$_bad" -ne 0 ] && [ -s "$_got_err" ] && [ -n "$_err_file" ]; then
        :
    elif [ "$_bad" -ne 0 ] && [ -s "$_got_err" ]; then
        echo "stderr:" >&2
        cat "$_got_err" >&2
    fi
@

@<Project@/litar@/run the driver.sh of the case 'dir' named 'name', if it has one@=
    if [ -f "$dir/driver.sh" ]; then
        if bash "$dir/driver.sh" "$LITAR" "$ROOT"; then
            finish_case 0 "$name"
        else
            finish_case 1 "$name"
        fi
        continue
    fi
@

The status, out and err files are optional.
@<Project@/litar@/run litar with the argv of the case 'dir' named 'name', and set 'case_bad' on a failure@=
        args=()
        while IFS= read -r line || [ -n "$line" ]; do
            args+=("$line")
        done < argv
        status=0
        if [ -f status ]; then
            status=$(tr -d '[:space:]' < status)
        fi
        out_file=
        err_file=
        if [ -f out ]; then
            out_file=$dir/out
        fi
        if [ -f err ]; then
            err_file=$dir/err
        fi
        if ! check_one "$name" "$status" "$out_file" "$err_file" \
            "$LITAR" "${args[@@]}"; then
            case_bad=1
        fi
@
Every filter run appends a line to count, so the count tells which runs started a process.
The pure run is started once and served from the cache the second time;
the run with a mapped file and the run that writes to stderr are started every time.
@<filter test@:litar@:Language@/Go@/File@/functions@+
func TestFilterCache(t *testing.T) {
if _, err := os.Stat("/dev/fuse"); err != nil {
	t.Skip("no /dev/fuse")
}
filterCacheDir = t.TempDir()
defer func() { filterCacheDir = "" }()
dir := t.TempDir()
count := filepath.Join(dir, "count")
origin := filepath.Join(dir, "origin.txt")
writeFile(t, origin, "mapped\n")
src := "" +
	"@@<tally@@=\n" +
	"#!/bin/sh\n" +
	"echo >> '" + count + "'\n" +
	"cat; echo; wc -l < '" + count + "' | tr -d ' '\n" +
	"@@\n" +
	"@@<loud@@=\n" +
	"#!/bin/sh\n" +
	"echo >> '" + count + "'\n" +
	"echo warning >&2; cat; echo\n" +
	"@@\n" +
	"@@<pure@@=\none\n@@|tally@@\n" +
	"@@<mapped@@=\none\n@@|tally@@,data.txt@@\n" +
	"@@<noisy@@=\none\n@@|loud@@\n"
blocks := mustArch(t, src)
maps := []Mapping{{Path: "data.txt", Origin: origin}}
for i, want := range []struct{ name, out string }{
	{"pure", "one\n1\n"},
	{"pure", "one\n1\n"},
	{"mapped", "one\n2\n"},
	{"mapped", "one\n3\n"},
	{"noisy", "one\n"},
	{"noisy", "one\n"},
} {
	got, err := NewEvaluator(blocks, maps, nil).Eval(mustRef(t, want.name), nil)
	if err != nil || got != want.out {
		t.Fatalf("%d %s %v %q", i, want.name, err, got)
	}
}
if data, err := os.ReadFile(count); err != nil || strings.Count(string(data), "\n") != 5 {
	t.Fatalf("%v %q", err, data)
}
}

@~ Project@/litar@/Go@/functions@/litar.NewEvaluator @~ Project@/litar@/Go@/functions@/litar.mustArch @~ Project@/litar@/Go@/functions@/litar.mustRef @~ Project@/litar@/Go@/functions@/litar.writeFile @~ Project@/litar@/Go@/types@/litar.Mapping @~ Project@/litar@/Go@/variables@/litar.filterCacheDir @