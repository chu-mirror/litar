The labels of a specialization path run from the innermost, so the target's labels are reversed to match.
@<Project@/litar@/Web@/go to the chunk of the reference 'target', at its deepest matching specialization@=
    const chunks = await tree('chunk', state.c, state.n);
    // A root chunk that is a file is listed below File.
    const byPath = leafIndex(chunks).byPath;
    const id = byPath.get(JSON.stringify(target.mods.concat(target.chunk)))
      ?? (target.mods.length ? undefined : byPath.get(JSON.stringify(['File'].concat(target.chunk.split('/')))));
    if (id === undefined) {
      return detail('<p class="error">No block of this node defines ' + esc(refText(target)) + '.</p>'
        + '<p class="note">A node based on this one may define it.</p>');
    }
    const specs = await tree('specialization', state.c, state.n, id);
    const want = target.labels.slice().reverse();
    let best = specs.id, depth = 0;
    walk(specs, (s, p) => {
      if (p.length > depth && p.every((l, k) => l === want[k])) { best = s.id; depth = p.length; }
    });
    location.replace(nodeBase() + '/chunks/' + id + '/' + best + '/effective' + labelsPart(target.labels, want.slice(0, depth)));
