func newVdir() *vdir {
	return &vdir{kids: map[string]*ventry{}}
}

@~ Go@/functions@/litar.newVdir @~ Go@/types@/litar.vdir @~ Go@/types@/litar.ventry @

@<fuse@:litar@:Go Structure@/functions@+
func buildVTree(files []viewFile) (*vdir, error) {
	root := newVdir()
	for i := range files {
		f := &files[i]
		parts := stringsSplit(f.path)
		dir := root
		for i, part := range parts {
			last := i == len(parts)-1
			cur := dir.kids[part]
			if last {
				if cur != nil && cur.dir != nil {
					return nil, errPath(f.path)
				}
				if cur != nil && cur.file != nil {
					return nil, errPath(f.path)
				}
				dir.kids[part] = &ventry{file: f}
				continue
			}
			if cur != nil && cur.file != nil {
				return nil, errPath(f.path)
			}
			if cur == nil {
				cur = &ventry{dir: newVdir()}
				dir.kids[part] = cur
			}
			dir = cur.dir
		}
	}
	assignInos(root)
	return root, nil
}

@~ Go@/functions@/litar.assignInos @~ Go@/functions@/litar.buildVTree @~ Go@/functions@/litar.errPath @~ Go@/functions@/litar.newVdir @~ Go@/functions@/litar.stringsSplit @~ Go@/types@/litar.vdir @~ Go@/types@/litar.ventry @~ Go@/types@/litar.viewFile @

@<fuse@:litar@:Go Structure@/functions@+
// assignInos gives every archive path one inode number for this mount.
// Entry timeouts are zero, so the kernel may look the name up again
// between stat and open. The same number keeps the stat stable.
func assignInos(root *vdir) {
	next := uint64(2)
	var walk func(*vdir)
	walk = func(d *vdir) {
		names := make([]string, 0, len(d.kids))
		for name := range d.kids {
			names = append(names, name)
		}
		sort.Strings(names)
		for _, name := range names {
			ch := d.kids[name]
			if ch.file != nil {
				ch.file.ino = next
				next++
				continue
			}
			ch.dir.ino = next
			next++
			walk(ch.dir)
		}
	}
	walk(root)
}

