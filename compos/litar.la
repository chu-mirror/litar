@<mcp@:litar@:Go Structure@/methods@+
func (a *agent) addWorldLocked(w *World) {
	if _, ok := a.worlds[w.Dir]; !ok {
		a.order = append(a.order, w.Dir)
	}
	a.worlds[w.Dir] = w
}

@~ Go@/methods@/litar.agent.addWorldLocked @~ Go@/types@/litar.World @~ Go@/types@/litar.agent @

@<mcp@:litar@:Go Structure@/methods@+
func (a *agent) addWorld(w *World) {
	a.mu.Lock()
	a.addWorldLocked(w)
	a.mu.Unlock()
}

@~ Go@/methods@/litar.agent.addWorld @~ Go@/methods@/litar.agent.addWorldLocked @~ Go@/types@/litar.World @~ Go@/types@/litar.agent @

@<mcp@:litar@:Go Structure@/methods@+
func (a *agent) useWorld(w *World) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	a.addWorldLocked(w)
	id := -1
	for i, c := range a.compositions() {
		if c.Dir == w.Dir {
			id = i
			break
		}
	}
	a.mu.Unlock()
	a.refresh()
	if id < 0 {
		return toolErr(errString("unknown composition"))
	}
	return toolText(strconv.Itoa(id))
}

@~ Go@/functions@/litar.toolErr @~ Go@/functions@/litar.toolText @~ Go@/methods@/litar.agent.addWorldLocked @~ Go@/methods@/litar.agent.compositions @~ Go@/methods@/litar.agent.refresh @~ Go@/methods@/litar.agent.useWorld @~ Go@/types@/litar.World @~ Go@/types@/litar.agent @~ Go@/types@/litar.errString @

@<mcp@:litar@:Go Structure@/methods@+
// compositions is the imported compositions in list order.
// The caller holds a.mu.
func (a *agent) compositions() []*World {
	out := make([]*World, 0, len(a.order))
	for _, dir := range a.order {
		if w := a.worlds[dir]; w != nil {
			out = append(out, w)
		}
	}
	return out
}

@~ Go@/methods@/litar.agent.compositions @~ Go@/types@/litar.World @~ Go@/types@/litar.agent @

@<mcp@:litar@:Go Structure@/methods@+
// compositionByID resolves an id from list://composition.
// The caller holds a.mu.
func (a *agent) compositionByID(id int) (*World, error) {
	comps := a.compositions()
	if id < 0 || id >= len(comps) {
		return nil, fmt.Errorf("unknown composition %d", id)
	}
	return comps[id], nil
}

@~ Go@/methods@/litar.agent.compositionByID @~ Go@/methods@/litar.agent.compositions @~ Go@/types@/litar.World @~ Go@/types@/litar.agent @

@<mcp@:litar@:Go Structure@/methods@+
func (a *agent) importComposition(ctx context.Context, _ *mcp.CallToolRequest, in importIn) (*mcp.CallToolResult, any, error) {
	if in.Path == "" {
		return toolErr(errString("missing path"))
	}
	w, err := SpecifyComposer(in.Path)
	if err != nil {
		return toolErr(err)
	}
	return a.useWorld(w)
}

@~ Go@/functions@/litar.SpecifyComposer @~ Go@/functions@/litar.toolErr @~ Go@/methods@/litar.agent.importComposition @~ Go@/methods@/litar.agent.useWorld @~ Go@/types@/litar.agent @~ Go@/types@/litar.errString @~ Go@/types@/litar.importIn @

@<mcp@:litar@:Go Structure@/methods@+
func (a *agent) createComposition(ctx context.Context, _ *mcp.CallToolRequest, in createArchiveIn) (*mcp.CallToolResult, any, error) {
	if in.Path == "" {
		return toolErr(errString("missing path"))
	}
	ground := ""
	if in.Ground != nil {
		ground = *in.Ground
	}
	w, err := CreateComposedArchive(in.Path, ground)
	if err != nil {
		return toolErr(err)
	}
	if in.Description != "" {
		w.Description = in.Description
		if err := w.save(); err != nil {
			return toolErr(err)
		}
	}
	return a.useWorld(w)
}

