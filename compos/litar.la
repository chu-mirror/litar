@<parse@:litar@:Language@/Go@/File@/methods@+
// skipToControl moves to the next control that starts or rejects an
// expression. "@@@@" stays in the comment.
func (p *parser) skipToControl() {
	for p.i < len(p.src) {
		kind, n, ok := p.atControl()
		if !ok {
			p.i++
			continue
		}
		if n == 2 && kind == '@@' {
			p.i += 2
			continue
		}
		return
	}
}

