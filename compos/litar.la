A loaded composer has no cycles, but a node edited in memory could form one; the walk stops at a repeated node.
@<Project@/litar@/collect 'n' and its bases up to the root@=
var rev []*Node
seen := map[string]bool{}
for {
	key := formatNodePath(nodePath(*n))
	if seen[key] {
		return nil, fmt.Errorf("cycle in node bases: %s", key)
	}
	seen[key] = true
	rev = append(rev, n)
	if len(n.Base) == 0 {
