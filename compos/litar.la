Every resource is read by one handler, which tells them apart by URI.
@<Project@/litar@/add the resources and resource templates of 'a'@=
for _, r := range fixedResources {
	a.server.AddResource(&mcp.Resource{
		URI:         r.uri,
		Name:        r.name,
		Description: r.desc,
		MIMEType:    r.mime,
	}, a.handle)
}
for _, t := range resourceTemplates {
	a.server.AddResourceTemplate(&mcp.ResourceTemplate{
		URITemplate: t.uri,
		Name:        t.name,
		Description: t.desc,
		MIMEType:    t.mime,
	}, a.handle)
}
