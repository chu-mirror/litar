The command litar parses its command line with the flag package and passes the result here.
@<cli@:litar@:Language@/Go@/File@/types@+
// Options is the command line of litar after parsing.
// An action is given by a non-empty operand; Agent takes none.
type Options struct {
	Agent     bool
	File      string
	Literal   string
	Effective string
	Depend    string
	Reference string
	Print     string
}

