@~ Go@/types@/litar.mount @

@<fuse@:litar@:Go Structure@/variables@+
var (
	liveMu     sync.Mutex
	liveMounts = map[*mount]struct{}{}
)

@~ Go@/types@/litar.mount @~ Go@/variables@/litar.liveMounts @~ Go@/variables@/litar.liveMu @

@<fuse@:litar@:Go Structure@/methods@+
func (m *mount) close() {
	if m == nil {
		return
	}
	liveMu.Lock()
	delete(liveMounts, m)
	liveMu.Unlock()
	if m.server != nil {
		// Unmount gives up while a process the filter left behind
		// still uses the mount, and Wait would then block forever.
		// A lazy unmount removes the mount now; the server stops
		// when the kernel drops the last use.
		if err := m.server.Unmount(); err != nil {
			detach(m.dir, m.direct)
		}
	}
	if m.dir != "" {
		_ = os.RemoveAll(m.dir)
	}
	for _, p := range m.extra {
		_ = os.RemoveAll(p)
	}
}

@~ Go@/functions@/litar.detach @~ Go@/methods@/litar.mount.close @~ Go@/types@/litar.mount @~ Go@/variables@/litar.liveMounts @~ Go@/variables@/litar.liveMu @

@<fuse@:litar@:Go Structure@/functions@+
func detach(dir string, direct bool) {
	if direct && syscall.Unmount(dir, syscall.MNT_DETACH) == nil {
		return
	}
	for _, prog := range []string{"fusermount3", "fusermount"} {
		if exec.Command(prog, "-u", "-z", dir).Run() == nil {
			return
		}
	}
}

@~ Go@/functions@/litar.detach @

@<fuse@:litar@:Go Structure@/functions@+
// DetachMounts lazily unmounts every filter view that is still mounted.
// A process that exits without it leaves a dead mount in the temporary directory.
func DetachMounts() {
	liveMu.Lock()
	defer liveMu.Unlock()
	for m := range liveMounts {
		detach(m.dir, m.direct)
	}
}

@~ Go@/functions@/litar.DetachMounts @~ Go@/functions@/litar.detach @~ Go@/variables@/litar.liveMounts @~ Go@/variables@/litar.liveMu @

@<fuse@:litar@:Go Structure@/functions@+
func mountView(files []viewFile) (*mount, error) {
	tree, err := buildVTree(files)
	if err != nil {
		return nil, err
	}
	dir, err := os.MkdirTemp("", "litar-mnt-*")
	if err != nil {
		return nil, fmtMount(err)
	}
	overlay, err := os.MkdirTemp("", "litar-ovl-*")
	if err != nil {
		os.RemoveAll(dir)
		return nil, fmtMount(err)
	}
	root := &dirNode{rel: "", spec: tree, overlay: overlay}
	zero := time.Duration(0)
	opts := &fs.Options{
		EntryTimeout:    &zero,
		AttrTimeout:     &zero,
		NullPermissions: true,
	}
	opts.FsName = "litar"
	opts.Name = "litar"
	opts.DirectMount = true
	server, err := fs.Mount(dir, root, opts)
	direct := err == nil
	if err != nil {
		os.RemoveAll(dir)
		dir, err = os.MkdirTemp("", "litar-mnt-*")
		if err != nil {
			os.RemoveAll(overlay)
			return nil, fmtMount(err)
		}
		opts.DirectMount = false
		root = &dirNode{rel: "", spec: tree, overlay: overlay}
		server, err = fs.Mount(dir, root, opts)
	}
	if err != nil {
		os.RemoveAll(dir)
		os.RemoveAll(overlay)
		return nil, fmtMount(err)
	}
	m := &mount{dir: dir, server: server, direct: direct, extra: []string{overlay}}
	liveMu.Lock()
	liveMounts[m] = struct{}{}
	liveMu.Unlock()
	return m, nil
}

