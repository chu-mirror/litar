@<parse@:litar@:Go Structure@/methods@+
func (a *Archive) Text() string {
	var b strings.Builder
	for _, bl := range a.Blocks {
		b.WriteString(bl.Comment)
		b.WriteString(bl.Raw)
	}
	b.WriteString(a.Trailing)
	return b.String()
}

