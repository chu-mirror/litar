A file is fetched directly, so its Content-Type tells text from a binary file.
@<Project@/litar@/Web@/views@+
async function fileView(fileId) {
  const files = await tree('file', state.c, state.n);
  showTree(files, s => nodeBase() + '/files/' + s.id, fileId, 'files');
  if (fileId === undefined) return detail('<p class="note">Choose a file.</p>');
  const path = leafIndex(files).byId.get(fileId) || [];
  detail('<h2>' + esc(path.join('/')) + '</h2><div id="view"><p class="note">Loading…</p></div>');
  const response = await fetch('/api/resource?uri=' + encodeURIComponent('file://' + state.c + '/' + state.n + '/' + fileId));
  const type = response.headers.get('Content-Type') || '';
  if (!response.ok) $('view').innerHTML = '<p class="error">' + esc((await response.text()).trim()) + '</p>';
  else if (/^text\/|json/.test(type)) $('view').innerHTML = linesHTML(await response.text());
  else $('view').innerHTML = '<p class="note">Binary file, ' + (await response.blob()).size + ' bytes.</p>';
}
