@<Project@/litar@/fail unless the catalog file 'f' at 'path' is defined exactly once@=
if f == nil {
	return "", "", nil, errString("file '" + path + "' is not defined")
}
if f.archive && f.mapping {
	return "", "", nil, errString("file '" + path + "' is defined as both an archive file and a mapping")
}
@~ Project@/litar@/Go@/types@/litar.errString @

Evaluation may run filters for long, so it runs without a.mu; the chain and mappings are already copied.
@<Project@/litar@/read 'f' into 'data', from its origin or by evaluating 'path'@=
if f.mapping && !f.archive {
	data, err = readOrigin(f.origin)
	if err != nil {
		return "", "", nil, err
	}
} else {
	a.mu.Unlock()
	text, err := evalReporting(chain, maps, ChunkRef{Chunk: Name(path)}, nil)
	a.mu.Lock()
	if err != nil {
		return "", "", nil, err
	}
	data = []byte(text)
}
