The stack holds the composers being loaded; meeting one again is a cycle,
reported from its first occurrence back to itself.
@<Project@/litar@/fail if 'ident' is already on the ground 'stack'@=
for i, frame := range stack {
	if frame.ident != ident {
		continue
	}
	var parts []string
	for _, g := range stack[i:] {
		parts = append(parts, g.name)
	}
	parts = append(parts, frame.name)
	return nil, fmt.Errorf("cycle in grounds: %s", strings.Join(parts, " -> "))
}
@

Unknown fields and trailing data are errors, so a misspelled key is not silently ignored.
@<Project@/litar@/decode the composer at 'path' into 'file'@=
data, err := os.ReadFile(path)
if err != nil {
	return nil, fmt.Errorf("could not read composer '%s': %v", path, err)
}
dec := json.NewDecoder(bytes.NewReader(data))
dec.DisallowUnknownFields()
if err := dec.Decode(&file); err != nil {
	return nil, fmt.Errorf("could not read composer '%s': %v", path, err)
}
if dec.More() {
	return nil, fmt.Errorf("could not read composer '%s': trailing data", path)
}
@

@<Project@/litar@/load the ground named in 'file' into 'ground' and 'groundNodes'@=
if file.Ground != nil {
	gname := *file.Ground
	ground = &gname
	if err := validGroundName(gname); err != nil {
		return nil, err
	}
	gpath, err := findGround(gname)
	if err != nil {
		return nil, err
	}
	gident, err := identityPath(gpath)
	if err != nil {
		return nil, fmt.Errorf("could not read composer '%s': %v", gpath, err)
	}
	gw, err := loadAt(gpath, gident, false, append(stack, groundFrame{ident: ident, name: gname}))
	if err != nil {
		return nil, err
	}
	groundNodes = gw.Nodes
}
@~ Project@/litar@/Go@/functions@/litar.findGround @~ Project@/litar@/Go@/functions@/litar.identityPath @~ Project@/litar@/Go@/functions@/litar.loadAt @~ Project@/litar@/Go@/functions@/litar.validGroundName @~ Project@/litar@/Go@/types@/litar.groundFrame @

@<Project@/litar@/combine 'groundNodes' and the nodes of 'file' into a World@=
if err := prepareNodes(file.Nodes); err != nil {
	return nil, err
}
// Names and bases are checked before archives are read.
if err := validateGraph(graphNodes(groundNodes, file.Nodes)); err != nil {
	return nil, err
}
local, err := nodesFrom(path, file.Nodes)
if err != nil {
	return nil, err
}
all := make([]Node, 0, len(groundNodes)+len(local))
all = append(all, groundNodes...)
all = append(all, local...)
if err := distinctArchives(all); err != nil {
	return nil, err
}
return &World{
	Composer:    path,
	Dir:         dirIdent,
	Description: file.Description,
	Ground:      ground,
	Nodes:       all,
	localAt:     len(groundNodes),
}, nil
@~ Project@/litar@/Go@/functions@/litar.distinctArchives @~ Project@/litar@/Go@/functions@/litar.graphNodes @~ Project@/litar@/Go@/functions@/litar.nodesFrom @~ Project@/litar@/Go@/functions@/litar.prepareNodes @~ Project@/litar@/Go@/functions@/litar.validateGraph @~ Project@/litar@/Go@/types@/litar.Node @~ Project@/litar@/Go@/types@/litar.World @

@<compose@:litar@:Language@/Go@/File@/functions@+
func validGroundName(name string) error {
	if name == "" || name == "." || name == ".." || strings.Contains(name, "/") || strings.Contains(name, `\`) {
		return fmt.Errorf("invalid ground '%s'", name)
	}
	return nil
}

@~ Project@/litar@/Go@/functions@/litar.validGroundName @

@<compose@:litar@:Language@/Go@/File@/functions@+
func findGround(name string) (string, error) {
	for _, dir := range librarySearchDirs() {
		path := filepath.Join(dir, name, "composer.json")
		if isRegular(path) {
			return path, nil
		}
	}
	return "", fmt.Errorf("could not find ground '%s'", name)
}

@~ Project@/litar@/Go@/functions@/litar.findGround @~ Project@/litar@/Go@/functions@/litar.isRegular @~ Project@/litar@/Go@/functions@/litar.librarySearchDirs @

@<compose@:litar@:Language@/Go@/File@/functions@+
func prepareNodes(raw []composerNode) error {
	for _, n := range raw {
		if n.Name == "" {
			return fmt.Errorf("empty name")
		}
		if !n.Base.set {
			return fmt.Errorf("node '%s' is missing base", n.Name)
		}
	}
	return nil
}

@~ Project@/litar@/Go@/functions@/litar.prepareNodes @~ Project@/litar@/Go@/types@/litar.composerNode @

@<compose@:litar@:Language@/Go@/File@/functions@+
func graphNodes(ground []Node, raw []composerNode) []Node {
	all := make([]Node, 0, len(ground)+len(raw))
	for _, n := range ground {
		all = append(all, Node{Name: n.Name, Base: copyPath(n.Base)})
	}
	for _, n := range raw {
		all = append(all, Node{Name: n.Name, Base: copyPath(n.Base.names)})
	}
	return all
}

@~ Project@/litar@/Go@/functions@/litar.copyPath @~ Project@/litar@/Go@/functions@/litar.graphNodes @~ Project@/litar@/Go@/types@/litar.Node @~ Project@/litar@/Go@/types@/litar.composerNode @

