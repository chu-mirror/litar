@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) createNode(ctx context.Context, _ *mcp.CallToolRequest, in createIn) (*mcp.CallToolResult, any, error) {
a.mu.Lock()
w, err := a.compositionByID(in.Composition)
if err != nil {
	a.mu.Unlock()
	return toolErr(err)
}
var base []string
@<Project@/litar@/set 'base' to the path of the parent node 'in.Base', if one is given@>
if err := w.CreateNode(in.Name, in.Archive, in.Description, base); err != nil {
	a.mu.Unlock()
	return toolErr(err)
}
id, err := nodeID(w, formatNodePath(append(base, in.Name)))
a.mu.Unlock()
if err != nil {
	return toolErr(err)
}
a.refresh()
return toolText(strconv.Itoa(id))
}

@~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodeID @~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/functions@/litar.toolText @~ Project@/litar@/Go@/methods@/litar.World.CreateNode @~ Project@/litar@/Go@/methods@/litar.agent.compositionByID @~ Project@/litar@/Go@/methods@/litar.agent.createNode @~ Project@/litar@/Go@/methods@/litar.agent.refresh @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.createIn @

@<Project@/litar@/set 'base' to the path of the parent node 'in.Base', if one is given@=
if in.Base != nil {
	parent, err := nodeByID(w, *in.Base)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	base = nodePath(*parent)
}
@~ Project@/litar@/Go@/functions@/litar.nodeByID @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/functions@/litar.toolErr @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) deleteNode(ctx context.Context, _ *mcp.CallToolRequest, in deleteNodeIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	w, n, err := a.worldNode(in.Composition, in.Node)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	if err := w.DeleteNode(formatNodePath(nodePath(*n))); err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	a.mu.Unlock()
	a.refresh()
	return toolText(strconv.Itoa(in.Node))
}

@~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/functions@/litar.toolText @~ Project@/litar@/Go@/methods@/litar.World.DeleteNode @~ Project@/litar@/Go@/methods@/litar.agent.deleteNode @~ Project@/litar@/Go@/methods@/litar.agent.refresh @~ Project@/litar@/Go@/methods@/litar.agent.worldNode @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.deleteNodeIn @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) deleteChunk(ctx context.Context, _ *mcp.CallToolRequest, in deleteChunkIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	w, n, err := a.worldNode(in.Composition, in.Node)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	chain, maps, err := a.nodeChain(w, in.Node)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	ref, err := chunkByID(chain, maps, in.Chunk)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	if err := w.DeleteChunkAll(formatNodePath(nodePath(*n)), ref); err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	a.mu.Unlock()
	a.refresh()
	return toolText(strconv.Itoa(in.Chunk))
}

