@<list@:litar@:Language@/Go@/File@/functions@+
func matchingBlocks(blocks []Block, ref ChunkRef) []Block {
	var out []Block
	for _, b := range blocks {
		if matchRef(b.Ref, ref) {
			out = append(out, b)
		}
	}
	return out
}

@~ Project@/litar@/Go@/functions@/litar.matchRef @~ Project@/litar@/Go@/functions@/litar.matchingBlocks @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @

@<list@:litar@:Language@/Go@/File@/functions@+
func effectiveBlocks(blocks []Block, ref ChunkRef) (eff []Block, ok bool) {
	for _, b := range blocks {
		if !matchRef(b.Ref, ref) {
			continue
		}
		ok = true
		if b.Op == OpSet {
			eff = []Block{b}
		} else {
			eff = append(eff, b)
		}
	}
	return eff, ok
}

@~ Project@/litar@/Go@/constants@/litar.OpSet @~ Project@/litar@/Go@/functions@/litar.effectiveBlocks @~ Project@/litar@/Go@/functions@/litar.matchRef @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @

@<list@:litar@:Language@/Go@/File@/functions@+
// Literal is the -l listing. A reference with no block is an error.
func Literal(blocks []Block, ref ChunkRef) (string, error) {
	got := matchingBlocks(blocks, ref)
	if len(got) == 0 {
		return "", fmt.Errorf("chunk '%s' is not defined", ref.String())
	}
	return FormatBlocks(got), nil
}

@~ Project@/litar@/Go@/functions@/litar.FormatBlocks @~ Project@/litar@/Go@/functions@/litar.Literal @~ Project@/litar@/Go@/functions@/litar.matchingBlocks @~ Project@/litar@/Go@/methods@/litar.ChunkRef.String @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @

@<list@:litar@:Language@/Go@/File@/functions@+
// Effective is the -e listing.
func Effective(blocks []Block, ref ChunkRef) (string, error) {
	got, ok := effectiveBlocks(blocks, ref)
	if !ok {
		return "", fmt.Errorf("chunk '%s' is not defined", ref.String())
	}
	return FormatBlocks(got), nil
}

