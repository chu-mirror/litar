type body struct {
	parts    []Part
	filters  []Filter
	items    []Item
	endsLine bool
}

@~ Go@/types@/litar.Filter @~ Go@/types@/litar.Item @~ Go@/types@/litar.Part @~ Go@/types@/litar.body @

@<parse@:litar@:Go Structure@/methods@+
// parseBody reads the content and what follows it up to the end control.
// One line break that ends the content is layout, not content;
// endsLine records it.
func (p *parser) parseBody() (body, error) {
	var b body
	var text strings.Builder
	flush := func() {
		if text.Len() == 0 {
			return
		}
		b.parts = append(b.parts, Part{Text: text.String()})
		text.Reset()
	}
	endContent := func() {
		s := text.String()
		switch {
		case strings.HasSuffix(s, "\r\n"):
			s = s[:len(s)-2]
		case strings.HasSuffix(s, "\n"):
			s = s[:len(s)-1]
		default:
			flush()
			return
		}
		b.endsLine = true
		text.Reset()
		text.WriteString(s)
		flush()
	}
	for {
		if p.i >= len(p.src) {
			return body{}, p.fail("unterminated block")
		}
		kind, n, ok := p.atControl()
		if !ok {
			text.WriteByte(p.src[p.i])
			p.i++
			continue
		}
		if n == 2 && kind == '@@' {
			text.WriteByte('@@')
			p.i += 2
			continue
		}
		if isEndControl(kind, n) {
			endContent()
			p.i += n
			return b, nil
		}
		switch kind {
		case '<':
			flush()
			p.i += n
			ref, err := p.parseInnerRef()
			if err != nil {
				return body{}, err
			}
			b.parts = append(b.parts, Part{Ref: ref})
		case '|':
			endContent()
			p.i += n
			filters, k2, n2, err := p.parseFilterList(false)
			if err != nil {
				return body{}, err
			}
			b.filters = filters
			if k2 == '~' && n2 == 2 {
				p.i += n2
				items, err := p.parseItems()
				if err != nil {
					return body{}, err
				}
				b.items = items
				return b, nil
			}
			if isEndControl(k2, n2) {
				p.i += n2
				return b, nil
			}
			return body{}, p.unexpected(k2, n2)
		case '~':
			endContent()
			p.i += n
			items, err := p.parseItems()
			if err != nil {
				return body{}, err
			}
			b.items = items
			return b, nil
		default:
			return body{}, p.unexpected(kind, n)
		}
	}
}

