type cycleError struct {
	chain []ChunkRef
}

@~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.cycleError @

@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *cycleError) Error() string {
	parts := make([]string, len(e.chain))
	for i, ref := range e.chain {
		parts[i] = ref.String()
	}
	return "circular reference " + strings.Join(parts, " -> ")
}

@~ Project@/litar@/Go@/methods@/litar.ChunkRef.String @~ Project@/litar@/Go@/types@/litar.cycleError @

