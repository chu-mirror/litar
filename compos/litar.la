@<compose@:litar@:Go Structure@/methods@+
func (w *World) findIndex(ref string) (int, error) {
	for i := range w.Nodes {
		if formatNodePath(nodePath(w.Nodes[i])) == ref {
			return i, nil
		}
	}
	return 0, fmt.Errorf("unknown node '%s'", ref)
}

