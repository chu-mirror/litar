@<mcp@:litar@:Language@/Go@/File@/functions@+
// specializationTree is the specializations of one chunk.
// The root is named "/" and is the unspecialized form.
// Each child is one label, general toward specific.
// The path label1/label2 is the specialization label2@@:label1.
// Every node, including the root, is a specialization.
// A specialization is a label path on a block of the chunk,
// or on a reference to the chunk.
func specializationTree(blocks []Block, maps []Mapping, chunk ChunkRef) (treeJSON, error) {
meta, err := describe(blocks, maps)
if err != nil {
	return treeJSON{}, err
}
type specNode struct {
	name  string
	path  []string
	kids  []*specNode
	index map[string]*specNode
}
root := &specNode{name: "/", index: map[string]*specNode{}}
ensure := func(labels []Name) {
	@<Project@/litar@/add the label path of 'labels' under 'root', the last label first@>
}
@<Project@/litar@/ensure the labels of every reference to 'chunk' in 'blocks'@>
var build func(*specNode) treeJSON
build = func(n *specNode) treeJSON {
	@<Project@/litar@/build the tree of the specialization 'n', described from 'meta'@>
}
tree := build(root)
assignIDs(&tree)
return tree, nil
}

@~ Project@/litar@/Go@/functions@/litar.assignIDs @~ Project@/litar@/Go@/functions@/litar.describe @~ Project@/litar@/Go@/functions@/litar.specializationTree @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Mapping @~ Project@/litar@/Go@/types@/litar.Name @~ Project@/litar@/Go@/types@/litar.treeJSON @

Labels are written most specific first, so the walk from the root reads them backward.
@<Project@/litar@/add the label path of 'labels' under 'root', the last label first@=
cur := root
for i := len(labels) - 1; i >= 0; i-- {
	name := string(labels[i])
	child := cur.index[name]
	if child == nil {
		path := append(append([]string{}, cur.path...), name)
		child = &specNode{name: name, path: path, index: map[string]*specNode{}}
		cur.index[name] = child
		cur.kids = append(cur.kids, child)
	}
	cur = child
}
@

A reference is resolved as evaluation resolves it: an inner reference inherits the labels
of its block, and a filter the labels of what it filters.
@<Project@/litar@/ensure the labels of every reference to 'chunk' in 'blocks'@=
note := func(ref ChunkRef) {
	if ref.Chunk == chunk.Chunk && modulesEqual(ref.Module, chunk.Module) {
		ensure(ref.Labels)
	}
}
for _, b := range blocks {
	note(b.Ref)
	for _, part := range b.Parts {
		if part.Ref == nil {
			continue
		}
		resolved := resolveBody(part.Ref.ChunkRef, b.Ref.Labels, b.Ref.Module)
		note(resolved)
		for _, f := range part.Ref.Filters {
			note(resolveFilter(f.Ref, resolved.Labels))
		}
	}
	for _, f := range b.Filters {
		note(resolveFilter(f.Ref, b.Ref.Labels))
	}
}
@~ Project@/litar@/Go@/functions@/litar.modulesEqual @~ Project@/litar@/Go@/functions@/litar.resolveBody @~ Project@/litar@/Go@/functions@/litar.resolveFilter @~ Project@/litar@/Go@/types@/litar.ChunkRef @

The description key is the specialization as written, most specific label first.
@<Project@/litar@/build the tree of the specialization 'n', described from 'meta'@=
key := ""
if len(n.path) > 0 {
	rev := make([]string, len(n.path))
	for i, part := range n.path {
		rev[len(n.path)-1-i] = part
	}
	key = strings.Join(rev, "@@:")
}
t := treeJSON{
	Name:        n.name,
	Description: meta.specs[key],
	SubTrees:    emptySub(),
	Leaf:        true,
}
for _, c := range n.kids {
	t.SubTrees = append(t.SubTrees, build(c))
}
return t
@~ Project@/litar@/Go@/functions@/litar.emptySub @~ Project@/litar@/Go@/types@/litar.treeJSON @

@<mcp@:litar@:Language@/Go@/File@/functions@+
func assignIDs(t *treeJSON) {
	n := 0
	var walk func(*treeJSON)
	walk = func(t *treeJSON) {
		t.ID = n
		n++
		for i := range t.SubTrees {
			walk(&t.SubTrees[i])
		}
	}
	walk(t)
}

@~ Project@/litar@/Go@/functions@/litar.assignIDs @~ Project@/litar@/Go@/types@/litar.treeJSON @

@<mcp@:litar@:Language@/Go@/File@/types@+
type treePlace struct {
	names []string
	leaf  bool
}

@~ Project@/litar@/Go@/types@/litar.treePlace @

@<mcp@:litar@:Language@/Go@/File@/functions@+
// indexTree maps each id to its path.
// includeRoot puts the root object's name on that path.
// Chunk, file, item, and specialization trees leave it off,
// so the wrapper named "/" does not appear in the path.
// The wrapper's own id is still present, with an empty path.
func indexTree(t treeJSON, includeRoot bool) map[int]treePlace {
out := map[int]treePlace{}
var walk func(treeJSON, []string)
walk = func(node treeJSON, path []string) {
	@<Project@/litar@/record the place of 'node' at 'path' in 'out', then walk its subtrees@>
}
var start []string
if includeRoot && t.Name != "" {
	start = []string{t.Name}
}
walk(t, start)
return out
}

@~ Project@/litar@/Go@/functions@/litar.indexTree @~ Project@/litar@/Go@/types@/litar.treeJSON @~ Project@/litar@/Go@/types@/litar.treePlace @

Each path is a fresh copy, since the walk extends it for every subtree.
@<Project@/litar@/record the place of 'node' at 'path' in 'out', then walk its subtrees@=
out[node.ID] = treePlace{names: append([]string{}, path...), leaf: node.Leaf}
for _, sub := range node.SubTrees {
	next := append(append([]string{}, path...), sub.Name)
	walk(sub, next)
}
@~ Project@/litar@/Go@/types@/litar.treePlace @

@<mcp@:litar@:Language@/Go@/File@/functions@+
func nodeByID(w *World, id int) (*Node, error) {
	tree := nodeTree(w)
	assignIDs(&tree)
	place, ok := indexTree(tree, true)[id]
	if !ok || len(place.names) == 0 {
		return nil, fmt.Errorf("unknown node %d", id)
	}
	i, err := w.findIndex(formatNodePath(place.names))
	if err != nil {
		return nil, fmt.Errorf("unknown node %d", id)
	}
	return &w.Nodes[i], nil
}

@~ Project@/litar@/Go@/functions@/litar.assignIDs @~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.indexTree @~ Project@/litar@/Go@/functions@/litar.nodeByID @~ Project@/litar@/Go@/functions@/litar.nodeTree @~ Project@/litar@/Go@/methods@/litar.World.findIndex @~ Project@/litar@/Go@/types@/litar.Node @~ Project@/litar@/Go@/types@/litar.World @

@<mcp@:litar@:Language@/Go@/File@/functions@+
func nodeID(w *World, path string) (int, error) {
	tree := nodeTree(w)
	assignIDs(&tree)
	for id, place := range indexTree(tree, true) {
		if formatNodePath(place.names) == path {
			return id, nil
		}
	}
	return 0, fmt.Errorf("unknown node '%s'", path)
}

@~ Project@/litar@/Go@/functions@/litar.assignIDs @~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.indexTree @~ Project@/litar@/Go@/functions@/litar.nodeID @~ Project@/litar@/Go@/functions@/litar.nodeTree @~ Project@/litar@/Go@/types@/litar.World @

@<mcp@:litar@:Language@/Go@/File@/functions@+
// A leaf below File is the file chunk of the path under File.
func chunkRefOf(p treePlace) ChunkRef {
	if len(p.names) == 0 {
		return ChunkRef{}
	}
	if len(p.names) > 1 && p.names[0] == "File" {
		return ChunkRef{Chunk: Name(strings.Join(p.names[1:], "/"))}
	}
	mod := make(ModulePath, len(p.names)-1)
	for i, name := range p.names[:len(p.names)-1] {
		mod[i] = Name(name)
	}
	return ChunkRef{Module: mod, Chunk: Name(p.names[len(p.names)-1])}
}

@~ Project@/litar@/Go@/functions@/litar.chunkRefOf @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.ModulePath @~ Project@/litar@/Go@/types@/litar.Name @~ Project@/litar@/Go@/types@/litar.treePlace @

@<mcp@:litar@:Language@/Go@/File@/functions@+
func chunkByID(blocks []Block, maps []Mapping, id int) (ChunkRef, error) {
	tree, err := chunkTree(blocks, maps)
	if err != nil {
		return ChunkRef{}, err
	}
	assignIDs(&tree)
	place, ok := indexTree(tree, false)[id]
	if !ok || !place.leaf {
		return ChunkRef{}, fmt.Errorf("unknown chunk %d", id)
	}
	return chunkRefOf(place), nil
}

@~ Project@/litar@/Go@/functions@/litar.assignIDs @~ Project@/litar@/Go@/functions@/litar.chunkByID @~ Project@/litar@/Go@/functions@/litar.chunkRefOf @~ Project@/litar@/Go@/functions@/litar.chunkTree @~ Project@/litar@/Go@/functions@/litar.indexTree @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Mapping @

@<mcp@:litar@:Language@/Go@/File@/functions@+
func fileByID(blocks []Block, maps []Mapping, id int) (string, error) {
	tree, err := fileTree(blocks, maps)
	if err != nil {
		return "", err
	}
	assignIDs(&tree)
	place, ok := indexTree(tree, false)[id]
	if !ok || !place.leaf {
		return "", fmt.Errorf("unknown file %d", id)
	}
	return strings.Join(place.names, "/"), nil
}

@~ Project@/litar@/Go@/functions@/litar.assignIDs @~ Project@/litar@/Go@/functions@/litar.fileByID @~ Project@/litar@/Go@/functions@/litar.fileTree @~ Project@/litar@/Go@/functions@/litar.indexTree @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Mapping @

@<mcp@:litar@:Language@/Go@/File@/functions@+
func itemByID(blocks []Block, maps []Mapping, id int) ([]Name, error) {
	tree, err := itemTree(blocks, maps)
	if err != nil {
		return nil, err
	}
	assignIDs(&tree)
	place, ok := indexTree(tree, false)[id]
	if !ok || !place.leaf {
		return nil, fmt.Errorf("unknown item %d", id)
	}
	item := make([]Name, len(place.names))
	for i, name := range place.names {
		item[i] = Name(name)
	}
	return item, nil
}

@~ Project@/litar@/Go@/functions@/litar.assignIDs @~ Project@/litar@/Go@/functions@/litar.indexTree @~ Project@/litar@/Go@/functions@/litar.itemByID @~ Project@/litar@/Go@/functions@/litar.itemTree @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Mapping @~ Project@/litar@/Go@/types@/litar.Name @

@<mcp@:litar@:Language@/Go@/File@/functions@+
func specLabels(blocks []Block, maps []Mapping, chunk ChunkRef, id int) ([]Name, error) {
	tree, err := specializationTree(blocks, maps, chunk)
	if err != nil {
		return nil, err
	}
	place, ok := indexTree(tree, false)[id]
	if !ok {
		return nil, fmt.Errorf("unknown specialization %d", id)
	}
	labels := make([]Name, len(place.names))
	for i, name := range place.names {
		labels[len(place.names)-1-i] = Name(name)
	}
	return labels, nil
}

@~ Project@/litar@/Go@/functions@/litar.indexTree @~ Project@/litar@/Go@/functions@/litar.specLabels @~ Project@/litar@/Go@/functions@/litar.specializationTree @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Mapping @~ Project@/litar@/Go@/types@/litar.Name @

