@~ Go@/methods@/litar.World.root @~ Go@/methods@/litar.World.rootIndex @~ Go@/types@/litar.Node @~ Go@/types@/litar.World @

@<compose@:litar@:Go Structure@/methods@+
func (w *World) rootIndex() (int, error) {
	found := -1
	for i := range w.Nodes {
		if len(w.Nodes[i].Base) == 0 {
			if found >= 0 {
				return 0, fmt.Errorf("composer has more than one root")
			}
			found = i
		}
	}
	if found < 0 {
		return 0, fmt.Errorf("composer has no root")
	}
	return found, nil
}

