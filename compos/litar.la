@<filter@:litar@:Go Structure@/functions@+
func validFilePath(p string) error {
	if p == "" || strings.HasPrefix(p, "/") || strings.Contains(p, "\x00") {
		return fmt.Errorf("invalid file path '%s'", p)
	}
	for _, c := range strings.Split(p, "/") {
		if c == "" || c == "." || c == ".." {
			return fmt.Errorf("invalid file path '%s'", p)
		}
	}
	return nil
}

@~ Go@/functions@/litar.validFilePath @

@<filter@:litar@:Go Structure@/methods@+
func (c *catalog) apply(ops []ViewOp) ([]viewFile, error) {
	in := map[string]bool{}
	var order []string
	defined := func(path string) (*catFile, error) {
		if err := validFilePath(path); err != nil {
			return nil, err
		}
		f := c.files[path]
		if f == nil || (!f.archive && !f.mapping) {
			return nil, fmt.Errorf("file '%s' is not defined", path)
		}
		if f.archive && f.mapping || c.conflicts[path] {
			return nil, fmt.Errorf("file '%s' is defined as both an archive file and a mapping", path)
		}
		return f, nil
	}
	add := func(path string) error {
		f, err := defined(path)
		if err != nil {
			return err
		}
		_ = f
		if !in[path] {
			in[path] = true
			order = append(order, path)
		}
		return nil
	}
	for _, op := range ops {
		switch op.Kind {
		case AddSet:
			name := string(op.Name)
			for _, path := range c.order {
				f := c.files[path]
				if _, ok := f.sets[name]; !ok {
					continue
				}
				if err := add(path); err != nil {
					return nil, err
				}
			}
		case SubSet:
			name := string(op.Name)
			for _, path := range c.order {
				f := c.files[path]
				if _, ok := f.sets[name]; ok {
					delete(in, path)
				}
			}
		case AddFile:
			if err := add(string(op.Name)); err != nil {
				return nil, err
			}
		case DelFile:
			path := string(op.Name)
			if err := validFilePath(path); err != nil {
				return nil, err
			}
			delete(in, path)
		}
	}
	var out []viewFile
	seen := map[string]bool{}
	for _, path := range order {
		if !in[path] || seen[path] {
			continue
		}
		seen[path] = true
		f := c.files[path]
		out = append(out, viewFile{
			path:       path,
			executable: f.executable && f.archive,
			origin:     f.origin,
			archive:    f.archive,
		})
	}
	return out, nil
}

