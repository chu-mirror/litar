// assignInos gives every archive path one inode number for this mount.
// Entry timeouts are zero, so the kernel may look the name up again
// between stat and open. The same number keeps the stat stable.
func assignInos(root *vdir) {
next := uint64(2)
var walk func(*vdir)
walk = func(d *vdir) {
	@<Project@/litar@/number the children of 'd' from 'next' in name order, walking into directories@>
}
walk(root)
}

@~ Project@/litar@/Go@/functions@/litar.assignInos @~ Project@/litar@/Go@/types@/litar.vdir @

Numbers start at 2, after the root's 1, and follow the sorted names,
so they do not depend on map order.
@<Project@/litar@/number the children of 'd' from 'next' in name order, walking into directories@=
names := make([]string, 0, len(d.kids))
for name := range d.kids {
	names = append(names, name)
}
sort.Strings(names)
for _, name := range names {
	ch := d.kids[name]
	switch {
	case ch.file != nil:
		ch.file.ino = next
	case ch.dir != nil:
		ch.dir.ino = next
	default:
		ch.ino = next
	}
	next++
	if ch.dir != nil {
		walk(ch.dir)
	}
}
