@<parse@:litar@:Go Structure@/methods@+
func (p *parser) takeOp() (Op, error) {
	kind, n, ok := p.atControl()
	if !ok || n != 2 || (kind != '=' && kind != '+') {
		if !ok && p.i >= len(p.src) {
			return 0, p.fail("unterminated block")
		}
		if ok {
			return 0, p.unexpected(kind, n)
		}
		return 0, p.fail("unterminated block")
	}
	p.i += n
	return Op(kind), nil
}

@~ Go@/methods@/litar.parser.atControl @~ Go@/methods@/litar.parser.fail @~ Go@/methods@/litar.parser.unexpected @~ Go@/types@/litar.Op @~ Go@/types@/litar.parser @

@<parse@:litar@:Go Structure@/methods@+
func (p *parser) parseBlock() (Block, error) {
	startLine := p.line()
	// Caller is positioned at "@@<".
	p.i += 2
	ref, kind, n, err := p.parseQName(qOpt{})
	if err != nil {
		return Block{}, err
	}
	if ref.Chunk == "" {
		return Block{}, p.fail("empty name")
	}
	if kind == '|' && n == 2 {
		return Block{}, p.unexpected(kind, n)
	}
	if n != 2 || (kind != '=' && kind != '+') {
		if n == 0 {
			return Block{}, p.fail("unterminated block")
		}
		return Block{}, p.unexpected(kind, n)
	}
	op := Op(kind)
	p.i += n
	p.consumeLayout()
	b, err := p.parseBody()
	if err != nil {
		return Block{}, err
	}
	return Block{
		Ref:       ref,
		Op:        op,
		Parts:     b.parts,
		Filters:   b.filters,
		Items:     b.items,
		EndsLine:  b.endsLine,
		StartLine: startLine,
		EndLine:   p.line(),
	}, nil
}

@~ Go@/methods@/litar.parser.consumeLayout @~ Go@/methods@/litar.parser.fail @~ Go@/methods@/litar.parser.line @~ Go@/methods@/litar.parser.parseBlock @~ Go@/methods@/litar.parser.parseBody @~ Go@/methods@/litar.parser.parseQName @~ Go@/methods@/litar.parser.unexpected @~ Go@/types@/litar.Block @~ Go@/types@/litar.Op @~ Go@/types@/litar.parser @~ Go@/types@/litar.qOpt @

@<parse@:litar@:Go Structure@/methods@+
func (p *parser) parseFile(executable bool) (Block, error) {
	startLine := p.line()
	p.i += 2
	path, kind, n, err := p.readName(false)
	if err != nil {
		return Block{}, err
	}
	if path == "" {
		return Block{}, p.fail("empty name")
	}
	if kind == ':' && n == 2 {
		return Block{}, p.fail("files cannot be specialized")
	}
	if kind == '/' && n == 2 {
		return Block{}, p.fail("files cannot be modularized")
	}
	var sets []Name
	for kind == '`' && n == 2 {
		p.i += n
		setName, k2, n2, err := p.readName(false)
		if err != nil {
			return Block{}, err
		}
		if setName == "" {
			return Block{}, p.fail("empty name")
		}
		sets = append(sets, setName)
		kind, n = k2, n2
	}
	if kind == '+' && n == 2 {
		return Block{}, p.fail("files are paired only with @@=")
	}
	if n != 2 || kind != '=' {
		if n == 0 {
			return Block{}, p.fail("unterminated block")
		}
		return Block{}, p.unexpected(kind, n)
	}
	op := Op(kind)
	p.i += n
	p.consumeLayout()
	b, err := p.parseBody()
	if err != nil {
		return Block{}, err
	}
	return Block{
		Ref:        ChunkRef{Chunk: path},
		Op:         op,
		Parts:      b.parts,
		Filters:    b.filters,
		Items:      b.items,
		EndsLine:   b.endsLine,
		StartLine:  startLine,
		EndLine:    p.line(),
		IsFile:     true,
		Path:       path,
		Executable: executable,
		Sets:       sets,
	}, nil
}

