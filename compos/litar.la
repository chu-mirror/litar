@<types@:litar@:Language@/Go@/File@/methods@+
// String renders a chunk reference in qualified-name form.
// The root module is omitted.
func (r ChunkRef) String() string {
	var b strings.Builder
	for _, label := range r.Labels {
		b.WriteString(string(label))
		b.WriteString("@@:")
	}
	for i, part := range r.Module {
		if i > 0 {
			b.WriteString("@@/")
		}
		b.WriteString(string(part))
	}
	if len(r.Module) > 0 {
		b.WriteString("@@/")
	}
	b.WriteString(string(r.Chunk))
	return b.String()
}

@~ Project@/litar@/Go@/methods@/litar.ChunkRef.String @~ Project@/litar@/Go@/types@/litar.ChunkRef @

@<types@:litar@:Language@/Go@/File@/methods@+
// key is a length-prefixed identity. Names may contain the bytes "@@:".
func (r ChunkRef) key() string {
	var b strings.Builder
	writeNames(&b, r.Labels)
	b.WriteByte(0)
	writeNames(&b, r.Module)
	b.WriteByte(0)
	fmt.Fprintf(&b, "%d:", len(r.Chunk))
	b.WriteString(string(r.Chunk))
	return b.String()
}

@~ Project@/litar@/Go@/functions@/litar.writeNames @~ Project@/litar@/Go@/methods@/litar.ChunkRef.key @~ Project@/litar@/Go@/types@/litar.ChunkRef @

@<types@:litar@:Language@/Go@/File@/functions@+
func writeNames(b *strings.Builder, ns []Name) {
	for _, n := range ns {
		fmt.Fprintf(b, "%d:", len(n))
		b.WriteString(string(n))
		b.WriteByte(',')
	}
}

@~ Project@/litar@/Go@/functions@/litar.writeNames @~ Project@/litar@/Go@/types@/litar.Name @

@<types@:litar@:Language@/Go@/File@/functions@+
func modulesEqual(a, b ModulePath) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

@~ Project@/litar@/Go@/functions@/litar.modulesEqual @~ Project@/litar@/Go@/types@/litar.ModulePath @

@<types@:litar@:Language@/Go@/File@/functions@+
func isRelName(n Name) bool {
	return n == "." || n == ".."
}

@~ Project@/litar@/Go@/functions@/litar.isRelName @~ Project@/litar@/Go@/types@/litar.Name @

@<types@:litar@:Language@/Go@/File@/functions@+
func hasRel(m ModulePath) bool {
	for _, n := range m {
		if isRelName(n) {
			return true
		}
	}
	return false
}

@~ Project@/litar@/Go@/functions@/litar.hasRel @~ Project@/litar@/Go@/functions@/litar.isRelName @~ Project@/litar@/Go@/types@/litar.ModulePath @

@<types@:litar@:Language@/Go@/File@/functions@+
// resolveModule applies "." and ".." against base when the path starts
// with one of them. Otherwise the path starts at the root, and a later
// "." or ".." still applies to the path built so far.
func resolveModule(base, path ModulePath) ModulePath {
	var cur ModulePath
	if len(path) > 0 && isRelName(path[0]) {
		cur = append(ModulePath(nil), base...)
	}
	for _, c := range path {
		switch c {
		case ".":
		case "..":
			if len(cur) > 0 {
				cur = cur[:len(cur)-1]
			}
		default:
			cur = append(cur, c)
		}
	}
	return cur
}

@~ Project@/litar@/Go@/functions@/litar.isRelName @~ Project@/litar@/Go@/functions@/litar.resolveModule @~ Project@/litar@/Go@/types@/litar.ModulePath @

