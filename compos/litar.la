The script is passed to the interpreter as a file, so its stdin stays free for the input.
A failure to write it is reported as a filter that exited with status 1.
@<Project@/litar@/write 'script' to the temporary file 'scriptPath'@=
scriptFile, err := os.CreateTemp("", "litar-script-*")
if err != nil {
	return "", fmt.Errorf("filter '%s' exited with status 1", ref.String())
}
scriptPath = scriptFile.Name()
if _, err := scriptFile.WriteString(script); err != nil {
	scriptFile.Close()
	os.Remove(scriptPath)
	return "", fmt.Errorf("filter '%s' exited with status 1", ref.String())
}
scriptFile.Close()
defer os.Remove(scriptPath)
