@<parse@:litar@:Go Structure@/methods@+
func (p *parser) line() int {
	line := 1
	end := p.i
	if end > len(p.src) {
		end = len(p.src)
	}
	for i := 0; i < end; i++ {
		if p.src[i] == '\n' {
			line++
		}
	}
	return line
}

