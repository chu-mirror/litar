@

The Makefile builds the binary and runs the acceptance cases.
The Go tests are not run here: the source tree is synced without the test files,
and the build composition runs go test in an invocation.
@[Makefile@`build@=
# Build the litar binary and run the test set.
#   make        compile ./litar
#   make test   run the acceptance cases of tests/
#   make clean  remove the binary

.PHONY: all test clean litar

all: litar

litar:
	go build -o litar ./cmd/litar

test: litar
	bash tests/run.sh $(abspath litar)

clean:
	rm -f litar
	$(MAKE) -C tests clean

mcp:
	npx @modelcontextprotocol/inspector


@

The acceptance tests run the binary on the case directories; they stay verbatim.
@[tests/assert.sh@`tests@=
# Helpers for tests/cases/*/driver.sh. Source this file; do not execute it.
# assert_* print a diagnostic and exit 1 on failure.

@<Project@/litar@/assertions of tests/assert.sh@>

@

A passing command must leave stderr empty.
@<Project@/litar@/assertions of tests/assert.sh@=
assert_ok() {
    _name=$1
    _exp=$2
    shift 2
    _out=$(mktemp)
    _err=$(mktemp)
    set +e
    "$@@" >"$_out" 2>"$_err"
    _st=$?
    set -e
    if [ "$_st" -ne 0 ]; then
        echo "FAIL $_name: exit $_st" >&2
        cat "$_err" >&2
        exit 1
    fi
    if [ -s "$_err" ]; then
        echo "FAIL $_name: unexpected stderr" >&2
        cat "$_err" >&2
        exit 1
    fi
    if ! cmp -s "$_exp" "$_out"; then
        echo "FAIL $_name: stdout" >&2
        diff -u "$_exp" "$_out" >&2 || true
        exit 1
    fi
    rm -f "$_out" "$_err"
}

@

@<Project@/litar@/assertions of tests/assert.sh@+
assert_text() {
    _name=$1
    _text=$2
    shift 2
    _file=$(mktemp)
    printf '%s' "$_text" >"$_file"
    assert_ok "$_name" "$_file" "$@@"
    rm -f "$_file"
}

@

A failing command must leave stdout empty, and its stderr only has to contain the needle.
@<Project@/litar@/assertions of tests/assert.sh@+
assert_fail() {
    _name=$1
    _needle=$2
    shift 2
    _out=$(mktemp)
    _err=$(mktemp)
    set +e
    "$@@" >"$_out" 2>"$_err"
    _st=$?
    set -e
    if [ "$_st" -eq 0 ]; then
        echo "FAIL $_name: expected failure" >&2
        exit 1
    fi
    if ! grep -F -q -e "$_needle" "$_err"; then
        echo "FAIL $_name: stderr missing [$_needle]" >&2
        cat "$_err" >&2
        exit 1
    fi
    if [ -s "$_out" ]; then
        echo "FAIL $_name: stdout not empty" >&2
        cat -A "$_out" >&2
        exit 1
    fi
    rm -f "$_out" "$_err"
}
