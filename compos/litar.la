}

@~ Go@/functions@/litar.formatNodePath @~ Go@/functions@/litar.nodePath @~ Go@/methods@/litar.World.root @~ Go@/methods@/litar.World.rootName @~ Go@/types@/litar.World @

@<compose@:litar@:Go Structure@/methods@+
// ancestry returns the node, then its base, up to the root.
func (w *World) ancestry(ref string) ([]*Node, error) {
	var n *Node
	var err error
	if ref == "" {
		n, err = w.root()
	} else {
		n, err = w.lookup(ref)
	}
	if err != nil {
		return nil, err
	}
	var rev []*Node
	seen := map[string]bool{}
	for {
		key := formatNodePath(nodePath(*n))
		if seen[key] {
			return nil, fmt.Errorf("cycle in node bases: %s", key)
		}
		seen[key] = true
		rev = append(rev, n)
		if len(n.Base) == 0 {
			return rev, nil
		}
		n, err = w.lookup(formatNodePath(n.Base))
		if err != nil {
			return nil, err
		}
	}
}

@~ Go@/functions@/litar.formatNodePath @~ Go@/functions@/litar.nodePath @~ Go@/methods@/litar.World.ancestry @~ Go@/methods@/litar.World.lookup @~ Go@/methods@/litar.World.root @~ Go@/types@/litar.Node @~ Go@/types@/litar.World @

@<compose@:litar@:Go Structure@/methods@+
// Chain is the base chain followed by the node's own blocks.
func (w *World) Chain(name string) ([]Block, error) {
	rev, err := w.ancestry(name)
	if err != nil {
		return nil, err
	}
	var blocks []Block
	for i := len(rev) - 1; i >= 0; i-- {
		blocks = append(blocks, rev[i].Own...)
	}
	return blocks, nil
}

@~ Go@/methods@/litar.World.Chain @~ Go@/methods@/litar.World.ancestry @~ Go@/types@/litar.Block @~ Go@/types@/litar.World @

@<compose@:litar@:Go Structure@/methods@+
// Mappings is the base chain's mappings followed by the node's own.
func (w *World) Mappings(name string) ([]Mapping, error) {
	rev, err := w.ancestry(name)
	if err != nil {
		return nil, err
	}
	var maps []Mapping
	for i := len(rev) - 1; i >= 0; i-- {
		maps = append(maps, rev[i].Mappings...)
	}
	return maps, nil
}

