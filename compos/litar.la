@<Project@/litar@/start 'cmd', with status 127 if the interpreter is missing@=
if err := cmd.Start(); err != nil {
	code := 1
	if os.IsNotExist(err) {
		code = 127
	}
	return "", fmt.Errorf("filter '%s' exited with status %d", ref.String(), code)
}
