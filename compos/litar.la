@<eval@:litar@:Language@/Go@/File@/methods@+
// readChunk evaluates a root-module file chunk on the current visit stack.
// Tangling calls it before the filter process starts, so the lock
// is not already held.
func (e *Evaluator) readChunk(chunk Name) ([]byte, error) {
	e.mu.Lock()
	defer e.mu.Unlock()
	text, err := e.expandLocked(ChunkRef{Chunk: chunk}, false)
	if err != nil {
		if e.fuseErr == nil {
			e.fuseErr = err
		}
		return nil, err
	}
	return []byte(text), nil
}

@~ Project@/litar@/Go@/methods@/litar.Evaluator.expandLocked @~ Project@/litar@/Go@/methods@/litar.Evaluator.readChunk @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.Name @

