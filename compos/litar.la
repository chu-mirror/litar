@<list@:litar@:Language@/Go@/File@/functions@+
func useMatches(use ChunkRef, query ChunkRef, header ModulePath) bool {
	mod := use.Module
	if hasRel(mod) {
		mod = resolveModule(header, mod)
	}
	if use.Chunk != query.Chunk || !modulesEqual(mod, query.Module) {
		return false
	}
	return isSuffix(query.Labels, use.Labels)
}

@~ Project@/litar@/Go@/functions@/litar.hasRel @~ Project@/litar@/Go@/functions@/litar.isSuffix @~ Project@/litar@/Go@/functions@/litar.modulesEqual @~ Project@/litar@/Go@/functions@/litar.resolveModule @~ Project@/litar@/Go@/functions@/litar.useMatches @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.ModulePath @

@<list@:litar@:Language@/Go@/File@/functions@+
func blockDepends(b Block, query ChunkRef) bool {
	check := func(use ChunkRef) bool {
		return useMatches(use, query, b.Ref.Module)
	}
	for _, part := range b.Parts {
		if part.Ref == nil {
			continue
		}
		if check(part.Ref.ChunkRef) {
			return true
		}
		for _, f := range part.Ref.Filters {
			if check(f.Ref) {
				return true
			}
		}
	}
	for _, f := range b.Filters {
		if check(f.Ref) {
			return true
		}
	}
	return false
}

@~ Project@/litar@/Go@/functions@/litar.blockDepends @~ Project@/litar@/Go@/functions@/litar.useMatches @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @

@<list@:litar@:Language@/Go@/File@/functions@+
// Depend is the -d listing. No match is an empty string, not an error.
func Depend(blocks []Block, query ChunkRef) string {
	var got []Block
	for _, b := range blocks {
		if blockDepends(b, query) {
			got = append(got, b)
		}
	}
	return FormatBlocks(got)
}

@~ Project@/litar@/Go@/functions@/litar.Depend @~ Project@/litar@/Go@/functions@/litar.FormatBlocks @~ Project@/litar@/Go@/functions@/litar.blockDepends @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @

@<list@:litar@:Language@/Go@/File@/functions@+
// Refer is the -r listing.
func Refer(blocks []Block, item Item) string {
	var got []Block
	for _, b := range blocks {
		for _, it := range b.Items {
			if sameItem(it, item) {
				got = append(got, b)
				break
			}
		}
	}
	return FormatBlocks(got)
}

