@<list@:litar@:Go Structure@/functions@+
func moduleSeen(seen []ModulePath, m ModulePath) bool {
	for _, s := range seen {
		if modulesEqual(s, m) {
			return true
		}
	}
	return false
}

@~ Go@/functions@/litar.moduleSeen @~ Go@/functions@/litar.modulesEqual @~ Go@/types@/litar.ModulePath @

@<list@:litar@:Go Structure@/functions@+
// Modules lists module paths strictly under parent, in first-introduction order.
// A reserved namespace is omitted. A description follows `Name:`, aligned with tabs.
func Modules(blocks []Block, parent ModulePath, meta metaInfo) string {
	var seen []ModulePath
	for _, b := range blocks {
		mod := b.Ref.Module
		for i := 1; i <= len(mod); i++ {
			pre := mod[:i]
			if moduleSeen(seen, pre) {
				continue
			}
			seen = append(seen, copyModule(pre))
		}
	}
	var rows []namedLine
	for _, m := range seen {
		if _, reserved := reservedNamespace(m); reserved {
			continue
		}
		if len(m) <= len(parent) || !modulesEqual(m[:len(parent)], parent) {
			continue
		}
		line := formatModule(m)
		rows = append(rows, namedLine{line, meta.modules[line]})
	}
	return formatNamed(rows)
}

@~ Go@/functions@/litar.Modules @~ Go@/functions@/litar.copyModule @~ Go@/functions@/litar.formatModule @~ Go@/functions@/litar.formatNamed @~ Go@/functions@/litar.moduleSeen @~ Go@/functions@/litar.modulesEqual @~ Go@/functions@/litar.reservedNamespace @~ Go@/types@/litar.Block @~ Go@/types@/litar.ModulePath @~ Go@/types@/litar.metaInfo @~ Go@/types@/litar.namedLine @

@<list@:litar@:Go Structure@/functions@+
// Chunks lists chunk names whose module equals mod.
// Chunks in a reserved namespace are omitted.
func Chunks(blocks []Block, mod ModulePath, meta metaInfo) string {
	seen := map[Name]bool{}
	var rows []namedLine
	for _, b := range blocks {
		if _, reserved := reservedNamespace(b.Ref.Module); reserved {
			continue
		}
		if b.Ref.Chunk == "" || !modulesEqual(b.Ref.Module, mod) {
			continue
		}
		if seen[b.Ref.Chunk] {
			continue
		}
		seen[b.Ref.Chunk] = true
		name := string(b.Ref.Chunk)
		rows = append(rows, namedLine{name, meta.chunks[leafKey(mod, name)]})
	}
	return formatNamed(rows)
}

@~ Go@/functions@/litar.Chunks @~ Go@/functions@/litar.formatNamed @~ Go@/functions@/litar.leafKey @~ Go@/functions@/litar.modulesEqual @~ Go@/functions@/litar.reservedNamespace @~ Go@/types@/litar.Block @~ Go@/types@/litar.ModulePath @~ Go@/types@/litar.Name @~ Go@/types@/litar.metaInfo @~ Go@/types@/litar.namedLine @

@<list@:litar@:Go Structure@/types@+
type namedLine struct {
	name string
	desc string
}

@~ Go@/types@/litar.namedLine @

@<list@:litar@:Go Structure@/functions@+
// formatNamed prints one name per line.
// A description is `Name:` then tabs, then the description.
// Tab stops are eight columns apart, and every description in the list
// starts at the same column, past the longest `Name:`.
func formatNamed(rows []namedLine) string {
	const tabWidth = 8
	width := 0
	for _, row := range rows {
		if row.desc == "" {
			continue
		}
		if n := utf8.RuneCountInString(row.name) + 1; n > width {
			width = n
		}
	}
	col := 0
	if width > 0 {
		col = (width/tabWidth + 1) * tabWidth
	}
	lines := make([]string, len(rows))
	for i, row := range rows {
		if row.desc == "" {
			lines[i] = row.name
			continue
		}
		lines[i] = row.name + ":" + tabPad(utf8.RuneCountInString(row.name)+1, col, tabWidth) + row.desc
	}
	return joinLines(lines)
}

@~ Go@/functions@/litar.formatNamed @~ Go@/functions@/litar.joinLines @~ Go@/functions@/litar.tabPad @~ Go@/types@/litar.namedLine @

@<list@:litar@:Go Structure@/functions@+
func tabPad(from, col, tabWidth int) string {
	var b strings.Builder
	pos := from
	for pos < col {
		b.WriteByte('\t')
		pos += tabWidth - pos%tabWidth
	}
	return b.String()
}

@~ Go@/functions@/litar.tabPad @

@<list@:litar@:Go Structure@/functions@+
func formatUnder(domain []Name, name Name) string {
	if len(domain) == 0 {
		return string(name)
	}
	return formatModule(domain) + "@@/" + string(name)
}

@~ Go@/functions@/litar.formatModule @~ Go@/functions@/litar.formatUnder @~ Go@/types@/litar.Name @

@<list@:litar@:Go Structure@/functions@+
// Subdomains lists the name that follows domain, once each.
func Subdomains(blocks []Block, domain []Name, meta metaInfo) string {
	seen := map[string]bool{}
	var rows []namedLine
	for _, b := range blocks {
		for _, it := range b.Items {
			if len(it) <= len(domain) || !namePrefix(it, domain) {
				continue
			}
			line := formatUnder(domain, it[len(domain)])
			if seen[line] {
				continue
			}
			seen[line] = true
			rows = append(rows, namedLine{line, meta.domains[line]})
		}
	}
	return formatNamed(rows)
}

@~ Go@/functions@/litar.Subdomains @~ Go@/functions@/litar.formatNamed @~ Go@/functions@/litar.formatUnder @~ Go@/functions@/litar.namePrefix @~ Go@/types@/litar.Block @~ Go@/types@/litar.Name @~ Go@/types@/litar.metaInfo @~ Go@/types@/litar.namedLine @

@<list@:litar@:Go Structure@/functions@+
// Items lists item paths whose prefix before the last name is domain.
func Items(blocks []Block, domain []Name, meta metaInfo) string {
	seen := map[string]bool{}
	var rows []namedLine
	for _, b := range blocks {
		for _, it := range b.Items {
			if len(it) != len(domain)+1 || !namePrefix(it, domain) {
				continue
			}
			line := formatItem(it)
			if seen[line] {
				continue
			}
			seen[line] = true
			rows = append(rows, namedLine{line, meta.items[leafKey(it[:len(it)-1], string(it[len(it)-1]))]})
		}
	}
	return formatNamed(rows)
}

@~ Go@/functions@/litar.Items @~ Go@/functions@/litar.formatItem @~ Go@/functions@/litar.formatNamed @~ Go@/functions@/litar.leafKey @~ Go@/functions@/litar.namePrefix @~ Go@/types@/litar.Block @~ Go@/types@/litar.Name @~ Go@/types@/litar.metaInfo @~ Go@/types@/litar.namedLine @

