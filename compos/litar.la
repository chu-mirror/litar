@<types@:litar@:Language@/Go@/File@/functions@+
// matchRef reports whether a block header matches a chunk reference.
// The block's labels must be a suffix of the reference's labels.
// Empty block labels match every specialization.
func matchRef(block, ref ChunkRef) bool {
	if block.Chunk != ref.Chunk || !modulesEqual(block.Module, ref.Module) {
		return false
	}
	return isSuffix(block.Labels, ref.Labels)
}

@~ Project@/litar@/Go@/functions@/litar.isSuffix @~ Project@/litar@/Go@/functions@/litar.matchRef @~ Project@/litar@/Go@/functions@/litar.modulesEqual @~ Project@/litar@/Go@/types@/litar.ChunkRef @

@<types@:litar@:Language@/Go@/File@/functions@+
func isSuffix(block, ref []Name) bool {
	if len(block) > len(ref) {
		return false
	}
	off := len(ref) - len(block)
	for i := range block {
		if block[i] != ref[off+i] {
			return false
		}
	}
	return true
}

@~ Project@/litar@/Go@/functions@/litar.isSuffix @~ Project@/litar@/Go@/types@/litar.Name @

@<types@:litar@:Language@/Go@/File@/functions@+
func formatModule(m ModulePath) string {
	if len(m) == 0 {
		return "/"
	}
	parts := make([]string, len(m))
	for i, n := range m {
		parts[i] = string(n)
	}
	return strings.Join(parts, "@@/")
}

@~ Project@/litar@/Go@/functions@/litar.formatModule @~ Project@/litar@/Go@/types@/litar.ModulePath @

@<types@:litar@:Language@/Go@/File@/functions@+
func formatItem(it Item) string {
	parts := make([]string, len(it))
	for i, n := range it {
		parts[i] = string(n)
	}
	return strings.Join(parts, "@@/")
}

@~ Project@/litar@/Go@/functions@/litar.formatItem @~ Project@/litar@/Go@/types@/litar.Item @

@<types@:litar@:Language@/Go@/File@/functions@+
func sameItem(a, b Item) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

@~ Project@/litar@/Go@/functions@/litar.sameItem @~ Project@/litar@/Go@/types@/litar.Item @

@<types@:litar@:Language@/Go@/File@/functions@+
func namePrefix(path []Name, prefix []Name) bool {
	if len(path) < len(prefix) {
		return false
	}
	for i := range prefix {
		if path[i] != prefix[i] {
			return false
		}
	}
	return true
}

@~ Project@/litar@/Go@/functions@/litar.namePrefix @~ Project@/litar@/Go@/types@/litar.Name @

@<types@:litar@:Language@/Go@/File@/functions@+
// FormatBlocks is the -l form: each block's comment and raw text.
// Trailing bytes after the last expression are not included.
func FormatBlocks(blocks []Block) string {
	var b strings.Builder
	for _, bl := range blocks {
		b.WriteString(bl.Comment)
		b.WriteString(bl.Raw)
	}
	return b.String()
}

@~ Project@/litar@/Go@/functions@/litar.FormatBlocks @~ Project@/litar@/Go@/types@/litar.Block @

@<types@:litar@:Language@/Go@/File@/functions@+
func joinLines(lines []string) string {
	if len(lines) == 0 {
		return ""
	}
	return strings.Join(lines, "\n") + "\n"
}

@~ Project@/litar@/Go@/functions@/litar.joinLines @

@<types@:litar@:Language@/Go@/File@/functions@+
// nodePath is the path from the root through this node.
func nodePath(n Node) []string {
	p := make([]string, len(n.Base)+1)
	copy(p, n.Base)
	p[len(n.Base)] = n.Name
	return p
}

@~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/types@/litar.Node @

@<types@:litar@:Language@/Go@/File@/functions@+
// formatNodePath joins a node path with slashes.
// A node name does not contain a slash, so the join is reversible.
func formatNodePath(p []string) string {
	return strings.Join(p, "/")
}

@~ Project@/litar@/Go@/functions@/litar.formatNodePath @

@<types@:litar@:Language@/Go@/File@/functions@+
func samePath(a, b []string) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

@~ Project@/litar@/Go@/functions@/litar.samePath @

@<types@:litar@:Language@/Go@/File@/functions@+
func hasPathPrefix(path, prefix []string) bool {
	if len(path) < len(prefix) {
		return false
	}
	for i := range prefix {
		if path[i] != prefix[i] {
			return false
		}
	}
	return true
}

@~ Project@/litar@/Go@/functions@/litar.hasPathPrefix @

@<types@:litar@:Language@/Go@/File@/functions@+
func copyPath(p []string) []string {
	if len(p) == 0 {
		return []string{}
	}
	return append([]string{}, p...)
}

