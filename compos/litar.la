@~ Project@/litar@/Go@/functions@/litar.specializationOrder @
The own blocks are ordered before the effective sets are computed,
so a less specialized block applied later does not hide a more specialized one.
The effective set is computed once per chunk reference, since many blocks share one.
@<Project@/litar@/keep the effective own blocks of 'n' in 'kept'@=
own := orderOwn(n.Own)
cache := map[string]map[int]bool{}
for bi, bl := range own {
	k := bl.Ref.key()
	set, ok := cache[k]
	if !ok {
		set = effectiveIndexSet(own, bl.Ref)
		cache[k] = set
	}
	if set[bi] {
		kept = append(kept, bl)
	}
}
@~ Project@/litar@/Go@/functions@/litar.effectiveIndexSet @~ Project@/litar@/Go@/functions@/litar.orderOwn @~ Project@/litar@/Go@/methods@/litar.ChunkRef.key @
A block applies after every block whose labels are a proper suffix of its own,
because a reference that sees both means the more specialized one to win.
Blocks with no such relation never apply to one reference together, so they keep their order;
the first block whose less specialized blocks are placed goes next.
@<compose@:litar@:Language@/Go@/File@/functions@+
// specializationOrder lists idx, the blocks of one chunk, so that a block follows
// the blocks whose labels are a proper suffix of its labels; otherwise idx keeps its order.
func specializationOrder(blocks []Block, idx []int) []int {
	k := len(idx)
	before := make([]int, k)
	after := make([][]int, k)
	for p := 0; p < k; p++ {
		for q := 0; q < k; q++ {
			lp, lq := blocks[idx[p]].Ref.Labels, blocks[idx[q]].Ref.Labels
			if len(lp) < len(lq) && isSuffix(lp, lq) {
				after[p] = append(after[p], q)
				before[q]++
			}
		}
	}
	order := make([]int, 0, k)
	placed := make([]bool, k)
	for len(order) < k {
		for q := 0; q < k; q++ {
			if !placed[q] && before[q] == 0 {
				placed[q] = true
				order = append(order, idx[q])
				for _, r := range after[q] {
					before[r]--
				}
				break
			}
		}
	}
	return order
}

@~ Project@/litar@/Go@/functions@/litar.isSuffix @~ Project@/litar@/Go@/functions@/litar.specializationOrder @~ Project@/litar@/Go@/types@/litar.Block @
@<compose test@:litar@:Language@/Go@/File@/functions@+
func TestOrderOwnSpecialization(t *testing.T) {
	cases := []struct {
		name, src, want string
	}{
		{
			"less specialized first",
			"@@<l@@:c@@=main@@\n@@<c@@=pkg@@\n",
			"@@<c@@=pkg@@\n@@<l@@:c@@=main@@\n",
		},
		{
			"equal labels keep their order",
			"@@<l@@:c@@=1@@\n@@<c@@=0@@\n@@<l@@:c@@+2@@\n",
			"@@<c@@=0@@\n@@<l@@:c@@=1@@\n@@<l@@:c@@+2@@\n",
		},
		{
			"unrelated labels keep their order",
			"@@<b@@:x@@:c@@=2@@\n@@<a@@:c@@=1@@\n",
			"@@<b@@:x@@:c@@=2@@\n@@<a@@:c@@=1@@\n",
		},
	}
	for _, tc := range cases {
		if got := orderedRaw(t, tc.src); got != tc.want {
			t.Fatalf("%s:\n%q\nwant\n%q", tc.name, got, tc.want)
		}
	}
}

@~ Project@/litar@/Go@/functions@/litar.orderedRaw @
The archive ends with the end control of its block, and the applied block is less specialized:
the append must keep that end control, and compaction must keep the specialized block.
@<compose test@:litar@:Language@/Go@/File@/functions@+
func TestApplyBlockAfterFinalEnd(t *testing.T) {
dir := t.TempDir()
arch := filepath.Join(dir, "a.la")
writeFile(t, arch, "@@<l@@:c@@=main@@")
comp := filepath.Join(dir, "composer.json")
writeFile(t, comp, composerDoc(`[
    {"name":"root","archive":"./a.la","description":"","mappings":[],"base":[]}
]`))
w, err := LoadComposer(comp)
if err != nil {
	t.Fatal(err)
}
if err := w.ApplyBlock("root", "@@<c@@=pkg@@\n"); err != nil {
	t.Fatal(err)
}
chain, err := w.Chain("root")
if err != nil {
	t.Fatal(err)
}
for ref, want := range map[string]string{"c": "pkg", "l@@:c": "main"} {
	got, err := NewEvaluator(chain, nil, nil).Eval(mustRef(t, ref), nil)
	if err != nil || got != want {
		t.Fatalf("%s: %v %q, want %q", ref, err, got, want)
	}
}
}

@~ Project@/litar@/Go@/functions@/litar.LoadComposer @~ Project@/litar@/Go@/functions@/litar.composerDoc @~ Project@/litar@/Go@/functions@/litar.writeFile @~ Project@/litar@/Go@/methods@/litar.World.ApplyBlock @
@<filter test@:litar@:Language@/Go@/File@/functions@+
func TestParseShebang(t *testing.T) {
	cases := []struct {
		script, interp, arg string
		hasArg, ok          bool
	}{
		{"#!/bin/sh\necho", "/bin/sh", "", false, true},
		{"#! /bin/sh  \n", "/bin/sh", "", false, true},
		{"#!/bin/sh -e", "/bin/sh", "-e", true, true},
		{"#!/usr/bin/env -S uv run --script\n", "/usr/bin/env", "-S uv run --script", true, true},
		{"#!/usr/bin/env  python3 \t\r\nx", "/usr/bin/env", "python3", true, true},
		{"echo", "", "", false, false},
	}
	for _, tc := range cases {
		interp, arg, hasArg, ok := parseShebang(tc.script)
		if interp != tc.interp || arg != tc.arg || hasArg != tc.hasArg || ok != tc.ok {
			t.Fatalf("%q: %q %q %v %v", tc.script, interp, arg, hasArg, ok)
		}
	}
}

@~ Project@/litar@/Go@/functions@/litar.parseShebang @
