@<cli@:litar@:Language@/Go@/File@/file@>@
The filter cache: the output of a filter run kept on disk under everything the run reads,
so a later run with the same script, input, and view files is not started again.
@[internal/litar/cache.go@`go module@=
@<cache@:litar@:Language@/Go@/File@/file@>@

@<cache@:litar@:Language@/Go@/File@/import paths@+
"crypto/sha256"
	"encoding/hex"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"strings"
@
Only Main sets the cache directory, so the tests run every filter unless a test sets it.
@<cache@:litar@:Language@/Go@/File@/variables@+
// filterCacheDir is the directory of the filter cache; empty turns the cache off.
var filterCacheDir string

@~ Project@/litar@/Go@/variables@/litar.filterCacheDir @
The directory is made absolute, because filters run in another working directory.
@<cache@:litar@:Language@/Go@/File@/functions@+
// cacheDirFromEnv is the directory that LITAR_CACHE names, or litar below the user cache
// directory when it is unset. LITAR_CACHE=off, or an empty value, turns the cache off.
func cacheDirFromEnv() string {
	dir, ok := os.LookupEnv("LITAR_CACHE")
	if !ok {
		base, err := os.UserCacheDir()
		if err != nil {
			return ""
		}
		dir = filepath.Join(base, "litar")
	}
	if dir == "" || dir == "off" {
		return ""
	}
	abs, err := filepath.Abs(dir)
	if err != nil {
		return ""
	}
	return abs
}

@~ Project@/litar@/Go@/functions@/litar.cacheDirFromEnv @
A run is keyed by everything it reads from litar. A mapped file or directory lies outside
the archive and may be written by the run, so a view with one gets no key and always runs.
The version line changes whenever the meaning of a key does.
@<cache@:litar@:Language@/Go@/File@/functions@+
// filterKey names a filter run by its script, its input, and the path, mode,
// and contents of each file in its view.
func filterKey(script, input string, files []viewFile) (string, bool) {
	if filterCacheDir == "" {
		return "", false
	}
	h := sha256.New()
	fmt.Fprintf(h, "litar filter 1\n%d:%s%d:%s", len(script), script, len(input), input)
	for _, f := range files {
		if !f.archive {
			return "", false
		}
		fmt.Fprintf(h, "%q %t %d:", f.path, f.executable, len(f.body))
		h.Write(f.body)
	}
	return hex.EncodeToString(h.Sum(nil)), true
}

@~ Project@/litar@/Go@/functions@/litar.filterKey @~ Project@/litar@/Go@/types@/litar.viewFile @~ Project@/litar@/Go@/variables@/litar.filterCacheDir @
Outputs are spread over subdirectories by the first two digits of their key.
The cache is best effort: an output that cannot be read is computed again,
and one that cannot be written is left out. An output is written beside its place
and renamed, so a concurrent litar never reads part of it.
@<cache@:litar@:Language@/Go@/File@/functions@+
func cachedOutputPath(key string) string {
	return filepath.Join(filterCacheDir, "filters", key[:2], key)
}

// readCachedOutput returns the output kept for key, if there is one.
func readCachedOutput(key string) (string, bool) {
	data, err := os.ReadFile(cachedOutputPath(key))
	if err != nil {
		return "", false
	}
	return string(data), true
}

// writeCachedOutput keeps out as the output for key.
func writeCachedOutput(key, out string) {
	path := cachedOutputPath(key)
	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
		return
	}
	f, err := os.CreateTemp(filepath.Dir(path), key+".*")
	if err != nil {
		return
	}
	_, err = f.WriteString(out)
	if closeErr := f.Close(); err == nil {
		err = closeErr
	}
	if err != nil || os.Rename(f.Name(), path) != nil {
		os.Remove(f.Name())
	}
}

@~ Project@/litar@/Go@/functions@/litar.cachedOutputPath @~ Project@/litar@/Go@/functions@/litar.readCachedOutput @~ Project@/litar@/Go@/functions@/litar.writeCachedOutput @~ Project@/litar@/Go@/variables@/litar.filterCacheDir @
A run that writes to stderr is not kept, so its messages are not lost on later runs.
The count is read after the command is waited for, when its copying has finished.
@<cache@:litar@:Language@/Go@/File@/types@+
// countingWriter passes writes to w and counts the bytes written.
type countingWriter struct {
	w io.Writer
	n int
}

@~ Project@/litar@/Go@/types@/litar.countingWriter @

@<cache@:litar@:Language@/Go@/File@/methods@+
func (c *countingWriter) Write(p []byte) (int, error) {
	n, err := c.w.Write(p)
	c.n += n
	return n, err
}

@~ Project@/litar@/Go@/methods@/litar.countingWriter.Write @~ Project@/litar@/Go@/types@/litar.countingWriter @
A filter learns the cache directory from LITAR_CACHE, so the files it leaves for its output,
such as an interpreter its output names, live and go with the outputs kept there.
When the cache is off the variable is removed, so a filter never reads "off" as a directory.
@<cache@:litar@:Language@/Go@/File@/functions@+
// filterEnv is the environment of a filter process.
func filterEnv() []string {
	var env []string
	for _, kv := range os.Environ() {
		if !strings.HasPrefix(kv, "LITAR_CACHE=") {
			env = append(env, kv)
		}
	}
	if filterCacheDir != "" {
		env = append(env, "LITAR_CACHE="+filterCacheDir)
	}
	return env
}

@~ Project@/litar@/Go@/functions@/litar.filterEnv @~ Project@/litar@/Go@/variables@/litar.filterCacheDir @
@<filter@:litar@:Language@/Go@/File@/functions@=
func buildCatalog(chain []Block, mappings []Mapping) *catalog {
c := &catalog{
	files:     map[string]*catFile{},
	conflicts: map[string]bool{},
}
touch := func(path string) *catFile {
	f := c.files[path]
	if f == nil {
		f = &catFile{sets: map[string]struct{}{}}
		c.files[path] = f
		c.order = append(c.order, path)
	}
	return f
}
@<Project@/litar@/add the archive files of 'chain' to 'c'@>
@<Project@/litar@/add the 'mappings' to 'c', noting paths that are also archive files@>
return c
}

@~ Project@/litar@/Go@/functions@/litar.buildCatalog @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Mapping @~ Project@/litar@/Go@/types@/litar.catFile @~ Project@/litar@/Go@/types@/litar.catalog @

A later file block with the same path replaces the executable bit and adds its sets.
@<Project@/litar@/add the archive files of 'chain' to 'c'@=
for _, b := range chain {
	if !b.IsFile {
		continue
	}
	f := touch(string(b.Path))
	f.archive = true
	f.executable = b.Executable
	for _, set := range b.Sets {
		f.sets[string(set)] = struct{}{}
	}
}
@

A path that is both an archive file and a mapping is recorded as a conflict,
reported only when a view asks for the file.
A mapping whose path ends with a slash maps the directory origin, not a file.
@<Project@/litar@/add the 'mappings' to 'c', noting paths that are also archive files@=
for _, m := range mappings {
	path, dir := strings.CutSuffix(m.Path, "/")
	f := touch(path)
	if f.archive {
		c.conflicts[path] = true
	}
	f.mapping = true
	f.dir = dir
	f.origin = m.Origin
	for _, set := range m.FileSet {
		f.sets[set] = struct{}{}
	}
}
@
@<filter@:litar@:Language@/Go@/File@/functions@+
func validFilePath(p string) error {
	if p == "" || strings.HasPrefix(p, "/") || strings.Contains(p, "\x00") {
		return fmt.Errorf("invalid file path '%s'", p)
	}
	for _, c := range strings.Split(p, "/") {
		if c == "" || c == "." || c == ".." {
			return fmt.Errorf("invalid file path '%s'", p)
		}
	}
	return nil
}

@~ Project@/litar@/Go@/functions@/litar.validFilePath @
@<filter@:litar@:Language@/Go@/File@/functions@+
// parseShebang reads "#! interpreter" or "#! interpreter arg".
// As the kernel's script loader does, arg is the rest of the line,
// one argument without its surrounding blanks.
func parseShebang(script string) (interp, arg string, hasArg, ok bool) {
if len(script) < 2 || script[0] != '#' || script[1] != '!' {
	return "", "", false, false
}
i := 2
for i < len(script) && (script[i] == ' ' || script[i] == '\t') {
	i++
}
interp, i = shebangWord(script, i)
if interp == "" {
	return "", "", false, false
}
@<Project@/litar@/return 'interp' alone unless a word follows it at 'i'@>
end := strings.IndexByte(script[i:], '\n')
if end < 0 {
	end = len(script) - i
}
arg = strings.TrimRight(script[i:i+end], " \t\r")
return interp, arg, true, true
}

@~ Project@/litar@/Go@/functions@/litar.parseShebang @~ Project@/litar@/Go@/functions@/litar.shebangWord @

Blanks after the interpreter do not make an argument; only a word before the line end does.
@<Project@/litar@/return 'interp' alone unless a word follows it at 'i'@=
if i < len(script) && script[i] == '\r' {
	i++
}
if i >= len(script) || script[i] == '\n' {
	return interp, "", false, true
}
for i < len(script) && (script[i] == ' ' || script[i] == '\t') {
	i++
}
if i >= len(script) || script[i] == '\n' || script[i] == '\r' {
	return interp, "", false, true
}
@
@<filter@:litar@:Language@/Go@/File@/functions@+
// shebangWord returns the word of script at i, up to a blank or a line end,
// and the index after it.
func shebangWord(script string, i int) (string, int) {
	start := i
	for i < len(script) && script[i] != ' ' && script[i] != '\t' && script[i] != '\n' && script[i] != '\r' {
		i++
	}
	return stripCR(script[start:i]), i
}

@~ Project@/litar@/Go@/functions@/litar.shebangWord @~ Project@/litar@/Go@/functions@/litar.stripCR @
@<filter@:litar@:Language@/Go@/File@/functions@+
func stripCR(s string) string {
	if strings.HasSuffix(s, "\r") {
		return strings.TrimSuffix(s, "\r")
	}
	return s
}

@~ Project@/litar@/Go@/functions@/litar.stripCR @
A run is looked up in the filter cache once its view files are known,
before the script is written or the view mounted.
@<filter@:litar@:Language@/Go@/File@/functions@+
func executeFilter(ev *Evaluator, script, input string, ref ChunkRef, view []ViewOp) (string, error) {
interp, arg, hasArg, ok := parseShebang(script)
if !ok {
	return "", fmt.Errorf("filter '%s' has no shebang", ref.String())
}
files, err := ev.cat.apply(view)
if err != nil {
	return "", err
}
if err := ev.tangle(files); err != nil {
	return "", err
}
key, keyed := filterKey(script, input, files)
if keyed {
	if out, ok := readCachedOutput(key); ok {
		return out, nil
	}
}
