@<eval@:litar@:Go Structure@/methods@+
func (e *Evaluator) noteErr(err error) {
	e.mu.Lock()
	defer e.mu.Unlock()
	if e.fuseErr == nil && err != nil {
		e.fuseErr = err
	}
}

@~ Go@/methods@/litar.Evaluator.noteErr @~ Go@/types@/litar.Evaluator @

@<eval@:litar@:Go Structure@/methods@+
func (e *Evaluator) takeFuseErr() error {
	err := e.fuseErr
	e.fuseErr = nil
	return err
}

@~ Go@/methods@/litar.Evaluator.takeFuseErr @~ Go@/types@/litar.Evaluator @

@<eval@:litar@:Go Structure@/methods@+
// Eval evaluates a print expression. A missing chunk is an error.
// An empty chunk with a pipeline is the empty input of that pipeline.
func (e *Evaluator) Eval(ref ChunkRef, filters []Filter) (string, error) {
	e.mu.Lock()
	defer e.mu.Unlock()
	return e.evalLocked(ref, filters)
}

@~ Go@/methods@/litar.Evaluator.Eval @~ Go@/methods@/litar.Evaluator.evalLocked @~ Go@/types@/litar.ChunkRef @~ Go@/types@/litar.Evaluator @~ Go@/types@/litar.Filter @

@<eval@:litar@:Go Structure@/methods@+
func (e *Evaluator) evalLocked(ref ChunkRef, filters []Filter) (string, error) {
	var (
		text string
		err  error
	)
	if ref.Chunk == "" {
		text = ""
	} else {
		text, err = e.expandLocked(ref, true)
		if err != nil {
			return "", err
		}
	}
	if len(filters) == 0 {
		return text, nil
	}
	return e.runFiltersLocked(text, filters, ref)
}

@~ Go@/methods@/litar.Evaluator.evalLocked @~ Go@/methods@/litar.Evaluator.expandLocked @~ Go@/methods@/litar.Evaluator.runFiltersLocked @~ Go@/types@/litar.ChunkRef @~ Go@/types@/litar.Evaluator @~ Go@/types@/litar.Filter @

@<eval@:litar@:Go Structure@/methods@+
func (e *Evaluator) expandLocked(ref ChunkRef, missingErr bool) (string, error) {
	key := ref.key()
	for i, fr := range e.stack {
		if fr.key == key {
			chain := make([]ChunkRef, 0, len(e.stack)-i+1)
			for _, older := range e.stack[i:] {
				chain = append(chain, older.ref)
			}
			chain = append(chain, ref)
			return "", &cycleError{chain: chain}
		}
	}
	e.stack = append(e.stack, frame{key: key, ref: ref})
	defer func() { e.stack = e.stack[:len(e.stack)-1] }()

	var acc string
	matched := false
	for _, b := range e.chain {
		if !matchRef(b.Ref, ref) {
			continue
		}
		matched = true
		text, err := e.expandBlock(b, ref)
		if err != nil {
			return "", err
		}
		switch {
		case b.Op == OpSet:
			acc = text
		case b.EndsLine && acc != "":
			acc += "\n" + text
		default:
			acc += text
		}
	}
	if !matched {
		if missingErr {
			return "", fmt.Errorf("chunk '%s' is not defined", ref.String())
		}
		return "", nil
	}
	return acc, nil
}

@~ Go@/constants@/litar.OpSet @~ Go@/functions@/litar.matchRef @~ Go@/methods@/litar.ChunkRef.String @~ Go@/methods@/litar.ChunkRef.key @~ Go@/methods@/litar.Evaluator.expandBlock @~ Go@/methods@/litar.Evaluator.expandLocked @~ Go@/types@/litar.ChunkRef @~ Go@/types@/litar.Evaluator @~ Go@/types@/litar.cycleError @~ Go@/types@/litar.frame @

@<eval@:litar@:Go Structure@/methods@+
func (e *Evaluator) expandBlock(b Block, applied ChunkRef) (string, error) {
	var sb strings.Builder
	for _, part := range b.Parts {
		if part.Ref == nil {
			sb.WriteString(part.Text)
			continue
		}
		inner := resolveBody(part.Ref.ChunkRef, applied.Labels, b.Ref.Module)
		text, err := e.expandLocked(inner, false)
		if err != nil {
			return "", err
		}
		if len(part.Ref.Filters) > 0 {
			text, err = e.runFiltersLocked(text, part.Ref.Filters, inner)
			if err != nil {
				return "", err
			}
		}
		sb.WriteString(text)
	}
	text := sb.String()
	if len(b.Filters) > 0 {
		var err error
		text, err = e.runFiltersLocked(text, b.Filters, applied)
		if err != nil {
			return "", err
		}
	}
	return text, nil
}

@~ Go@/functions@/litar.resolveBody @~ Go@/methods@/litar.Evaluator.expandBlock @~ Go@/methods@/litar.Evaluator.expandLocked @~ Go@/methods@/litar.Evaluator.runFiltersLocked @~ Go@/types@/litar.Block @~ Go@/types@/litar.ChunkRef @~ Go@/types@/litar.Evaluator @

@<eval@:litar@:Go Structure@/functions@+
func resolveBody(ref ChunkRef, outerLabels []Name, header ModulePath) ChunkRef {
	labels := ref.Labels
	if len(labels) == 0 {
		labels = copyLabels(outerLabels)
	} else {
		labels = copyLabels(labels)
	}
	var mod ModulePath
	if hasRel(ref.Module) {
		mod = resolveModule(header, ref.Module)
	} else {
		mod = copyModule(ref.Module)
	}
	return ChunkRef{Labels: labels, Module: mod, Chunk: ref.Chunk}
}

@~ Go@/functions@/litar.copyLabels @~ Go@/functions@/litar.copyModule @~ Go@/functions@/litar.hasRel @~ Go@/functions@/litar.resolveBody @~ Go@/functions@/litar.resolveModule @~ Go@/types@/litar.ChunkRef @~ Go@/types@/litar.ModulePath @~ Go@/types@/litar.Name @

@<eval@:litar@:Go Structure@/functions@+
func resolveFilter(ref ChunkRef, outerLabels []Name) ChunkRef {
	labels := ref.Labels
	if len(labels) == 0 {
		labels = copyLabels(outerLabels)
	} else {
		labels = copyLabels(labels)
	}
	return ChunkRef{Labels: labels, Module: copyModule(ref.Module), Chunk: ref.Chunk}
}

@~ Go@/functions@/litar.copyLabels @~ Go@/functions@/litar.copyModule @~ Go@/functions@/litar.resolveFilter @~ Go@/types@/litar.ChunkRef @~ Go@/types@/litar.Name @

@<eval@:litar@:Go Structure@/methods@+
func (e *Evaluator) runFiltersLocked(text string, filters []Filter, attached ChunkRef) (string, error) {
	for _, f := range filters {
		resolved := resolveFilter(f.Ref, attached.Labels)
		script, err := e.expandLocked(resolved, true)
		if err != nil {
			return "", err
		}
		e.mu.Unlock()
		out, runErr := executeFilter(e, script, text, resolved, f.View)
		e.mu.Lock()
		if fuse := e.takeFuseErr(); fuse != nil {
			return "", fuse
		}
		if runErr != nil {
			return "", runErr
		}
		text = out
	}
	return text, nil
}

@~ Go@/functions@/litar.executeFilter @~ Go@/functions@/litar.resolveFilter @~ Go@/methods@/litar.Evaluator.expandLocked @~ Go@/methods@/litar.Evaluator.runFiltersLocked @~ Go@/methods@/litar.Evaluator.takeFuseErr @~ Go@/types@/litar.ChunkRef @~ Go@/types@/litar.Evaluator @~ Go@/types@/litar.Filter @

@<eval@:litar@:Go Structure@/methods@+
// readChunk evaluates a root-module file chunk on the current visit stack.
// Tangling calls it before the filter process starts, so the lock
// is not already held.
func (e *Evaluator) readChunk(chunk Name) ([]byte, error) {
	e.mu.Lock()
	defer e.mu.Unlock()
	text, err := e.expandLocked(ChunkRef{Chunk: chunk}, false)
	if err != nil {
		if e.fuseErr == nil {
			e.fuseErr = err
		}
		return nil, err
	}
	return []byte(text), nil
}

@~ Go@/methods@/litar.Evaluator.expandLocked @~ Go@/methods@/litar.Evaluator.readChunk @~ Go@/types@/litar.ChunkRef @~ Go@/types@/litar.Evaluator @~ Go@/types@/litar.Name @

