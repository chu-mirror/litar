The command litar-web serves a browser interface for compositions.
It runs litar -a and reads everything through that MCP server,
so the browser sees the same resources and tools as an agent,
and the command line of litar stays as the design defines it.
@[cmd/litar-web/main.go@`go module@=
@<litar-web@:command@:Language@/Go@/File@/file@>@

The page is embedded beside the program, so the command is one file to install.
@[cmd/litar-web/index.html@`go module@=
@<Project@/litar@/Web@/page@>

@

@<litar-web@:command@:Language@/Go@/File@/package comment@=
// Command litar-web serves a browser interface for litar compositions.
@

@<litar-web@:command@:Language@/Go@/File@/import paths@+
    "context"
    _ "embed"
    "encoding/json"
    "io"
    "net/http"
    "os/exec"
    "strings"

    "github.com/modelcontextprotocol/go-sdk/mcp"
@

@<litar-web@:command@:Language@/Go@/File@/variables@+
//go:embed index.html
var indexHTML []byte

@~ Project@/litar@/Go@/variables@/litar-web.indexHTML @

The browser may call only the tools that leave archives untouched:
importing reads a composition, and evaluating runs the filters it already holds.
@<litar-web@:command@:Language@/Go@/File@/variables@+
var readOnlyTools = map[string]bool{
	"import_composition":  true,
	"evaluate_expression": true,
}

@~ Project@/litar@/Go@/variables@/litar-web.readOnlyTools @

The stderr of litar passes through, so its errors reach the terminal of litar-web.
@<litar-web@:command@:Language@/Go@/File@/functions@+
func connect(litar, file string) (*mcp.ClientSession, error) {
	args := []string{"-a"}
	if file != "" {
		args = append(args, "-f", file)
	}
	cmd := exec.Command(litar, args...)
	cmd.Stderr = os.Stderr
	client := mcp.NewClient(&mcp.Implementation{Name: "litar-web", Version: "0.1.0"}, nil)
	return client.Connect(context.Background(), &mcp.CommandTransport{Command: cmd}, nil)
}

@~ Project@/litar@/Go@/functions@/litar-web.connect @

@<litar-web@:command@:Language@/Go@/File@/functions@+
func serveIndex(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.Write(indexHTML)
}

@~ Project@/litar@/Go@/functions@/litar-web.serveIndex @~ Project@/litar@/Go@/variables@/litar-web.indexHTML @

A resource keeps the MIME type litar gives it.
Text is sent as UTF-8; a blob, such as a binary file, is sent as its bytes.
@<litar-web@:command@:Language@/Go@/File@/functions@+
func resourceHandler(session *mcp.ClientSession) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		uri := r.URL.Query().Get("uri")
		res, err := session.ReadResource(r.Context(), &mcp.ReadResourceParams{URI: uri})
		if err != nil {
			http.Error(w, err.Error(), http.StatusBadRequest)
			return
		}
		if len(res.Contents) == 0 {
			http.Error(w, "resource '"+uri+"' is empty", http.StatusNotFound)
			return
		}
		c := res.Contents[0]
		mime := c.MIMEType
		if mime == "" {
			mime = "text/plain"
		}
		if c.Blob != nil {
			w.Header().Set("Content-Type", mime)
			w.Write(c.Blob)
			return
		}
		w.Header().Set("Content-Type", mime+"; charset=utf-8")
		io.WriteString(w, c.Text)
	}
}

@~ Project@/litar@/Go@/functions@/litar-web.resourceHandler @

A tool call must be application/json. A page of another site cannot send that
without a CORS preflight, which this server never grants.
A tool error comes back as 422 with the message litar wrote.
@<litar-web@:command@:Language@/Go@/File@/functions@+
func toolHandler(session *mcp.ClientSession) http.HandlerFunc {
return func(w http.ResponseWriter, r *http.Request) {
var call struct {
Name      string         `json:"name"`
Arguments map[string]any `json:"arguments"`
}
@<Project@/litar@/read into 'call' the JSON tool call of 'r', answering 'w' when it is refused@>
res, err := session.CallTool(r.Context(), &mcp.CallToolParams{Name: call.Name, Arguments: call.Arguments})
if err != nil {
http.Error(w, err.Error(), http.StatusBadGateway)
return
}
@<Project@/litar@/write to 'w' the text of the tool result 'res', as an error when it is one@>
}
}

@~ Project@/litar@/Go@/functions@/litar-web.toolHandler @

Only the read-only tools may be called from the page.
@<Project@/litar@/read into 'call' the JSON tool call of 'r', answering 'w' when it is refused@=
if r.Header.Get("Content-Type") != "application/json" {
http.Error(w, "the request must be application/json", http.StatusUnsupportedMediaType)
return
}
if err := json.NewDecoder(r.Body).Decode(&call); err != nil {
http.Error(w, err.Error(), http.StatusBadRequest)
return
}
if !readOnlyTools[call.Name] {
http.Error(w, "tool '"+call.Name+"' is not available", http.StatusForbidden)
return
}
@~ Project@/litar@/Go@/variables@/litar-web.readOnlyTools @

@<Project@/litar@/write to 'w' the text of the tool result 'res', as an error when it is one@=
var text strings.Builder
for _, c := range res.Content {
if t, ok := c.(*mcp.TextContent); ok {
text.WriteString(t.Text)
}
}
if res.IsError {
http.Error(w, text.String(), http.StatusUnprocessableEntity)
return
}
w.Header().Set("Content-Type", "text/plain; charset=utf-8")
io.WriteString(w, text.String())
@

The page is served at the root, resources and tools below /api.
@<litar-web@:command@:Language@/Go@/File@/main body@=
session, err := connect(command.flags.litar, command.flags.file)
if err != nil {
	fmt.Fprintln(os.Stderr, "litar-web:", err)
	os.Exit(1)
}
defer session.Close()
http.HandleFunc("GET /{$}", serveIndex)
http.HandleFunc("GET /api/resource", resourceHandler(session))
http.HandleFunc("POST /api/tool", toolHandler(session))
fmt.Fprintf(os.Stderr, "litar-web: serving on http://%s/\n", command.flags.addr)
if err := http.ListenAndServe(command.flags.addr, nil); err != nil {
	fmt.Fprintln(os.Stderr, "litar-web:", err)
	os.Exit(1)
}
@~ Project@/litar@/Go@/functions@/litar-web.connect @~ Project@/litar@/Go@/functions@/litar-web.serveIndex @~ Project@/litar@/Go@/functions@/litar-web.resourceHandler @~ Project@/litar@/Go@/functions@/litar-web.toolHandler @
