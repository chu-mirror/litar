// worldNode resolves a composition id and a node id.
// The caller holds a.mu.
func (a *agent) worldNode(composition, node int) (*World, *Node, error) {
	w, err := a.compositionByID(composition)
	if err != nil {
		return nil, nil, err
	}
	n, err := nodeByID(w, node)
	if err != nil {
		return nil, nil, err
	}
	return w, n, nil
}

