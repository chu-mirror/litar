The probe prints the stats of both files, after checking that reading and copying
change neither them nor the directory.
@<Project@/litar@/lines of the probe script in TestArchiveFileStatStable@=
"#!/bin/sh\n" +
	"fields='%i %s %f %h %X %Y %Z'\n" +
	@<.@/probe lines that stat the files around reads and a copy@>
	@<.@/probe lines that fail if a stat changed or hello.txt can be modified@>
	"echo \"$s1\"\n" +
	"echo \"$n1\"\n" +
@

@<Project@/litar@/probe lines that stat the files around reads and a copy@=
"s1=$(stat -c \"$fields\" hello.txt)\n" +
	"cat hello.txt >/dev/null\n" +
	"out=$(mktemp)\n" +
	"cp hello.txt \"$out\" || exit 1\n" +
	"cmp hello.txt \"$out\" || exit 1\n" +
	"rm -f \"$out\"\n" +
	"s2=$(stat -c \"$fields\" hello.txt)\n" +
	"d1=$(stat -c %i doc)\n" +
	"cat doc/note.txt >/dev/null\n" +
	"d2=$(stat -c %i doc)\n" +
	"n1=$(stat -c \"$fields\" doc/note.txt)\n" +
@

Both touch and chmod must fail, and the failed attempts must not change the stats either.
@<Project@/litar@/probe lines that fail if a stat changed or hello.txt can be modified@=
"if [ \"$s1\" != \"$s2\" ] || [ \"$d1\" != \"$d2\" ]; then\n" +
	"  echo \"changed $s1 $s2 $d1 $d2\"\n" +
	"  exit 1\n" +
	"fi\n" +
	"if touch hello.txt || chmod 644 hello.txt; then\n" +
	"  echo mutable\n" +
	"  exit 1\n" +
	"fi\n" +
	"s3=$(stat -c \"$fields\" hello.txt)\n" +
	"if [ \"$s1\" != \"$s3\" ]; then\n" +
	"  echo \"meta $s1 $s3\"\n" +
	"  exit 1\n" +
	"fi\n" +
@

Each file has its own inode, one link, the size of its content, and zero times.
@<Project@/litar@/check the stats of hello.txt and doc/note.txt printed in 'got'@=
lines := strings.Split(strings.TrimSpace(got), "\n")
if len(lines) != 2 {
	t.Fatalf("%q", got)
}
hello := strings.Fields(lines[0])
note := strings.Fields(lines[1])
// ino, size, mode, nlink, atime, mtime, ctime
if len(hello) != 7 || len(note) != 7 {
	t.Fatalf("%q", got)
}
if hello[0] == note[0] || hello[0] == "0" {
	t.Fatalf("inode %q", got)
}
if hello[1] != "11" || note[1] != "4" {
	t.Fatalf("size %q", got)
}
if hello[3] != "1" || note[3] != "1" {
	t.Fatalf("nlink %q", got)
}
if hello[4] != "0" || hello[5] != "0" || hello[6] != "0" {
	t.Fatalf("time %q", got)
}
@

