@. lib/c-structure.la @

@<summary@=
A classic example at the beginning of learning programming.

`hello.c` is the source file.
@

@<hello.c@=
@<hello@:executable@:C Structure@/module@>
@

@<hello@:C Structure@/invocation syntax@=
{
    name => 'hello',
    usages => [
        {
            name => 'run',
            options => [],
            arguments => [],
        },
    ],
}
@

@<hello@:C Structure@/main body@=
printf("Hello World!\n");
@

