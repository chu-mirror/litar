@[show.c@=
@<show@:light@:C Module@/C executable@>
@

@<show@:light@:C Module@/C module properties@=
name => "show",
@

@<show@:light@:C Module@/include paths@=
Light
@

@<show@:light@:C Module@/includes@=
#include <stdio.h>
#include <assert.h>
#include <stdbool.h>
#include "context.h"
#include "list.h"
#include "function.h"
@

@<show@:Light@/main body@=
printf("Testing light\n");
@<show cases@>
printf("All test passed\n");
@

@<show cases@=
do {
    int arr[6] = {1, 2, 3, 4, 5, 6};
    List l1, l2, l3, l4;

    @<show cases for list@>
} while (0);
@

@<show cases for list@=
UNDER_CONTEXT( /* test |push| and |pop| */
    int *n;
    l1 = _LIST(arr, 3);
    RENAME(pop(&l1), n);
    assert(*n == 1);
    RENAME(car(l1), n);
    assert(*n == 2);
    assert(length(l1) == 2);
    push(&arr[0], &l1);
    RENAME(car(l1), n);
    assert(*n == 1);
    assert(length(l1) == 3);
);

UNDER_CONTEXT( /* test |reverse| */
    l1 = _LIST(arr, 6);
    reverse(&l1);

    do {
	int i, *np;

	i = 0;
	FOREACH (np, l1) {
	    assert(*np == 6 - i);
	    ++i;
	}
    } while (0);
);

UNDER_CONTEXT( /* test |append| */
    l1 = _LIST(arr, 3);
    assert(length(l1) == 3);

    l2 = _LIST(arr + 3, 3);
    assert(length(l2) == 3);

    l3 = append(&l1, &l2);
    assert(length(l3) == 6);

    do { /* ensure that |l3| has correct elements */
	int i, *np;

	i = 1;
	FOREACH (np, l3) {
	    assert(*np == i);
	    ++i;
	}
    } while (0);
);

UNDER_CONTEXT( /* test |copy_list| */
    l1 = _LIST(arr, 6);
    l2 = copy_list(l1);
    assert(length(l1) == length(l2));

    List _l2 = l2;
    int *elm;
    FOREACH (elm, l1) {
	assert(elm == car(_l2));
	_l2 = cdr(_l2);
    }
);
@

@<show@:light@:C Module@/function declarations@=
DECLARE_FUNCTION(bigger_than, int *a; int *b;);
DEFINE_FUNCTION(bigger_than,
    int res, *ret;
    res = *args->a > *args->b;
    MOVE(&res, ret);
    return ret;
)
@

@<show cases@=
UNDER_CONTEXT (
    Function bigger_than_3;
    int n = 3, n1 = 1, n2 = 2, n3 = 3, n4 = 4;

    bigger_than_3= FUNCTION(bigger_than);
    shift_arguments(bigger_than_3, 1);
    fill_argument(bigger_than_3, &n);

    int *res;
    RENAME(invoke(bigger_than_3, cons(&n1, empty_list)), res);
    assert(!*res);
    RENAME(invoke(bigger_than_3, cons(&n2, empty_list)), res);
    assert(!*res);
    RENAME(invoke(bigger_than_3, cons(&n3, empty_list)), res);
    assert(!*res);
    RENAME(invoke(bigger_than_3, cons(&n4, empty_list)), res);
    assert(*res);
);
@

@<show cases for list (debug)@=

do { /* test |map| */
    int i, *np;

    map(inc, l3);

    i = 0;
    FOREACH (np, l3) {
	assert(*np == i + 2);
	assert(arr[i] == i + 2);
	++i;
    }
} while (0);

do { /* test |remove_all| */
    int i, *np;
    remove_all(less_than_4, &l3);
    assert(length(l3) == 4);

    i = 0;
    FOREACH (np, l3) {
	assert(*np == i + 4);
	++i;
    }
} while (0);

do { /* test |remove_first| */
    int i, *np;
    push(&arr[0], &l3);
    assert(remove_first(less_than_4, &l3) == &arr[0]);
    assert(length(l3) == 4);

    i = 0;
    FOREACH (np, l3) {
	assert(*np == i + 4);
	++i;
    }
} while (0);
@

@. lib/light.la
