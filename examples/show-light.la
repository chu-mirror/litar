@[show.c@=
@<show@:light@:C Module@/C executable@>
@

@<show@:light@:C Module@/C module properties@=
name => "show",
@

@<show@:light@:C Module@/include paths@=
Light
@

@<show@:light@:C Module@/includes@=
#include <stdio.h>
#include <assert.h>
#include <stdbool.h>
#include <setjmp.h>
#include "context.h"
#include "list.h"
#include "function.h"
#include "higher.h"
#include "array.h"
#include "str.h"
#include "hashtable.h"
#include "atom.h"
@

@<show@:Light@/main body@=
printf("Testing light\n");
@<show cases@>
printf("All test passed\n");
@

@<show cases@=
UNDER(
    jmp_buf jump_buffer;
    if (setjmp(jump_buffer) == 0) {
        UNDER(
	    int *n;
	    NEW(n);
	    ESCAPE(
	        UNDER(
		    longjmp(jump_buffer, 1);
		);
	    );
	);
    }
    printf("Passed setjmp\n");
);
@

@<show cases@=
do {
    int arr[6] = {1, 2, 3, 4, 5, 6};
    List l1, l2, l3, l4;

    @<show cases for list@>
} while (0);
@

@<show cases for list@=
UNDER( /* test |push| and |pop| */
    int *n;
    l1 = _LIST(arr, 3);
    RENAME(pop(&l1), n);
    assert(*n == 1);
    RENAME(car(l1), n);
    assert(*n == 2);
    assert(length(l1) == 2);
    push(&arr[0], &l1);
    RENAME(car(l1), n);
    assert(*n == 1);
    assert(length(l1) == 3);
    printf("Passed push and pop\n");
);

UNDER( /* test |reverse| */
    l1 = LIST(arr);
    reverse(&l1);

    do {
	int i, *np;

	i = 0;
	FOREACH (np, l1) {
	    assert(*np == 6 - i);
	    ++i;
	}
    } while (0);
    printf("Passed reverse\n");
);

UNDER( /* test |append| */
    l1 = _LIST(arr, 3);
    assert(length(l1) == 3);

    l2 = _LIST(arr + 3, 3);
    assert(length(l2) == 3);

    l3 = append(&l1, &l2);
    assert(length(l3) == 6);

    do { /* ensure that |l3| has correct elements */
	int i, *np;

	i = 1;
	FOREACH (np, l3) {
	    assert(*np == i);
	    ++i;
	}
    } while (0);
    printf("Passed reverse\n");
);

UNDER( /* test |copy_list| */
    l1 = _LIST(arr, 6);
    l2 = copy_list(l1);
    assert(length(l1) == length(l2));

    List _l2 = l2;
    int *elm;
    FOREACH (elm, l1) {
	assert(elm == car(_l2));
	_l2 = cdr(_l2);
    }
    printf("Passed copy_list\n");
);
@

@<show@:light@:C Module@/static inline functions@=
DECLARE_FUNCTION(bigger_than, int *a; int *b;);
DEFINE_FUNCTION(bigger_than,
    int res, *ret;
    res = *args->a > *args->b;
    MOVE(&res, ret);
    return ret;
)
@

@<show cases@=
UNDER(
    Function bigger_than_3;

    int n = 3, n1 = 1, n2 = 2, n3 = 3, n4 = 4;

    bigger_than_3= FUNCTION(bigger_than);
    shift_arguments(bigger_than_3, 1);
    fill_argument(bigger_than_3, &n);

    int *res;
    RENAME(invoke(bigger_than_3, cons(&n1, empty_list)), res);
    assert(!*res);
    RENAME(invoke(bigger_than_3, cons(&n2, empty_list)), res);
    assert(!*res);
    RENAME(invoke(bigger_than_3, cons(&n3, empty_list)), res);
    assert(!*res);
    RENAME(invoke(bigger_than_3, cons(&n4, empty_list)), res);
    assert(*res);
    printf("Passed bigger_than_3\n");
);
@

@<show cases for list@=
UNDER( /* test |map| */
    Function bigger_than_3;

    int n = 3;
    bigger_than_3= FUNCTION(bigger_than);
    shift_arguments(bigger_than_3, 1);
    fill_argument(bigger_than_3, &n);

    l1 = LIST(arr);
    l2 = map(bigger_than_3, l1);

    int i, *np;
    i = 1;
    FOREACH (np, l2) {
        if (i > 3) {
	    assert(*np);
	} else {
	    assert(!*np);
	}
	++i;
    }
    printf("Passed map\n");
);

UNDER( /* test |find_first| */
    Function bigger_than_3;

    int n = 3;
    bigger_than_3= FUNCTION(bigger_than);
    shift_arguments(bigger_than_3, 1);
    fill_argument(bigger_than_3, &n);

    l1 = LIST(arr);

    int *res;
    RENAME(find_first(bigger_than_3, l1), res);
    assert(*res == 4);
    printf("Passed find_first\n");
);

UNDER( /* test |filter| */
    Function bigger_than_3;

    int n = 3;
    bigger_than_3= FUNCTION(bigger_than);
    shift_arguments(bigger_than_3, 1);
    fill_argument(bigger_than_3, &n);

    l1 = LIST(arr);
    l2 = filter(bigger_than_3, l1);
    assert(length(l2) == 3);

    int i, *np;
    i = 4;
    FOREACH (np, l2) {
        assert(i == *np);
	++i;
    }
    printf("Passed filter\n");
);

UNDER( /* test |remove_first| */
    Function bigger_than_3;

    int n = 3;
    bigger_than_3= FUNCTION(bigger_than);
    shift_arguments(bigger_than_3, 1);
    fill_argument(bigger_than_3, &n);

    int *n_;
    l1 = LIST(arr);
    RENAME(remove_first(bigger_than_3, &l1), n_);
    assert(*n_ == 4);
    assert(length(l1) == 5);

    int i, *np;
    i = 1;
    FOREACH (np, l1) {
        assert(i == *np);
	++i;
	if (i == 4) ++i;
    }
    printf("Passed remove_first\n");
);

UNDER(
    Array arr;
    int *n;
    arr = new_array();

    *nth(arr, 0) = VALUE((int8_t)-1);
    assert(*nth(arr, 0) == VALUE(-1));

    *nth(arr, 1) = VALUE(1);
    RENAME(nth(arr, 1), n);
    ++(*n);
    assert(*nth(arr, 1) == VALUE(2));

    *nth(arr, 2000) = VALUE(1);
    RENAME(nth(arr, 2000), n);
    ++(*n);
    assert(*nth(arr, 2000) == VALUE(2));

    for (int i = 2; i < 2000; ++i) {
	assert(*nth(arr, i) == VALUE(0));
    }
    printf("Passed array\n");
);

UNDER(
    Deque q;
    void *elm;

    q = new_deque();
    assert(is_empty_deque(q));

    push_back(q, VALUE(1));
    assert(*nth_of_deque(q, 0) == VALUE(1));
    assert(!is_empty_deque(q));

    elm = pop_back(q);
    assert(elm == VALUE(1));
    assert(is_empty_deque(q));

    int i;
    for (i = 0; i < 100; ++i) {
	push_back(q, VALUE(i));
    }
    for (i = 0; i < 100; ++i) {
	push_front(q, VALUE(i));
    }
    for (i = 0; i < 100; ++i) {
	elm = pop_front(q);
	assert(elm == VALUE(99 - i));
    }
    for (i = 0; i < 100; ++i) {
	elm = pop_front(q);
	assert(elm == VALUE(i));
    }
    assert(is_empty_deque(q));
    printf("Passed deque\n");
);

UNDER(
    Str str = new_str();
    for (int i = 0; i < 10; ++i) {
	static char num[2];
	num[0] = '0';
	num[0] += i;
	str_extend(str, num);
    }
    assert(strcmp(raw_string(str), "0123456789") == 0);
    assert(str_length(str) == 10);

    str = new_str();
    for (int i = 0; i < 10; ++i) {
	str_extend(str, "Hello");
    }
    assert(str_length(str) == 10 * strlen("Hello"));
    printf("Passed str\n");
);

UNDER(
    HashTable tbl = NULL;
    tbl = new_string_hash_table(10);

    put_to_hash_table(tbl, "Chu", "Hello");
    put_to_hash_table(tbl, "Mzz", "Welcome");
    assert(strcmp((char *)get_from_hash_table(tbl, "Chu"), "Hello") == 0);
    assert(
	strcmp((char *)get_from_hash_table(tbl, "Mzz"), "Welcome") == 0
    );

    put_to_hash_table(tbl, "Chu", "Welcome");
    assert(
	strcmp((char *)get_from_hash_table(tbl, "Chu"), "Welcome") == 0
    );

    remove_from_hash_table(tbl, "Chu");
    assert(get_from_hash_table(tbl, "Chu") == NULL);
    printf("Passed hashtable\n");
);

UNDER(
    char *str1 = NULL, *str2 = NULL;
    CALLOC(str1, 10);
    CALLOC(str2, 10);
    strcpy(str1, "Hello");
    strcpy(str2, "Hello");
    assert(str1 != str2);

    const char *a1, *a2;
    size_t c;

    a1 = atom_str(str1);
    a2 = atom_str(str2);

    assert(a1 == a2);
    assert(strcmp(a1, "Hello") == 0);
    printf("Passed atom\n");
);
@

@. lib/light.la
