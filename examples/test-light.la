@[test-light.c@=
@<test light@:C Structure@/executable@>
@

@<test light@:C Structure@/includes@=
#include <stdio.h>
#include <assert.h>
#include <unistd.h>
#include "_light.h"
@

@<test light@:C Structure@/main body@=
printf("Testing light\n");
@<test cases@>
printf("All test passed\n");
@

@<test light@:C Structure@/macros@=
#define test_case_context_size (1 << 23)
@

@<test light@:C Structure@/global variables@=
CONTEXT(test_case, NULL, test_case_context_size)
@

@<test cases@=
do {
    enter_context(test_case);
    assert(remaining_memory() == test_case_context_size - sizeof(void *));
    char (*buf)[100];
    NEW(buf);
    assert(remaining_memory() == test_case_context_size - sizeof(void *) - 100);
    do {
        enter_frame();
        assert(remaining_memory() == test_case_context_size - 2 * sizeof(void *) - 100);
        char (*buf)[100];
        NEW(buf);
        assert(remaining_memory() == test_case_context_size - 2 * sizeof(void *) - 2 * 100);
        exit_frame();
    } while (0);
    assert(remaining_memory() == test_case_context_size - sizeof(void *) - 100);
    printf("Passed basic memory management\n");
    exit_context(test_case);
} while (0);
@

@<test cases@=
do {
    int i;
    enter_context(test_case);
#define HEAP_SIZE 100000
    Heap hp = new_heap(HEAP_SIZE, 10);
    assert(hp);
    uint8_t *(*arr)[HEAP_SIZE];
    NEW(arr);
    assert(arr);
    for (i = 0; i < HEAP_SIZE; ++i) {
        (*arr)[i] = heap_alloc(hp);
        if (i > 0) {
            assert((*arr)[i]-(*arr)[i-1] == 10);
        }
    }
    for (i = 0; i < HEAP_SIZE/2; ++i) {
        heap_free(hp, (*arr)[i*2]);
    }
    for (i = 0; i < HEAP_SIZE/2; ++i) {
        assert((*arr)[i*2] == heap_alloc(hp));
    }
    for (i = 0; i < HEAP_SIZE/3; ++i) {
        heap_free(hp, (*arr)[i*3]);
    }
    for (i = 0; i < HEAP_SIZE/3; ++i) {
        assert((*arr)[i*3] == heap_alloc(hp));
    }
    assert(heap_alloc(hp) == NULL);
    printf("Passed heap\n");
#undef HEAP_SIZE
    exit_context(test_case);
} while (0);
@

@<test cases@=
do {
    enter_context(test_case);
#define LIST_SIZE 200000
    int i;
    struct {
        int n;
        struct list list_header;
    } *nd_r, *l;
    l = NULL;
    for (i = 0; i < LIST_SIZE; ++i) {
        NEW(nd_r);
        assert(nd_r != NULL);
        nd_r->n = i;
        l = cons(nd_r, l);
    }
    assert(length(l) == LIST_SIZE);
    i = LIST_SIZE;
    while (l) {
        assert(l->n == i-1);
        l = cdr(l);
        --i;
    }
    assert(i == 0);
    printf("Passed list\n");
#undef LIST_SIZE
    exit_context(test_case);
} while (0);
@

@<test cases@=
do {
    enter_context(test_case);
    Heap hp = new_heap(100, SEGMENT_SIZE(int elm[100]));
    Segmented sg = new_segmented(hp);
    for (int i = 0; i < 2000; ++i) {
        int arr[5] = {0, 1, 2, 3, 4};
        segmented_append(sg, arr, sizeof(arr));
    }
    SegmentedRandom sgr = segmented_random(sg);
    for (int i = 0; i < 2000 * 5 * sizeof(int); i += sizeof(int)) {
        assert(*(int *)segmented_pointer(sgr, i) == (i / sizeof(int)) % 5);
    }
    int *arr_total = segmented_continuous(sg);
    for (int i = 0; i < 2000 * 5; ++i) {
        assert(arr_total[i] == i % 5);
    }

    printf("Passed segmented\n");
    exit_context(test_case);
} while (0);
@

@. lib/_light.la
