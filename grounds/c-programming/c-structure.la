@<executable@:C Structure@/global variables@+
struct {
    enum {@<.@/Invoke@/usage enumeration@>} usage;
    struct {@<.@/Invoke@/command line options@>} options;
    struct {@<.@/Invoke@/command line arguments@>} arguments;
} command;
@
@<executable@:C Structure@/includes@+
#include <getopt.h>
@
@<executable@:C Structure@/global variables@+
const struct option long_options[] = {
    @<.@/Invoke@/getopt long options@>
};
@
@<executable@:C Structure@/includes@+
#include <unistd.h>
#include <stdlib.h>
#include <stdio.h>
@
@<executable@:C Structure@/functions@+
int main(int argc, char *argv[])
{
    @<.@/Invoke@/parse command line arguments@>
    int ret = 0;
    @<.@/main body@>
    return ret;
}
@
@<C Structure@/Invoke@/parse command line arguments@=
do {
    int opt, idx;
    while ((opt = getopt_long(argc, argv, "@<.@/getopt string@>", long_options, &idx)) != -1) {
        switch (opt) {
        case 0:
            @<.@/handle long option of index "idx"@>
            break;
        @<.@/cases for short options@>
        case '?':
            break;
        default:
            fprintf(stderr, "getopt return unexpected value %d", opt);
            exit(1);
        }
    }
    @<.@/choose usage and store arguments@>
} while (0);
@
@<C Structure@/Filters@/wrap with included flag@=
@<Text Processing@/basic python settings@>


class ModuleMeta(pydantic.BaseModel):
    model_config = pydantic.ConfigDict(extra='allow')
    name: str
    included_flag_format: str


meta = configuration(ModuleMeta, r'''
@<..@/module meta information@>
''')
flag = meta.included_flag_format % meta.name.upper()
sys.stdout.write(f'#ifndef {flag}\n#define {flag}\n')
sys.stdout.write(sys.stdin.read())
sys.stdout.write('#endif\n')
@
The module meta information is a Jsonnet object.
The module properties are the fields of a second object, which override these defaults;
Jsonnet rejects a field given twice in the module properties.
@<C Structure@/module meta information@=
{
    name: 'default',
    included_flag_format: '_MODULE_%s',
} + {
    @<.@/module properties@>
}
@
@<C Structure@/Invoke@/command line usage@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>


def option_to_str(opt):
    text = f'-{opt.opt}' if opt.opt else f'--{opt.long_opt}'
    if opt.argument:
        text += f' {opt.argument}'.upper()
    return f'[{text}]'


def usage_to_str(usage):
    options = ' '.join(option_to_str(opt) for opt in usage.options if not opt.hide)
    return f'{syntax.name} {options} ' + ' '.join(usage.arguments).upper()


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print(r'Usage:\t' + r'\n\t'.join(map(usage_to_str, syntax.usages)) + r'\n', end='')
@|Basic@/evaluate@
@<C Structure@/Invoke@/manpage synopsis@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>


def option_to_str(opt):
    text = rf'\fB\-{opt.opt}\fR' if opt.opt else rf'\fB\-\-{opt.long_opt}\fR'
    if opt.argument:
        text += rf' \fI{opt.argument}\fR'
    return text


def usage_to_str(usage):
    options = '|'.join(option_to_str(opt) for opt in usage.options if not opt.hide)
    arguments = ' '.join(rf'\fI{arg}\fR' for arg in usage.arguments)
    return f'.B {syntax.name}\n[{options}]\n{arguments}\n'


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print('\n'.join(map(usage_to_str, syntax.usages)), end='')
@|Basic@/evaluate@
@<C Structure@/Invoke@/manpage options@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>
syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')

text = ''
for opt in all_options(syntax):
    text += '.TP\n'
    if opt.opt:
        text += rf'.BR \-{opt.opt}, " " '
    text += rf'\-\-{opt.long_opt}'
    if opt.argument:
        text += rf' " " \fI{opt.argument}\fR'
    text += f'\n{opt.description}\n'
print(text, end='')
@|Basic@/evaluate@
@<C Structure@/Invoke@/usage enumeration@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>
syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print(','.join(map(enum_constant, syntax.usages)), end='')
@|Basic@/evaluate@
@<C Structure@/Invoke@/command line options@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>
syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print('\n'.join(('const char *' if opt.argument else 'int ') + option_field(opt) + ';'
                for opt in all_options(syntax)), end='')
@|Basic@/evaluate@
An argument shared by several usages is declared once, where it first appears.
@<C Structure@/Invoke@/command line arguments@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>
syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
arguments = dict.fromkeys(arg for usage in syntax.usages for arg in usage.arguments)
print(''.join(f'const char *{argument_field(arg)};' for arg in arguments), end='')
@|Basic@/evaluate@
@<C Structure@/Invoke@/getopt string@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>
syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print(''.join(opt.opt + (':' if opt.argument else '')
              for opt in all_options(syntax) if opt.opt), end='')
@|Basic@/evaluate@
@<C Structure@/Invoke@/cases for short options@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>


def short_opt_case(opt):
    if not opt.opt:
        return ''
    value = 'optarg' if opt.argument else '1'
    return f'''
            case '{opt.opt}':
                command.options.{option_field(opt)} = {value};
                break;
        '''


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print(''.join(map(short_opt_case, all_options(syntax))), end='')
@|Basic@/evaluate@
@<C Structure@/Invoke@/choose usage and store arguments@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>


def look_option_of_usage(opt, usage):
    constant = enum_constant(usage)
    short_opt = f' -{opt.opt}' if opt.opt else ''
    return f'''
        if (command.options.{option_field(opt)}) {{
            if (!found_usage) {{
                found_usage = 1;
                command.usage = {constant};
            }} else if (command.usage != {constant}) {{
                fprintf(stderr, "Conflict option: --{opt.long_opt}{short_opt}\\n");
                exit(1);
            }}
        }}
    '''


def look_usage_argument_number(usage):
    return f'''
        if (!found_usage && argc - optind == {len(usage.arguments)}) {{
            found_usage = 1;
            command.usage = {enum_constant(usage)};
        }}
    '''


def store_arguments_for_usage(usage):
    store = ''.join(f'command.arguments.{argument_field(arg)} = argv[optind + {idx}];'
                    for idx, arg in enumerate(usage.arguments))
    return f'''
        case {enum_constant(usage)}:
            if (argc - optind != {len(usage.arguments)}) {{
                fprintf(stderr, "Unmatched argument number, see --help for usage\\n");
                exit(1);
            }}
            {store}
            break;
    '''


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
text = 'do { int found_usage = 0;'
text += ''.join(look_option_of_usage(opt, usage)
                for usage in syntax.usages for opt in usage.options)
text += '\n'.join(map(look_usage_argument_number, syntax.usages))
text += '''
    if (!found_usage) {
        fprintf(stderr, "Invalid usage, see --help for usage\\n");
        exit(1);
    }
'''
text += 'switch (command.usage) {'
text += '\n'.join(map(store_arguments_for_usage, syntax.usages))
text += '}} while (0);'
print(text, end='')
@|Basic@/evaluate@
getopt_long finds the end of the options at an entry of zeros.
@<C Structure@/Invoke@/getopt long options@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>


def option_to_longopt(opt):
    has_arg = 'required_argument' if opt.argument else 'no_argument'
    val = f"'{opt.opt}'" if opt.opt else '0'
    return f'{{"{opt.long_opt}",{has_arg},NULL,{val}}},'


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print(''.join(map(option_to_longopt, all_options(syntax))) + '{0,0,0,0},', end='')
@|Basic@/evaluate@
@<C Structure@/Invoke@/handle long option of index "idx"@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>


def long_option_handling(opt):
    if opt.opt:
        return ''
    value = 'optarg' if opt.argument else '1'
    return f'''
            if (strcmp(long_options[idx].name, "{opt.long_opt}") == 0) {{
                command.options.{option_field(opt)} = {value};
            }}
        '''


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print(''.join(map(long_option_handling, all_options(syntax))), end='')
@|Basic@/evaluate@
The generators include this chunk as one fragment.
Its models validate the invocation syntax before any generator writes C,
so a misspelled key or a missing name fails the evaluation.
@<C Structure@/Invoke@/invocation syntax helpers@=
class Option(pydantic.BaseModel):
    model_config = pydantic.ConfigDict(extra='forbid')
    long_opt: str
    opt: str | None = pydantic.Field(None, pattern=r'^[0-9A-Za-z]$')
    argument: str | None = None
    description: str = ''
    hide: bool = False


class Usage(pydantic.BaseModel):
    model_config = pydantic.ConfigDict(extra='forbid')
    name: str
    options: list[Option] = []
    arguments: list[str] = []


class InvocationSyntax(pydantic.BaseModel):
    model_config = pydantic.ConfigDict(extra='forbid')
    name: str
    usages: list[Usage] = pydantic.Field(min_length=1)
@
Every generator names a field with these functions, so they agree on each field.
@<C Structure@/Invoke@/invocation syntax helpers@+
def all_options(syntax):
    return [opt for usage in syntax.usages for opt in usage.options]


def enum_constant(usage):
    return 'COMMAND_USAGE_' + usage.name.replace(' ', '_').upper()


def option_field(opt):
    return opt.long_opt.replace('-', '_').lower()


def argument_field(arg):
    return arg.replace(' ', '_').lower()
@
The invocation syntax is a Jsonnet object:

{
    name: COMMAND_NAME,
    usages: [
        {
            name: USAGE_NAME,
            options: [
                {
                    long_opt: LONG_OPTION,
                    opt: SHORT_OPTION (optional),
                    argument: OPTION_ARGUMENT (optional),
                    description: DESCRIPTION,
                    hide: HIDDEN_FROM_USAGE (optional),
                },
                ...
            ],
            arguments: [
                ARGUMENT,
                ...
            ],
        },
        ...
    ],
}

A short option is one letter or digit, and a command has at least one usage.

@<C Structure@/Invoke@/invocation syntax@=
{}
@
