@<Chunk@/Basic@=
{
    "description": "Some common structures and filters."
}
@

Executes the input as a script, the input must have a shebang,
use the output of that script as the output.

@<Basic@/evaluate@=#!/bin/sh
set -e
temp_file=`mktemp`
cat - > $temp_file
chmod +x $temp_file
$temp_file
rm $temp_file
@
@<Chunk@/Text Processing@=
{
    "description": "Text processing based on python."
}
@
@<Text Processing@/remove newlines@=
@<.@/basic python settings@>
lines = sys.stdin.buffer.read().split(b'\n')
if lines[-1] == b'':
    lines.pop()
sys.stdout.buffer.write(b' '.join(lines))
@
Strip every newline at the end of the input, so the text joins the line after its reference.
Carriage returns of CRLF endings are stripped too; other trailing whitespace is kept.

@<Text Processing@/remove ending newlines@=
@<.@/basic python settings@>
sys.stdout.buffer.write(sys.stdin.buffer.read().rstrip(b'\r\n'))
@
@<Chunk@/Invocation@=
{
    "description": "Command line syntax shared by the structures of every language."
}
@
The usage lines list every usage of the command, one per line, after "Usage: ".
@<Invocation@/command line usage@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>


def usage_line(usage):
    words = [syntax.name]
    words += [f'[{option_with_value(opt)}]' for opt in usage.options if not opt.hide]
    words += map(placeholder, usage.arguments)
    return ' '.join(words)


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print('Usage: ' + '\n       '.join(map(usage_line, syntax.usages)))
@|Basic@/evaluate@
The manpage synopsis shows the usage lines in roff, one paragraph line per usage.
@<Invocation@/manpage synopsis@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>
@<.@/Internals@/manpage helpers@>


def usage_lines(usage):
    lines = [f'.B {roff(syntax.name)}']
    lines += [f'[{bold_option(opt)}]' for opt in usage.options if not opt.hide]
    lines += [italic(placeholder(arg)) for arg in usage.arguments]
    return lines


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print('\n.br\n'.join('\n'.join(usage_lines(usage)) for usage in syntax.usages))
@|Basic@/evaluate@
The manpage options describe every option in a tagged paragraph, hidden ones included.
@<Invocation@/manpage options@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>
@<.@/Internals@/manpage helpers@>


def option_entry(opt):
    value = '' if opt.type == 'bool' else ' ' + italic(metavar(opt))
    tag = ', '.join(rf'\fB{roff(name)}\fR' for name in option_names(opt)) + value
    return f'.TP\n{tag}\n{roff(opt.description)}\n'


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print(''.join(map(option_entry, all_options(syntax))), end='')
@|Basic@/evaluate@
roff escapes a backslash as \e and a hyphen as \-,
so option names render with minus signs that can be copied into a shell.
@<Invocation@/Internals@/manpage helpers@=
def roff(text):
    return text.replace('\\', r'\e').replace('-', r'\-')


def italic(text):
    return rf'\fI{roff(text)}\fR'


def bold_option(opt):
    text = rf'\fB{roff(option_name(opt))}\fR'
    return text if opt.type == 'bool' else text + ' ' + italic(metavar(opt))
@
The option summary describes every option on one line:
its names, the value it takes, its description, then its default unless that is empty, false, or zero.
@<Invocation@/option summary@=
@<Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>


def default_note(opt):
    if opt.default in (None, '', False, 0):
        return ''
    if opt.type == 'string':
        return ' (default "' + opt.default + '")'
    return ' (default ' + ('true' if opt.default is True else str(opt.default)) + ')'


def summary_line(opt):
    value = '' if opt.type == 'bool' else f' {metavar(opt)}'
    return ', '.join(option_names(opt)) + value + f': {opt.description}' + default_note(opt) + '\n'


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print(''.join(map(summary_line, all_options(syntax))), end='')
@|Basic@/evaluate@
The structures include this chunk in their generators,
so every generator validates the invocation syntax the same way.
A short name is one letter or digit.
@<Invocation@/invocation syntax helpers@=
class Option(pydantic.BaseModel):
    model_config = pydantic.ConfigDict(extra='forbid')
    name: str = pydantic.Field(pattern=r'^[A-Za-z0-9][A-Za-z0-9_-]*$')
    short: str | None = pydantic.Field(None, pattern=r'^[0-9A-Za-z]$')
    type: Literal['bool', 'string', 'int', 'int64', 'uint', 'uint64', 'float64'] = 'bool'
    argument: str | None = None
    default: bool | int | float | str | None = None
    description: str = ''
    hide: bool = False

    @pydantic.model_validator(mode='after')
    def check_default(self):
        value = self.default
        if value is None:
            return self
        if self.type == 'bool':
            suits = isinstance(value, bool)
        elif self.type == 'string':
            suits = isinstance(value, str)
        elif self.type == 'float64':
            suits = isinstance(value, (int, float)) and not isinstance(value, bool)
        else:
            suits = (isinstance(value, int) and not isinstance(value, bool)
                     and (value >= 0 or not self.type.startswith('u')))
        if not suits:
            raise ValueError(f'default {value!r} does not suit type {self.type}')
        return self
@
Options and arguments at the top level become one usage named after the command.
Usage names, option names, and short names are each unique in the whole command,
because its parser reads the options of every usage.
@<Invocation@/invocation syntax helpers@+
class Usage(pydantic.BaseModel):
    model_config = pydantic.ConfigDict(extra='forbid')
    name: str
    options: list[Option] = []
    arguments: list[str] = []


class InvocationSyntax(pydantic.BaseModel):
    model_config = pydantic.ConfigDict(extra='forbid')
    name: str = 'command'
    usages: list[Usage] = pydantic.Field(min_length=1)

    @pydantic.model_validator(mode='before')
    @classmethod
    def gather_single_usage(cls, data):
        if isinstance(data, dict) and 'usages' not in data:
            data = dict(data)
            usage = {'name': data.get('name', 'command')}
            for key in ('options', 'arguments'):
                if key in data:
                    usage[key] = data.pop(key)
            data['usages'] = [usage]
        return data

    @pydantic.model_validator(mode='after')
    def check_unique_names(self):
        options = all_options(self)
        for kind, names in (
            ('usage', [usage.name for usage in self.usages]),
            ('option', [opt.name for opt in options]),
            ('short option', [opt.short for opt in options if opt.short]),
        ):
            for name in names:
                if names.count(name) > 1:
                    raise ValueError(f'{kind} {name!r} is given twice')
        return self
@
A placeholder stands for a value in a usage line: upper case, with underscores between words.
@<Invocation@/invocation syntax helpers@+
def all_options(syntax):
    return [opt for usage in syntax.usages for opt in usage.options]


def placeholder(name):
    return name.upper().replace('-', '_').replace(' ', '_')


def metavar(opt):
    return placeholder(opt.argument or opt.name)
@
The invocation syntax of a command is one Jsonnet object.
The usage lines and the manpage of the command are generated from it here,
and a structure turns it into the parser of its language,
so every form of the command line comes from this one chunk.
A usage is one way to call the command: its options and its positional arguments.
A command with one usage may give its options and arguments at the top level instead.
An option is a switch when its type is bool; any other type takes a value,
shown by its argument name, or by its own name, in upper case.
The type is bool, string, int, int64, uint, uint64, or float64,
and a default must suit it. A hidden option is left out of usage lines.
A structure rejects the features its language does not support.

{
    name: COMMAND_NAME,
    usages: [
        {
            name: USAGE_NAME,
            options: [
                {
                    name: LONG_NAME,
                    short: SHORT_NAME (optional),
                    type: TYPE (optional, bool by default),
                    argument: ARGUMENT_NAME (optional),
                    default: DEFAULT (optional),
                    description: DESCRIPTION (optional),
                    hide: HIDDEN_FROM_USAGE (optional),
                },
                ...
            ],
            arguments: [
                ARGUMENT,
                ...
            ],
        },
        ...
    ],
}

@<Invocation@/invocation syntax@=
{}
@
An option is shown by its short name if it has one, otherwise by its long name.
@<Invocation@/invocation syntax helpers@+
LONG_PREFIX = r'''
@<.@/long option prefix@>
'''.strip()


def option_name(opt):
    return f'-{opt.short}' if opt.short else LONG_PREFIX + opt.name


def option_with_value(opt):
    return option_name(opt) + ('' if opt.type == 'bool' else f' {metavar(opt)}')
@
A long option starts with this prefix in usage lines and the manpage.
A structure whose parser reads long options after another prefix overrides it under its own label.
@<Invocation@/long option prefix@=
--
@
A description of an option names it both ways, the short name first.
@<Invocation@/invocation syntax helpers@+
def option_names(opt):
    return ([f'-{opt.short}'] if opt.short else []) + [LONG_PREFIX + opt.name]
@
A text processing script is a Python script that declares its dependencies:
jsonnet evaluates configuration, and pydantic validates it.
Its interpreter runs it in a background process that has loaded them already.
@<Text Processing@/basic python settings@=
#!@<.@/Internals@/path to python interpreter@>
@<.@/Internals@/python dependencies@>
import os
import re
import sys
from typing import Literal

@<.@/Internals@/import dependencies@>

@<.@/Internals@/configuration helpers@>
@
Configuration is a Jsonnet expression, so a block can extend an object of a base node with +.
A pydantic model validates the evaluated value.
An invalid configuration, like any fail, prints a message and fails the evaluation.
@<Text Processing@/Internals@/configuration helpers@=
def fail(message):
    sys.exit(message)


def configuration(model, source):
    try:
        value = _jsonnet.evaluate_snippet('configuration', source)
    except RuntimeError as error:
        fail(str(error))
    try:
        return model.model_validate_json(value)
    except pydantic.ValidationError as error:
        fail(str(error))
@
The interpreter of a script is the client of a background Python process.
The client and the server are written to a directory named by their checksum,
private to the user, so a changed client, server, or python3 gets its own server.
The directory is moved into place whole, so a concurrent evaluation never sees it half written.
@<Text Processing@/Internals@/path to python interpreter@=
#!/bin/sh
set -e
base=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/litar-python-`id -u`
mkdir -p -m 700 "$base"
if [ ! -O "$base" ]; then
    echo "$base is not owned by the user" >&2
    exit 1
fi
temp=`mktemp -d "$base/new.XXXXXX"`
trap 'rm -rf "$temp"' EXIT
printf '#!%s -S\n' "`which python3`" > "$temp/client"
cat >> "$temp/client" <<'LITAR_PYTHON_CLIENT'
@<.@/python client@>
LITAR_PYTHON_CLIENT
cat > "$temp/server" <<'LITAR_PYTHON_SERVER'
@<.@/python server@>
LITAR_PYTHON_SERVER
chmod +x "$temp/client"
dir=$base/`cat "$temp/client" "$temp/server" | cksum | tr ' ' -`
if [ ! -x "$dir/client" ]; then
    mv -T "$temp" "$dir" 2>/dev/null || [ -x "$dir/client" ]
fi
echo "$dir/client"
@|Basic@/evaluate@
The client is the interpreter of a script.
It passes its standard streams, arguments, directory and environment to the server,
then exits with the status the server reports.
When no server listens, it starts one in the background and runs this script itself,
so only the first script pays for loading the dependencies.
The server leaves the working directory, a view that is unmounted after the script,
and closes the standard streams, which the evaluation reads until they close.
@<Text Processing@/Internals@/python client@=
import json
import os
import socket
import sys

here = os.path.dirname(os.path.abspath(__file__))


def start_server():
    if os.fork() == 0:
        os.setsid()
        os.chdir('/')
        null = os.open(os.devnull, os.O_RDWR)
        for fd in range(3):
            os.dup2(null, fd)
        server = os.path.join(here, 'server')
        os.execv(sys.executable, [sys.executable, server])


try:
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    connection.connect(os.path.join(here, 'socket'))
except OSError:
    start_server()
    os.execv(sys.executable, [sys.executable, *sys.argv[1:]])
request = {
    'argv': [os.path.abspath(sys.argv[1]), *sys.argv[2:]],
    'cwd': os.getcwd(),
    'env': dict(os.environ),
}
socket.send_fds(connection, [b'\0'], [0, 1, 2])
connection.sendall(json.dumps(request).encode())
connection.shutdown(socket.SHUT_WR)
status = b''
while chunk := connection.recv(64):
    status += chunk
sys.exit(int(status) if status else 1)
@
The server loads the dependencies once, then forks a fresh child for every connection,
so each script starts from the same state and none sees what another changed.
A lock keeps one server per directory; a second one exits at once.
After ten idle minutes the server removes its socket, so clients start a new server,
serves the connections already waiting, and exits.
@<Text Processing@/Internals@/python server@=
@<.@/python dependencies@>
import fcntl
import hashlib
import json
import os
import re
import runpy
import signal
import socket
import sys
import traceback
from typing import Literal

@<.@/import dependencies@>

@<.@/preload pydantic@>

here = os.path.dirname(os.path.abspath(__file__))

@<.@/cache jsonnet@>

@<.@/run a script@>

@<.@/serve a connection@>


def accept_all():
    while True:
        try:
            connection, _ = listener.accept()
        except (TimeoutError, BlockingIOError):
            return
        if os.fork() == 0:
            serve(connection)
        connection.close()


lock = open(os.path.join(here, 'lock'), 'w')
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit()
path = os.path.join(here, 'socket')
if os.path.lexists(path):
    os.unlink(path)
listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
listener.bind(path)
listener.listen(64)
listener.settimeout(600)
signal.signal(signal.SIGCHLD, signal.SIG_IGN)
accept_all()
os.unlink(path)
listener.setblocking(False)
accept_all()
@
The inline script metadata tells uv what a script, or the background process, depends on.
@<Text Processing@/Internals@/python dependencies@=
# /// script
# requires-python = ">=3.10"
# dependencies = ["jsonnet>=0.20", "pydantic>=2"]
# ///
@
When python3 cannot import the dependencies, the script runs itself again through uv,
which provides them from its cache, downloading them on the first run.
The marker variable stops a second attempt, and is removed so nested scripts start afresh.
In the background process the imports already succeeded, so a script never reaches uv there.
@<Text Processing@/Internals@/import dependencies@=
try:
    import _jsonnet
    import pydantic
except ImportError:
    if os.environ.pop('LITAR_UV_RUN', None):
        raise
    os.environ['LITAR_UV_RUN'] = '1'
    os.execvp('uv', ['uv', 'run', '--quiet', '--script', *sys.argv])
os.environ.pop('LITAR_UV_RUN', None)
@
The child of a connection takes the client's standard streams, arguments, directory
and environment, restores the default handling of exited children for the script,
and reports its status. When the child fails before that, the client exits with 1.
@<Text Processing@/Internals@/serve a connection@=
def serve(connection):
    try:
        connection.setblocking(True)
        signal.signal(signal.SIGCHLD, signal.SIG_DFL)
        lock.close()
        listener.close()
        _, fds, _, _ = socket.recv_fds(connection, 1, 3)
        data = b''
        while chunk := connection.recv(65536):
            data += chunk
        request = json.loads(data)
        for target, fd in enumerate(fds):
            os.dup2(fd, target)
            os.close(fd)
        os.chdir(request['cwd'])
        os.environ.clear()
        os.environ.update(request['env'])
        sys.argv = request['argv']
        connection.sendall(str(run(sys.argv[0])).encode())
    except BaseException:
        traceback.print_exc()
    os._exit(0)
@
A script ends as it would in its own interpreter:
sys.exit with a message prints it and gives 1, an uncaught exception prints its traceback,
and the output is flushed before the status is known.
@<Text Processing@/Internals@/run a script@=
def run(script):
    try:
        runpy.run_path(script, run_name='__main__')
        status = 0
    except SystemExit as error:
        status = error.code
        if status is None:
            status = 0
        elif not isinstance(status, int):
            print(status, file=sys.stderr)
            status = 1
    except BaseException:
        traceback.print_exc()
        status = 1
    for stream in sys.stdout, sys.stderr:
        try:
            stream.flush()
        except OSError:
            status = status or 120
    return status
@
pydantic imports its parts on first use and builds its validators on the first model,
so the server does both once, before forking, instead of every script doing them.
@<Text Processing@/Internals@/preload pydantic@=
class Preload(pydantic.BaseModel):
    model_config = pydantic.ConfigDict(extra='allow')
    name: str = pydantic.Field('', pattern=r'^$')


Preload.model_validate_json('{}')
@
jsonnet parses its standard library again on every evaluation, which costs more than most scripts.
The server replaces evaluate_snippet, so its scripts keep each result in a file
named by the hash of the source, shared by later scripts and later builds.
A source that may import a file, or an evaluation with options, is never cached,
because its result depends on more than the source; a failed evaluation is not cached either.
The result is written aside and renamed, so a concurrent script never reads it half written.
@<Text Processing@/Internals@/cache jsonnet@=
def cached(evaluate):
    cache = os.path.join(here, 'jsonnet')
    os.makedirs(cache, exist_ok=True)

    def evaluate_snippet(filename, source, **options):
        if options or 'import' in source:
            return evaluate(filename, source, **options)
        key = hashlib.sha256(f'{filename}\0{source}'.encode()).hexdigest()
        path = os.path.join(cache, key)
        try:
            with open(path, encoding='utf-8') as file:
                return file.read()
        except FileNotFoundError:
            pass
        value = evaluate(filename, source)
        temp = f'{path}.{os.getpid()}'
        with open(temp, 'w', encoding='utf-8') as file:
            file.write(value)
        os.replace(temp, path)
        return value

    return evaluate_snippet


_jsonnet.evaluate_snippet = cached(_jsonnet.evaluate_snippet)
@
