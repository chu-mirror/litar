@<Go Structure@/package name@=
@<Text Processing@/basic python settings@>


class ModuleMeta(pydantic.BaseModel):
    model_config = pydantic.ConfigDict(extra='allow')
    name: str = pydantic.Field(pattern=r'^[A-Za-z_][A-Za-z0-9_]*$')


meta = configuration(ModuleMeta, r'''
@<.@/module meta information@>
''')
print(meta.name, end='')
@|Basic@/evaluate@
The name field is the package identifier.
pkg stands in until a file sets its own name.
A command does not read this name; its package clause says main.
The module properties are the fields of a second Jsonnet object, which override these defaults;
further fields belong there too, and Jsonnet rejects a field given twice.
@<Go Structure@/module meta information@=
{
    name: 'pkg',
} + {
    @<.@/module properties@>
}
@
No import declaration is emitted when the path list is empty
or contains only whitespace.
A blank line between paths starts another group,
and gofmt keeps that group.
@<Go Structure@/imports@=
@<Text Processing@/basic python settings@>
paths = r'''
@<.@/import paths@>
'''.strip(' \t\n\r\f\v')
if paths:
    print(f'import (\n{paths}\n)')
@|Basic@/evaluate@

@<command@:Go Structure@/import paths@+
    "flag"
    "fmt"
    "os"
@
@<Go Structure@/Flag@/command variables@=
@<Text Processing@/basic python settings@>
@<.@/flag syntax helpers@>


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
if syntax.flags or syntax.arguments:
    print('var command struct {')
    if syntax.flags:
        print('flags struct {')
        for flag in syntax.flags:
            print(f'{take_field(flag.name)} {flag.type}')
        print('}')
    if syntax.arguments:
        print('arguments struct {')
        for arg in syntax.arguments:
            print(f'{take_field(arg)} string')
        print('}')
    print('}')
@|Basic@/evaluate@
@<Go Structure@/Flag@/register flags@=
@<Text Processing@/basic python settings@>
@<.@/flag syntax helpers@>


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
for flag in syntax.flags:
    field = take_field(flag.name)
    print(f'flag.{FLAG_FUNCS[flag.type]}(&command.flags.{field}, {go_string(flag.name)}, '
          f'{go_literal(flag)}, {go_string(flag.usage)})')
@|Basic@/evaluate@
@<Go Structure@/Flag@/usage literal@=
@<Text Processing@/basic python settings@>
@<.@/flag syntax helpers@>


def shown(name):
    return name.upper().replace('-', '_').replace(' ', '_')


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
parts = [syntax.name]
for flag in syntax.flags:
    opt = f'-{flag.name}'
    if flag.type != 'bool':
        opt += f' {shown(flag.name)}'
    parts.append(f'[{opt}]')
parts += map(shown, syntax.arguments)
print(go_string('Usage: ' + ' '.join(parts) + '\n'), end='')
@|Basic@/evaluate@
@<Go Structure@/Flag@/store arguments@=
@<Text Processing@/basic python settings@>
@<.@/flag syntax helpers@>


syntax = configuration(InvocationSyntax, r'''
@<.@/invocation syntax@>
''')
print(f'if len(flag.Args()) != {len(syntax.arguments)} {{')
print('flag.Usage()')
print('os.Exit(1)')
print('}')
for i, arg in enumerate(syntax.arguments):
    print(f'command.arguments.{take_field(arg)} = flag.Args()[{i}]')
@|Basic@/evaluate@
The generators include this chunk as one fragment,
so a flag name becomes the same Go field in each of them.
@<Go Structure@/Flag@/flag syntax helpers@=
GO_KEYWORDS = {
    'break', 'default', 'func', 'interface', 'select',
    'case', 'defer', 'go', 'map', 'struct',
    'chan', 'else', 'goto', 'package', 'switch',
    'const', 'fallthrough', 'if', 'range', 'type',
    'continue', 'for', 'import', 'return', 'var',
}


def field_name(name):
    parts = [part for part in re.split(r'[-_]+', re.sub(r'\s+', '-', name)) if part]
    if not parts:
        return ''
    return parts[0].lower() + ''.join(part.capitalize() for part in parts[1:])


def take_field(name):
    field = field_name(name)
    if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', field):
        raise ValueError(f"name '{name}' is not a Go field")
    if field in GO_KEYWORDS:
        raise ValueError(f"name '{name}' is a Go keyword")
    return field
@
@<Go Structure@/Flag@/flag syntax helpers@+
FLAG_FUNCS = {
    'bool': 'BoolVar',
    'string': 'StringVar',
    'int': 'IntVar',
    'int64': 'Int64Var',
    'uint': 'UintVar',
    'uint64': 'Uint64Var',
    'float64': 'Float64Var',
}


def go_string(text):
    for raw, escaped in (('\\', '\\\\'), ('"', '\\"'), ('\n', '\\n'), ('\r', '\\r'), ('\t', '\\t')):
        text = text.replace(raw, escaped)
    return f'"{text}"'


def go_literal(flag):
    if flag.default is None:
        return {'bool': 'false', 'string': '""'}.get(flag.type, '0')
    if flag.type == 'bool':
        return 'true' if flag.default else 'false'
    if flag.type == 'string':
        return go_string(flag.default)
    return str(flag.default)
@
A default must suit the type of its flag: a boolean for bool, a string for string,
an integer for the integer types, not negative for the unsigned ones, and a number for float64.
@<Go Structure@/Flag@/flag syntax helpers@+
class Flag(pydantic.BaseModel):
    model_config = pydantic.ConfigDict(extra='forbid')
    name: str
    type: Literal['bool', 'string', 'int', 'int64', 'uint', 'uint64', 'float64']
    default: bool | int | float | str | None = None
    usage: str = ''

    @pydantic.model_validator(mode='after')
    def check_default(self):
        value = self.default
        if value is None:
            return self
        if self.type == 'bool':
            suits = isinstance(value, bool)
        elif self.type == 'string':
            suits = isinstance(value, str)
        elif self.type == 'float64':
            suits = isinstance(value, (int, float)) and not isinstance(value, bool)
        else:
            suits = (isinstance(value, int) and not isinstance(value, bool)
                     and (value >= 0 or not self.type.startswith('u')))
        if not suits:
            raise ValueError(f'default {value!r} does not suit type {self.type}')
        return self
@
Flags, and separately arguments, must become distinct Go fields.
@<Go Structure@/Flag@/flag syntax helpers@+
class InvocationSyntax(pydantic.BaseModel):
    model_config = pydantic.ConfigDict(extra='forbid')
    name: str = 'command'
    flags: list[Flag] = []
    arguments: list[str] = []

    @pydantic.model_validator(mode='after')
    def check_fields(self):
        for names in ([flag.name for flag in self.flags], self.arguments):
            seen = set()
            for name in names:
                field = take_field(name)
                if field in seen:
                    raise ValueError(f"name '{name}' repeats field {field}")
                seen.add(field)
        return self
@
A command line is one Jsonnet object.
The filters below validate it with pydantic and turn it into Go,
and the program uses the standard flag package.
name is the word in the usage line.
Each flag has a name, a flag package type, a default, and a usage string.
The type is bool, string, int, int64, uint, uint64, or float64.
A bool default is a Jsonnet boolean.
A string default is a Jsonnet string.
A numeric default is a Jsonnet number; an integer type takes a whole number.
The Go field is the flag name in camel case.
Hyphens and spaces separate words.
Positional arguments are an exact list.
An omitted list is empty,
so the command accepts no positional arguments.
flag.Usage prints the usage line and the flag defaults.
A man page is not generated.

{
    name: COMMAND_NAME,
    flags: [
        {
            name: FLAG_NAME,
            type: TYPE,
            default: DEFAULT,
            usage: USAGE,
        },
    ],
    arguments: [
        ARGUMENT,
    ],
}
@<Go Structure@/Flag@/invocation syntax@=
{}
@
command is the rightmost label of a package main program.
These blocks set the package name to main,
add the flag, fmt, and os imports,
add the command variable when the invocation syntax needs one,
and add func main.
func main parses the command line and then runs the main body.
Parsing always calls flag.Parse, flag.Usage, and os.Exit,
so those three imports stay used when the command has no flags.
Replace module meta information to name the other files in the node.
That replacement does not rename the command.
@<command@:Go Structure@/package name@=main@
