Say hello to all your classmates.

@[hello.c@=
#include <stdio.h>

int main()
{
    @<print hello to every one@>
}
@|Scripts@/add comment@

@<classmates@=
Alice
Floyd
@

@<print hello to every one@=
@<classmates
    @|Scripts@/greetings for a list of people
    @|Scripts@/exaggerated version for greetings@>
@

@- Scripts

@<add comment@=#!/bin/sh
echo "/* this file is auto-generated by litar from hello.la */"
cat -
@

@[sed_script/greet_each.sed@=
/^[A-Z]/s/\(.*\)/printf("Hello, \1!\\n");/
@

@<greetings for a list of people@=#!/bin/sh
sed -f sed_script/greet_each.sed
@

@<exaggerated version for greetings@=#!/bin/sh
sed -e 's/Hello,/HELLO!/'
@

