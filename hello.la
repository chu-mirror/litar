Say hello to all your classmates.

@[hello.c@=
@<hello@:Simple C@/a simple c program@>
@

@<hello@:Simple C@/main body@=
@<classmates
    @|Scripts@/greetings for a list of people
    @|Scripts@/exaggerated version for greetings@>
@

@[hello2.c@=
@<hello2@:Simple C@/a simple c program@>
@

@<hello2@:Simple C@/main body@=
@<classmates
    @|Scripts@/greetings for a list of people@>
@

@<classmates@=
Alice
Floyd
@

@- Scripts

@<add comment@=#!/bin/sh
echo "/* this file is auto-generated by litar from hello.la */"
cat -
@

@[sed_script/greet_each.sed@=
/^[A-Z]/s/\(.*\)/printf("Hello, \1!\\n");/
@

@<greetings for a list of people@=#!/bin/sh
sed -f sed_script/greet_each.sed
@

@<exaggerated version for greetings@=#!/bin/sh
sed -e 's/Hello,/HELLO!/'
@

@- Simple C

@<a simple c program@=
#include <stdio.h>

int main(int argc, char *argv[])
{
    @<main body@>
    return 0;
}
@|Scripts@/add comment@

