Say hello to all your classmates.

@[src/hello.c@=
#include <stdio.h>

int main()
{
    @<print hello to every one@>
}
@

@<classmates@=
Alice
Floyd
@

@[sed_script/greet_each.sed@=
s/\(.*\)/printf("Hello, \1!\\n");/
@

@<greetings for a list of people@=#!/bin/sh
sed -f sed_script/greeting_each.sed
@

@<exaggerated version for greetings@=#!/bin/sh
sed -e 's/Hello,/HELLO!/'
@

@<print hello to every one@=
@<classmates@|greetings for a list of people@|exaggerated version for greetings@>
@

