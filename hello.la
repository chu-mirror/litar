Say hello to all your classmates.

@<hello.c@=
#include <stdio.h>

int main()
{
    @<print hello to every one@>
}
@

@<classmates@=
Alice
Floyd
@

@<greetings for a list of people@=
sed -e 's/\(.*\)/printf("Hello, \1!\\n");/'
@

@<exaggerated version for greetings@=
sed -e 's/Hello,/HELLO!/'
@

@<print hello to every one@=
@<classmates@|greetings for a list of people@|exaggerated version for greetings@>
@

