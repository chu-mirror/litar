Say hello to all your classmates.

@<classmates@=
Alice
Floyd
@

@<say hello@=#!/usr/bin/perl
print "hello\n";
@

@[hello.c@=
@<hello@:C Module@/C module@>
@

@<hello@:C Module@/C module properties@=
name => 'hello',
@

@<hello@:C Module@/includes@=
#include <stdio.h>
@

@<hello@:C Module@/functions@=
void print_hello()
{
    @<classmates
        @|Scripts@/greetings for a list of people
        @|Scripts@/exaggerated version for greetings@>
}
@

@[hello.h@=
@<hello@:C Module@/C module interface@>
@

@[main.c@=
@<main@:C Module@/C module@>
int main(int argc, char *argv[])
{
    @<main body@>
    return 0;
}
@

@<main@:C Module@/includes@=
#include "hello.h"
@

@<main body@=
print_hello();
@

@<run hello@=#!/bin/sh
gcc -o hello main.c hello.c
./hello
@

@- Scripts

@[sed_script/greet_each.sed@=
/^[A-Z]/s/\(.*\)/printf("Hello, \1!\\n");/
@

@<greetings for a list of people@=#!/bin/sh
sed -f sed_script/greet_each.sed
@

@<exaggerated version for greetings@=#!/bin/sh
sed -e 's/Hello,/HELLO!/'
@

@. lib/c-suit.ls

