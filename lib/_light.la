@

@<light options@=
#ifndef light_option_context_main_size
#define light_option_context_main_size (1 << 20)  /* 1 MB */
#endif

#ifndef light_option_logging_level
/* #define light_option_logging_level ERROR */
#endif
@

@<light@:executable@:C Structure@/global variables@=
static uint8_t context_main_memory[light_option_context_main_size];
struct context context_main = {
    .name = "main",
    .parent = NULL,
    .memory_end = context_main_memory + sizeof(context_main_memory),
    .stack_top = context_main_memory,
};
@

@<light@:executable@:C Structure@/includes@=
#include "_light.h"
@

@<light@:C Structure@/main body@=
do {
    enter_context(&context_main);
    @<main body@>
    exit_context(&context_main);
} while (0);
@


