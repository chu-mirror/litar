@- Light

Light is a framework mainly for C programming.
It reflects the author's preferences and customs, which includes how to format code,
how to manage memory, how to handle exception, etc.

Light encourage using of statical memory rather than heap.

@<light@:C Structure@/module properties@=
name => 'light',
@

@<light@:C Structure@/exported data type declarations@=
struct context {
    struct context * const parent_context;
    const void *stack_end;
    void **stack_frame_start;
    void *stack_top;
};
extern thread_local struct context *_light_top_context;
@

@<light@:C Structure@/exported macros@=
#define CONTEXT(name, parent, size) \
    struct { \
        uint8_t mem[size]; \
        struct context ctx; \
    } name = { \
        .ctx = { \
            .parent_context = parent, \
            .stack_end = &name.mem[size], \
            .stack_frame_start = (void **)&name.mem[0], \
            .stack_top = &name.mem[sizeof(void *)] , \
        } \
    };
@

@<light@:C Structure@/global variables@=
thread_local struct context *_light_top_context;
@

@<light@:C Structure@/exported static inline functions@=
static inline void *_salloc(struct context *ctx, size_t size) {
    uint8_t *stack_top = ctx->stack_top;
    if (stack_top + size > (uint8_t *)ctx->stack_end) {
        return NULL;
    }
    ctx->stack_top = stack_top + size;
    return stack_top;
}

static inline void *_csalloc(struct context *ctx, size_t nmemb, size_t size) {
    size_t tot = nmemb * size;
    void *p = _salloc(ctx, tot);
    memset(p, 0, tot);
    return p;
}

static inline void *salloc(size_t size) {
    return _salloc(_light_top_context, size);
}

static inline void *csalloc(size_t nmemb, size_t size) {
    return _csalloc(_light_top_context, nmemb, size);
}

static inline size_t _remaining_memory(struct context *ctx) {
    return (uint8_t *)ctx->stack_end - (uint8_t *)ctx->stack_top;
}

static inline size_t remaining_memory() {
    return _remaining_memory(_light_top_context);
}
@

@<light@:C Structure@/exported macros@=
#define NEW(p) \
    do { \
        typeof(p) *p_r = &(p); \
        (*p_r) = (typeof(p))salloc(sizeof *(p)); \
    } while (0)
#define CALLOC(p, len) \
    do { \
        typeof(p) *p_r = &(p); \
        (*p_r) = (typeof(p))csalloc((len), sizeof *(p)); \
    } while (0)
#define NEW0(p) CALLOC(p, 1)
@

@<light@:C Structure@/exported static inline functions@=
static inline void enter_frame() {
    void **p = salloc(sizeof(void *));
    *p = _light_top_context->stack_frame_start;
    _light_top_context->stack_frame_start = p;
}

static inline void exit_frame() {
    _light_top_context->stack_top = _light_top_context->stack_frame_start;
    _light_top_context->stack_frame_start = *_light_top_context->stack_frame_start;
}
@

@<light@:C Structure@/exported macros@=
#define enter_context(name) do { _light_top_context = &name.ctx; } while (0)
#define exit_context(name) do { \
        name.ctx.stack_frame_start = (void **) &name.mem[0]; \
        name.ctx.stack_top = &name.mem[sizeof(void *)]; \
        _light_top_context = name.ctx.parent_context; \
    } while (0)
@

@<light@:C Structure@/exported data type declarations@=
typedef struct heap *Heap;
@

@<light@:C Structure@/macros@=
#define HEAP_LABEL_TYPE unsigned int
#define HEAP_LABEL_SIZE (sizeof(HEAP_LABEL_TYPE) * 8)
@

@<light@:C Structure@/data types@=
struct heap {
    size_t length;
    size_t unit_size;
    HEAP_LABEL_TYPE *labels;
    int first_direct;
    uint8_t *space;
};
@

@<light@:C Structure@/functions@=
Heap new_heap(size_t len, size_t unit_size)
{
    Heap hp;
    NEW(hp);
    if (!hp) {
        return NULL;
    }
    hp->length = len;
    hp->unit_size = unit_size;
    hp->space = salloc(len * unit_size);

    int w_n = 1;
    while (w_n < len) {
        w_n *= HEAP_LABEL_SIZE;
    }

    hp->first_direct = (w_n-1)/(HEAP_LABEL_SIZE-1);
    CALLOC(
        hp->labels,
        hp->first_direct + (len+HEAP_LABEL_SIZE-1)/HEAP_LABEL_SIZE
    );
    return hp;
}

void *heap_alloc(Heap hp)
{
    int p = 0;
    while (p < hp->first_direct) {
        p = HEAP_LABEL_SIZE * p + 1 + __builtin_clzg(~hp->labels[p], (int)HEAP_LABEL_SIZE);
    }

    int n = __builtin_clzg(~hp->labels[p], (int)HEAP_LABEL_SIZE);
    int idx = (p - hp->first_direct) * HEAP_LABEL_SIZE + n;

    if (idx >= hp->length) {
        return NULL;
    }

    hp->labels[p] |= (HEAP_LABEL_TYPE) 1 << (HEAP_LABEL_SIZE - n - 1);

    while (__builtin_popcountg(hp->labels[p]) == HEAP_LABEL_SIZE) {
        int _p = (p - 1) / HEAP_LABEL_SIZE;
        hp->labels[_p] |=
            (HEAP_LABEL_TYPE) 1 << (HEAP_LABEL_SIZE - 1 - (p - (_p * HEAP_LABEL_SIZE + 1)));
        if (_p == 0) {
            break;
        }
        p = _p;
    }

    return hp->space + (idx * hp->unit_size);
}

void heap_free(Heap hp, void *elm)
{
    uint8_t *_elm = elm;
    if (_elm < hp->space || _elm >= hp->space + hp->length * hp->unit_size) {
        return;
    }
    size_t idx = (_elm - hp->space) / hp->unit_size;
    int p = hp->first_direct + idx/HEAP_LABEL_SIZE;
    hp->labels[p] &= ~((HEAP_LABEL_TYPE) 1 << (HEAP_LABEL_SIZE - 1 - (idx % HEAP_LABEL_SIZE)));
    do {
        int _p = (p - 1) /HEAP_LABEL_SIZE;
        hp->labels[_p] &= ~(
            (HEAP_LABEL_TYPE) 1 << (HEAP_LABEL_SIZE - 1 - (p - (_p * HEAP_LABEL_SIZE + 1)))
        );
        if (__builtin_popcountg(hp->labels[_p]) < HEAP_LABEL_SIZE - 1) {
            break;
        }
        p = _p;
    } while (p);
}
@

Copied from linux kernel.

@<light@:C Structure@/exported macros@=
#define container_of(ptr, type, member) \
    _Generic(ptr, \
        const typeof(*(ptr)) *: ((const type *)((uint8_t *)(ptr) - offsetof(type, member))), \
        default: ((type *)((uint8_t *)(ptr) - offsetof(type, member))) \
    )
@

@<light@:C Structure@/exported data types@=
struct list {
    struct list *next;
};
@

@<light@:C Structure@/exported macros@=
#define cons(nd, l) ({ \
        typeof(nd) __light_macro_local_nd = (nd); typeof(nd) __light_macro_local_l = (l); \
        __light_macro_local_nd->list_header.next = \
            __light_macro_local_l? &(__light_macro_local_l)->list_header : NULL; \
        __light_macro_local_nd; \
    })
#define cdr(l) ({ \
        typeof(l) __light_macro_local_l = (l); \
        __light_macro_local_l->list_header.next ? \
            container_of((l)->list_header.next, typeof(*(l)), list_header) : NULL; \
    })
#define length(l) ({ \
        struct list * __light_macro_local_l_hd = &(l)->list_header; \
        int c = 0;  \
        while (__light_macro_local_l_hd) { \
            ++c; \
            __light_macro_local_l_hd = __light_macro_local_l_hd -> next; \
        } \
        c; \
    })
@

@<light@:C Structure@/data types@=
struct segment {
    struct list list_header;
    uint8_t mem[];
};
struct segmented {
    Heap heap;
    struct segment *head, *tail;
    size_t tail_size;
};
@

@<light@:C Structure@/exported macros@=
#define SEGMENT_SIZE(elms) sizeof(struct {struct list list_header; elms;})
@

@<light@:C Structure@/exported data type declarations@=
typedef struct segmented *Segmented;
@

@<light@:C Structure@/static inline functions@=
static inline size_t segment_size(Segmented sg)
{
    return sg->heap->unit_size - offsetof(struct segment, mem);
}

static inline void segmented_init(Segmented sg, Heap hp)
{
    sg->heap = hp;
    sg->head = heap_alloc(hp);
    sg->tail = sg->head;
    sg->tail_size = 0;
}

static inline Segmented segmented_attach_new_segment(Segmented sg)
{
    struct segment *nsg = heap_alloc(sg->heap);
    if (!nsg) {
        return NULL;
    }
    cons(sg->tail, cons(nsg, NULL));
    sg->tail = nsg;
    sg->tail_size = 0;
    return sg;
}
@

@<light@:C Structure@/functions@=
Segmented new_segmented(Heap hp)
{
    Segmented sg;
    NEW(sg);
    if (!sg) {
        return NULL;
    }
    segmented_init(sg, hp);
    return sg;
}

Segmented new_segmented_in_heap(Heap hp_s, Heap hp)
{
    if (hp_s->unit_size >= sizeof(struct segmented)) {
        return NULL;
    }
    Segmented sg = heap_alloc(hp_s);
    if (!sg) {
        return NULL;
    }
    segmented_init(sg, hp);
    return sg;
}

size_t segmented_size(Segmented sg)
{
    return (length(sg->head)-1) * segment_size(sg) + sg->tail_size;
}

Segmented segmented_append(Segmented sg, const void *src, size_t n)
{
    const uint8_t *src_ = src;;
    while (n) {
        size_t tail_usable, save_to_tail;

        tail_usable = segment_size(sg) - sg->tail_size;
        save_to_tail = n < tail_usable ? n : tail_usable;

        memcpy(sg->tail->mem + sg->tail_size, src_, save_to_tail);
        n -= save_to_tail;
        src_ += save_to_tail;
        sg->tail_size += save_to_tail;

        if (sg->tail_size == segment_size(sg)) {
            if (!segmented_attach_new_segment(sg)) {
                return NULL;
            }
        }
    }
    return sg;
}

Segmented segmented_resize(Segmented sg, size_t size)
{
    struct segment *seg = sg->head;
    size_t acc = 0;
    while (acc < size) {
        acc += segment_size(sg);
        sg->tail = seg;

        seg = cdr(seg);
        if (!seg) {
            if (!segmented_attach_new_segment(sg)) {
                return NULL;
            }
            seg = sg->tail;
        }
    }
    cons(sg->tail, NULL);
    while (seg) {
        struct segment *seg_ = seg;
        seg = cdr(seg);
        heap_free(sg->heap, seg_);
    }
    if (acc > size) {
        sg->tail_size = size + segment_size(sg) - acc;
    }
    return sg;
}

void segmented_free(Heap hp_s, Segmented sg)
{
    struct segment *seg = sg->head, *seg_;
    while (seg) {
        seg_ = seg;
        seg = cdr(seg);
        heap_free(sg->heap, seg_);
    }
    heap_free(hp_s, sg);
}
@

@<light@:C Structure@/data types@=
struct segmented_random {
    Segmented segmented;
    void **segments;
};
@

@<light@:C Structure@/exported data type declarations@=
typedef struct segmented_random *SegmentedRandom;
@

@<light@:C Structure@/functions@=
SegmentedRandom segmented_random(Segmented sg)
{
    SegmentedRandom sgr;
    NEW(sgr);
    if (!sgr) {
        return NULL;
    }
    sgr->segmented = sg;

    struct segment *segs = sg->head;
    sgr->segments = csalloc(length(segs), sizeof(*sgr->segments));
    if (!sgr->segments) {
        return NULL;
    }

    int i = 0;
    while (segs) {
        sgr->segments[i] = segs->mem;
        segs = cdr(segs);
        ++i;
    }
    return sgr;
}

void *segmented_pointer(SegmentedRandom sgr, int addr)
{
    return (uint8_t *)sgr->segments[addr/segment_size(sgr->segmented)]
        + addr % segment_size(sgr->segmented);
}

void segmented_copy_to(Segmented sg, void *buf)
{
    struct segment *segs = sg->head;
    int addr = 0;
    while (segs != sg->tail) {
        memcpy(buf + addr, segs->mem, segment_size(sg));
        addr += segment_size(sg);
        segs = cdr(segs);
    }
    memcpy(buf + addr, segs->mem, sg->tail_size);
}

void *segmented_continuous(Segmented sg)
{
    uint8_t *cont;

    cont = salloc(segmented_size(sg));
    if (!cont) {
        return NULL;
    }
    segmented_copy_to(sg, cont);

    return cont;
}
@

@<light@:C Structure@/exported data type declarations@=
typedef Segmented String;
@

@<light@:C Structure@/functions@=
String string(Heap hp, const char *s)
{
    Segmented sg = new_segmented(hp);
    sg = segmented_append(sg, s, strlen(s));
    return sg;
}

const char *cstring(String str)
{
    size_t l = segmented_size(str);
    char *s = salloc(l+1);
    if (!s) {
        return NULL;
    }
    segmented_copy_to(str, s);
    s[l] = '\0';
    return s;
}

String string_append(String str, const char *s)
{
    return segmented_append(str, s, strlen(s));
}
@

