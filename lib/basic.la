@- Basics

@<evaluate@=#!/bin/sh
set -e
temp_file=`mktemp`
cat - > $temp_file
chmod +x $temp_file
$temp_file
rm $temp_file
@

@<system prerequisites@=
libfuse3-dev
pkg-config
libtext-template-perl
@

@<install prerequisites@=#!/bin/sh
sudo apt install @<system prerequisites@|Text Processing@/remove newlines@>
@

@[helper.md@=
Help
@
