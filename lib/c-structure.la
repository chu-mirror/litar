@- C Structure

@<Basics@/system prerequisites@=
cproto
clang-format-19
@

@<module meta information@=
(
    name => 'default',
    included_flag_format => '_MODULE_%s',
    include_paths => [qw(@<include paths@>)],
    @<module properties@>
)
@

@<-I flags@=@<Text Processing@/basic perl settings@>
my %meta = @<module meta information@>;

print join " ", map {"-I$_"} @@{ $meta{include_paths} };
@|Basics@/evaluate@

@<module@=
@<include flags@>
@<includes@>
@<macros@>
@<data type declarations@>
@<data types@>
@<function declarations@>
@<global variables@>
@<static inline functions@>
@<functions@>
@|format C code@

@<module interface@=
@<interface required includes@>
@<interface specific macros@>
@<exported macros@>
@<exported data type declarations@>
@<exported data types@>
@<global declarations@>
@<exported static inline functions@>
@|wrap with included flag@|format C code@

@<wrap with included flag@=@<Text Processing@/basic perl settings@>
my %meta = @<module meta information@>;

printf("#ifndef $meta{included_flag_format}\n", uc($meta{name}));
printf("#define $meta{included_flag_format}\n", uc($meta{name}));

while (<STDIN>) {
    print;
}

print "#endif\n";
@

