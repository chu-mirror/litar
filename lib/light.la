@- Light

Light is a framework mainly for C programming.
It reflects the author's preferences and customs, which includes how to format code,
how to manage memory, how to handle exception, etc.

The flags showing that a module was included follow this pattern.
@<light module@:C Structure@/module properties@=
included_flag_format => '_LIGHT_%s',
@

Include headers for debugging.
@<light module@:C Structure@/includes@=
#include <assert.h>
#ifndef NDEBUG
#include <stdio.h>
#endif
@

The module "basic" is used everywhere when using light.

@<basic@:light module@:C Structure@/module properties@=
name => 'basic',
@

@[light.c@=
@<basic@:light module@:C Structure@/module@>
@

@[light.h@=
@<basic@:light module@:C Structure@/module interface@>
@

Some always to use header files.

@<basic@:light module@:C Structure@/interface required includes@=
#include <stdlib.h>
#include <ctype.h>
#include <string.h>
#include <stddef.h>
#include <stdint.h>
#include <threads.h>
#include <pthread.h>
@

There are some idioms to make life a bit easier.

@<basic@:light module@:C Structure@/exported macros@=
/* Give value a new name, and force type casting. */
#define RENAME(old, new) (new = (typeof(new))old)

/* Generic data structure usually accept pointers, enable them to handle
 * integers. */
#define VALUE(v) (void *)(ptrdiff_t)(v)

#define ZEROFY(p, n) memset((p), 0, sizeof(*p) * (n))
#define ZEROFY_SINGLE(p) ZEROFY(p, 1)

#define COPY(src, dest) memcpy((dest), (src), sizeof(*(src)))

#define SIGN(v) (((v) > 0) - ((v) < 0))
#define ABS(v) ((v) * SIGN(v))
#define BETWEEN(v, l, r)                                             \
    ((((l) <= (v)) && ((v) < (r))) || (((r) <= (v)) && ((v) < (l))))
#define SWAP(a, b)                             \
    do {                                       \
        typeof(a) *a_r = &(a), *b_r = &(b), t; \
        t = *a_r;                              \
        *a_r = *b_r;                           \
        *b_r = t;                              \
    } while (0)
@

Light uses hash tables extensively to extend the relations
between pointers and other entities
without modify the data structure that the pointer reference to.
The hash algorithm chosen is Fibonacci Hashing.

@<basic@:light module@:C Structure@/macros@=
#define GOLDEN_RATIO_64 (0x9E3779B97F4A7C15ULL)
@

@<basic@:light module@:C Structure@/static inline functions@=
static inline uint64_t _hash_fibonacci(uint64_t v) {
    return GOLDEN_RATIO_64 * v;
}

static inline uint64_t _hash_ptr(void *p) {
    return _hash_fibonacci((uintptr_t)p);
}
@

@<basic@:light module@:C Structure@/exported data types@=
struct _hash_table_ptr_entry {
    struct _hash_table_ptr_entry *next;
    void *ptr;
    void *val;
};
@

@<basic@:light module@:C Structure@/exported macros@=
#define MAPPING_PTR(name) \
    pthread_mutex_t ptr_to_##name##_mutex = PTHREAD_MUTEX_INITIALIZER; \
    static struct _hash_table_ptr_entry *ptr_to_##name[1 << ptr_to_##name##_size]
@

@<basic@:light module@:C Structure@/functions@=
static struct _hash_table_ptr_entry **
_mapping_find_entry(struct _hash_table_ptr_entry **mapping, size_t size, void *k)
{
    uint64_t h = _hash_ptr(k);
    h = h & (1<<size)-1;
    struct _hash_table_ptr_entry *ent, *ent_;
    ent_ = NULL;
    ent = mapping[h];
    while (ent && ent->ptr != k) {
        ent_ = ent;
        ent = ent->next;
    }
    if (ent && ent_) { /* move the found entry to top of chain */
        ent_->next = ent->next;
        ent->next = mapping[h];
        mapping[h] = ent;
    }
    return &mapping[h];
}

void _map_ptr_to(
    struct _hash_table_ptr_entry **mapping,
    pthread_mutex_t *mutex_r,
    size_t size,
    void *k, void *v
) {
    struct _hash_table_ptr_entry *ent, **ent_r;
    pthread_mutex_lock(mutex_r);
    ent_r = _mapping_find_entry(mapping, size, k);
    if (*ent_r && (*ent_r)->ptr == k) {
        (*ent_r)->val = v;
    } else {
        ent = malloc(sizeof(*ent));
        ent->next = *ent_r;
        ent->ptr = k;
        ent->val = v;
        *ent_r = ent;
    }
    pthread_mutex_unlock(mutex_r);
}

void _unmap_ptr(
    struct _hash_table_ptr_entry **mapping,
    pthread_mutex_t *mutex_r,
    size_t size,
    void *k
) {
    struct _hash_table_ptr_entry **ent_r, *ent;
    pthread_mutex_lock(mutex_r);
    ent_r = _mapping_find_entry(mapping, size, k);
    if (*ent_r && (*ent_r)->ptr == k) {
        ent = *ent_r;
        *ent_r = ent->next;
        free(ent);
    }
    pthread_mutex_unlock(mutex_r);
}

void *_mapped_by_ptr(
    struct _hash_table_ptr_entry **mapping,
    pthread_mutex_t *mutex_r,
    size_t size,
    void *k
) {
    void *ret;
    struct _hash_table_ptr_entry **ent_r;
    pthread_mutex_lock(mutex_r);
    ent_r = _mapping_find_entry(mapping, size, k);
    if (!*ent_r || (*ent_r)->ptr != k) {
        ret = NULL;
    } else {
        ret = (*ent_r)->val;
    }
    pthread_mutex_unlock(mutex_r);
    return ret;
}
@

Some convenient macros.

@<basic@:light module@:C Structure@/exported macros@=
#define map_ptr_to(name, k, v) \
    _map_ptr_to(ptr_to_##name, &ptr_to_##name##_mutex, ptr_to_##name##_size, (k), (v))
#define unmap_ptr(name, k) \
    _unmap_ptr(ptr_to_##name, &ptr_to_##name##_mutex, ptr_to_##name##_size, (k))
#define mapped_by_ptr(name, k) \
    _mapped_by_ptr(ptr_to_##name, &ptr_to_##name##_mutex, ptr_to_##name##_size, (k))
@

The forming of program follows a common pattern,
you build up a context, then you write program under that context.
The maintainance of contexts in C program is a hard work.
It contains allocating of memory, and requiring resources from operating system,
what's more, the memory or resources allocated must be released at some point.
This kind of management is a major source of bugs in C programs,
because C program lacks a garbage collector.

C only has a minumal support for contexts through stack. Light extends it.

A context can be embedded to another context,
so the current context is in fact a stack of contexts.
This might not be correct if the program is multi-threaded. In that case,
the organization of contexts is like a tree.
The context a context embedded to is the parent context of that context.

A context has a list of resources, the resources must know how to release themselves.

@<basic@:light module@:C Structure@/exported data type declarations@=
typedef struct context *Context;
typedef struct resource *Resource;
@

@<basic@:light module@:C Structure@/exported data types@=
struct resource_node {
    struct resource_node *previous, *next;
    Resource resource;
};

struct context_child_node {
    struct context_child_node *next;
    Context child;
};

struct context {
    Context parent;
    struct context_child_node *children;
    struct resource_node *resources;
};

struct resource {
    void *identity;
    void (*clean)(void *);
};
@

Despite that all threads has its own interface to context tree,
the context tree itself is managed globally.

@<basic@:light module@:C Structure@/global variables@=
thread_local Context _light_top_context;
static pthread_mutex_t context_tree_mutex = PTHREAD_MUTEX_INITIALIZER;
@

@<basic@:light module@:C Structure@/global declarations@=
extern thread_local Context _light_top_context;
@

@<basic@:light module@:C Structure@/macros@=
#ifndef ptr_to_resource_node_size
#define ptr_to_resource_node_size (12)
#endif
@

@<basic@:light module@:C Structure@/global variables@=
static MAPPING_PTR(resource_node);
@

@<basic@:light module@:C Structure@/functions@=
void enter_context() {
    struct resource_node *nd_r;
    nd_r = malloc(sizeof(*nd_r));
    nd_r->previous = nd_r;
    nd_r->next = nd_r;
    nd_r->resource = NULL;

    Context ctx;
    ctx = malloc(sizeof(*ctx));
    ctx->parent = _light_top_context;
    ctx->children = NULL;
    ctx->resources = nd_r;

    struct context_child_node *nd;
    nd = malloc(sizeof(*nd));
    nd->child = ctx;

    pthread_mutex_lock(&context_tree_mutex);
    nd->next = _light_top_context->children;
    _light_top_context->children = nd;
    pthread_mutex_unlock(&context_tree_mutex);

    _light_top_context = ctx;

#ifndef NDEBUG
    fprintf(stderr, "Enter context: %p, parent: %p\n", ctx, ctx->parent);
#endif
}

void new_resource(void *id, void (*cl)(void *)) {
    Resource res;
    res = malloc(sizeof(*res));
    res->identity = id;
    res->clean = cl;

    struct resource_node *nd_r;
    nd_r = malloc(sizeof(*nd_r));
    nd_r->resource = res;

    pthread_mutex_lock(&context_tree_mutex);
    nd_r->previous = _light_top_context->resources;
    nd_r->next = _light_top_context->resources->next;
    _light_top_context->resources->next->previous = nd_r;
    _light_top_context->resources->next = nd_r;
    pthread_mutex_unlock(&context_tree_mutex);

    map_ptr_to(resource_node, id, nd_r);

#ifndef NDEBUG
    fprintf(stderr, "New resource: %p, under: %p\n", id, _light_top_context);
#endif
}

static void _delete_resource(struct resource_node *nd_r)
{
    pthread_mutex_lock(&context_tree_mutex);
    nd_r->previous->next = nd_r->next;
    nd_r->next->previous = nd_r->previous;
    pthread_mutex_unlock(&context_tree_mutex);

    nd_r->resource->clean(nd_r->resource->identity);
    free(nd_r);
#ifndef NDEBUG
    fprintf(stderr, "Free resource: %p, under: %p\n", nd_r->resource->identity, _light_top_context);
#endif
}

void delete_resource(void *id) {
    _delete_resource(mapped_by_ptr(resource_node, id));
    unmap_ptr(resource_node, id);
}

void rename_resource(void *id1, void *id2) {
    struct resource_node *nd_r;
    nd_r = mapped_by_ptr(resource_node, id1);
    unmap_ptr(resource_node, id1);

    pthread_mutex_lock(&context_tree_mutex);
    nd_r->resource->identity = id2;
    pthread_mutex_unlock(&context_tree_mutex);

    map_ptr_to(resource_node, id2, nd_r);
#ifndef NDEBUG
    fprintf(stderr, "Rename resource: %p, to: %p, under: %p\n", id1, id2, _light_top_context);
#endif
}

static void _exit_context(Context ctx) {
    while (ctx->children) {
        _exit_context(ctx->children->child);
    }

    while (ctx->resources->next != ctx->resources) {
        _delete_resource(ctx->resources->next);
    }

    do {
        struct context_child_node *nd, **nd_r;

        pthread_mutex_lock(&context_tree_mutex);
        nd_r = &ctx->parent->children;
        nd = ctx->parent->children;

        for (; nd; nd_r = &nd->next, nd = nd->next) {
            if (nd->child == ctx) {
                *nd_r = nd->next;
                free(nd);
                break;
            }
        }
        pthread_mutex_unlock(&context_tree_mutex);
    } while (0);

#ifndef NDEBUG
    fprintf(stderr, "Exit context: %p, parent: %p\n", ctx, ctx->parent);
#endif

    free(ctx->resources);
    free(ctx);
}

void exit_context() {
    Context parent;

    pthread_mutex_lock(&context_tree_mutex);
    parent = _light_top_context->parent;
    pthread_mutex_unlock(&context_tree_mutex);

    _exit_context(_light_top_context);

    _light_top_context = parent;
}
@

Unlike automatical finding of a variable by its name, when using context from Light,
users have to state explicitly whether some statements are execute under
the current context or not.

@<basic@:light module@:C Structure@/exported macros@=
#define UNDER(...) \
    do { \
        enter_context(); \
        Context _block_top_context = _light_top_context; \
        __VA_ARGS__; \
        GO_BACK(); \
        exit_context(); \
    } while (0)

#define GO_BACK() do { while (_block_top_context != _light_top_context) exit_context(); } while (0)

#define ESCAPE(...) \
    do { \
        Context __temp_context = _light_top_context; \
        _light_top_context = _light_top_context->parent; \
        __VA_ARGS__; \
        _light_top_context = __temp_context; \
    } while (0)
@

Based on the context defined, Light refines the memory management.

@<basic@:light module@:C Structure@/exported macros@=
#define NEW(p) \
    do { \
        typeof(p) *p_r = &(p); \
        (*p_r) = (typeof(p))malloc(sizeof *(p)); new_resource(*p_r, free); \
    } while (0)
#define FREE(p) delete_resource(p)
#define CALLOC(p, len) \
    do { \
        typeof(p) *p_r = &(p); \
        (*p_r) = (typeof(p))calloc((len), sizeof *(p)); new_resource(*p_r, free); \
    } while (0)
#define NEW0(p) CALLOC(p, 1)
#define REALLOC_ARRAY(p, len) \
    do { \
        typeof(p) *p_r = &(p); \
        void *p_ = *p_r; \
        (*p_r) = (typeof(p))reallocarray(*p_r, sizeof *(p), (len)); \
        rename_resource(p_, *p_r); \
    } while (0)
#define MOVE(src, dest) \
    do { \
        typeof(dest) *dest_r = &(dest); \
        NEW(*dest_r); memcpy((*dest_r), (src), sizeof *(dest)); \
    } while (0)
#define MOVE_ARRAY(src, dest, n) \
    do { \
        typeof(dest) *dest_r = &(dest); \
        CALLOC(*dest_r, n); memcpy((*dest_r), (src), sizeof *(dest) * (n)); \
    } while (0)
#define STRDUP(src, dest) \
    do { \
        typeof(dest) *dest_r = &(dest); \
        (*dest_r) = strdup(src); new_resource(*dest_r, free); \
    } while (0)
@

@<light@:C Structure@/includes@=
#include <setjmp.h>
@

@<light@:C Structure@/global variables@=
jmp_buf exit_main;
@

@<light@:C Structure@/main body@=
Context ctx;
ctx = malloc(sizeof(*ctx));
ctx->parent = NULL;
ctx->children = NULL;
ctx->resources = NULL;
_light_top_context = ctx;
UNDER(UNDER(
    @<initializations of main context@>
    int ext_n;
    if ((ext_n = setjmp(exit_main)) == 0) {
        @<main body@>
    } else {
        returned = ext_n;
    }
));
free(ctx);
@

Lists are used everywhere.

@<basic@:light module@:C Structure@/exported data type declarations@=
typedef struct list *List;
@

@<basic@:light module@:C Structure@/data types@=
struct list {
    struct list *rest;
    void *first;
};
@

The API of list adopts the conventions from lisp.

@<basic@:light module@:C Structure@/functions@=
List cons(void *ele, List l)
{
    List _l;

    NEW(_l);
    _l->first = ele;
    _l->rest = l;

    return _l;
}

void *car(List l)
{
    return l->first;
}

List cdr(List l)
{
    return l->rest;
}

List *rest(List l)
{
    return &l->rest;
}

void free_list(List l)
{
    while (l) {
        List _l = l->rest;
        FREE(l);
        l = _l;
    }
}
@

A list can be easily used as a stack.
@<basic@:light module@:C Structure@/functions@=
List push(void *elm, List *l_r)
{
    return *l_r = cons(elm, *l_r);
}

void *pop(List *l_r)
{
    List _l = cdr(*l_r);
    void *v = car(*l_r);
    FREE(*l_r);
    *l_r = _l;
    return v;
}
@

Construct a list from other linear structures.
@<basic@:light module@:C Structure@/functions@=
List list_from_arr(void *arr, size_t len, size_t size)
{
    int i;
    List l = NULL;
    for (i = 0; i < len; ++i) {
        push(arr + (len - i - 1) * size, &l);
    }
    return l;
}

List copy_list(List l)
{
    List _l = NULL;

    void *elm;
    FOREACH (elm, l) {
        push(elm, &_l);
    }
    reverse(&_l);

    return _l;
}
@

Modify the underlying structure of list.

@<basic@:light module@:C Structure@/functions@=
void reverse(List *l_r)
{
    List l, ll;

    l = *l_r;
    ll = NULL;

    while (l) {
        List l_t = l->rest;
        l->rest = ll;
        ll = l;
        l = l_t;
    }

    *l_r = ll;
}

List append(List *l1_r, List *l2_r)
{
    List l;

    if (!*l1_r) {
        l = *l2_r;
        *l2_r = NULL;
        return l;
    }

    do { /* find tail |l| of |*l1_r| */
        l = *l1_r;
        while (cdr(l)) {
            l = cdr(l);
        }
        l->rest = *l2_r;
    } while (0);

    l = *l1_r;

    *l1_r = NULL;
    *l2_r = NULL;

    return l;
}
@

@<basic@:light module@:C Structure@/exported macros@=
#define _LIST(arr, len) list_from_arr((arr), len, sizeof((arr)[0]))
#define LIST(arr) _LIST((arr), sizeof(arr) / sizeof((arr)[0]))
#define FOREACH(elm, l)                                      \
    for (List __light_list_l = (l);                          \
         __light_list_l && RENAME(car(__light_list_l), elm), \
         __light_list_l;                                     \
         __light_list_l = cdr(__light_list_l))
@

@<basic@:light module@:C Structure@/functions@=
size_t length(List l)
{
    size_t len;
    for (len = 0; l; l = cdr(l)) {
        ++len;
    }
    return len;
}
@

If a function F is of type X->Y->Z, we now want to get another function by
passing the first argument x to F, namely F(x). The type of F(x) is Y->Z.
Such operation is called partial application.
C does not support partial application through its native type system,
but it's so convenient, so Light implement similar machanisms.
The secret is to reorder arguments.

@<basic@:light module@:C Structure@/exported data type declarations@=
typedef struct function *Function;
@

@<basic@:light module@:C Structure@/data types@=
struct function {
    void *(*func)(void *);
    int argn;
    List args;
    int *mapping;
};
@

@<basic@:light module@:C Structure@/functions@=
Function _new_function(void *(*f)(void *), int argn)
{
    Function func;
    NEW(func);
    func->func = f;
    func->argn = argn;
    func->args = NULL;
    CALLOC(func->mapping, argn);

    int i;
    for (i = 0; i < argn; ++i) {
        func->mapping[i] = i;
    }
    return func;
}

void shift_arguments(Function func, int n)
{
    int p = length(func->args), l = func->argn - p;
    UNDER(
        int *_mapping = func->mapping + p, *dup;
        MOVE_ARRAY(_mapping, dup, l);
        int i;
        for (i = 0; i < l; ++i) {
            _mapping[i] = dup[(i+n)%l];
        }
    );
}

void fill_argument(Function func, void *arg)
{
    push(arg, &func->args);
}

static void *structured_args(Function func, List args)
{
    void *arg;
    List _args = copy_list(func->args);
    FOREACH (arg, args) {
        push(arg, &_args);
    }
    assert(length(_args) == func->argn);

    void **args_;
    CALLOC(args_, func->argn);

    reverse(&_args);

    int i = 0;
    FOREACH (arg, _args) {
        args_[func->mapping[i]] = arg;
        ++i;
    }
    return args_;
}

void *invoke(Function func, List args)
{
    void *ret;
    UNDER(
        void *args_ = structured_args(func, args);
        ESCAPE(ret = func->func(args_));
    );
    return ret;
}
@

@<basic@:light module@:C Structure@/exported macros@=
#define DECLARE_FUNCTION(name, ...) \
    static void *_function_func_##name(void *); \
    struct _function_args_##name {__VA_ARGS__};

#define DEFINE_FUNCTION(name, ...) \
    void *_function_func_##name(void *_args) { \
        struct _function_args_##name *args; \
        RENAME(_args, args); \
        __VA_ARGS__; \
    }
#define FUNCTION(name) \
    _new_function(_function_func_##name, sizeof(struct _function_args_##name)/sizeof(void *))
@

Generalized functions are good to define threads.

@<basic@:light module@:C Structure@/exported macros@=
#define DECLARE_THREAD(name, ...) DECLARE_FUNCTION(name, Context top_context; __VA_ARGS__)
#define DEFINE_THREAD(name, ...) \
    DEFINE_FUNCTION(name, _light_top_context = args->top_context; __VA_ARGS__)
@

@<basic@:light module@:C Structure@/exported static inline functions@=
static inline Function
_new_thread(void *(*f)(void *), int argn)
{
    Function func;
    func = _new_function(f, argn);
    fill_argument(func, _light_top_context);
    return func;
}
@

@<basic@:light module@:C Structure@/exported macros@=
#define THREAD(name) \
    _new_thread(_function_func_##name, sizeof(struct _function_args_##name)/sizeof(void *))
@

@<basic@:light module@:C Structure@/functions@=
int create_thread(pthread_t *thread, const pthread_attr_t *attr, Function func, List args)
{
    int ret;
    void *args_ = structured_args(func, args);
    ret = pthread_create(thread, attr, func->func, args_);
    return ret;
}
@

@<basic@:light module@:C Structure@/global declarations@=
int create_thread(pthread_t *thread, const pthread_attr_t *attr, Function func, List args);
@

Here are some useful higher-order functions that make use of generalized functions.

@<basic@:light module@:C Structure@/functions@=
List map(Function func, List l)
{
    List _l = NULL;
    void *elm;
    FOREACH (elm, l) {
        UNDER(
            List args = cons(elm, NULL);
            ESCAPE(push(invoke(func, args), &_l));
        );
    }
    reverse(&_l);
    return _l;
}

void *find_first(Function jdg, List l)
{
    void *elm, *ret = NULL;
    FOREACH(elm, l) {
        int found = 0;
        UNDER(
            List args = cons(elm, NULL);
            found = *(int *)invoke(jdg, args);
        );
        if (found) {
            ret = elm;
            break;
        }
    }
    return ret;
}

List filter(Function jdg, List l)
{
    List _l = NULL;
    void *elm;
    FOREACH (elm, l) {
        UNDER(
            List args = cons(elm, NULL);
            int *to_reserve;
            RENAME(invoke(jdg, args), to_reserve);
            if (*to_reserve) {
                ESCAPE(push(elm, &_l));
            }
        );
    }
    reverse(&_l);
    return _l;
}

void *remove_first(Function jdg, List *l_r)
{
    void *elm;
    List *_l_r = l_r;
    FOREACH (elm, *l_r) {
        int found = 0;
        UNDER(
            List args = cons(elm, NULL);
            int *to_remove;
            RENAME(invoke(jdg, args), to_remove);
            found = *to_remove;
        );
        if (found) {
            (*_l_r) = cdr(__light_list_l);
            *rest(__light_list_l) = NULL;
            FREE(__light_list_l);
            break;
        }
        _l_r = rest(*_l_r);
    }
    return elm;
}
@


Some useful generalized functions.

@<basic@:light module@:C Structure@/exported static inline functions@=
DECLARE_FUNCTION(pointer_equal, const void *p1; const void *p2;);
DEFINE_FUNCTION(pointer_equal,
    int res, *res_r;
    res = args->p1 == args->p2;
    MOVE(&res, res_r);
    return res_r;
)
@

Despite that Light prefers list, C uses array even more.
Light extends classic C arrays with dynamic size changing.

@<basic@:light module@:C Structure@/data types@=
struct array {
    void **elements;
    int size;
};
@

@<basic@:light module@:C Structure@/exported data type declarations@=
typedef struct array *Array;
@

@<basic@:light module@:C Structure@/macros@=
#define INITIAL_ARRAY_SIZE 64
@

@<basic@:light module@:C Structure@/functions@=
Array new_array()
{
    Array arr;
    NEW0(arr);
    arr->size = INITIAL_ARRAY_SIZE;
    CALLOC(arr->elements, INITIAL_ARRAY_SIZE);
    return arr;
}

void free_array(Array arr)
{
    FREE(arr->elements);
    FREE(arr);
}

void **
nth(Array arr, int n)
{
    if (n < arr->size) {
        return &arr->elements[n];
    }

    int _size = arr->size;
    while (!(n < arr->size)) {
        arr->size <<= 1;
    }
    REALLOC_ARRAY(arr->elements, arr->size);

    ZEROFY(arr->elements + _size, arr->size - _size);

    return &arr->elements[n];
}
@

Deque can be implemented above array.

@<basic@:light module@:C Structure@/data types@=
struct deque {
    Array array;
    int head;
    int tail;
    int size;
};
@

@<basic@:light module@:C Structure@/exported data type declarations@=
typedef struct deque *Deque;
@

@<basic@:light module@:C Structure@/static inline functions@=
static inline int
next_slot_back(Deque q)
{
    return (q->tail + 1) % q->size;
}

static inline int
previous_slot_back(Deque q)
{
    return (q->tail - 1 + q->size) % q->size;
}

static inline int
next_slot_front(Deque q)
{
    return (q->head - 1 + q->size) % q->size;
}

static inline int
previous_slot_front(Deque q)
{
    return (q->head + 1) % q->size;
}

static inline int
used_slots(Deque q)
{
    return (q->tail - q->head + q->size) % q->size;
}

static inline int
is_full_deque(Deque q)
{
    return used_slots(q) == q->size - 1;
}
@

@<basic@:light module@:C Structure@/functions@=
static void enlarge_deque(Deque q)
{
    int ns = q->size << 1; /* new size */
    int sht = q->size; /* shift */
    nth(q->array, ns - 1); /* ensure that array[0..ns) is accessable */
    if (q->head > q->tail) {
        memcpy(
            nth(q->array, q->head) + sht,
            nth(q->array, q->head),
            (q->size - q->head) * sizeof(void *)
        );
        q->head += sht;
    }
    q->size = ns;
}

Deque new_deque()
{
    Deque q;
    NEW0(q);
    q->array = new_array();
    q->head = 0;
    q->tail = 0;
    q->size = 2;
}

void free_deque(Deque q)
{
    free_array(q->array);
    FREE(q);
}

void clear_deque(Deque q)
{
    q->head = 0;
    q->tail = 0;
}

int is_empty_deque(Deque q)
{
    return q->tail == q->head;
}

int length_of_deque(Deque q)
{
    return used_slots(q);
}

void push_back(Deque q, void *elm)
{
    if (is_full_deque(q)) {
        enlarge_deque(q);
    }
    *nth(q->array, q->tail) = elm;
    q->tail = next_slot_back(q);
}

void push_front(Deque q, void *elm)
{
    if (is_full_deque(q)) {
        enlarge_deque(q);
    }
    q->head = next_slot_front(q);
    *nth(q->array, q->head) = elm;
}

void *pop_back(Deque q)
{
    if (is_empty_deque(q)) {
        return NULL;
    }
    q->tail = previous_slot_back(q);
    return *nth(q->array, q->tail);
}

void *pop_front(Deque q)
{
    if (is_empty_deque(q)) {
        return NULL;
    }

    void *elm = *nth(q->array, q->head);
    q->head = previous_slot_front(q);
    return elm;
}

void **nth_of_deque(Deque q, int n)
{
    if (n > used_slots(q)) {
        return NULL;
    }
    return nth(q->array, (q->head + n) % q->size);
}

void *last_value_of_deque(Deque q)
{
    return *nth_of_deque(q, used_slots(q) - 1);
}
@

Array of char is so important that Light reimplement most logic of array
just for better optimization.

@<basic@:light module@:C Structure@/data types@=
struct str {
    char *raw_string;
    int len;
    int mem_size;
};
@

@<basic@:light module@:C Structure@/exported data type declarations@=
typedef struct str *Str;
@

@<basic@:light module@:C Structure@/macros@=
#define INITIAL_MEM_SIZE 32
@

@<basic@:light module@:C Structure@/functions@=
Str new_str()
{
    Str s;
    NEW0(s);
    s->len = 0;
    s->mem_size = INITIAL_MEM_SIZE;
    CALLOC(s->raw_string, s->mem_size);
    return s;
}

void free_str(Str s)
{
    FREE(s->raw_string);
    FREE(s);
}

char *raw_string(Str str)
{
    return str->raw_string;
}

int str_length(Str str)
{
    return str->len;
}

void str_extend(Str str, const char *s)
{
    int new_len;

    new_len = str->len + strlen(s);
    if (str->mem_size < new_len) {
        while (str->mem_size < new_len) {
            str->mem_size <<= 1;
        }
        REALLOC_ARRAY(str->raw_string, str->mem_size);
    }
    strcpy(str->raw_string + str->len, s);
    str->len = new_len;
}

void str_append(Str str, char c)
{
    char s[2] = {c, '\0'};
    str_extend(str, s);
}

void str_clean(Str str)
{
    str->len = 0;
    str->raw_string[0] = '\0';
}
@

Besides lists, there is another type of data strucutre used everywhere, table.
There are many types of table, but they all share a common basic unit, key value pair.
Light call such a pair a record.

@<basic@:light module@:C Structure@/exported data types@=
struct table_record {
    const void *k;
    void *v;
};
@

@<basic@:light module@:C Structure@/exported data type declarations@=
typedef struct table_record *TableRecord;
@

Hashtable is the most common implementation of table.

@<basic@:light module@:C Structure@/data types@=
struct hash_table {
    Array table;
    size_t size;
    List slots;
    uint32_t (*hash_func)(const void *);
    int (*equal_func)(const void *, const void *);
};
@

@<basic@:light module@:C Structure@/exported data type declarations@=
typedef struct hash_table *HashTable;
@

@<basic@:light module@:C Structure@/static inline functions@=
static inline List *
record_list(HashTable tbl, const void *key)
{
    List *rcds_r;
    uint32_t hv;
    hv = tbl->hash_func(key);
    RENAME(nth(tbl->table, hv % tbl->size), rcds_r);
    return rcds_r;
}
@

@<basic@:light module@:C Structure@/functions@=
HashTable new_hash_table(size_t size, uint32_t hf(const void *), int eq(const void *, const void *))
{
    HashTable tbl;
    NEW0(tbl);
    tbl->table = new_array();
    tbl->size = size;
    tbl->slots = NULL;
    tbl->hash_func = hf;
    tbl->equal_func = eq;
    return tbl;
}

void free_hash_table(HashTable tbl)
{
    List *rcds_r; /* records */

    FOREACH (rcds_r, tbl->slots) {
        TableRecord *rcd_r;
        FOREACH (rcd_r, *rcds_r) {
            FREE(rcd_r);
        }
        free_list(*rcds_r);
    }
    free_list(tbl->slots);
    free_array(tbl->table);
    FREE(tbl);
}

List mappings_of_hash_table(HashTable tbl)
{
    List ms = NULL;
    List *rcds_r; /* records */

    FOREACH (rcds_r, tbl->slots) {
        TableRecord *rcd_r;
        FOREACH (rcd_r, *rcds_r) {
            push(rcd_r, &ms);
        }
    }
    return ms;
}
@

@<basic@:light module@:C Structure@/static inline functions@=
DECLARE_FUNCTION(key_equal_record_key,
    int (*eq)(const void *, const void *);
    const void *key;
    TableRecord rcd;
)

DEFINE_FUNCTION(key_equal_record_key,
    int res, *res_r;
    res = args->eq(args->key, args->rcd->k);
    MOVE(&res, res_r);
    return res_r;
)
@

@<basic@:light module@:C Structure@/functions@=
void *put_to_hash_table(HashTable tbl, const void *key, void *v)
{
    TableRecord rcd;

    List *rcds_r; /* records */
    rcds_r = record_list(tbl, key);

    UNDER( /* search the already stored keys */
        Function record_is_of_key = FUNCTION(key_equal_record_key);
        fill_argument(record_is_of_key, tbl->equal_func);
        fill_argument(record_is_of_key, (void *)key);

        rcd = find_first(record_is_of_key, *rcds_r);
    );

    if (!rcd) { /* create a new record */
        NEW0(rcd);
        rcd->k = key;
        push(rcd, rcds_r);
        push(rcds_r, &tbl->slots);
    }

    void *orig = rcd->v;
    rcd->v = v;

    return orig;
}

void *get_from_hash_table(HashTable tbl, const void *key)
{
    TableRecord rcd = NULL;

    List rcds; /* records */
    rcds = *record_list(tbl, key);

    UNDER( /* search the already stored keys */
        Function record_is_of_key = FUNCTION(key_equal_record_key);
        fill_argument(record_is_of_key, tbl->equal_func);
        fill_argument(record_is_of_key, (void *)key);

        rcd = find_first(record_is_of_key, rcds);
    );

    return rcd ? rcd->v : NULL;
}

void *remove_from_hash_table(HashTable tbl, const void *key)
{
    void *v = NULL;

    List *rcds_r; /* records */
    rcds_r = record_list(tbl, key);

    UNDER( /* search the already stored keys */
        Function record_is_of_key = FUNCTION(key_equal_record_key);
        fill_argument(record_is_of_key, tbl->equal_func);
        fill_argument(record_is_of_key, (void *)key);

        TableRecord rcd;
        ESCAPE(rcd = remove_first(record_is_of_key, rcds_r));
        if (rcd) {
            v = rcd->v;
            FREE(rcd);
        }
    );
    return v;
}
@

@<basic@:light module@:C Structure@/functions@=
static uint32_t hash_func_str(const void *s)
{
    return hash_str((const char *)s);
}

static int equal_func_str(const void *s1, const void *s2)
{
    return strcmp((const char *)s1, (const char *)s2) == 0;
}

HashTable new_string_hash_table(size_t size)
{
    return new_hash_table(size, hash_func_str, equal_func_str);
}
@

If a user not sure that how big a hash table might be, 1024 might be a reasonable starting point.

@<basic@:light module@:C Structure@/exported macros@=
#define HASH_TABLE_DEFAULT_SIZE (1024)
@

Light chooses FNV-1a as the default hash algorithm, the main usage is to calculate keys
from a set of small values anyway.

@<basic@:light module@:C Structure@/exported static inline functions@=
static inline uint32_t
hash(const uint8_t *value, size_t len)
{
    uint32_t result;

    int i;
    for (i = 0, result = 2166136261U; i < len; ++i) {
        result ^= value[i];
        result *= 16777619U;
    }

    return result;
}

static inline uint32_t
hash_str(const char *str)
{
    return hash((const uint8_t *)str, strlen(str));
}
@

A list can be used as a table.

@<basic@:light module@:C Structure@/data types@=
struct assoc_table {
    List records;
    int (*equal_func)(const void *, const void *);
};
@

@<basic@:light module@:C Structure@/exported data type declarations@=
typedef struct assoc_table *AssocTable;
@

@<basic@:light module@:C Structure@/functions@=
AssocTable new_assoc_table(int eq(const void *, const void *))
{
    AssocTable tbl;
    NEW(tbl);
    tbl->records = NULL;
    tbl->equal_func = eq;
    return tbl;
}

void free_assoc_table(AssocTable tbl)
{
    TableRecord rcd;
    FOREACH (rcd, tbl->records) {
        FREE(rcd);
    }

    free_list(tbl->records);
    FREE(tbl);
}

void put_to_assoc_table(AssocTable tbl, const void *key, void *v)
{
    TableRecord rcd;
    UNDER(
        Function record_is_of_key = FUNCTION(key_equal_record_key);
        fill_argument(record_is_of_key, tbl->equal_func);
        fill_argument(record_is_of_key, (void *)key);

        rcd = find_first(record_is_of_key, tbl->records);
    );
    if (!rcd) {
        NEW(rcd);
        rcd->k = key;
        push(rcd, &tbl->records);
    }
    rcd->v = v;
}

void *get_from_assoc_table(AssocTable tbl, const void *key)
{
    TableRecord rcd;
    void *ret;
    UNDER(
        Function record_is_of_key = FUNCTION(key_equal_record_key);
        fill_argument(record_is_of_key, tbl->equal_func);
        fill_argument(record_is_of_key, (void *)key);

        rcd = find_first(record_is_of_key, tbl->records);
    );
    if (rcd) {
        ret = rcd->v;
    } else {
        ret = NULL;
    }
    return ret;
}

void remove_from_assoc_table(AssocTable tbl, const void *key)
{
    UNDER(
        Function record_is_of_key = FUNCTION(key_equal_record_key);
        fill_argument(record_is_of_key, tbl->equal_func);
        fill_argument(record_is_of_key, (void *)key);

        TableRecord rcd;
        ESCAPE(rcd = remove_first(record_is_of_key, &tbl->records));
        FREE(rcd);
    );
}

static int equal_func_reference(const void *r1, const void *r2)
{
    return r1 == r2;
}

AssocTable new_reference_assoc_table()
{
    return new_assoc_table(equal_func_reference);
}

AssocTable new_string_assoc_table()
{
    return new_assoc_table(equal_func_str);
}
@

Sometimes we only want to reserve one copy of data, any following referencing
to the same data can use that copy. Hash table is a natural choice for this purpose.
A such copy is usually called an atom.

@<basic@:light module@:C Structure@/data types@=
struct atom {
    const uint8_t *block;
    size_t len;
};
@

@<basic@:light module@:C Structure@/functions@=
static uint32_t hash_func_atom(const void *a)
{
    struct atom *_a;
    RENAME(a, _a);

    return hash(_a->block, _a->len);
}

static int equal_func_atom(const void *a1, const void *a2)
{
    struct atom *_a1, *_a2;
    RENAME(a1, _a1);
    RENAME(a2, _a2);
    return _a1->len == _a2->len
           && memcmp(_a1->block, _a2->block, _a1->len) == 0;
}
@

Because of the introducing of context, the management of atoms should be treated carefully.
Whether they should be global or localized under a context, Light choose the later way.

@<basic@:light module@:C Structure@/macros@=
#ifndef ptr_to_atoms_size
#define ptr_to_atoms_size (6)
#endif
@

@<basic@:light module@:C Structure@/global variables@=
static MAPPING_PTR(atoms);
@

@<basic@:light module@:C Structure@/macros@=
#ifndef ATOMS_DEFAULT_SIZE
#define ATOMS_DEFAULT_SIZE (1<<10)
#endif
@

@<basic@:light module@:C Structure@/functions@=
void init_atoms(size_t size)
{
    if (!mapped_by_ptr(atoms, _light_top_context)) {
        map_ptr_to(atoms, _light_top_context, new_hash_table(size, hash_func_atom, equal_func_atom));
    }
}

static void clean_mapping(void *mp)
{
    unmap_ptr(atoms, *(Context *)mp);
    free(mp);
}

static void new_mapping(Context ctx, HashTable atoms)
{
    Context *mp;
    mp = malloc(sizeof(*mp));
    *mp = ctx;
    new_resource(mp, clean_mapping);
    map_ptr_to(atoms, ctx, atoms);
}

void *atom(const uint8_t *blk, size_t len)
{
    HashTable atoms;
    struct atom a;
    void *p;

    if (!RENAME(mapped_by_ptr(atoms, _light_top_context), atoms)) {
        RENAME(new_hash_table(ATOMS_DEFAULT_SIZE, hash_func_atom, equal_func_atom), atoms);
        new_mapping(_light_top_context, atoms);
    }

    a.block = blk;
    a.len = len;

    p = get_from_hash_table(atoms, &a);

    if (p == NULL) {
        uint8_t *_blk = NULL;
        MOVE_ARRAY(blk, _blk, len);
        a.block = _blk;

        struct atom *a_r = NULL;
        MOVE(&a, a_r);
        put_to_hash_table(atoms, a_r, a_r);
        p = a_r;
    }

    return p;
}

const char *atom_str(const char *str)
{
    struct atom *a_r;
    RENAME(atom((const uint8_t *)str, strlen(str) + 1), a_r);
    return (const char *)(a_r->block);
}
@

@<state@:light module@:C Structure@/module properties@=
name => "state",
@

@[state.c@=
@<state@:light module@:C Structure@/module@>
@

@[state.h@=
@<state@:light module@:C Structure@/module interface@>
@

@<state@:light module@:C Structure@/includes@=
#include "light.h"
@

@<state@:light module@:C Structure@/data type declarations@=
@<list@:light@:C Structure@/exported data type declarations@>
@

@<state@:light module@:C Structure@/data types@=
struct state {
    State parent;
    StateType type;
    List children;
    State active_child;
    State last_child;
    State (*handler)(State, Signal);
    State (*in)(State, Signal);
    State (*out)(State, Signal);
    void *local;
};
@

@<state@:light module@:C Structure@/exported data types@=
enum state_type {
    STATE_XOR,
    STATE_AND 
};
@

@<state@:light module@:C Structure@/exported data type declarations@=
typedef void *Signal;
typedef struct state *State;
typedef enum state_type StateType;
@

@<state@:light module@:C Structure@/exported macros@=
#define root_state NULL
@

@<state@:light module@:C Structure@/functions@=
State new_state(State p, StateType t, State (*hd)(State, Signal))
{
    State s;
    NEW0(s);
    s->parent = p;
    s->type = t;
    s->handler = hd;
    s->children = NULL;
    if (p != root_state) {
        push(s, &p->children);
    }
    return s;
}

void free_state(State s)
{
    free_list(s->children);
    FREE(s);
}

void
state_register_in_func(State s, State (*in)(State, Signal))
{
    s->in = in;
}

void
state_register_out_func(State s, State (*out)(State, Signal))
{
    s->out = out;
}
@

@<state@:light module@:C Structure@/functions@=
static void into_state(State s, Signal sig)
{
    if (s->in != NULL) {
        State cld;
        cld = s->in(s, sig);
        s->active_child = cld == NULL ? s->last_child : cld;
    }
    if (s->type == STATE_XOR && s->active_child) {
        into_state(s->active_child, sig);
    }
    if (s->type == STATE_AND) {
        State cld;
        FOREACH (cld, s->children) {
            into_state(cld, sig);
        }
    }
}

static void out_state(State s, Signal sig)
{
    if (s->type == STATE_XOR && s->active_child) {
        out_state(s->active_child, sig);
    }
    if (s->type == STATE_AND) {
        State cld;
        FOREACH (cld, s->children) {
            out_state(cld, sig);
        }
    }
    if (s->out != NULL) {
        State cld;
        cld = s->out(s, sig);
        s->last_child = cld == NULL ? s->active_child : cld;
    }
}
@

@<state@:light module@:C Structure@/functions@=
void state_init(State s)
{
    into_state(s, NULL);
}

void state_clear(State s)
{
    out_state(s, NULL);
}

int state_handle_signal(State s, Signal sig)
{
    State next;
    int handled = 0;

    next = s->handler == NULL ? NULL : s->handler(s, sig);
    if (next == NULL) {
        if (s->type == STATE_XOR && s->active_child != NULL) {
            handled = state_handle_signal(s->active_child, sig);
        }
        if (s->type == STATE_AND) {
            State cld;
            FOREACH (cld, s->children) {
                handled = state_handle_signal(cld, sig) || handled;
            }
        }
    } else {
        handled = 1;
        assert(next->parent == s->parent);
        if (next != s) {
            assert(s->parent != root_state && s->parent->type == STATE_XOR);
            out_state(s, sig);
            s->parent->active_child = next;
            into_state(next, sig);
        }
    }
    return handled;
}

void **state_local(State s)
{
    return &s->local;
}

int state_is_active(State s)
{
    State _s = s;

    while (_s->parent) {
        if (_s->parent->type == STATE_XOR && _s->parent->active_child != _s) {
            return 0;
        }
        _s = _s->parent;
    }
    return 1;
}
@

The model of states:

[
    {
        name => NAME_OF_STATE,
        parent => PARENT_OF_STATE,
        type => TYPE_OF_STATE (optional),
    },
    ...
]

@<C structs for state@=
sub state_to_c_var {
    "state_$_[0]->{name}"
}

sub state_to_handler {
    state_to_c_var($_[0]) . "_handler"
}

sub state_to_in_func {
    state_to_c_var($_[0]) . "_in"
}

sub state_to_out_func {
    state_to_c_var($_[0]) . "_out"
}

sub state_to_dec (_) {
    "State @@{[state_to_c_var($_[0])]};"
}
@

@<declaration of states@=@<Text Processing@/basic perl settings@>
@<C structs for state@>
my $model = [@<states@>];

print join "\n", map state_to_dec, @@{$model};
@|Basics@/evaluate@

@<initialization of states@=@<Text Processing@/basic perl settings@>
@<C structs for state@>
my $model = [@<states@>];
my @model = @@{$model};
my %states = ();

for my $st (@model) {
    $states{$st->{name}} = $st;
}

sub state_to_init (_) {
    my($st, $s) = ($_[0], "");
    $s .= "new_state(&@@{[state_to_c_var($st)]},";
    if ($st->{parent}) {
        $s .= " @@{[state_to_c_var($states{$st->{parent}})]},";
    } else {
        $s .= "root_state,";
    }
    if ($st->{type} && $st->{type} eq "and") {
        $s .= " STATE_AND,";
    } else {
        $s .= " STATE_XOR,";
    }
    $s .= " @@{[state_to_handler($st)]});\n";
    $s .= "state_register_in_func(@@{[state_to_c_var($st)]}, @@{[state_to_in_func($st)]});\n";
    $s .= "state_register_out_func(@@{[state_to_c_var($st)]}, @@{[state_to_out_func($st)]});\n";
    $s
}

my $str = join "\n", map state_to_init, @model;
$str .= "\nstate_init(@@{[state_to_c_var($model[0])]});\n";
print $str;
@|Basics@/evaluate@

@<cleaning of states@=@<Text Processing@/basic perl settings@>
@<C structs for state@>
my $model = [@<states@>];
my @model = @@{$model};

sub state_to_free (_) {
    "free_state(&@@{[state_to_c_var($_[0])]});";
}

my $str = "state_clear(@@{[state_to_c_var($model[0])]});\n";
$str .= join "\n", map state_to_free, @model;
print($str);
@|Basics@/evaluate@

@. lib/basic.la
@. lib/text-processing.la
@. lib/c-structure.la
