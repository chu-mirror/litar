@- Light

Light is a framework mainly for C programming.
It reflects the author's preferences and customs, which includes how to format code,
how to manage memory, how to handle exception, etc.

The flags showing that a module was included follow this pattern.
@<light@:C Module@/C module properties@=
included_flag_format => '_LIGHT_%s',
@

Include headers for debugging.
@<light@:C Module@/includes@=
#include <assert.h>
#ifndef NDEBUG
#include <stdio.h>
#endif
@

There are some idioms to make life a bit easier.
@<light@:C Module@/macros@=
/* Give value a new name, and force type casting. */
#define RENAME(old, new) new = (typeof(new))old

/* Generic data structure usually accept pointers, enable them to handle
 * integers. */
#define VALUE(v) (void *)(ptrdiff_t)(v)

#define ZEROFY(p, n) memset((p), 0, sizeof(*p) * (n))
#define ZEROFY_SINGLE(p) ZEROFY(p, 1)

#define COPY(src, dest) memcpy((dest), (src), sizeof(*(src)))

#define SIGN(v) (((v) > 0) - ((v) < 0))
#define ABS(v) ((v) * SIGN(v))
#define BETWEEN(v, l, r)                                             \
    ((((l) <= (v)) && ((v) < (r))) || (((r) <= (v)) && ((v) < (l))))
#define SWAP(a, b)                             \
    do {                                       \
        typeof(a) *a_r = &(a), *b_r = &(b), t; \
        t = *a_r;                              \
        *a_r = *b_r;                           \
        *b_r = t;                              \
    } while (0)
@

@<light@:C Module@/includes@=
#include <stdlib.h>
#include <string.h>
@

@<light@:C Module@/interface required includes@=
#include <stddef.h>
@

Light uses hash tables extensively to extend the relations
between pointers and other entities
without modify the data structure that the pointer reference to.
The hash algorithm chosen is Fibonacci Hashing.

@<light@:C Module@/macros@=
#define GOLDEN_RATIO_64 (0x9E3779B97F4A7C15ULL)
@

@<light@:C Module@/includes@=
#include <stdint.h>
@

@<light@:C Module@/static inline functions@=
static inline uint64_t _hash_fibonacci(uint64_t v) {
    return GOLDEN_RATIO_64 * v;
}

static inline uint64_t _hash_ptr(void *p) {
    return _hash_fibonacci((uintptr_t)p);
}
@

@<light@:C Module@/data types@=
struct _hash_table_ptr_entry {
    struct _hash_table_ptr_entry *next;
    void *ptr;
    void *val;
};
@

@<light@:C Module@/macros@=
#define MAPPING_PTR(name) \
    struct _hash_table_ptr_entry *ptr_to_##name[1 << ptr_to_##name##_size]
@

@<light@:C Module@/static inline functions@=
static inline struct _hash_table_ptr_entry **
_mapping_find_entry(struct _hash_table_ptr_entry **mapping, size_t size, void *k)
{
    uint64_t h = _hash_ptr(k);
    h = h & (1<<size)-1;
    struct _hash_table_ptr_entry *ent, *ent_;
    ent_ = NULL;
    ent = mapping[h];
    while (ent && ent->ptr != k) {
        ent_ = ent;
	ent = ent->next;
    }
    if (ent && ent_) { /* move the found entry to top of chain */
        ent_->next = ent;
	ent->next = mapping[h];
	mapping[h] = ent;
    }
    return &mapping[h];
}

static inline void _map_ptr_to(struct _hash_table_ptr_entry **mapping, size_t size, void *k, void *v)
{
    struct _hash_table_ptr_entry *ent, **ent_r;
    ent_r = _mapping_find_entry(mapping, size, k);
    if (*ent_r && (*ent_r)->ptr == k) {
        (*ent_r)->val = v;
    } else {
        ent = malloc(sizeof(*ent));
	ent->next = *ent_r;
	ent->ptr = k;
	ent->val = v;
	*ent_r = ent;
    }
}

static inline void _unmap_ptr(struct _hash_table_ptr_entry **mapping, size_t size, void *k)
{
    struct _hash_table_ptr_entry **ent_r, *ent;
    ent_r = _mapping_find_entry(mapping, size, k);
    if (*ent_r && (*ent_r)->ptr == k) {
        ent = *ent_r;
	*ent_r = ent->next;
	free(ent);
    }
}

static inline void *_mapped_by_ptr(struct _hash_table_ptr_entry **mapping, size_t size, void *k)
{
    struct _hash_table_ptr_entry **ent_r;
    ent_r = _mapping_find_entry(mapping, size, k);
    if (!*ent_r || (*ent_r)->ptr != k) {
        return NULL;
    }
    return (*ent_r)->val;
}
@

Some convenient macros.

@<light@:C Module@/macros@=
#define map_ptr_to(name, k, v) _map_ptr_to(ptr_to_##name, ptr_to_##name##_size, (k), (v))
#define unmap_ptr(name, k) _unmap_ptr(ptr_to_##name, ptr_to_##name##_size, (k))
#define mapped_by_ptr(name, k) _mapped_by_ptr(ptr_to_##name, ptr_to_##name##_size, (k))
@

The forming of program follows a common pattern,
you build up a context, then you write program under that context.
The maintainance of contexts in C program is a hard work.
It contains allocating of memory, and requiring resources from operating system,
what's more, the memory or resources allocated must be released at some point.
This kind of management is a major source of bugs in C programs,
because C program lacks a garbage collector.

C does not have an explicit notation for contexts, so Light defines its own.

@<context@:light@:C Module@/C module properties@=
name => 'context',
@

@[context.c@=
@<context@:light@:C Module@/C module@>
@

@[context.h@=
@<context@:light@:C Module@/C module interface@>
@

A context can be embedded to another context,
so the current context is in fact a stack of contexts.
This might not be correct if the program is multi-threaded. In that case,
the organization of contexts is like a tree.
The context a context embedded to is the parent context of that context.

A context has a list of resources, the resources must know how to release themselves.

@<context@:light@:C Module@/exported data type declarations@=
typedef struct context *Context;
typedef struct resource *Resource;
@

@<context@:light@:C Module@/data types@=
struct resource_node {
    struct resource_node *previous, *next;
    Resource resource;
};

struct context {
    Context parent;
    struct resource_node *resources;
};

struct resource {
    void *identity;
    void (*clean)(void *);
};
@

@<context@:light@:C Module@/global variables@=
Context _light_top_context;
@

@<context@:light@:C Module@/macros@=
#define ptr_to_resource_node_size (12)
@

@<context@:light@:C Module@/global variables@=
static MAPPING_PTR(resource_node);
@

@<context@:light@:C Module@/functions@=
void enter_context() {
    Context ctx;
    ctx = malloc(sizeof(*ctx));
    ctx->parent = _light_top_context;
    ctx->resources = NULL;
    _light_top_context = ctx;
#ifndef NDEBUG
    fprintf(stderr, "Enter context: %p\n", ctx);
#endif
}

void new_resource(void *id, void (*cl)(void *)) {
    Resource res;
    res = malloc(sizeof(*res));
    res->identity = id;
    res->clean = cl;

    struct resource_node *nd;
    nd = malloc(sizeof(*nd));
    nd->resource = res;
    nd->next = _light_top_context->resources;
    nd->previous = NULL;
    if (nd->next) {
	nd->next->previous = nd;
    }

    _light_top_context->resources = nd;
    map_ptr_to(resource_node, id, nd);
#ifndef NDEBUG
    fprintf(stderr, "New resource: %p, under: %p\n", id, _light_top_context);
#endif
}

void delete_resource(void *id) {
    struct resource_node *nd;
    nd = mapped_by_ptr(resource_node, id);
    if (nd->previous) {
        nd->previous->next = nd->next;
    } else {
        _light_top_context->resources = nd->next;
    }
    if (nd->next) {
        nd->next->previous = nd->previous;
    }
    
    unmap_ptr(resource_node, id);
    Resource res = nd->resource;
#ifndef NDEBUG
    fprintf(stderr, "Free resource: %p, under: %p\n", res->identity, _light_top_context);
#endif
    res->clean(res->identity);
    free(nd);
}

void rename_resource(void *id1, void *id2) {
    struct resource_node *nd;
    nd = mapped_by_ptr(resource_node, id1);
    unmap_ptr(resource_node, id1);

    nd->resource->identity = id2;
    map_ptr_to(resource_node, id2, nd);
#ifndef NDEBUG
    fprintf(stderr, "Rename resource: %p, to: %p, under: %p\n", id1, id2, _light_top_context);
#endif
}

void exit_context() {
    Context ctx = _light_top_context;

    struct resource_node *nd, *nd_;
    for (nd_ = NULL, nd = ctx->resources; nd != NULL; nd_ = nd, nd = nd->next, free(nd_)) {
	Resource res = nd->resource;
#ifndef NDEBUG
	fprintf(stderr, "Free resource: %p, under: %p\n", res->identity, _light_top_context);
#endif
	res->clean(res->identity);
	unmap_ptr(resource_node, res->identity);
	free(res);
    }

    _light_top_context = _light_top_context->parent;
    free(ctx);
#ifndef NDEBUG
    fprintf(stderr, "Exit context: %p\n", ctx);
#endif
}
@

@<context@:light@:C Module@/interface specific macros@=
#define UNDER_CONTEXT(...) \
    do { \
        enter_context(); \
	Context _block_top_context = _light_top_context; \
	__VA_ARGS__; \
	GO_BACK(); \
	exit_context(); \
    } while (0)

#define GO_BACK() do { while (_block_top_context != _light_top_context) exit_context(); } while (0)

#define ESCAPE(...) \
    do { \
	Context __temp_context = _light_top_context; \
	_light_top_context = _light_top_context->parent; \
	__VA_ARGS__; \
	_light_top_context = __temp_context; \
    } while (0)
@

@<light@:C Module@/main body@=
UNDER_CONTEXT(@<main body@>);
@

@<light@:C Module@/includes@=
#include "context.h"
@

Based on the context defined, Light refines the memory management.

@<light@:C Module@/macros@=
#define NEW(p) \
    do { \
        typeof(p) *p_r = &(p); \
        (*p_r) = (typeof(p))malloc(sizeof *(p)); new_resource(*p_r, free); \
    } while (0)
#define FREE(p) delete_resource(p)
#define CALLOC(p, len) \
    do { \
        typeof(p) *p_r = &(p); \
        (*p_r) = (typeof(p))calloc((len), sizeof *(p)); new_resource(*p_r, free); \
    } while (0)
#define NEW0(p) CALLOC(p, 1)
#define REALLOC_ARRAY(p, len) \
    do { \
        typeof(p) *p_r = &(p); \
	void *p_ = *p_r; \
	(*p_r) = (typeof(p))reallocarray(*p_r, sizeof *(p), (len)); \
	rename_resource(p_, *p_r); \
    } while (0)
#define MOVE(src, dest) \
    do { \
        typeof(dest) *dest_r = &(dest); \
        NEW(*dest_r); memcpy((*dest_r), (src), sizeof *(dest)); \
    } while (0)
#define MOVE_ARRAY(src, dest, n) \
    do { \
        typeof(dest) *dest_r = &(dest); \
        CALLOC(*dest_r, n); memcpy((*dest_r), (src), sizeof *(dest) * (n)); \
    } while (0)
#define STRDUP(src, dest) \
    do { \
        typeof(dest) *dest_r = &(dest); \
        (*dest_t) = strdup(src); new_resource(*dest_t, free); \
    } while (0)
@

@<list@:light@:C Module@/C module properties@=
name => 'list',
@

@[list.c@=
@<list@:light@:C Module@/C module@>
@

@[list.h@=
@<list@:light@:C Module@/C module interface@>
@

@<list@:light@:C Module@/exported data type declarations@=
typedef struct list *List;
@

@<list@:light@:C Module@/data types@=
struct list {
    struct list *rest;
    void *first;
};
@

The API of list adopts the naming of lisp.
@<list@:light@:C Module@/functions@=
List cons(void *ele, List l)
{
    List _l = NULL;

    NEW(_l);
    _l->first = ele;
    _l->rest = l;

    return _l;
}

void *car(List l)
{
    return l->first;
}

List cdr(List l)
{
    return l->rest;
}
@

@<list@:light@:C Module@/functions@=
size_t length(List l)
{
    size_t len;

    for (len = 0; !is_empty_list(l); l = cdr(l)) {
        ++len;
    }

    return len;
}
@

A list can be easily used as a stack.
@<list@:light@:C Module@/functions@=
List push(void *elm, List *l_r)
{
    return *l_r = cons(elm, *l_r);
}

void *pop(List *l_r)
{
    List _l = cdr(*l_r);
    void *v = car(*l_r);
    (*l_r)->rest = empty_list;
    FREE(*l_r);
    *l_r = _l;
    return v;
}
@

Construct a list from other linear structures.
@<list@:light@:C Module@/functions@=
List list_from_arr(void *arr, size_t len, size_t size)
{
    int i;
    List l = empty_list;
    for (i = 0; i < len; ++i) {
        push(arr + (len - i - 1) * size, &l);
    }
    return l;
}

List copy_list(List l)
{
    List _l = empty_list;

    do {
        List tail, __l;
        void *elm;

        tail = cons(NULL, empty_list);
        __l = tail;
        FOREACH (elm, l) {
            List nn; /* new node */
            nn = cons(elm, empty_list);
            tail->rest = nn;
            tail = nn;
        }
        _l = cdr(__l);
        FREE(__l);
    } while (0);

    return _l;
}
@

Modify the underlying structure of list.

@<list@:light@:C Module@/functions@=
void reverse(List *l_r)
{
    List l, ll;

    l = *l_r;
    ll = empty_list;

    while (l != empty_list) {
        List l_t = l->rest;
        l->rest = ll;
        ll = l;
        l = l_t;
    }

    *l_r = ll;
}

List append(List *l1_r, List *l2_r)
{
    List l;

    if (is_empty_list(*l1_r)) {
        l = *l2_r;
        *l2_r = empty_list;
        return l;
    }

    do { /* find tail |l| of |*l1_r| */
        l = *l1_r;
        while (!is_empty_list(cdr(l))) {
            l = cdr(l);
        }
        l->rest = *l2_r;
    } while (0);

    l = *l1_r;

    *l1_r = empty_list;
    *l2_r = empty_list;

    return l;
}
@

@<list@:light@:C Module@/exported macros@=
#define empty_list NULL
#define is_empty_list(l) ((l) == NULL)
#define _LIST(arr, len) list_from_arr((arr), len, sizeof((arr)[0]))
#define LIST(arr) _LIST((arr), sizeof(arr) / sizeof((arr)[0]))
#define FOREACH(elm, l)                                           \
    for (List __light_list_l = (l);                               \
         !is_empty_list(__light_list_l)                           \
         && (((elm) = (typeof(elm))car(__light_list_l)) != NULL); \
         __light_list_l = cdr(__light_list_l))
@

@[hash.c@=
@<hash@:light@:C Module@/C module@>
@

@[hash.h@=
@<hash@:light@:C Module@/C module interface@>
@

@<hash@:light@:C Module@/C module properties@=
name => "hash",
@

@<hash@:light@:C Module@/interface required includes@=
#include <stdint.h>
@

@<hash@:light@:C Module@/functions@=
uint32_t
hash(const uint8_t *value, size_t len)
{
    const uint32_t p = 257;
    uint32_t result, p_;
    int i;

    for (i = 0, p_ = p, result = 0; i < len; ++i) {
        result += *(value + i) * p_;
        p_ *= p;
    }
    return result;
}

uint32_t
hash_str(const char *str)
{
    return hash((const uint8_t *)str, strlen(str));
}
@

@. lib/basic.la
@. lib/text-processing.la
@. lib/c-structure.la
