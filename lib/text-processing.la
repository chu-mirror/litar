@? included Text Processing @|@|

@. lib/basic.la @

@<Text Processing@/summary@=
Text processing based on perl.

- `basic perl settings`: header for perl scripts;
- `remove newlines`: remove newlines from input.
@

@<Text Processing@/Internals@/path to perl interpreter@=
#!/bin/sh
which perl
@|Basic@/evaluate@

@<Text Processing@/basic perl settings@=
#!@<Text Processing@/Internals@/path to perl interpreter@>
use v5.14;
use warnings FATAL => 'all';
use strict;
@

@<Text Processing@/remove newlines@=
@<Text Processing@/basic perl settings@>
my @pres = <STDIN>;
chomp @pres;
print "@pres";
@

@! included Text Processing @
@

