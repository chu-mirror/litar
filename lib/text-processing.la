@? included Text Processing @|@|

@. lib/basic.la @

@- Text Processing @

@<summary@=
Text processing based on perl.

- `basic perl settings`: header for perl scripts;
- `remove newlines`: remove newlines from input.
@

@<path to perl interpreter@=
#!/bin/sh
which perl
@|Basics@/evaluate@

@<basic perl settings@=
#!@<path to perl interpreter@>
use v5.14;
use warnings FATAL => 'all';
use strict;
@

@<remove newlines@=
@<basic perl settings@>
my @pres = <STDIN>;
chomp @pres;
print "@pres";
@

@! included Text Processing @
@

