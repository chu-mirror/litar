@- Text Processing

@<path to perl interpreter@=#!/bin/sh
which perl
@|Basics@/evaluate@

@<basic perl settings@=#!@<path to perl interpreter@>
use v5.14;
use warnings;
@

@<remove newlines@=@<Text Processing@/basic perl settings@>
my @pres = <STDIN>;
chomp @pres;
print "@pres";
@

