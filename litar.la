}
static State state_command_waiting_handler(State s, Signal sig)
{
    Token tkn;
    RENAME(sig, tkn);
    if (tkn->type == TOKEN_CONTROL_CHARACTER) {
        return *control_character_to_state[tkn->value];
    }
