
@<litar.c@>=
@<includes@>

@<flags@>
@<global variables@>

int main(int argc, char *argv[])
{
    @<parse command line arguments to set flags and global variables@>
    @<perform operations according to flags@>
    return 0;
}
@

@<parse command line arguments to set flags and global variables@>=
do {
    int opt;
    while ((opt = getopt(argc, argv, "v")) != -1) {
        switch (opt) {
        case 'v':
            @<print version information@|fill in build time infomation@>
            do_not_perform_operations = true;
            break;
        default:
            break;
        }
    }
} while (0);
@

@<flags@>=
bool do_not_perform_operations;
@

@<perform operations according to flags@>=
if (!do_not_perform_operations) {
    @<perform some operations according to flags@>
}
@

@<global variables@>=
char version[] = "dev";
@

@<print version information@>=
printf("Version %s, built at <build time>\n", version);
@

@<fill in build time infomation@>=
sed -e "s/<build time>/$(date -Iminute)/g"
@

@<perform some operations according to flags@>=
printf("Performing operations\n");
@

@<includes@>=
#include <stdio.h>
#include <string.h>
#include <stdbool.h>
#include <unistd.h>
@

