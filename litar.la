# Parsing

The purpose of parsing is to extract relations between objects of
a specific domain from unstructured information.

The grammar of litar is designed deliberately to be as simple as possible.
As a result, the tokens only have four types, control character,
normal character, newline and EOF,
and the whole parsing process can be implemented as a finite state machine.

@<litarfs@:light@:C Structure@/data types@=
typedef struct {
    const char *file;
    FILE *in;
    /* current position, current column, current row */
    int cp, cc, cr;
    /* previous position, previous column, previous row */
    int pp, pc, pr;
} *InputFrame;

typedef struct {
    enum {
        TOKEN_CONTROL_CHARACTER,
        TOKEN_NORMAL_CHARACTER,
        TOKEN_NEWLINE,
        TOKEN_EOF,
    } type;
    char value;
} *Token;
@

@<litarfs@:light@:C Structure@/functions@=
static Token next_token(InputFrame ipt)
{
    Token tkn = NULL;
    char c;
    int n = 0;

    if (!ipt->in) {
        if ((ipt->in = fopen(ipt->file, "r")) == NULL) {
            perror(ipt->file);
            longjmp(exit_main, 1);
        }
    }

    NEW0(tkn);

    ipt->pp = ipt->cp;
    ipt->pc = ipt->cc;
    ipt->pr = ipt->cr;

    n += (c = fgetc(ipt->in)) == EOF ? 0 : 1;
    if (c == '\100') {
        n += (c = fgetc(ipt->in)) == EOF ? 0 : 1;
        if (isalpha(c)) {
            n -= ungetc(c, ipt->in) == EOF ? 0 : 1;
            tkn->type = TOKEN_NORMAL_CHARACTER;
            tkn->value = '\100';
        } else {
            tkn->type = TOKEN_CONTROL_CHARACTER;
            if (c == EOF || c == '\n' || c == '\t' || c == ' ') {
                tkn->value = ' ';
            } else {
                tkn->value = c;
            }
            if (c == '\n') {
                n -= ungetc(c, ipt->in) == EOF ? 0 : 1;
            }
        }
    } else if (c == '\n') {
        tkn->type = TOKEN_NEWLINE;
        tkn->value = '\n';
        ipt->cp += n;
        ++ipt->cr;
        ipt->cc = 0;
        n = 0;
    } else if (c == EOF) {
        tkn->type = TOKEN_EOF;
        tkn->value = EOF;
    } else {
        tkn->type = TOKEN_NORMAL_CHARACTER;
        tkn->value = c;
    }
    ipt->cp += n;
    ipt->cc += n;

    return tkn;
}
@

There's a lot of names in a litar archive. To avoid potential miss use of
blanks, the names are normalized according to a simple rule.
The names consists of none-space words, so "name of chunk" does not
differ from "  name  of  chunk".

@<litarfs@:light@:C Structure@/functions@=
const char *
normalize(const char *name)
{
    int i = 0, j = 0, l = strlen(name);
    char *norm = NULL;

    STRDUP(name, norm);

    l = strlen(name);
    while (i < l) {
        if (isspace(name[i])) {
            if (j != 0 && !isspace(norm[j-1])) {
                norm[j++] = ' ';
            }
        } else {
            norm[j++] = name[i];
        }
        ++i;
    }
    if (isspace(norm[j-1])) {
        norm[j-1] = '\0';
    } else {
        norm[j] = '\0';
    }

    const char *a;
    a = atom_str(norm);

    FREE(norm);

    return a;
}
@

@<litarfs@:light@:C Structure@/data type declarations@=
@<basic@:light module@:C Structure@/exported data type declarations@>
@<state@:light module@:C Structure@/exported data type declarations@>
@

@<litarfs@:light@:C Structure@/global variables@=
@<parse@:Light@/declaration of states@>
@

There are some common patterns will be used many times.

@<litarfs@:light@:C Structure@/functions@=
static State state_parse_text_in(State s, Signal sig)
{
    Str cache = new_str();
    s->local = cache;
    return NULL;
}
static State state_parse_text_handler(State s, Signal sig)
{
    Token tkn;
    RENAME(sig, tkn);

    Str cache;
    RENAME(s->local, cache);

    if (tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == '\100') {
        str_append(cache, '\100');
        return s;
    }
    if (tkn->type == TOKEN_NORMAL_CHARACTER || tkn->type == TOKEN_NEWLINE) {
        str_append(cache, tkn->value);
        return s;
    }
    if (tkn->type == TOKEN_CONTROL_CHARACTER) {
        return s->parent;
    }
    return NULL;
}
static State state_parse_text_out(State s, Signal sig)
{
    free_str((Str)s->local);
    return NULL;
}
@

@<litarfs@:light@:C Structure@/data types@=
struct state_parse_chunk_ref_local {
    List labels;
    const char *module_name;
    const char *chunk_name;
};
@

@<litarfs@:light@:C Structure@/functions@=
static inline int is_chunk_ref_end(Token tkn)
{
    return tkn->type == TOKEN_CONTROL_CHARACTER
        && (tkn->value == '=' || tkn->value == '>' || tkn->value == ' ' || tkn->value == '|');
}
static State state_parse_chunk_ref_in(State s, Signal sig)
{
    struct state_parse_chunk_ref_local *lc_r;
    NEW0(lc_r);
    s->local = lc_r;
    return NULL;
}
static State state_parse_chunk_ref_handler(State s, Signal sig)
{
    Token tkn;
    RENAME(sig, tkn);
    if (is_chunk_ref_end(tkn)) {
        return s->parent;
    }
    return NULL;
}
static State state_parse_chunk_ref_out(State s, Signal sig)
{
    struct state_parse_chunk_ref_local *lc_r;
    RENAME(s->local, lc_r);
    free_list(lc_r->labels);
    FREE(lc_r);
    return NULL;
}
static State state_parse_chunk_ref_final(State sc, Signal sig)
{
    Token tkn;
    RENAME(sig, tkn);
    if (tkn->type == TOKEN_CONTROL_CHARACTER && (tkn->value == ':' | tkn->value == '/')) {
        return sc;
    }
    return NULL;
}
static void state_parse_chunk_ref_callback(State sc, Signal sig)
{
    Str cache;
    struct state_parse_chunk_ref_local *lc_r;
    RENAME(sc->local, cache);
    RENAME(sc->parent->local, lc_r);

    const char *name;
    name = normalize(raw_string(cache));

    Token tkn;
    RENAME(sig, tkn);
    if (tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == ':') {
        push((char *)name, &lc_r->labels);
    }
    if (tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == '/') {
        lc_r->module_name = name;
    }
    if (is_chunk_ref_end(tkn)) {
        lc_r->chunk_name = name;
    }
}
@

@<parse@:Light@/states@=
{
    name => "compile",
    type => "and",
    has_final => 1,
},
@

@<litarfs@:light@:C Structure@/data types@=
struct state_compile_local {
    List input_frames;
    Module current_module;
    Archive archive;
};
@

@<litarfs@:light@:C Structure@/functions@=
static State state_compile_in(State s, Signal sig)
{
    struct state_compile_local *lc_r;
    NEW0(lc_r);
    NEW0(lc_r->archive);
    lc_r->current_module = module_of_name_in_archive("", lc_r->archive);
    s->local = lc_r;
    return NULL;
}

static State state_compile_handler(State s, Signal sig)
{
    Token tkn;
    RENAME(sig, tkn);

    if (tkn->type == TOKEN_EOF) {
        struct state_compile_local *lc_r;
        RENAME(s->local, lc_r);

        InputFrame ipt;
        RENAME(car(lc_r->input_frames), ipt);

        fclose(ipt->in);
        FREE(ipt);
        pop(&lc_r->input_frames);

        return s;
    }
    return NULL;
}

static State state_compile_out(State s, Signal sig)
{
    FREE(s->local);
    return NULL;
}
@

@<litarfs@:light@:C Structure@/functions@=
void put_to_input_frames(const char *ar, List *input_frames_r)
{
    char path[PATH_MAX+1];
    char *ptr = realpath(ar, path);
    if (ptr == NULL) {
        fprintf(stderr, "realpath %s: %s", ar, strerror(errno));
        longjmp(exit_main, 1);
    }
    InputFrame ipt = NULL;
    NEW0(ipt);
    ipt->file = atom_str(path);
    push(ipt, input_frames_r);
}

Archive parse_archive(const char *archive)
{
    Archive ret;

    @<parse@:Light@/initialization of states@>

    struct state_compile_local *lc_r;
    RENAME(state_compile->local, lc_r);

    put_to_input_frames(archive, &lc_r->input_frames);

    while (lc_r->input_frames) {
        Token tkn;
        InputFrame ipt;

        RENAME(car(lc_r->input_frames), ipt);

        UNDER(
            tkn = next_token(ipt);
#ifdef SHOW_COMPILE_INFO
            if (tkn->type == TOKEN_CONTROL_CHARACTER) {
                fprintf(stderr, "Handling control character %c\n", tkn->value);
            } else if (tkn->type == TOKEN_NORMAL_CHARACTER) {
                fprintf(stderr, "Handling normal character %c\n", tkn->value);
            } else if (tkn->type == TOKEN_NEWLINE) {
                fprintf(stderr, "Handling newline\n");
            } else if (tkn->type == TOKEN_EOF) {
                fprintf(stderr, "Handling EOF\n");
            }
#endif
            ESCAPE(
                if (!state_handle_signal(state_compile, tkn)) {
                    fprintf(
                        stderr,
                        "Unexpected token at row %d column %d of %s\n",
                        ipt->pr+1, ipt->pc+1, ipt->file
                    );
                    longjmp(exit_main, 1);
                }
            );
        );
    }
    ret = lc_r->archive;

    @<parse@:Light@/cleaning of states@>
    return ret;
}
@

@<litarfs@:light@:C Structure@/functions@=
void print_chunk_ref(ChunkRef ckr)
{
    fprintf(
        stderr,
        "Chunk: %s/%s, ",
        ckr->chunk->module->name,
        ckr->chunk->name
    );
    fprintf(stderr, "Labels: ");
    const char *lbl;
    FOREACH (lbl, ckr->labels) {
        fprintf(stderr, "%s ", lbl);
    }
}

void print_node(Node nd, int level)
{
    char *prefix = NULL;

    CALLOC(prefix, level+1);
    memset(prefix, '\t', level);
    prefix[level] = '\0';
    switch (nd->type) {
    case NODE_DIRECTORY:
        printf("%s%s/\n", prefix, nd->name);
        
        Node sub;
        FOREACH (sub, nd->value.nodes) {
            print_node(sub, level+1);
        }
        break;
    default:
        printf("%s%s\n", prefix, nd->name);
    }
    FREE(prefix);
}
@

@<show parsed information@=
Block blk;
reverse(&archive->blocks);
FOREACH (blk, archive->blocks) {
    fprintf(stderr, "Comment:\n%s\n", blk->comment);
    if (blk->chunk_ref) {
        fprintf(stderr, "Extending ");
        print_chunk_ref(blk->chunk_ref);
        fprintf(stderr, "\n");
        BlockContent blc;
        reverse(&blk->contents);
        FOREACH (blc, blk->contents) {
            if (blc->type == BLOCK_CONTENT_TEXT) {
                fprintf(stderr, "Text:\n%s\n", blc->value.text);
            } else if (blc->type == BLOCK_CONTENT_CHUNK) {
                print_chunk_ref(blc->value.chunk.chunk_ref);
                ChunkRef ckr;
                reverse(&blc->value.chunk.filters);
                FOREACH (ckr, blc->value.chunk.filters) {
                    fprintf(stderr, "\n|");
                    print_chunk_ref(ckr);
                }
                reverse(&blc->value.chunk.filters);
                fprintf(stderr, "\n");
            }
        }
        reverse(&blk->contents);
        reverse(&blk->filters);
        ChunkRef ckr;
        FOREACH (ckr, blk->filters) {
            fprintf(stderr, "\n|");
            print_chunk_ref(ckr);
        }
        reverse(&blk->filters);
        fprintf(stderr, "\n");
    }
}
reverse(&archive->blocks);
print_node(file_system_root, 0);
longjmp(exit_main, 2);
@

