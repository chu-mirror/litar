@<parse invocation syntax@=
import json
import sys
from typing import NamedTuple

class Option(NamedTuple):
    name: str
    argument: str
    comment: str

stx = json.load(sys.stdin)

name = stx["name"]
options = list(map(
    lambda opt: Option(opt[1], opt[2] if len(opt)==3 else None, opt[0]),
    stx["options"]
))
arguments = stx["arguments"]
@

@<synopsis for manpage@=#!/usr/bin/python
@<parse invocation syntax@>
str = f".B {name}\n"

def opt_to_str(opt):
    if opt.argument is not None:
        return f"\\fB\\-{opt[0]}\\fR \\fI{opt[1]}\\fR"
    else:
        return f"\\fB\\-{opt[0]}\\fR"

str += "[" + "|".join(map(opt_to_str, options)) + "]"
for arg in arguments:
    str += f" \\fI{arg}\\fR"
print(str)
@

@<options for manpage@=#!/usr/bin/python
@<parse invocation syntax@>
str = ""

def opt_to_str(opt):
    if opt.argument is None:
        return f".BR \\-{opt.name}\n"
    else:
        return f".BR \\-{opt.name} \" \" \\fI{opt.argument}\\fR\n"

for opt in options:
    str += ".TP\n"
    str += opt_to_str(opt)
    str += opt.comment + "\n"

print(str)
@

@<usage of invocation syntax@=#!/usr/bin/python
@<parse invocation syntax@>
str = "\""
str += name

def opt_to_str(opt):
    if opt.argument is not None:
        return f"-{opt[0]} {opt[1]}"
    else:
        return f"-{opt[0]}"

str += " [" + "|".join(map(opt_to_str, options)) + "]"

for arg in arguments:
    str += " " + arg
str += "\""

print(str, end="")
@

@<getopt string for invocation syntax@=#!/usr/bin/python
@<parse invocation syntax@>

def opt_to_str(opt):
    if opt.argument is None:
        return opt.name
    else:
        return opt.name + ":"

print("\"" + "".join(map(opt_to_str, options)) + "\"", end="")
@

@<parse model of states@=
import json
import sys
from typing import NamedTuple

states = {}

class State(NamedTuple):
    name: str
    parent: str

def state_to_c_var(st):
    return f"state_{st.name}"

def state_to_handler(st):
    return f"{state_to_c_var(st)}_handler"

def state_to_in_func(st):
    return f"{state_to_c_var(st)}_in"

def state_to_out_func(st):
    return f"{state_to_c_var(st)}_out"

model = json.load(sys.stdin)

for st in model:
    states[st[0]] = State(st[0], st[1])
@

@<declarations of states@=#!/usr/bin/python
@<parse model of states@>

def state_to_dec(st):
    return f"State {state_to_c_var(st)};"

str = "\n".join(map(state_to_dec, states.values())) + "\n"
print(str)
@

@<initialization of states@=#!/usr/bin/python
@<parse model of states@>

def state_to_init(st):
    s = ""
    s += f"new_state(&{state_to_c_var(st)},"
    s += f" {state_to_c_var(states[st.parent])}," if st.parent is not None else "root_state,"
    s += f" STATE_XOR,"
    s += f" {state_to_handler(st)});\n"
    s += f"state_register_in_func({state_to_c_var(st)}, {state_to_in_func(st)});\n"
    s += f"state_register_out_func({state_to_c_var(st)}, {state_to_out_func(st)});\n"
    return s

str = "\n".join(map(state_to_init, states.values())) + "\n"
str += f"state_init({state_to_c_var(list(states.values())[0])});\n"
print(str)
@

@<cleaning of states@=#!/usr/bin/python
@<parse model of states@>

def state_to_free(st):
    s = f"free_state(&{state_to_c_var(st)});"
    return s

str = f"state_clear({state_to_c_var(list(states.values())[0])});\n"
str += "\n".join(map(state_to_free, states.values())) + "\n"
print(str)
@

