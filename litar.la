@<litarfs@:light@:C Structure@/data types@=
struct state_parse_block_content_local {
    ChunkRef chunk_ref;
    List filters;
};
@

@<litarfs@:light@:C Structure@/functions@=
static State state_parse_block_content_in(State s, Signal sig)
{
    struct state_parse_block_content_local *lc_r;
    NEW0(lc_r);
    s->local = lc_r;
    return NULL;
}
static State state_parse_block_content_handler(State s, Signal sig)
{
    Token tkn;
    RENAME(sig, tkn);
    if (s->active_child == state_parse_block_content_text
        && tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == '|') {
        return state_parse_block_filters;
    }
    if (tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == ' ') {
        return state_parse_block_comment;
    }
    return NULL;
}
static State state_parse_block_content_out(State s, Signal sig)
{
    FREE(s->local);
    return NULL;
}
static void state_parse_block_content_callback(State sc, Signal sig)
{
    Block blk;
    RENAME(state_parse_block->local, blk);
    if (sc == state_parse_block_content_text) {
        Str cache;
        RENAME(sc->local, cache);

        char *text;
        STRDUP(raw_string(cache), text);
        block_contain_text(blk, text);
    }
    if (sc == state_parse_block_content_chunk_ref) {
        struct state_parse_chunk_ref_local *lc_r;
        struct state_parse_block_content_local *lcp_r;
        struct state_compile_local *ccl_r;
        RENAME(sc->local, lc_r);
        RENAME(sc->parent->local, lcp_r);
        RENAME(state_compile->local, ccl_r);

        Module mod;
        if (lc_r->module_name) {
            mod = module_of_name_in_archive(lc_r->module_name, ccl_r->archive);
        } else {
            mod = ccl_r->current_module;
        }

        ChunkRef ckr;
        NEW0(ckr);
        ckr->labels = copy_list(lc_r->labels);
        ckr->chunk = chunk_of_name_in_module(lc_r->chunk_name, mod);
        if (!lcp_r->chunk_ref) {
            lcp_r->chunk_ref = ckr;
        } else {
            push(ckr, &lcp_r->filters);
        }

        Token tkn;
        RENAME(sig, tkn);
        if (tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == '>') {
            block_include_chunk(blk, lcp_r->chunk_ref, lcp_r->filters);
            lcp_r->chunk_ref = NULL;
            lcp_r->filters = empty_list;
        }
    }
}
static State state_parse_block_content_final(State sc, Signal sig)
{
    Token tkn;
    RENAME(sig, tkn);

    if (sc == state_parse_block_content_text
        && tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == '<') {
        return state_parse_block_content_chunk_ref;
    }
    if (sc == state_parse_block_content_chunk_ref
        && tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == '>') {
        return state_parse_block_content_text;
    }
    if (sc == state_parse_block_content_chunk_ref
        && tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == '|') {
        return state_parse_block_content_chunk_ref;
    }

    return NULL;
}

static State state_parse_block_filters_in(State s, Signal sig)
{
    return NULL;
}
static State state_parse_block_filters_handler(State s, Signal sig)
{
    return NULL;
}
static State state_parse_block_filters_out(State s, Signal sig)
{
    return NULL;
}
@

@<litarfs@:light@:C Structure@/functions@=
static State state_parse_block_final(State sc, Signal sig)
{
    Token tkn;
    RENAME(sig, tkn);
    if (sc == state_parse_block_comment
        && tkn->type == TOKEN_CONTROL_CHARACTER
        && (tkn->value == '<' | tkn->value == '[' | tkn->value == '(')) {
        Block blk;
        RENAME(state_parse_block->local, blk);
        switch (tkn->value) {
        case '<':
            blk->chunk_type = CHUNK_TYPE_NORMAL;
            break;
        case '[':
            blk->chunk_type = CHUNK_TYPE_REGULAR_FILE;
            break;
        case '(':
            blk->chunk_type = CHUNK_TYPE_EXECUTABLE;
            break;
        }
        return state_parse_block_chunk_ref;
    }
    if (sc == state_parse_block_chunk_ref
        && tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == '=') {
        return state_parse_block_content;
    }
    if (sc == state_parse_block_filters
        && tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == '|') {
        return state_parse_block_filters;
    }
    if (sc == state_parse_block_filters
        && tkn->type == TOKEN_CONTROL_CHARACTER && tkn->value == ' ') {
        return state_parse_block_comment;
    }
    return NULL;
}
static void state_parse_block_callback(State sc, Signal sig)
{
    struct state_compile_local *ccl_r;
    RENAME(state_compile->local, ccl_r);

    Block blk;
    RENAME(sc->parent->local, blk);
    if (sc == state_parse_block_comment) {
        Str cache;
        RENAME(sc->local, cache);
        char *comment;
        STRDUP(raw_string(cache), comment);
        blk->comment = comment;
    }

    if (sc == state_parse_block_chunk_ref) {
        struct state_parse_chunk_ref_local *lc_r;
        RENAME(sc->local, lc_r);
        Module mod;
        if (lc_r->module_name) {
            mod = module_of_name_in_archive(lc_r->module_name, ccl_r->archive);
        } else {
            mod = ccl_r->current_module;
        }
        Chunk chk = chunk_of_name_in_module(lc_r->chunk_name, mod);
        NEW0(blk->chunk_ref);
        blk->chunk_ref->chunk = chk;
        blk->chunk_ref->labels = copy_list(lc_r->labels);
    }

    if (sc == state_parse_block_filters) {
        struct state_parse_chunk_ref_local *lc_r;
        RENAME(sc->local, lc_r);
        Module mod;
        if (lc_r->module_name) {
            mod = module_of_name_in_archive(lc_r->module_name, ccl_r->archive);
        } else {
            mod = ccl_r->current_module;
        }
        Chunk chk = chunk_of_name_in_module(lc_r->chunk_name, mod);
        ChunkRef ckr;
        NEW0(ckr);
        ckr->chunk = chk;
        ckr->labels = copy_list(lc_r->labels);
        push(ckr, &blk->filters);
    }
}
@


@<litar@:C Structure@/invocation syntax@=
{
    name => 'litar',
    usages => [
        {
            options => [@<command line options for "litar"@>],
            arguments => [],
        },
        {
            options => [@<command line options for "litar ARCHIVE"@>],
            arguments => ['ARCHIVE'],
        },
    ],
}
@

@[litar.1@=
.TH LITAR 1
.SH NAME
litar \- manage all text in one file
.SH SYNOPSIS
@<litar@:C Structure@/manpage synopsis@>
.SH DESCRIPTION
.B litar
deal with a litar archive. It provides all necessary functionalities
expected from the using of a litar archive.
.SH OPTIONS
@<litar@:C Structure@/manpage options@>
@

@<litar@:C Structure@/global variables@=
@<flags@>
@

@<litar@:C Structure@/main body@=
@<initializations of global variables@>
@<parse command line arguments to set flags and global variables@>;
@<perform operations according to flags@>
@<close child process and remove directories@>
@

@<litar@:C Structure@/functions@=
void
print_usage()
{
    printf("@<command line usage@>");
}
@

@<litar@:C Structure@/global variables@=
int chosen_usage = -1;
char *archive_name = NULL;
@

@<parse command line arguments to set flags and global variables@=
do {
    int opt, option_index;
    static struct option long_options[] = {
        @<long options@>
    };

    while (
        (
            opt = getopt_long(
                argc, argv,
                "@<getopt string@>",
                long_options,
                &option_index
            )
        ) != -1
    ) {
        switch (opt) {
        case 0:
            @<cases for long option@>
            break;
        @<cases for command line option@>
        default:
            print_usage();
            exit(1);
        }
    }

    if (chosen_usage == -1) {
        print_usage();
        exit(1);
    }

    switch (chosen_usage) {
    case 0:
        break;
    case 1:
        if (argc - optind != 1) {
            print_usage();
            exit(1);
        }
        archive_name = argv[optind];

        if (access(archive_name, R_OK) == -1) {
            perror(archive_name);
            exit(1);
        }
        break;
    default:
        print_usage();
        exit(1);
    }
} while (0);
@

The operations can be performed at three stages:

1. before parsing;
2. after parsing, before mounting;
3. after mounting.

@<perform operations according to flags@=
do {
    bool to_continue = true;

    KEEP(@<operations before parsing@|execute sequentially@>);
    if (!to_continue) {
        break;
    }

    RESERVE(@<parse input@>);

    KEEP(@<operations after parsing input@|execute sequentially@>);
    if (!to_continue) {
        break;
    }

    KEEP(@<mount file system@>);

    KEEP(@<operations after mounting file system@|execute sequentially@>);
} while (0);
@

# Concepts



