### Include File

@<handlings for token "tkn" when "state_escape"@=
if (ipt->cc == 2
    && tkn->type == TOKEN_CONTROL_CHARACTER
    && tkn->value == '.') {
    lc_r->esc = tkn->value;
    return state_escape;
}
