@<parse@:Light@/states@=
{
    name => "command_set_current_module",
    parent => "command",
},
@

@<mappings from control_character to state@=
['-'] = &state_command_set_current_module,
@

@<litarfs@:light@:C Structure@/functions@=
static State state_command_set_current_module_in(State s, Signal sig)
{
    Str cache = new_str();
    s->local = new_str();
    return NULL;
}
static State state_command_set_current_module_handler(State s, Signal sig)
{
    Token tkn;
    RENAME(sig, tkn);
    if (extract_string(s, tkn)) {
        if (tkn->type == TOKEN_NEWLINE) {
            return state_command_waiting;
        }
        return s;
    }
    return NULL;
}
static State state_command_set_current_module_out(State s, Signal sig)
{
    Str cache;
    RENAME(s->local, cache);
    struct state_compile_local *lc_r;
    RENAME(state_compile->local, lc_r);
    lc_r->current_module = module_of_name(lc_r->modules, normalize(raw_string(cache)));
#ifdef SHOW_COMPILE_INFO
    fprintf(stderr, "Command: set current module to %s\n", lc_r->current_module->name);
#endif
    free_str(cache);
    return NULL;
}
@

@<parse@:Light@/states@=
{
    name => "parse_block",
    parent => "compile",
    init_child => "parse_block_comment",
    has_final => 1,
    has_callback => 1,
},
@

@<litarfs@:light@:C Structure@/functions@=
static State state_parse_block_in(State s, Signal sig)
{
    Block blk;
    NEW0(blk);
    s->local = blk;
    return NULL;
}
static State state_parse_block_handler(State s, Signal sig)
{
    if (!state_is_active(state_command_waiting)) {
        return s;
    }
    Token tkn;
    RENAME(sig, tkn);
    if (tkn->type == TOKEN_CONTROL_CHARACTER && *control_character_to_state[tkn->value]) {
        return s;
    }
    if (tkn->type == TOKEN_CONTROL_CHARACTER && (tkn->value == ' ' || tkn->value == '|')) {
        return s->parent;
    }
    return NULL;
}
static State state_parse_block_out(State s, Signal sig)
{
    return NULL;
}
@

@<litarfs@:light@:C Structure@/functions@=
static State state_compile_final(State sc, Signal sig)
{
    if (sc == state_parse_block) {
        Block blk;
        RENAME(sc->local, blk);
        block_extend_chunk_ref(blk, blk->chunk_ref);
        return state_parse_block;
    }
}
@

@<parse@:Light@/states@=
{
    name => "parse_block_comment",
