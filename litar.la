@<command line options for "litar ARCHIVE"@=
{
    long_opt => 'module',
    opt => 'm',
    hide => 1,
    argument => 'MODULE',
    description => 'Specify that CHUNK is in MODULE',
},
@

@<litar@:C Structure@/global variables@=
const char *specified_module_name = "";
@

@<cases for command line option@=
case 'm':
    specified_module_name = optarg;
    break;
@

@<command line options for "litar ARCHIVE"@=
{
    long_opt => 'label',
    opt => 'l',
    hide => 1,
    argument => 'LABEL',
    description => 'Specify the labels used for specialization',
},
@

@<litar@:C Structure@/global variables@=
List specified_labels = empty_list;
@

@<cases for command line option@=
case 'l':
    push((void *)normalize(optarg), &specified_labels);
    break;
@


@<command line options for "litar ARCHIVE"@=
{
    long_opt => 'print',
    opt => 'p',
    argument => 'CHUNK',
    description => 'Print the content of CHUNK in ARCHIVE.',
},
@

@<litar@:C Structure@/global variables@=
char *name_of_chunk_to_print;
@

@<cases for command line option@=
case 'p':
    chosen_usage = 1;
    name_of_chunk_to_print = optarg;
    break;
@

@<operations after mounting file system@=
if (name_of_chunk_to_print) {
    if (
        !chunk_of_name_exist_in_module(
            name_of_chunk_to_print,
            module_of_name(specified_module_name)
        )
    ) {
        fprintf(stderr, "Unknown chunk: %s\n", name_of_chunk_to_print);
        exit(1);
    }
    Chunk chk;
    chk = chunk_in_module_of_name(
        module_of_name(specified_module_name),
        name_of_chunk_to_print
    );

    Str cc;
    cc = content_of_chunk_with_labels(chk, specified_labels);

    puts(raw_string(cc));
    free_str(&cc);
    break;
}
@

@<command line options for "litar ARCHIVE"@=
{
    long_opt => 'execute',
    opt => 'x',
    argument => 'CHUNK',
    description => 'Execute a filter CHUNK under ARCHIVE.',
},
@

@<litar@:C Structure@/global variables@=
char *name_of_chunk_to_execute;
@

@<cases for command line option@=
case 'x':
    chosen_usage = 1;
    name_of_chunk_to_execute = optarg;
    break;
@

@<operations after mounting file system@=
if (name_of_chunk_to_execute) {
    if (
        !chunk_of_name_exist_in_module(
            name_of_chunk_to_execute,
            module_of_name(specified_module_name)
        )
    ) {
        fprintf(stderr, "Unknown chunk: %s\n", name_of_chunk_to_execute);
        exit(1);
    }
    Chunk chk;
    chk = chunk_in_module_of_name(
        module_of_name(specified_module_name),
        name_of_chunk_to_execute
    );

    ChunkRef ckr = NULL;
    NEW0(ckr);
    ckr->chunk = chk;
    ckr->labels = specified_labels;

    pid_t cld;
    int st;
    cld = run_filter(ckr, STDIN_FILENO, STDOUT_FILENO);
    FREE(ckr);
    waitpid(cld, &st, 0);

    if (WIFEXITED(st)) {
        if (WEXITSTATUS(st) != 0) {
            fprintf(stderr,
                "Faled at execute @@<%s@@>, error code: %d\n",
                name_of_chunk_to_execute,
                WEXITSTATUS(st)
            );
            exit(1);
        }
    } else {
        fprintf(stderr,
            "Faled at execute @@<%s@@>, unknown reason\n",
            name_of_chunk_to_execute
        );
        exit(1);
    }
    break;
}
@

@<operations after parsing input (DEBUG)@=
@<print all sections@>
@

@<functions (DEBUG)@=
void
print_section(Section sec)
{
    if (sec->type == SECTION_COMMENT) {
        List lst = copy_list(sec->content.comment);
        reverse(&lst);
        TextRef txt;
        FOREACH (txt, lst) {
            printf("Comment: (%s, %d, %d)\nContent:\n%s\n",
                txt->file,
                txt->start,
                txt->end,
                fetch_text_from(txt)
            );
        }
    } else {
        printf("Block: %s\n", name_of_chunk(sec->content.block->chunk));
        List lst = copy_list(sec->content.block->contents);
        reverse(&lst);
        do {
            BlockContent bc;
            FOREACH(bc, lst) {
                if (bc->type == BLOCK_CONTENT_TEXT) {
                    printf("\tText: (%s, %d, %d)\n",
                        bc->value.text->file,
                        bc->value.text->start,
                        bc->value.text->end
                    );
                } else {
                    printf("\tReference: %s", name_of_chunk(bc->value.chunk->chunk));
                    List lst2 = copy_list(bc->value.chunk->filters);
                    reverse(&lst2);
                    Chunk chk;
                    FOREACH(chk, lst2) {
                        printf(" | %s", chk->name);
                    }
                    free_list(&lst2);
                    putchar('\n');
                }
            }
        } while (0);
        free_list(&lst);
    }
}
@

@<print all sections@=
do {
    Section sec;
    reverse(&sections);
    FOREACH(sec, sections) {
        print_section(sec);
    }
} while (0);
@

@<operations after parsing input (debug)@=
@<print nodes@>
@

@<litar@:C Structure@/functions@=
void print_node(Node nd, int level)
{
    char *prefix = NULL;

    CALLOC(prefix, level+1);
    memset(prefix, '\t', level);
    prefix[level] = '\0';
    switch (nd->type) {
    case NODE_DIRECTORY:
        printf("%s%s/\n", prefix, nd->name);
        
        Node sub;
        FOREACH (sub, nd->value.nodes) {
            print_node(sub, level+1);
        }
        break;
    default:
        printf("%s%s\n", prefix, nd->name);
    }
    FREE(prefix);
}
@

@<print nodes@=
print_node(root_node, 0);
@

@<operations after mounting file system@=
do {
    printf("Starting executing shell\n");
    if (execl("/usr/bin/bash", "bash", "-i", NULL) != 0) {
        perror("execl");
        exit(1);
    }
} while (0);
