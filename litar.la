# User Interface

@<command line options for "litar"@=
{
    long_opt => 'help',
    description => 'Show the usage of litar',
},
@

@<flags@=
bool to_print_help;
@

@<cases for long option@=
if (strcmp(long_options[option_index].name, "help") == 0) {
    chosen_usage = 0;
    to_print_help = true;
    break;
}
@

@<operations before parsing@=
if (to_print_help) {
    print_usage();
    to_continue = false;
    break;
}
@

@<command line options for "litar"@=
{
    long_opt => 'version',
    description => 'Print version of current build',
},
@

@<flags@=
bool to_print_version_info;
@

@<cases for long option@=
if (strcmp(long_options[option_index].name, "version") == 0) {
    chosen_usage = 0;
    to_print_version_info = true;
    break;
}
@

@<litar@:C Structure@/global variables@=
char version[] = "dev";
@

@<operations before parsing@=
if (to_print_version_info) {
    @<print version information@>
    to_continue = false;
    break;
}
@

@<print version information@=
printf("Version dev, built at <build time>\n");
@|fill in build time information@

@<command line options for "litar ARCHIVE"@=
{
    long_opt => 'module',
    opt => 'm',
    hide => 1,
    argument => 'MODULE',
    description => 'Specify that CHUNK is in MODULE',
},
@

@<litar@:C Structure@/global variables@=
const char *specified_module_name = "";
@

@<cases for command line option@=
case 'm':
    specified_module_name = optarg;
    break;
@

@<command line options for "litar ARCHIVE"@=
{
    long_opt => 'label',
    opt => 'l',
    hide => 1,
    argument => 'LABEL',
    description => 'Specify the labels used for specialization',
},
@

@<litar@:C Structure@/global variables@=
List specified_labels = empty_list;
@

@<cases for command line option@=
case 'l':
    push((void *)normalize(optarg), &specified_labels);
    break;
@


@<command line options for "litar ARCHIVE"@=
{
    long_opt => 'print',
    opt => 'p',
    argument => 'CHUNK',
    description => 'Print the content of CHUNK in ARCHIVE.',
},
@

@<litar@:C Structure@/global variables@=
char *name_of_chunk_to_print;
@

@<cases for command line option@=
case 'p':
    chosen_usage = 1;
    name_of_chunk_to_print = optarg;
    break;
@

@<operations after mounting file system@=
if (name_of_chunk_to_print) {
    if (
        !chunk_of_name_exist_in_module(
            name_of_chunk_to_print,
            module_of_name(specified_module_name)
        )
    ) {
        fprintf(stderr, "Unknown chunk: %s\n", name_of_chunk_to_print);
        exit(1);
    }
    Chunk chk;
    chk = chunk_in_module_of_name(
        module_of_name(specified_module_name),
        name_of_chunk_to_print
    );

    Str cc;
    cc = content_of_chunk_with_labels(chk, specified_labels);

    puts(raw_string(cc));
    free_str(&cc);
    break;
}
@

@<command line options for "litar ARCHIVE"@=
{
    long_opt => 'execute',
    opt => 'x',
    argument => 'CHUNK',
    description => 'Execute a filter CHUNK under ARCHIVE.',
},
@

@<litar@:C Structure@/global variables@=
char *name_of_chunk_to_execute;
@

@<cases for command line option@=
case 'x':
    chosen_usage = 1;
    name_of_chunk_to_execute = optarg;
    break;
@

