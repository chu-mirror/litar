{
    name => "parse_block_content",
    parent => "parse_block",
    init_child => "parse_block_content_text",
},
{
    name => "parse_block_content_text",
    parent => "parse_block_content",
    alias => "parse_text",
},
{
    name => "parse_block_content_chunk_ref",
    parent => "parse_block_content",
