prints literal $'@@<c@@+A@@\n@@<s1@@:c@@+B@@\n@@<s2@@:s1@@:c@@+C@@\n@@<s2@@:s1@@:c@@=Z@@\n' -f archive.la -l 's2@@:s1@@:c'
