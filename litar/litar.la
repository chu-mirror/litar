A reference in the content is resolved as the evaluator resolves it,
and a filter of it under the labels of the resolved reference;
a filter of the block is resolved under the labels the block is applied with.
@<Project@/litar@/Selection@/walk the references and filters of the block 'i' under 'applied'@=
b := chain[i]
for _, part := range b.Parts {
	if part.Ref == nil {
		continue
	}
	inner := resolveBody(part.Ref.ChunkRef, applied.Labels, b.Ref.Module)
	walk(inner)
	for _, f := range part.Ref.Filters {
		walk(resolveFilter(f.Ref, inner.Labels))
	}
}
for _, f := range b.Filters {
	walk(resolveFilter(f.Ref, applied.Labels))
}
