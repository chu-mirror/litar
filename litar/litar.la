tangle writes each view file's bytes before the filter process starts. An archive file is the root-module chunk named by its path. A mapped file is the contents of origin. A mapped directory is created when it is missing, so a build can write into a fresh tree; a read-only one, of the ground, is left as it is.
@<filter@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) tangle(files []viewFile) error {
	for i := range files {
		var (
			data []byte
			err  error
		)
		switch {
		case files[i].archive:
			data, err = e.readChunk(Name(files[i].path))
		case files[i].dir && files[i].readOnly:
		case files[i].dir:
			if err = os.MkdirAll(files[i].origin, 0o755); err != nil {
				err = fmt.Errorf("could not create '%s'", files[i].origin)
				e.noteErr(err)
			}
		default:
			data, err = os.ReadFile(files[i].origin)
			if err != nil {
				err = fmt.Errorf("could not read '%s'", files[i].origin)
				e.noteErr(err)
			}
		}
		if err != nil {
			return err
		}
		files[i].body = data
	}
	return nil
}

