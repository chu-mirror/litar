renderBlocks answers a blocks:// resource: the kind after the scheme says which blocks of the node's chain are listed, and how many refs follow.
Only the blocks a worker reads are listed: a select field narrows them.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) renderBlocks(uri, mime string) (string, string, []byte, error) {
	kind, rest, _ := strings.Cut(strings.TrimPrefix(uri, "blocks://"), "/")
	count := map[string]int{"node": 2, "refer": 3, "define": 3, "specialization": 3, "apply": 4, "effective": 4, "depend": 4}[kind]
	w, refs, err := a.refParts(rest, count)
	if err != nil {
		return "", "", nil, err
	}
	node, err := nodeByRef(w, refs[1])
	if err != nil {
		return "", "", nil, err
	}
	chain, maps, err := a.readChain(w, refs[1])
	if err != nil {
		return "", "", nil, err
	}
	blocks := node.Own
	if kind != "node" {
		if blocks, err = selectBlocks(kind, chain, maps, refs[2:]); err != nil {
			return "", "", nil, err
		}
	}
	raw, err := json.Marshal(blockList(w, node, blocks))
	if err != nil {
		return "", "", nil, err
	}
	return string(raw), mime, nil, nil
}

