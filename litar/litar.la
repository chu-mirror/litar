A file or a mapped directory may not share its path with anything else,
and a path may only pass through directories of the view.
@<Project@/litar@/add 'part' of the path of 'f' under 'dir'@=
last := i == len(parts)-1
cur := dir.kids[part]
if last {
	if cur != nil {
		return nil, errPath(f.path)
	}
	if f.dir {
		dir.kids[part] = &ventry{host: f.origin}
	} else {
		dir.kids[part] = &ventry{file: f}
	}
	continue
}
if cur != nil && cur.dir == nil {
	return nil, errPath(f.path)
}
if cur == nil {
	cur = &ventry{dir: newVdir()}
	dir.kids[part] = cur
}
dir = cur.dir
