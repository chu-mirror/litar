encodeItem writes an item as an archive holds it.
@<rewrite@:litar@:Language@/Go@/File@/functions@+
func encodeItem(it Item) string {
	parts := make([]string, len(it))
	for i, n := range it {
		parts[i] = encodeName(n)
	}
	return strings.Join(parts, "@@/")
}

