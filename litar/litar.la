		if !ok {
			text.WriteByte(p.src[p.i])
			p.i++
			continue
		}
		if n == 2 && kind == '@@' {
			text.WriteByte('@@')
			p.i += 2
			continue
		}
		if isEndControl(kind, n) {
			b.endContent(&text)
			p.i += n
			return b, nil
		}
		switch kind {
		@<Project@/litar@/Parser@/cases of the control 'kind' in the body 'b', after the content 'text'@>
		default:
			return body{}, p.unexpected(kind, n)
		}
