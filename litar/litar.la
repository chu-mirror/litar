nullableStringSchema is the inferred object schema with field rewritten. A *string infers "type": ["null", "string"]. Some clients accept only one type per schema, so null and string are separate anyOf branches.
@<mcp@:litar@:Language@/Go@/File@/functions@+
func nullableStringSchema[T any](field string) *jsonschema.Schema {
	s, err := jsonschema.For[T](nil)
	if err != nil {
		panic(err)
	}
	prop := s.Properties[field]
	s.Properties[field] = &jsonschema.Schema{
		Description: prop.Description,
		AnyOf: []*jsonschema.Schema{
			{Type: "null"},
			{Type: "string"},
		},
	}
	return s
}

