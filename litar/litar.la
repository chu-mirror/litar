parseUnit reads an entry of the select field of a node, written as in the reserved namespaces:
an entry under Index names an item, an entry under File names a file,
and any other entry is a chunk reference. The names of a file are joined into its path.
@<list@:litar@:Language@/Go@/File@/functions@+
func parseUnit(s string) (unit, error) {
	bad := fmt.Errorf("invalid select entry '%s'", s)
	if rest, ok := strings.CutPrefix(s, "Index@@/"); ok {
		it, err := ParseItem(rest)
		if err != nil {
			return unit{}, bad
		}
		return unit{item: it}, nil
	}
	if rest, ok := strings.CutPrefix(s, "File@@/"); ok {
		names, err := ParseItem(rest)
		if err != nil {
			return unit{}, bad
		}
		parts := make([]string, len(names))
		for i, n := range names {
			parts[i] = string(n)
		}
		return unit{file: strings.Join(parts, "/")}, nil
	}
	ref, err := ParseChunkRef(s)
	if err != nil {
		return unit{}, bad
	}
	return unit{chunk: &ref}, nil
}

func parseUnits(entries []string) ([]unit, error) {
	units := make([]unit, len(entries))
	for i, s := range entries {
		u, err := parseUnit(s)
		if err != nil {
			return nil, err
		}
		units[i] = u
	}
	return units, nil
}

@~ Project@/litar@/Go@/functions@/litar.ParseChunkRef @~ Project@/litar@/Go@/functions@/litar.ParseItem @? Project@/litar@/Go@/functions@/litar.parseUnit @? Project@/litar@/Go@/functions@/litar.parseUnits @~ Project@/litar@/Go@/types@/litar.unit @

selection says, for each block of chain, whether a node that selects units visits it.
The steps follow the design: the construction blocks of the units;
the blocks they reach through R edges, traced only once, because the block that defines
an item is enough to use it; then one step back through Ca edges from all of these,
for the blocks that declare the objects quoted in a chunk name,
and one step back through R edges from the construction blocks, for the blocks that use
what the task may change. Cf edges are not stepped back, because a shared filter
is invoked all over the composition.
@<list@:litar@:Language@/Go@/File@/functions@+
func selection(chain []Block, units []unit) []bool {
	built := constructionBlocks(chain, units)
	in := append([]bool(nil), built...)
	markItems(chain, itemsOf(chain, built, false), true, in)
	reached := append([]bool(nil), in...)
	markContainers(chain, reached, in)
	markItems(chain, itemsOf(chain, built, true), false, in)
	return in
}

@~ Project@/litar@/Go@/functions@/litar.constructionBlocks @~ Project@/litar@/Go@/functions@/litar.itemsOf @~ Project@/litar@/Go@/functions@/litar.markContainers @~ Project@/litar@/Go@/functions@/litar.markItems @? Project@/litar@/Go@/functions@/litar.selection @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.unit @

constructionBlocks marks the blocks reached through C edges from the blocks applied to
each unit, or defining it. A block is visited under the labels it is evaluated with,
as the evaluator does, so a reference without labels reaches the specialized blocks
of the reference being expanded.
@<list@:litar@:Language@/Go@/File@/functions@+
func constructionBlocks(chain []Block, units []unit) []bool {
	in := make([]bool, len(chain))
	seen := map[string]bool{}
	var visit func(i int, applied ChunkRef)
	walk := func(ref ChunkRef) {
		for _, i := range effectiveIndexes(chain, ref) {
			visit(i, ref)
		}
	}
	visit = func(i int, applied ChunkRef) {
		key := fmt.Sprintf("%d %s", i, labelsText(applied.Labels))
		if seen[key] {
			return
		}
		seen[key] = true
		in[i] = true
		@<Project@/litar@/Selection@/walk the references and filters of the block 'i' under 'applied'@>
	}
	for _, u := range units {
		@<Project@/litar@/Selection@/walk from the blocks applied to the unit 'u', or defining it@>
	}
	return in
}

