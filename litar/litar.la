trimWS strips leading and trailing ASCII whitespace bytes from b.
@<parse@:litar@:Language@/Go@/File@/functions@+
func trimWS(b []byte) []byte {
	i := 0
	j := len(b)
	for i < j && isWS(b[i]) {
		i++
	}
	for j > i && isWS(b[j-1]) {
		j--
	}
	return b[i:j]
}

