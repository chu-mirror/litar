// DeleteChunk removes own blocks that match ref, the same set -l prints.
func (w *World) DeleteChunk(nodeName string, ref ChunkRef) error {
	n, err := w.requireLocal(nodeName)
	if err != nil {
		return err
	}
	return w.rewriteOwn(n, func(b Block, _ int) bool {
		return !matchRef(b.Ref, ref)
	})
}

@~ Project@/litar@/Go@/functions@/litar.matchRef @~ Project@/litar@/Go@/methods@/litar.World.DeleteChunk @~ Project@/litar@/Go@/methods@/litar.World.requireLocal @~ Project@/litar@/Go@/methods@/litar.World.rewriteOwn @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.World @

@<compose@:litar@:Language@/Go@/File@/methods@+
// DeleteChunkAll removes every own block of ref's module and chunk,
// whatever labels it carries.
func (w *World) DeleteChunkAll(nodeName string, ref ChunkRef) error {
	n, err := w.requireLocal(nodeName)
	if err != nil {
		return err
	}
	return w.rewriteOwn(n, func(b Block, _ int) bool {
		return b.Ref.Chunk != ref.Chunk || !modulesEqual(b.Ref.Module, ref.Module)
	})
}

@~ Project@/litar@/Go@/functions@/litar.modulesEqual @~ Project@/litar@/Go@/methods@/litar.World.DeleteChunkAll @~ Project@/litar@/Go@/methods@/litar.World.requireLocal @~ Project@/litar@/Go@/methods@/litar.World.rewriteOwn @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.World @

@<compose@:litar@:Language@/Go@/File@/methods@+
// DeleteFile removes file blocks with that path and blocks applied to
// the root chunk of that path.
func (w *World) DeleteFile(nodeName, path string) error {
	n, err := w.requireLocal(nodeName)
	if err != nil {
		return err
	}
	ref := ChunkRef{Chunk: Name(path)}
	return w.rewriteOwn(n, func(b Block, _ int) bool {
		if b.IsFile && string(b.Path) == path {
			return false
		}
		return !matchRef(b.Ref, ref)
	})
}

