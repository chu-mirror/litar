@<Project@/litar@/Composer@/tell whether block 'i' can be placed, requiring its 'includers' if 'strict'@=
if placed[i] || (chainPrev[i] >= 0 && !placed[chainPrev[i]]) {
	return false
}
if !strict {
	return true
}
for a := range includers[i] {
	if !placed[a] {
		return false
	}
}
return true
@

When no block has all its includers placed, inclusion is circular,
and the first block whose chunk predecessor is placed goes next.
@<Project@/litar@/Composer@/append to 'out' the first ready block, preferring one whose includers are placed@=
next := -1
for i := 0; i < n && next < 0; i++ {
	if ready(i, true) {
		next = i
	}
}
for i := 0; i < n && next < 0; i++ {
	if ready(i, false) {
		next = i
	}
}
placed[next] = true
out = append(out, blocks[next])
@
The earlier block of a chunk is the one before it in specializationOrder.
@<Project@/litar@/Composer@/link each block to the earlier block of its chunk in 'chainPrev'@=
for _, idx := range byChunk {
	order := specializationOrder(blocks, idx)
	chainPrev[order[0]] = -1
	for j := 1; j < len(order); j++ {
		chainPrev[order[j]] = order[j-1]
	}
}
@~ Project@/litar@/Go@/functions@/litar.specializationOrder @

effectiveIndexSet lists blocks that still contribute to query.
@<compose@:litar@:Language@/Go@/File@/functions@+
func effectiveIndexSet(blocks []Block, query ChunkRef) map[int]bool {
	var idx []int
	for i, b := range blocks {
		if !matchRef(b.Ref, query) {
			continue
		}
		if b.Op == OpSet {
			idx = []int{i}
		} else {
			idx = append(idx, i)
		}
	}
	set := make(map[int]bool, len(idx))
	for _, i := range idx {
		set[i] = true
	}
	return set
}

