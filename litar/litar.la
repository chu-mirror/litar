Counts active fuse.litar mounts on Linux by scanning /proc/self/mounts.
@<fuse linux@:litar@:Language@/Go@/File@/functions@+
func countLitarMounts() (int, bool) {
	data, err := os.ReadFile("/proc/self/mounts")
	if err != nil {
		return 0, false
	}
	return strings.Count(string(data), "fuse.litar"), true
}

@? Project@/litar@/Go@/functions@/litar.countLitarMounts @

nobrowse keeps ephemeral filter views out of Finder and Spotlight;
noappledouble and noapplexattr keep macOS tools from creating ._ files or failing on xattrs.
@<fuse darwin@:litar@:Language@/Go@/File@/functions@+
func mountFUSE(dir string, root *dirNode, opts *fs.Options, _ *vdir, overlay string) (string, *fuse.Server, bool, error) {
	opts.Options = append(opts.Options, "nobrowse", "noappledouble", "noapplexattr")
	server, err := fs.Mount(dir, root, opts)
	if err != nil {
		os.RemoveAll(dir)
		os.RemoveAll(overlay)
		return "", nil, false, fmtMount(err)
	}
	return dir, server, false, nil
}

