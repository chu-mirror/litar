@<mcp test@:litar@:Language@/Go@/File@/functions@+
func TestMCPDescribeSearch(t *testing.T) {
	f := newMCPFixture(t, blocksArchive)
	if got := f.tool("describe", "description", "the root"); got != f.n {
		t.Fatalf("describe answered %q", got)
	}
	args := map[string]any{"composition": f.c, "description": "a composition"}
	if got := callTool(t, f.ctx, f.session, "describe", args); got != f.c {
		t.Fatalf("describe answered %q", got)
	}
	raw, _ := os.ReadFile(filepath.Join(f.dir, "composer.json"))
	if !strings.Contains(string(raw), `"the root"`) || !strings.Contains(string(raw), `"a composition"`) {
		t.Fatalf("composer %s", raw)
	}
	f.fail("describe", "node", "none", "description", "x")
	var found []blockJSON
	if err := json.Unmarshal([]byte(f.tool("search_blocks", "text", "Second")), &found); err != nil {
		t.Fatal(err)
	}
	if len(found) != 1 || found[0].Comment != "Second." || found[0].Ref != refOf("block", "@@<seq@@+\ntwo\n@@") {
		t.Fatalf("found %+v", found)
	}
	if got := f.tool("search_blocks", "text", "no such text"); got != "[]" {
		t.Fatalf("nothing found answered %q", got)
	}
	f.fail("search_blocks", "text", "")
}

