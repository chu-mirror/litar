@<Project@/litar@/Rewrite@/unmap 'arg' from 'kept', or note the files it names in 'gone' and 'lines'@=
if rest, ok := unmap(kept, arg); ok {
	kept = rest
	lines = append(lines, "unmapped "+path.Clean(arg))
	continue
}
p, files, dir, err := ix.source(arg)
switch {
case err != nil:
	return nil, err
case len(files) == 0 && strings.Contains(flags, "f"):
	continue
case len(files) == 0:
	return nil, fmt.Errorf("no such file '%s'", p)
case dir && !recursive:
	return nil, fmt.Errorf("'%s' is a directory", p)
}
