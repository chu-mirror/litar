parseItems reads the items up to the end control; mark is the control before the first one.
Each item is carried by the block, and an item after "@@?" is also defined by it.
@<parse@:litar@:Language@/Go@/File@/methods@+
func (p *parser) parseItems(mark byte) ([]Item, []Item, error) {
	var items, defines []Item
	var item Item
	for {
		name, kind, n, err := p.readName(false)
		if err != nil {
			return nil, nil, err
		}
		if name == "" {
			return nil, nil, p.fail("empty name")
		}
		item = append(item, name)
		if kind == '/' && n == 2 {
			p.i += n
			continue
		}
		end := isEndControl(kind, n)
		if !end && ((kind != '~' && kind != '?') || n != 2) {
			return nil, nil, p.unexpected(kind, n)
		}
		p.i += n
		items = append(items, item)
		if mark == '?' {
			defines = append(defines, item)
		}
		if end {
			return items, defines, nil
		}
		item, mark = nil, kind
	}
}

