The kernel caches neither entries nor attributes, NullPermissions leaves
the permission bits as the nodes report them, and UID and GID default to the
current user so macFUSE allows creating overlay files in the root directory.
Discarding go-fuse logs keeps stderr clean for filter checks and MCP stdio.
@<Project@/litar@/FUSE View@/mount 'tree' at 'dir' with new files in 'overlay', setting 'server' and 'direct'@=
root := &dirNode{rel: "", spec: tree, overlay: overlay}
zero := time.Duration(0)
discard := log.New(io.Discard, "", 0)
opts := &fs.Options{
	EntryTimeout:    &zero,
	AttrTimeout:     &zero,
	NullPermissions: true,
	UID:             uint32(os.Getuid()),
	GID:             uint32(os.Getgid()),
	Logger:          discard,
}
opts.FsName = "litar"
opts.Name = "litar"
opts.MountOptions.Logger = discard
dir, server, direct, err = mountFUSE(dir, root, opts, tree, overlay)
if err != nil {
	return nil, err
}
