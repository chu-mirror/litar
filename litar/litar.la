			Arguments map[string]any `json:"arguments"`
		}
		@<Project@/litar@/Web Server@/read into 'call' the JSON tool call of 'r', answering 'w' when it is refused@>
		res, err := session.CallTool(r.Context(), &mcp.CallToolParams{Name: call.Name, Arguments: call.Arguments})
		if err != nil {
			http.Error(w, err.Error(), http.StatusBadGateway)
			return
		}
		@<Project@/litar@/Web Server@/write to 'w' the text of the tool result 'res', as an error when it is one@>
	}
}

