A mapped directory shows in the file tree with the files of the host below it,
and each of them is read through its file resource.
@<mcp test@:litar@:Language@/Go@/File@/functions@+
func TestMCPMappedDirectory(t *testing.T) {
	f := newMCPFixture(t, "@@[a.txt@@=a@@\n")
	if err := os.MkdirAll(filepath.Join(f.dir, "host", "sub"), 0o755); err != nil {
		t.Fatal(err)
	}
	writeFile(t, filepath.Join(f.dir, "host", "sub", "data.txt"), "inside")
	f.tool("map_file", "path", "in/", "origin", "host")
	f.tool("map_file", "path", "later/", "origin", "missing")
	tree := readResource(t, f.ctx, f.session, "tree://file/"+f.c+"/"+f.n)
	for _, want := range []string{`"name":"in"`, `"name":"sub"`, `"name":"data.txt"`, `"name":"later"`} {
		if !strings.Contains(tree, want) {
			t.Fatalf("missing %s in %s", want, tree)
		}
	}
	uri := "file://" + f.c + "/" + f.n + "/" + refOf("file", "in", "sub", "data.txt")
	if got := readResource(t, f.ctx, f.session, uri); got != "inside" {
		t.Fatalf("file of the mapped directory %q", got)
	}
}

