rename takes the ref of an entry of the chunk tree or of the item tree. A branch and a leaf have different refs, so the ref alone says what is renamed.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) rename(ctx context.Context, _ *mcp.CallToolRequest, in renameIn) (*mcp.CallToolResult, any, error) {
	to, err := ParseModulePath(in.To)
	if err != nil {
		return toolErr(err)
	}
	a.mu.Lock()
	from, err := a.renameLocked(in, to)
	a.mu.Unlock()
	if err != nil {
		return toolErr(err)
	}
	a.refresh()
	return toolText(from + " -> " + in.To)
}

