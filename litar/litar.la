Test helper that invokes an MCP tool, fails the test on transport or tool error, and returns the first text content block.
@<mcp test@:litar@:Language@/Go@/File@/functions@+
func callTool(t *testing.T, ctx context.Context, session *mcp.ClientSession, name string, args map[string]any) string {
	t.Helper()
	res, err := session.CallTool(ctx, &mcp.CallToolParams{Name: name, Arguments: args})
	if err != nil || res.IsError {
		t.Fatalf("%s %v %+v", name, err, res)
	}
	return res.Content[0].(*mcp.TextContent).Text
}

