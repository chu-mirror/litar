@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (w *World) removeFiles(n *Node, ix fileIndex, words []string) ([]string, error) {
	flags, args, err := fileArgs(words, "rRf")
	if err != nil {
		return nil, err
	}
	recursive := strings.ContainsAny(flags, "rR")
	var gone fileMoves
	var lines []string
	kept := n.Mappings
	for _, arg := range args {
		@<Project@/litar@/Rewrite@/unmap 'arg' from 'kept', or note the files it names in 'gone' and 'lines'@>
	}
	if len(gone) > 0 {
		err = w.rewriteOwn(n, func(b Block, _ int) bool {
			_, ok := gone.applyRef(ChunkRef{Module: b.Ref.Module, Chunk: b.Ref.Chunk})
			return !ok
		})
	}
	@<Project@/litar@/Rewrite@/save 'kept' as the mappings of 'n', restoring them if the composer cannot be written@>
	return lines, err
}

@~ Project@/litar@/Go@/functions@/litar.fileArgs @~ Project@/litar@/Go@/functions@/litar.unmap @~ Project@/litar@/Go@/methods@/litar.World.Mappings @? Project@/litar@/Go@/methods@/litar.World.removeFiles @~ Project@/litar@/Go@/methods@/litar.World.rewriteOwn @~ Project@/litar@/Go@/methods@/litar.fileMoves.applyRef @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Node @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.fileIndex @~ Project@/litar@/Go@/types@/litar.fileMoves @
