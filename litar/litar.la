Verifies that MCP resource subscriptions track clients per session, deliver ResourceUpdated notifications only to subscribed URIs, and stop notifying after unsubscribe.
@<mcp test@:litar@:Language@/Go@/File@/functions@+
func TestMCPSubscriptions(t *testing.T) {
	ctx := context.Background()
	ag := newAgent()
	listenDone := make(chan struct{}, 8)
	ag.server.AddReceivingMiddleware(func(next mcp.MethodHandler) mcp.MethodHandler {
		return func(ctx context.Context, method string, req mcp.Request) (mcp.Result, error) {
			res, err := next(ctx, method, req)
			if method == "subscriptions/listen" {
				listenDone <- struct{}{}
			}
			return res, err
		}
	})
	connect := func() (*mcp.ClientSession, *mcp.ServerSession, chan string, chan struct{}) {
		ch := make(chan string, 8)
		acked := make(chan struct{}, 8)
		client := mcp.NewClient(&mcp.Implementation{Name: "test", Version: "0"}, &mcp.ClientOptions{
			ResourceUpdatedHandler: func(_ context.Context, req *mcp.ResourceUpdatedNotificationRequest) {
				ch <- req.Params.URI
			},
		})
		client.AddReceivingMiddleware(func(next mcp.MethodHandler) mcp.MethodHandler {
			return func(ctx context.Context, method string, req mcp.Request) (mcp.Result, error) {
				res, err := next(ctx, method, req)
				if method == "notifications/subscriptions/acknowledged" {
					acked <- struct{}{}
				}
				return res, err
			}
		})
		serverT, clientT := mcp.NewInMemoryTransports()
		serverSession, err := ag.server.Connect(ctx, serverT, nil)
		if err != nil {
			t.Fatal(err)
		}
		session, err := client.Connect(ctx, clientT, nil)
		if err != nil {
			t.Fatal(err)
		}
		t.Cleanup(func() { session.Close() })
		return session, serverSession, ch, acked
	}
	s1, _, ch1, ack1 := connect()
	s2, _, ch2, ack2 := connect()

	waitSignal := func(ch <-chan struct{}, what string) {
		t.Helper()
		select {
		case <-ch:
		case <-time.After(time.Second):
			t.Fatalf("timed out waiting for %s", what)
		}
	}
	subscribe := func(s *mcp.ClientSession, acked <-chan struct{}, u string) {
		t.Helper()
		if err := s.Subscribe(ctx, &mcp.SubscribeParams{URI: u}); err != nil {
			t.Fatal(err)
		}
		if res := s.InitializeResult(); res != nil && res.ProtocolVersion >= "2026-07-28" {
			waitSignal(acked, "subscribe acknowledgement")
		}
	}
	unsubscribe := func(s *mcp.ClientSession, u string) {
		t.Helper()
		if err := s.Unsubscribe(ctx, &mcp.UnsubscribeParams{URI: u}); err != nil {
			t.Fatal(err)
		}
		if res := s.InitializeResult(); res != nil && res.ProtocolVersion >= "2026-07-28" {
			waitSignal(listenDone, "unsubscribe completion")
		}
	}

	dir := filepath.Join(t.TempDir(), "archive")
	c := callTool(t, ctx, s1, "create_composition", map[string]any{"path": dir, "ground": nil})
	n := callTool(t, ctx, s1, "create_node", map[string]any{
		"composition": c, "name": "root", "archive": "a.la", "description": "", "base": nil,
	})
	uri := "tree://chunk/" + c + "/" + n

	expect := func(ch chan string, want string) {
		t.Helper()
		select {
		case got := <-ch:
			if got != want {
				t.Fatalf("got notification %q, want %q", got, want)
			}
		case <-time.After(time.Second):
			t.Fatalf("timed out waiting for notification %q", want)
		}
	}
	expectNone := func(ch chan string) {
		t.Helper()
		select {
		case got := <-ch:
			t.Fatalf("unexpected notification %q", got)
		case <-time.After(50 * time.Millisecond):
		}
	}

	subscribe(s1, ack1, uri)
	if err := s1.Subscribe(ctx, &mcp.SubscribeParams{URI: uri}); err != nil {
		t.Fatal(err)
	}
	subscribe(s2, ack2, uri)

	callTool(t, ctx, s1, "apply_block", map[string]any{
		"composition": c, "node": n, "text": "@@<a@@=one@@\n",
	})
	expect(ch1, uri)
	expect(ch2, uri)

	unsubscribe(s1, uri)
	if err := s1.Unsubscribe(ctx, &mcp.UnsubscribeParams{URI: "tree://chunk/missing/node"}); err != nil {
		t.Fatal(err)
	}
	callTool(t, ctx, s1, "apply_block", map[string]any{
		"composition": c, "node": n, "text": "@@<b@@=two@@\n",
	})
	expect(ch2, uri)
	expectNone(ch1)

	unsubscribe(s2, uri)
	ag.mu.Lock()
	left := len(ag.subscribed)
	ag.mu.Unlock()
	if left != 0 {
		t.Fatalf("expected no remaining subscriptions, got %d", left)
	}
	callTool(t, ctx, s1, "apply_block", map[string]any{
		"composition": c, "node": n, "text": "@@<c@@=three@@\n",
	})
	expectNone(ch1)
	expectNone(ch2)

	// Closing a subscribed session cleans up its subscription, and refresh prunes any closed session left in subscribed.
	s3, ss3, _, ack3 := connect()
	subscribe(s3, ack3, uri)
	if err := s3.Close(); err != nil {
		t.Fatal(err)
	}
	if res := s3.InitializeResult(); res != nil && res.ProtocolVersion >= "2026-07-28" {
		waitSignal(listenDone, "close unsubscribe completion")
	}
	_ = ss3.Wait()
	ag.mu.Lock()
	if len(ag.subscribed) != 0 {
		left := len(ag.subscribed)
		ag.mu.Unlock()
		t.Fatalf("expected closed session subscription to be removed, got %d", left)
	}
	ag.subscribed[uri] = map[*mcp.ServerSession]bool{ss3: true}
	ag.mu.Unlock()
	callTool(t, ctx, s1, "apply_block", map[string]any{
		"composition": c, "node": n, "text": "@@<d@@=four@@\n",
	})
	ag.mu.Lock()
	left = len(ag.subscribed)
	ag.mu.Unlock()
	if left != 0 {
		t.Fatalf("expected closed session subscription to be pruned on refresh, got %d", left)
	}
}

@? Project@/litar@/Go@/functions@/litar.TestMCPSubscriptions @~ Project@/litar@/Go@/functions@/litar.callTool @~ Project@/litar@/Go@/functions@/litar.newAgent @

@<Index@/Project@/litar@/Go@/functions@/litar.TestMCPSubscriptions@=
{"description": "Tests per-session MCP resource subscription tracking, ResourceUpdated notifications on mutation, and cleanup on unsubscribe."}
@
