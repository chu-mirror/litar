Every file is tried; the ones that could not be removed are reported together.
@<Project@/litar@/Composer@/remove the files in 'archives'@=
var failed []string
for _, path := range archives {
	if path == "" {
		continue
	}
	if err := os.Remove(path); err != nil && !os.IsNotExist(err) {
		failed = append(failed, path)
	}
}
if len(failed) > 0 {
	return fmt.Errorf("could not remove '%s'", strings.Join(failed, "', '"))
