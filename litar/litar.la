@<mcp test@:litar@:Language@/Go@/File@/functions@+
// checkMCPRefs checks that a ref is a hash of the kind and names of its object,
// so a client can keep it across reads and mutations.
func checkMCPRefs(t *testing.T, f *mcpFixture) {
	t.Helper()
	compDir, err := identityPath(f.dir)
	if err != nil {
		t.Fatal(err)
	}
	var listed []listJSON
	if err := json.Unmarshal([]byte(readResource(t, f.ctx, f.session, "list://composition")), &listed); err != nil {
		t.Fatal(err)
	}
	if len(listed) != 1 || listed[0].Name != compDir || listed[0].Description != "" || listed[0].Ref != f.c {
		t.Fatalf("compositions %+v", listed)
	}
	if f.c != refOf("composition", compDir) || f.n != refOf("node", "root") || len(f.n) != 10 {
		t.Fatalf("refs %q %q", f.c, f.n)
	}
	tree := readResource(t, f.ctx, f.session, "tree://node/"+f.c)
	if !strings.Contains(tree, `"name":"root"`) || !strings.Contains(tree, `"ref":"`+f.n+`"`) || !strings.Contains(tree, `"sub-trees":[]`) {
		t.Fatalf("tree %s", tree)
	}
	if got := f.ref("chunk", "msg"); got != refOf("chunk", "msg") || got == refOf("module", "msg") {
		t.Fatalf("chunk ref %q", got)
	}
}

@~ Project@/litar@/Go@/functions@/litar.checkMCPRefs @~ Project@/litar@/Go@/functions@/litar.identityPath @~ Project@/litar@/Go@/functions@/litar.readResource @~ Project@/litar@/Go@/functions@/litar.refOf @~ Project@/litar@/Go@/methods@/litar.mcpFixture.ref @~ Project@/litar@/Go@/types@/litar.listJSON @~ Project@/litar@/Go@/types@/litar.mcpFixture @
@<mcp test@:litar@:Language@/Go@/File@/functions@+
func checkMCPResources(t *testing.T, f *mcpFixture) {
	t.Helper()
	if files := f.read("tree://file"); !strings.Contains(files, `"sub-trees":[]`) {
		t.Fatalf("file tree %s", files)
	}
	own := f.blocks("node")
	if len(own) != 2 || own[0].Text != "@@<msg@@=hello@@" || own[0].Node != "" || own[0].Ref != refOf("block", "@@<msg@@=hello@@") {
		t.Fatalf("blocks %+v", own)
	}
	msg, plain := f.ref("chunk", "msg"), f.ref("specialization")
	if applied := f.blocks("apply", msg, plain); len(applied) != 2 {
		t.Fatalf("applied %+v", applied)
	}
	if eff := f.blocks("effective", msg, plain); len(eff) != 1 || eff[0].Text != "@@<msg@@=replaced@@" {
		t.Fatalf("effective %+v", eff)
	}
	if plain != refOf("labels") {
		t.Fatalf("specialization ref %q", plain)
	}
	uri := "file://" + f.c + "/" + f.n + "/none"
	if _, err := f.session.ReadResource(f.ctx, &mcp.ReadResourceParams{URI: uri}); err == nil || !strings.Contains(err.Error(), "unknown file 'none'") {
		t.Fatalf("missing file: %v", err)
	}
}

