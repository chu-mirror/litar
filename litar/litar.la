readName reads bytes up to the next control. "@@@@" stays inside the name and decodes to one "@@". Trim happens before that decode. allowEOF lets a command-line name end at end of input. kind, n describe the control that stopped the name; they are zero at EOF.
@<parse@:litar@:Language@/Go@/File@/methods@+
func (p *parser) readName(allowEOF bool) (Name, byte, int, error) {
	start := p.i
	for p.i < len(p.src) {
		kind, n, ok := p.atControl()
		if !ok {
			p.i++
			continue
		}
		if n == 2 && kind == '@@' {
			p.i += 2
			continue
		}
		raw := p.src[start:p.i]
		return Name(decodeAt(trimWS(raw))), kind, n, nil
	}
	if !allowEOF {
		return "", 0, 0, p.fail("unterminated name")
	}
	return Name(decodeAt(trimWS(p.src[start:p.i]))), 0, 0, nil
}

