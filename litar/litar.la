Each case names the selected blocks by their headers, in the order of the archive.
An item starts from the block defining it, and steps back to every block referring to it.
@<eval test@:litar@:Language@/Go@/File@/functions@+
func TestSelection(t *testing.T) {
	chain := mustArch(t, selectionArchive)
	cases := []struct {
		entry, want string
	}{
		{"body", "main.c|body|step|fmt|call def|user of x|container"},
		{"File@@/main.c", "main.c|body|step|fmt|call def|user of x|container"},
		{"Index@@/K@@/call", "body|call def|call inner|user of call|container"},
	}
	for _, tc := range cases {
		u, err := parseUnit(tc.entry)
		if err != nil {
			t.Fatal(err)
		}
		in := selection(chain, []unit{u})
		var got []string
		for i, b := range chain {
			if in[i] {
				got = append(got, b.Ref.String())
			}
		}
		if strings.Join(got, "|") != tc.want {
			t.Fatalf("%s selects %q", tc.entry, strings.Join(got, "|"))
		}
	}
	for _, bad := range []string{"Index@@/", "File@@/", "a@@/"} {
		if _, err := parseUnit(bad); err == nil {
			t.Fatalf("entry %q accepted", bad)
		}
	}
}

