MCP resource read handler that acquires the agent lock, renders the requested URI, and wraps the text or binary result in a ReadResourceResult.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) handle(ctx context.Context, req *mcp.ReadResourceRequest) (*mcp.ReadResourceResult, error) {
	a.mu.Lock()
	defer a.mu.Unlock()
	text, mime, blob, err := a.render(req.Params.URI)
	if err != nil {
		return nil, err
	}
	contents := &mcp.ResourceContents{URI: req.Params.URI, MIMEType: mime}
	if blob != nil {
		contents.Blob = blob
	} else {
		contents.Text = text
	}
	return &mcp.ReadResourceResult{Contents: []*mcp.ResourceContents{contents}}, nil
}

@? Project@/litar@/Go@/methods@/litar.agent.handle @~ Project@/litar@/Go@/methods@/litar.agent.render @~ Project@/litar@/Go@/types@/litar.agent @

Asynchronously sends ResourceUpdated notifications for all currently subscribed resource URIs with a two-second timeout, pruning closed sessions from the subscription map.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) refresh() {
	a.mu.Lock()
	if len(a.subscribed) == 0 {
		a.mu.Unlock()
		return
	}
	live := map[*mcp.ServerSession]bool{}
	for s := range a.server.Sessions() {
		live[s] = true
	}
	uris := make([]string, 0, len(a.subscribed))
	for u, sessions := range a.subscribed {
		for s := range sessions {
			if !live[s] {
				delete(sessions, s)
			}
		}
		if len(sessions) == 0 {
			delete(a.subscribed, u)
			continue
		}
		uris = append(uris, u)
	}
	a.mu.Unlock()
	if len(uris) == 0 {
		return
	}
	go func() {
		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
		defer cancel()
		for _, u := range uris {
			_ = a.server.ResourceUpdated(ctx, &mcp.ResourceUpdatedNotificationParams{URI: u})
		}
	}()
}

@? Project@/litar@/Go@/methods@/litar.agent.refresh @~ Project@/litar@/Go@/types@/litar.agent @

Dispatches an MCP resource URI to the appropriate list, tree, block, or file renderer and returns its serialized content and MIME type.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) render(uri string) (text, mime string, blob []byte, err error) {
	mime = mimeOf(uri)
	switch {
	case uri == "list://composition":
		raw, err := json.Marshal(a.compositionList())
		if err != nil {
			return "", "", nil, err
		}
		return string(raw), mime, nil, nil
	case strings.HasPrefix(uri, "tree://node/"):
		w, _, err := a.refParts(strings.TrimPrefix(uri, "tree://node/"), 1)
		if err != nil {
			return "", "", nil, err
		}
		raw, err := json.Marshal(nodeTree(w))
		if err != nil {
			return "", "", nil, err
		}
		return string(raw), mime, nil, nil
	case strings.HasPrefix(uri, "tree://chunk/"):
		return a.renderTree(uri, "tree://chunk/", chunkTree)
	case strings.HasPrefix(uri, "tree://item/"):
		return a.renderTree(uri, "tree://item/", itemTree)
	case strings.HasPrefix(uri, "tree://file/"):
		return a.renderTree(uri, "tree://file/", fileTree)
	case strings.HasPrefix(uri, "tree://specialization/"):
		return a.renderTree(uri, "tree://specialization/", labelTree)
	case strings.HasPrefix(uri, "blocks://"):
		return a.renderBlocks(uri, mime)
	case strings.HasPrefix(uri, "file://"):
		return a.renderFile(uri, mime)
	default:
		return "", "", nil, errString("unknown resource")
	}
}

@~ Project@/litar@/Go@/functions@/litar.mimeOf @~ Project@/litar@/Go@/functions@/litar.nodeTree @~ Project@/litar@/Go@/methods@/litar.agent.compositionList @~ Project@/litar@/Go@/methods@/litar.agent.refParts @? Project@/litar@/Go@/methods@/litar.agent.render @~ Project@/litar@/Go@/methods@/litar.agent.renderBlocks @~ Project@/litar@/Go@/methods@/litar.agent.renderFile @~ Project@/litar@/Go@/methods@/litar.agent.renderTree @~ Project@/litar@/Go@/types@/litar.agent @

Builds the JSON list of loaded compositions with each composition's directory, description, and ref.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) compositionList() []listJSON {
	comps := a.compositions()
	out := make([]listJSON, 0, len(comps))
	for _, w := range comps {
		out = append(out, listJSON{
			Name:        w.Dir,
			Description: w.Description,
			Ref:         compositionRef(w),
		})
	}
	return out
}

