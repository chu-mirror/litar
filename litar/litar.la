// ref finds an entry of a tree of the root node by its names.
func (f *mcpFixture) ref(kind string, names ...string) string {
	f.t.Helper()
	var tree treeJSON
	if err := json.Unmarshal([]byte(f.read("tree://"+kind)), &tree); err != nil {
		f.t.Fatal(err)
	}
	got, ok := findTree(tree, names...)
	if !ok {
		f.t.Fatalf("%s tree has no %v: %s", kind, names, mustTree(f.t, tree))
	}
	return got.Ref
}

