	"@@<top@@=\n"+
	"@@<..@@/top@@>\n"+
	"@@\n"), nil, nil).Eval(mustRef(t, "top"), nil)
if err == nil || !strings.Contains(err.Error(), "circular reference top -> top") {
	t.Fatal(err)
}
