func checkNullableArg(t *testing.T, ctx context.Context, session *mcp.ClientSession, tool, arg, typ string) {
t.Helper()
var schema map[string]any
@<Project@/litar@/set 'schema' to the input schema of 'tool' listed by 'session'@>
