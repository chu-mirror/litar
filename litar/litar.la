@<Project@/litar@/Web@/style rules@+
h1 { font-size: 20px; line-height: 1.35; margin: 0 0 4px; overflow-wrap: anywhere; }
h1 .mod { color: var(--muted); font-weight: 400; }
h2 { font-size: 15px; margin: 28px 0 8px; }
.kind { text-transform: uppercase; letter-spacing: .06em; font-size: 11px; color: var(--muted); }
