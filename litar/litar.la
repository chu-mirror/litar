Rename moves a chunk, a module, an item, or a domain to another path. Block headers, references, filters, items, and descriptions follow, in the node and in the local nodes based on it.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (w *World) Rename(nodeName string, r renaming) error {
	n, err := w.requireLocal(nodeName)
	if err != nil {
		return err
	}
	if err := w.checkRename(n, r); err != nil {
		return err
	}
	return w.rewriteNodes(w.subtree(n), r.edit)
}

