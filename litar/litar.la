The cases hold raw strings over several lines, so their reference starts its line:
an indented reference would indent the lines inside the strings too.
@<compose test@:litar@:Language@/Go@/File@/functions@+
func TestComposerErrors(t *testing.T) {
	dir := t.TempDir()
	writeFile(t, filepath.Join(dir, "a.la"), "@@<m@@=a@@")
	cases := []struct {
		name string
		json string
		msg  string
	}{
@<Project@/litar@/Tests@/Composer@/composers that LoadComposer refuses, each with a part of its error@>
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			path := filepath.Join(dir, tc.name+".json")
			body := tc.json
			if strings.HasPrefix(strings.TrimSpace(body), "[") {
				body = composerDoc(body)
			}
			writeFile(t, path, body)
			_, err := LoadComposer(path)
			if err == nil || !strings.Contains(err.Error(), tc.msg) {
				t.Fatal(err)
			}
		})
	}
}

