	if err != nil {
		return body{}, err
	}
	b.filters = filters
	if (k2 == '~' || k2 == '?') && n2 == 2 {
		p.i += n2
		b.items, b.defines, err = p.parseItems(k2)
		if err != nil {
			return body{}, err
		}
		return b, nil
	}
