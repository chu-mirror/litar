The stderr of litar passes through, so its errors reach the terminal of litar-web.
@<litar-web@:command@:Language@/Go@/File@/functions@+
func connect(litar, file string) (*mcp.ClientSession, error) {
	args := []string{"-a"}
	if file != "" {
		args = append(args, "-f", file)
	}
	cmd := exec.Command(litar, args...)
	cmd.Stderr = os.Stderr
	client := mcp.NewClient(&mcp.Implementation{Name: "litar-web", Version: "0.1.0"}, nil)
	return client.Connect(context.Background(), &mcp.CommandTransport{Command: cmd}, nil)
}

@~ Project@/litar@/Go@/functions@/litar-web.connect @

@<litar-web@:command@:Language@/Go@/File@/functions@+
func serveIndex(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.Write(indexHTML)
}

@~ Project@/litar@/Go@/functions@/litar-web.serveIndex @~ Project@/litar@/Go@/variables@/litar-web.indexHTML @

A resource keeps the MIME type litar gives it.
Text is sent as UTF-8; a blob, such as a binary file, is sent as its bytes.
@<litar-web@:command@:Language@/Go@/File@/functions@+
func resourceHandler(session *mcp.ClientSession) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		uri := r.URL.Query().Get("uri")
		res, err := session.ReadResource(r.Context(), &mcp.ReadResourceParams{URI: uri})
		if err != nil {
			http.Error(w, err.Error(), http.StatusBadRequest)
			return
		}
		if len(res.Contents) == 0 {
			http.Error(w, "resource '"+uri+"' is empty", http.StatusNotFound)
			return
		}
		c := res.Contents[0]
		mime := c.MIMEType
		if mime == "" {
			mime = "text/plain"
		}
		if c.Blob != nil {
			w.Header().Set("Content-Type", mime)
			w.Write(c.Blob)
			return
		}
		w.Header().Set("Content-Type", mime+"; charset=utf-8")
		io.WriteString(w, c.Text)
	}
}

@~ Project@/litar@/Go@/functions@/litar-web.resourceHandler @

A tool call must be application/json. A page of another site cannot send that
without a CORS preflight, which this server never grants.
A tool error comes back as 422 with the message litar wrote.
@<litar-web@:command@:Language@/Go@/File@/functions@+
func toolHandler(session *mcp.ClientSession) http.HandlerFunc {
return func(w http.ResponseWriter, r *http.Request) {
var call struct {
Name      string         `json:"name"`
Arguments map[string]any `json:"arguments"`
}
@<Project@/litar@/read into 'call' the JSON tool call of 'r', answering 'w' when it is refused@>
