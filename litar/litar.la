	@<Project@/litar@/Composer@/set 'ident' to the identity of 'resolved' unless another node has it@>
	@<Project@/litar@/Composer@/parse 'resolved' and append the new node to the composer@>
}

@~ Project@/litar@/Go@/functions@/litar.createNewArchive @? Project@/litar@/Go@/methods@/litar.World.CreateNode @~ Project@/litar@/Go@/types@/litar.World @

@<Project@/litar@/Composer@/check the 'name' and 'base' of the new node@=
if name == "" {
	return fmt.Errorf("empty name")
}
if strings.Contains(name, "/") {
	return fmt.Errorf("invalid node name '%s'", name)
}
base = copyPath(base)
if len(base) == 0 {
	if _, err := w.root(); err == nil {
		return fmt.Errorf("composer already has a root")
	}
} else if _, err := w.lookup(formatNodePath(base)); err != nil {
	return fmt.Errorf("base '%s' of node '%s' is not defined", formatNodePath(base), name)
}
for _, n := range w.Nodes {
	if n.Name == name && samePath(n.Base, base) {
		return fmt.Errorf("duplicate node '%s'", name)
	}
}
