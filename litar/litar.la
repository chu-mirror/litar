The command keeps filter outputs in the cache that LITAR_CACHE names; run alone, as the tests call it, keeps none.
@<cli@:litar@:Language@/Go@/File@/functions@=
// Main runs litar with a parsed command line and returns the exit status.
func Main(opts Options) int {
	sigs := make(chan os.Signal, 1)
	signal.Notify(sigs, syscall.SIGINT, syscall.SIGTERM, syscall.SIGHUP)
	go func() {
		sig := <-sigs
		DetachMounts()
		os.Exit(128 + int(sig.(syscall.Signal)))
	}()
	filterCacheDir = cacheDirFromEnv()
	return run(opts, os.Stdout, os.Stderr)
}

