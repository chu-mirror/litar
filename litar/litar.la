endContent flushes the content text without the one line break that ends it, and records that break in endsLine.
@<parse@:litar@:Language@/Go@/File@/methods@+
func (b *body) endContent(text *strings.Builder) {
	s := text.String()
	switch {
	case strings.HasSuffix(s, "\r\n"):
		s = s[:len(s)-2]
	case strings.HasSuffix(s, "\n"):
		s = s[:len(s)-1]
	default:
		b.flush(text)
		return
	}
	b.endsLine = true
	text.Reset()
	text.WriteString(s)
	b.flush(text)
}

