The stack holds the composers being loaded; meeting one again is a cycle,
reported from its first occurrence back to itself.
@<Project@/litar@/Composer@/fail if 'ident' is already on the ground 'stack'@=
for i, frame := range stack {
	if frame.ident != ident {
		continue
	}
	var parts []string
	for _, g := range stack[i:] {
		parts = append(parts, g.name)
	}
	parts = append(parts, frame.name)
	return nil, fmt.Errorf("cycle in grounds: %s", strings.Join(parts, " -> "))
}
@

Unknown fields and trailing data are errors, so a misspelled key is not silently ignored.
@<Project@/litar@/Composer@/decode the composer at 'path' into 'file'@=
data, err := os.ReadFile(path)
if err != nil {
	return nil, fmt.Errorf("could not read composer '%s': %v", path, err)
}
dec := json.NewDecoder(bytes.NewReader(data))
dec.DisallowUnknownFields()
if err := dec.Decode(&file); err != nil {
	return nil, fmt.Errorf("could not read composer '%s': %v", path, err)
}
if dec.More() {
	return nil, fmt.Errorf("could not read composer '%s': trailing data", path)
}
@

The mappings of the ground become read-only here: compositions built on one ground
share its mapped directories, so none of them may change what the others read.
@<Project@/litar@/Composer@/load the ground named in 'file' into 'ground' and 'groundNodes'@=
if file.Ground != nil {
	gname := *file.Ground
	ground = &gname
	if err := validGroundName(gname); err != nil {
		return nil, err
	}
	gpath, err := findGround(gname, filepath.Dir(path))
	if err != nil {
		return nil, err
	}
	gident, err := identityPath(gpath)
	if err != nil {
		return nil, fmt.Errorf("could not read composer '%s': %v", gpath, err)
	}
	gw, err := loadAt(gpath, gident, false, append(stack, groundFrame{ident: ident, name: gname}))
	if err != nil {
		return nil, err
	}
	groundNodes = gw.Nodes
	for i := range groundNodes {
		for j := range groundNodes[i].Mappings {
			groundNodes[i].Mappings[j].ReadOnly = true
		}
	}
}
@~ Project@/litar@/Go@/functions@/litar.findGround @~ Project@/litar@/Go@/functions@/litar.identityPath @~ Project@/litar@/Go@/functions@/litar.loadAt @~ Project@/litar@/Go@/functions@/litar.validGroundName @~ Project@/litar@/Go@/types@/litar.groundFrame @

@<Project@/litar@/Composer@/combine 'groundNodes' and the nodes of 'file' into a World@=
if err := prepareNodes(file.Nodes); err != nil {
	return nil, err
}
// Names and bases are checked before archives are read.
if err := validateGraph(graphNodes(groundNodes, file.Nodes)); err != nil {
	return nil, err
}
local, err := nodesFrom(path, file.Nodes)
if err != nil {
	return nil, err
}
all := make([]Node, 0, len(groundNodes)+len(local))
all = append(all, groundNodes...)
all = append(all, local...)
if err := distinctArchives(all); err != nil {
	return nil, err
}
return &World{
	Composer:    path,
	Dir:         dirIdent,
	Description: file.Description,
	Ground:      ground,
	Nodes:       all,
	localAt:     len(groundNodes),
}, nil
@~ Project@/litar@/Go@/functions@/litar.distinctArchives @~ Project@/litar@/Go@/functions@/litar.graphNodes @~ Project@/litar@/Go@/functions@/litar.nodesFrom @~ Project@/litar@/Go@/functions@/litar.prepareNodes @~ Project@/litar@/Go@/functions@/litar.validateGraph @~ Project@/litar@/Go@/types@/litar.Node @~ Project@/litar@/Go@/types@/litar.World @

A ground is written as a name, searched for in the library directories,
or as a relative path whose first element is "." or "..",
resolved against the directory of the composer file.
@<compose@:litar@:Language@/Go@/File@/functions@+
func validGroundName(name string) error {
	if name == "" || strings.Contains(name, `\`) {
		return fmt.Errorf("invalid ground '%s'", name)
	}
	if !groundIsPath(name) && strings.Contains(name, "/") {
		return fmt.Errorf("invalid ground '%s'", name)
	}
	return nil
}

func groundIsPath(name string) bool {
	first, _, _ := strings.Cut(name, "/")
	return first == "." || first == ".."
}

@? Project@/litar@/Go@/functions@/litar.groundIsPath @? Project@/litar@/Go@/functions@/litar.validGroundName @

findGround locates the composer file of a ground; dir is the directory of the composer
file that names it.
@<compose@:litar@:Language@/Go@/File@/functions@+
func findGround(name, dir string) (string, error) {
	if groundIsPath(name) {
		if path := filepath.Join(dir, name, "composer.json"); isRegular(path) {
			return path, nil
		}
		return "", fmt.Errorf("could not find ground '%s'", name)
	}
	for _, lib := range librarySearchDirs() {
		path := filepath.Join(lib, name, "composer.json")
		if isRegular(path) {
			return path, nil
		}
	}
	return "", fmt.Errorf("could not find ground '%s'", name)
}

@? Project@/litar@/Go@/functions@/litar.findGround @~ Project@/litar@/Go@/functions@/litar.groundIsPath @~ Project@/litar@/Go@/functions@/litar.isRegular @~ Project@/litar@/Go@/functions@/litar.librarySearchDirs @

prepareNodes checks that every local composer node has a non-empty name and an explicit base field.
@<compose@:litar@:Language@/Go@/File@/functions@+
func prepareNodes(raw []composerNode) error {
	for _, n := range raw {
		if n.Name == "" {
			return fmt.Errorf("empty name")
		}
		if !n.Base.set {
			return fmt.Errorf("node '%s' is missing base", n.Name)
		}
	}
	return nil
}

