file is the catalog file at path, or the file at path below a mapped directory.
A file below a mapped directory has no entry in the catalog, since the directory is mapped
as a whole; it is read as a mapped file whose origin lies below the origin of the directory.
@<filter@:litar@:Language@/Go@/File@/methods@+
func (c *catalog) file(path string) *catFile {
	if f := c.files[path]; f != nil {
		return f
	}
	for dir, f := range c.files {
		rest, ok := strings.CutPrefix(path, dir+"/")
		if ok && f.dir && !f.archive {
			return &catFile{mapping: true, origin: filepath.Join(f.origin, filepath.FromSlash(rest))}
		}
	}
	return nil
}

@? Project@/litar@/Go@/methods@/litar.catalog.file @~ Project@/litar@/Go@/types@/litar.catFile @~ Project@/litar@/Go@/types@/litar.catalog @

Visible returns the blocks of a node that a worker reads. The nearest node on the base
chain that has a select field decides: under it, the reader sees the blocks it selects,
the meta chunks of the reserved namespaces, and the own blocks of that node and the nodes
based on it. Without such a node the reader sees the whole chain.
Evaluation always uses Chain, so a selection never changes a result.
@<compose@:litar@:Language@/Go@/File@/methods@+
func (w *World) Visible(name string) ([]Block, error) {
	rev, err := w.ancestry(name)
	if err != nil {
		return nil, err
	}
	chain, err := w.Chain(name)
	if err != nil {
		return nil, err
	}
	sel := slices.IndexFunc(rev, func(n *Node) bool { return n.Select != nil })
	if sel < 0 {
		return chain, nil
	}
	units, err := parseUnits(rev[sel].Select)
	if err != nil {
		return nil, err
	}
	in := selection(chain, units)
	// The ancestors of the selecting node come first in the chain.
	start := 0
	for _, n := range rev[sel+1:] {
		start += len(n.Own)
	}
	var out []Block
	for i, b := range chain {
		_, meta := reservedNamespace(b.Ref.Module)
		if in[i] || meta || i >= start {
			out = append(out, b)
		}
	}
	return out, nil
}

@~ Project@/litar@/Go@/functions@/litar.parseUnits @~ Project@/litar@/Go@/functions@/litar.reservedNamespace @~ Project@/litar@/Go@/functions@/litar.selection @~ Project@/litar@/Go@/methods@/litar.World.Chain @? Project@/litar@/Go@/methods@/litar.World.Visible @~ Project@/litar@/Go@/methods@/litar.World.ancestry @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Node @~ Project@/litar@/Go@/types@/litar.World @

SetSelect gives a node of the composition the functional units it selects and saves the
composer; nil entries remove its select field.
@<compose@:litar@:Language@/Go@/File@/methods@+
func (w *World) SetSelect(ref string, entries []string) error {
	n, err := w.requireLocal(ref)
	if err != nil {
		return err
	}
	if _, err := parseUnits(entries); err != nil {
		return err
	}
	old := n.Select
	n.Select = nil
	if entries != nil {
		n.Select = append([]string{}, entries...)
	}
	if err := w.save(); err != nil {
		n.Select = old
		return fmt.Errorf("could not write '%s'", w.Composer)
	}
	return nil
}

