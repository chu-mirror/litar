"bytes"
"fmt"
"io"
"os"
"os/exec"
"strings"
"syscall"
@

Represents a single entry in the file catalog, recording its file sets, origin path, and flags for executable, archive, mapped, directory, and read-only status.
@<filter@:litar@:Language@/Go@/File@/types@+
type catFile struct {
	sets       map[string]struct{}
	executable bool
	archive    bool
	mapping    bool
	// dir is set for a mapping of a directory.
	dir    bool
	origin string
	// readOnly is set for a mapping of the ground.
	readOnly bool
}

@? Project@/litar@/Go@/types@/litar.catFile @

Holds the ordered list of cataloged file paths, their catFile metadata indexed by path, and a map of paths with archive-versus-mapping conflicts.
@<filter@:litar@:Language@/Go@/File@/types@+
type catalog struct {
	order     []string
	files     map[string]*catFile
	conflicts map[string]bool
}

@~ Project@/litar@/Go@/types@/litar.catFile @? Project@/litar@/Go@/types@/litar.catalog @

Represents a file materialized into a filter's mounted view, including its path, flags, content body, and a stable inode number assigned once for the mount.
@<filter@:litar@:Language@/Go@/File@/types@+
type viewFile struct {
	path       string
	executable bool
	origin     string
	archive    bool
	dir        bool
	readOnly   bool
	body       []byte
	// ino is assigned once for the mount. A fresh number on each
	// lookup makes tools treat the file as replaced mid-invocation.
	ino uint64
}

@? Project@/litar@/Go@/types@/litar.viewFile @

