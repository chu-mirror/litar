// args adds the composition and the root node to the arguments of a tool.
func (f *mcpFixture) args(pairs ...any) map[string]any {
	args := map[string]any{"composition": f.c, "node": f.n}
	for i := 0; i < len(pairs); i += 2 {
		args[pairs[i].(string)] = pairs[i+1]
	}
	return args
}

