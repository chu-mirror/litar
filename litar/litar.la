@<Project@/litar@/check the specialization tree of msg in 'arch', and that its ids are stable@=
chunk := ChunkRef{Chunk: "msg"}
tree, err := specializationTree(arch.Blocks, nil, &chunk)
if err != nil {
t.Fatal(err)
}
if tree.Name != "/" || tree.Ref != refOf("labels") || tree.Description != "" || len(tree.SubTrees) != 1 {
t.Fatalf("root %+v", tree)
}
label1 := tree.SubTrees[0]
if label1.Name != "label1" || label1.Ref != refOf("labels", "label1") || label1.Description != "" || len(label1.SubTrees) != 1 {
t.Fatalf("label1 %+v", label1)
}
label2 := label1.SubTrees[0]
if label2.Name != "label2" || label2.Ref != refOf("labels", "label1", "label2") || label2.Description != "the spec" || len(label2.SubTrees) != 0 {
t.Fatalf("label2 %+v", label2)
