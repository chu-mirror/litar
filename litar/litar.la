A file is the chunk named by its path; an item starts from the blocks that define it,
each under its own header.
@<Project@/litar@/Selection@/walk from the blocks applied to the unit 'u', or defining it@=
switch {
case u.chunk != nil:
	walk(*u.chunk)
case u.file != "":
	walk(ChunkRef{Chunk: Name(u.file)})
default:
	for i, b := range chain {
		if carries(b.Defines, u.item) {
			visit(i, b.Ref)
		}
	}
}
