@<fuse@:litar@:Language@/Go@/File@/methods@+
func (d *dirNode) Mkdir(ctx context.Context, name string, mode uint32, out *fuse.EntryOut) (*fs.Inode, syscall.Errno) {
	if d.specChild(name) != nil {
		return nil, syscall.EEXIST
	}
	host := filepath.Join(d.hostDir(), name)
	if err := os.MkdirAll(host, 0o755); err != nil {
		return nil, syscall.EIO
	}
	out.Mode = syscall.S_IFDIR | 0o755
	node := &dirNode{rel: d.childRel(name), overlay: d.overlay}
	return d.NewInode(ctx, node, fs.StableAttr{Mode: syscall.S_IFDIR}), 0
}

@~ Project@/litar@/Go@/methods@/litar.dirNode.childRel @~ Project@/litar@/Go@/methods@/litar.dirNode.hostDir @~ Project@/litar@/Go@/methods@/litar.dirNode.specChild @~ Project@/litar@/Go@/types@/litar.dirNode @

@<fuse@:litar@:Language@/Go@/File@/methods@+
func (d *dirNode) Unlink(ctx context.Context, name string) syscall.Errno {
	if d.specChild(name) != nil {
		return syscall.EROFS
	}
	host := filepath.Join(d.hostDir(), name)
	if err := os.Remove(host); err != nil {
		if os.IsNotExist(err) {
			return syscall.ENOENT
		}
		return syscall.EIO
	}
	return 0
}

@~ Project@/litar@/Go@/methods@/litar.dirNode.hostDir @~ Project@/litar@/Go@/methods@/litar.dirNode.specChild @~ Project@/litar@/Go@/types@/litar.dirNode @

@<fuse@:litar@:Language@/Go@/File@/methods@+
func (d *dirNode) Rmdir(ctx context.Context, name string) syscall.Errno {
	if ch := d.specChild(name); ch != nil {
		return syscall.EROFS
	}
	host := filepath.Join(d.hostDir(), name)
	if err := os.Remove(host); err != nil {
		if os.IsNotExist(err) {
			return syscall.ENOENT
		}
		return syscall.EIO
	}
	return 0
}

