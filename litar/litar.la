		"@@<msg@@=\n@@<word@@> @@<other@@>\n@@~ K@@/w @@\n"+
		"@@<word@@=hello\n@@? K@@/w @@\n"+
		"@@<other@@=world@@\n"+
		"@@<unrelated@@=far@@\n"+
		"@@<Index@@/K@@/w@@={\"description\": \"a word\"}@@\n")
	item := f.ref("item", "K", "w")
	if defs := f.blocks("define", item); len(defs) != 1 || !strings.Contains(defs[0].Text, "hello") {
		t.Fatalf("defining blocks %+v", defs)
	}
	node := func(name string, sel []string) map[string]any {
		return map[string]any{"composition": f.c, "name": name, "archive": name + ".la", "description": "", "base": f.n, "select": sel}
	}
	callToolError(t, f.ctx, f.session, "create_node", node("bad", []string{"Index@@/"}))
	task := callTool(t, f.ctx, f.session, "create_node", node("task", []string{"word"}))
	raw, _ := os.ReadFile(filepath.Join(f.dir, "composer.json"))
	if !strings.Contains(string(raw), `"select": [`) || strings.Contains(string(raw), `"bad"`) {
		t.Fatalf("composer %s", raw)
	}
	@<Project@/litar@/Tests@/MCP@/check what the node 'task' of 'f' reads and evaluates@>
}

