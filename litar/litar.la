Force-unmounts a macOS FUSE mount point, trying syscall.Unmount, then umount -f, and finally diskutil unmount force.
@<fuse darwin@:litar@:Language@/Go@/File@/functions@+
func detach(dir string, _ bool) {
	if syscall.Unmount(dir, mntForce) == nil {
		return
	}
	if exec.Command("umount", "-f", dir).Run() == nil {
		return
	}
	_ = exec.Command("diskutil", "unmount", "force", dir).Run()
}

