items reads the items up to the end control. The caller has consumed "@@~" or "@@?",
and either may introduce each further item.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (s *spanScanner) items() error {
	p := &s.p
	start := p.i
	var item Item
	for {
		name, kind, n, err := p.readName(false)
		if err != nil {
			return err
		}
		item = append(item, name)
		if kind == '/' && n == 2 {
			p.i += n
			continue
		}
		s.spans = append(s.spans, nameSpan{start: start, end: p.i, role: spanItem, item: item})
		if (kind != '~' && kind != '?') || n != 2 {
			return nil
		}
		p.i += n
		start, item = p.i, nil
	}
}

@~ Project@/litar@/Go@/constants@/litar.spanItem @~ Project@/litar@/Go@/methods@/litar.parser.readName @? Project@/litar@/Go@/methods@/litar.spanScanner.items @~ Project@/litar@/Go@/types@/litar.Item @~ Project@/litar@/Go@/types@/litar.nameSpan @~ Project@/litar@/Go@/types@/litar.spanScanner @

namespace is the reserved module that holds the descriptions of what moves.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (r renaming) namespace() Name {
	if r.items {
		return "Index"
	}
	return "Chunk"
}

@? Project@/litar@/Go@/methods@/litar.renaming.namespace @~ Project@/litar@/Go@/types@/litar.Name @~ Project@/litar@/Go@/types@/litar.renaming @

applyItem returns an item renamed.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (r renaming) applyItem(it Item) (Item, bool) {
	exact := len(it) == len(r.from) && !r.module
	below := r.module && len(it) > len(r.from)
	if !r.items || !(exact || below) || !namePrefix(it, r.from) {
		return it, false
	}
	return append(append(Item{}, r.to...), it[len(r.from):]...), true
}

@~ Project@/litar@/Go@/functions@/litar.namePrefix @? Project@/litar@/Go@/methods@/litar.renaming.applyItem @~ Project@/litar@/Go@/types@/litar.Item @~ Project@/litar@/Go@/types@/litar.renaming @

carried reports whether a block carries an item that the renaming moves.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (r renaming) carried(bl Block) bool {
	for _, it := range bl.Items {
		if _, ok := r.applyItem(it); ok {
			return true
		}
	}
	return false
}

@~ Project@/litar@/Go@/methods@/litar.renaming.applyItem @? Project@/litar@/Go@/methods@/litar.renaming.carried @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.renaming @

checkItems refuses to rename an item that the node does not carry, or that a base node carries: the base keeps its blocks, so the cross-reference would break in two.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (w *World) checkItems(n *Node, r renaming) error {
	name := formatModule(ModulePath(r.from))
	rev, err := w.ancestry(formatNodePath(nodePath(*n)))
	if err != nil {
		return err
	}
	for _, base := range rev[1:] {
		for _, bl := range base.Own {
			if r.carried(bl) {
				return fmt.Errorf("%s '%s' is used in node '%s'", r.what(), name, base.Name)
			}
		}
	}
	for _, bl := range n.Own {
		if r.carried(bl) {
			return nil
		}
	}
	return fmt.Errorf("unknown %s '%s'", r.what(), name)
}

@~ Project@/litar@/Go@/functions@/litar.formatModule @~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/methods@/litar.World.ancestry @? Project@/litar@/Go@/methods@/litar.World.checkItems @~ Project@/litar@/Go@/methods@/litar.renaming.carried @~ Project@/litar@/Go@/methods@/litar.renaming.what @~ Project@/litar@/Go@/types@/litar.ModulePath @~ Project@/litar@/Go@/types@/litar.Node @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.renaming @

MapFile adds a mapping to a node: the file or directory origin, outside the archives, appears in the node at path.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (w *World) MapFile(nodeName, at, origin string, sets []string) error {
	n, err := w.requireLocal(nodeName)
	if err != nil {
		return err
	}
	p, err := cleanPath(at)
	if err != nil {
		return err
	}
	if origin == "" {
		return fmt.Errorf("missing origin")
	}
	if _, ok := unmap(n.Mappings, p); ok {
		return fmt.Errorf("mapping '%s' already exists", p)
	}
	if strings.HasSuffix(at, "/") {
		p += "/"
	}
	m := Mapping{Path: p, FileSet: append([]string{}, sets...), Origin: origin, OriginSpec: origin}
	if !filepath.IsAbs(origin) {
		m.Origin = filepath.Join(filepath.Dir(w.Composer), origin)
	}
	n.Mappings = append(n.Mappings, m)
	if err := w.save(); err != nil {
		n.Mappings = n.Mappings[:len(n.Mappings)-1]
		return fmt.Errorf("could not write '%s'", w.Composer)
	}
	return nil
}

@~ Project@/litar@/Go@/functions@/litar.cleanPath @~ Project@/litar@/Go@/functions@/litar.unmap @? Project@/litar@/Go@/methods@/litar.World.MapFile @~ Project@/litar@/Go@/methods@/litar.World.Mappings @~ Project@/litar@/Go@/methods@/litar.World.requireLocal @~ Project@/litar@/Go@/methods@/litar.World.save @~ Project@/litar@/Go@/types@/litar.Mapping @~ Project@/litar@/Go@/types@/litar.World @

OverrideBlock puts the blocks of text in the place of one block of the node. The new blocks are applied to the chunk reference of the old one, so the change stays within one chunk; the comment of the old block goes with it.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (w *World) OverrideBlock(nodeName, ref, text string) error {
	n, err := w.requireLocal(nodeName)
	if err != nil {
		return err
	}
	i, err := ownBlock(n, ref)
	if err != nil {
		return err
	}
	arch, err := ParseArchive([]byte(text), n.Archive)
	if err != nil {
		return err
	}
	@<Project@/litar@/Rewrite@/fail unless 'arch' has blocks, all applied to the reference of block 'i' of 'n'@>
	@<Project@/litar@/Rewrite@/start the comment of 'arch' where the comment of block 'i' started@>
	var b strings.Builder
	joinBlocks(&b, n.Own[:i])
	joinBlocks(&b, arch.Blocks)
	joinBlocks(&b, n.Own[i+1:])
	b.WriteString(n.Trailing)
	data, next, err := compacted(n, b.String())
	if err != nil {
		return err
	}
	return store(n, data, next)
}

