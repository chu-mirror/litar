func (w *World) requireLocal(ref string) (*Node, error) {
	i, err := w.findIndex(ref)
	if err != nil {
		return nil, err
	}
	if i < w.localAt {
		return nil, fmt.Errorf("node '%s' is defined in the ground", w.Nodes[i].Name)
	}
	return &w.Nodes[i], nil
}

