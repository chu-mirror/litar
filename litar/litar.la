A long name wraps inside its row, so the navigator never scrolls sideways.
@<Project@/litar@/Web@/style rules@+
ul.tree { list-style: none; margin: 0; padding: 0; }
ul.tree ul.tree { margin-left: 9px; padding-left: 8px; border-left: 1px solid var(--line); }
.tree summary, .tree .leaf { display: flex; gap: 4px; align-items: baseline; padding: 2px 6px; border-radius: 6px; overflow-wrap: anywhere; }
.tree summary { cursor: pointer; font-weight: 600; list-style: none; }
.tree summary::-webkit-details-marker { display: none; }
.tree summary::before { content: '▸'; color: var(--muted); width: 1em; flex: none; }
.tree details[open] > summary::before { content: '▾'; }
.tree .name, .tree .leaf a { flex: 1; min-width: 0; }
.tree .leaf a { color: var(--fg); }
.tree .leaf:hover, .tree summary:hover { background: var(--accent-bg); }
.tree .leaf.sel { background: var(--accent-bg); }
.tree .leaf.sel a { color: var(--accent); font-weight: 600; }
.tree .pen { visibility: hidden; border: 0; background: none; padding: 0 2px; color: var(--muted); }
.tree .leaf:hover .pen, .tree summary:hover .pen, .tree .pen:focus-visible { visibility: visible; }

