func TestRenameChunk(t *testing.T) {
	w, a, b := rewriteWorld(t, renameRoot, renameChild)
	if err := w.Rename("root", renaming{module: false, from: ModulePath{"Mod", "one"}, to: ModulePath{"New", "uno"}}); err != nil {
		t.Fatal(err)
	}
	if err := w.Rename("root", renaming{module: false, from: ModulePath{"Mod", "three"}, to: ModulePath{"tres"}}); err != nil {
		t.Fatal(err)
	}
	text := archiveText(t, a)
	for _, want := range []string{
		"About one.\n@@<New@@/uno@@=\n1 @@<Mod@@/Sub@@/two@@> @@<x@@:tres@@|Mod@@/Sub@@/filter@@>",
		"@@<Chunk@@/New@@/uno@@=",
		"2 @@<tres@@> @@<other@@>",
	} {
		if !strings.Contains(text, want) {
			t.Fatalf("missing %q in\n%s", want, text)
		}
	}
	if got := archiveText(t, b); !strings.Contains(got, "@@<lab@@:New@@/uno@@+") {
		t.Fatalf("child %s", got)
	}
	chain, _ := w.Chain("root/child")
	got, err := NewEvaluator(chain, nil, nil).Eval(ChunkRef{Labels: []Name{"lab"}, Module: ModulePath{"New"}, Chunk: "uno"}, nil)
	if err != nil || !strings.HasPrefix(got, "1 2 3 o 3") {
		t.Fatalf("eval %q %v", got, err)
	}
}

