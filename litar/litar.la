A direct mount needs privileges. Without them the mount is tried again through
fusermount, in a fresh directory and with a fresh root node.
@<fuse linux@:litar@:Language@/Go@/File@/functions@+
func mountFUSE(dir string, root *dirNode, opts *fs.Options, tree *vdir, overlay string) (string, *fuse.Server, bool, error) {
	opts.DirectMount = true
	server, err := fs.Mount(dir, root, opts)
	direct := err == nil
	if err != nil {
		os.RemoveAll(dir)
		dir, err = os.MkdirTemp("", "litar-mnt-*")
		if err != nil {
			os.RemoveAll(overlay)
			return "", nil, false, fmtMount(err)
		}
		opts.DirectMount = false
		root = &dirNode{rel: "", spec: tree, overlay: overlay}
		server, err = fs.Mount(dir, root, opts)
	}
	if err != nil {
		os.RemoveAll(dir)
		os.RemoveAll(overlay)
		return "", nil, false, fmtMount(err)
	}
	return dir, server, direct, nil
}

@? Project@/litar@/Go@/functions@/litar.mountFUSE @~ Project@/litar@/Go@/functions@/litar.fmtMount @~ Project@/litar@/Go@/types@/litar.dirNode @~ Project@/litar@/Go@/types@/litar.vdir @

Performs a lazy unmount of a Linux FUSE mount point, trying syscall.Unmount with MNT_DETACH for direct mounts before falling back to fusermount3 or fusermount.
@<fuse linux@:litar@:Language@/Go@/File@/functions@+
func detach(dir string, direct bool) {
	if direct && syscall.Unmount(dir, syscall.MNT_DETACH) == nil {
		return
	}
	for _, prog := range []string{"fusermount3", "fusermount"} {
		if exec.Command(prog, "-u", "-z", dir).Run() == nil {
			return
		}
	}
}

