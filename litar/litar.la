@<mcp@:litar@:Language@/Go@/File@/functions@+
func describe(blocks []Block, maps []Mapping) (metaInfo, error) {
	meta := newMeta()
	ev := NewEvaluator(blocks, maps, nil)
	seen := map[string]bool{}
	for _, b := range blocks {
		ns, ok := reservedNamespace(b.Ref.Module)
		if !ok || b.Ref.Chunk == "" || len(b.Ref.Labels) != 0 {
			continue
		}
		ref := ChunkRef{Module: copyModule(b.Ref.Module), Chunk: b.Ref.Chunk}
		if seen[ref.key()] {
			continue
		}
		seen[ref.key()] = true
		var desc string
		@<Project@/litar@/MCP Server@/set 'desc' to the description in the meta chunk 'ref'@>
		target := append(append([]Name{}, b.Ref.Module[1:]...), b.Ref.Chunk)
		@<Project@/litar@/MCP Server@/record 'desc' in 'meta' for the 'target' of the namespace 'ns'@>
	}
	return meta, nil
}

