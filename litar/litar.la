	Comment   string // bytes after the previous expression
	Raw       string // the expression as written, including the end control
	Source    string
	StartLine int
	EndLine   int
	// Set when the expression is @@[ or @@(.
	IsFile     bool
	Path       Name
	Executable bool
	Sets       []Name
}

