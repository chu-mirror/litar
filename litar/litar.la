orderedRaw parses src, runs orderOwn on its blocks, and returns their concatenated comment and raw text.
@<compose test@:litar@:Language@/Go@/File@/functions@+
func orderedRaw(t *testing.T, src string) string {
	t.Helper()
	var b strings.Builder
	for _, bl := range orderOwn(mustArch(t, src)) {
		b.WriteString(bl.Comment)
		b.WriteString(bl.Raw)
	}
	return b.String()
}

