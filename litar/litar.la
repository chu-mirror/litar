@<mcp test@:litar@:Language@/Go@/File@/functions@+
func TestMCPRename(t *testing.T) {
	f := newMCPFixture(t, blocksArchive)
	if got := f.tool("rename", "object", f.ref("chunk", "seq"), "to", "Mod@@/list"); got != "seq -> Mod@@/list" {
		t.Fatalf("rename answered %q", got)
	}
	f.tool("rename", "object", f.ref("chunk", "Mod"), "to", "Part")
	f.tool("rename", "object", f.ref("item", "Dom", "b"), "to", "Dom@@/kind@@/b")
	f.tool("rename", "object", f.ref("item", "Dom", "kind"), "to", "Dom@@/sort")
	data := f.archive()
	for _, want := range []string{
		"@@<lab@@:Part@@/list@@+\nfour\n@@~ Dom@@/sort@@/a @@~ Dom@@/sort@@/b @@",
		"@@<Index@@/Dom@@/sort@@/a@@=",
		"@@<Chunk@@/Part@@/list@@=",
	} {
		if !strings.Contains(data, want) {
			t.Fatalf("missing %q in\n%s", want, data)
		}
	}
	if msg := f.fail("rename", "object", "none", "to", "x"); !strings.Contains(msg, "unknown object 'none'") {
		t.Fatalf("message %q", msg)
	}
}

