	text string
	deps map[string]dependency
}

@~ Project@/litar@/Go@/types@/litar.cachedFile @~ Project@/litar@/Go@/types@/litar.dependency @

A dependency is a chunk an evaluation expanded or the view of a filter it ran,
with a digest of the blocks matching the chunk or of the files in the view.
@<eval@:litar@:Language@/Go@/File@/types@+
type dependency struct {
	ref    ChunkRef
	view   []ViewOp
	isView bool
	sum    [sha256.Size]byte
}

@~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.ViewOp @~ Project@/litar@/Go@/types@/litar.dependency @

