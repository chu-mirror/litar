Reports whether FUSE is available on Linux by checking if /dev/fuse exists.
@<fuse linux@:litar@:Language@/Go@/File@/functions@+
func fuseAvailable() bool {
	_, err := os.Stat("/dev/fuse")
	return err == nil
}

