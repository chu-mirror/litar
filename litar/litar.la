@<mcp test@:litar@:Language@/Go@/File@/functions@+
// newMCPFixture creates the composition through the session, fills the archive
// of its root node behind the server, and imports it again.
func newMCPFixture(t *testing.T, archive string) *mcpFixture {
	t.Helper()
	f := &mcpFixture{t: t, ctx: context.Background(), dir: filepath.Join(t.TempDir(), "archive")}
	f.session = connectMCP(t, f.ctx)
	f.arch = filepath.Join(f.dir, "a.la")
	f.c = callTool(t, f.ctx, f.session, "create_composition", map[string]any{"path": f.dir, "ground": nil})
	f.n = callTool(t, f.ctx, f.session, "create_node", map[string]any{
		"composition": f.c, "name": "root", "archive": "a.la", "description": "root node", "base": nil,
	})
	writeFile(t, f.arch, archive)
	if again := callTool(t, f.ctx, f.session, "import_composition", map[string]any{"path": f.dir}); again != f.c {
		t.Fatalf("composition ref %q, then %q", f.c, again)
	}
	return f
}

