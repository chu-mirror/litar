Computes the POSIX link count for a virtual directory as 2 plus the number of direct subdirectories.
@<fuse@:litar@:Language@/Go@/File@/functions@+
func dirNlink(d *vdir) uint32 {
	n := uint32(2)
	if d == nil {
		return n
	}
	for _, ch := range d.kids {
		if ch.dir != nil {
			n++
		}
	}
	return n
}

@? Project@/litar@/Go@/functions@/litar.dirNlink @~ Project@/litar@/Go@/types@/litar.vdir @

Populates FUSE directory attributes with 0755 permissions, the computed subdirectory link count, and fixed timestamps.
@<fuse@:litar@:Language@/Go@/File@/functions@+
func setDirAttr(d *vdir, out *fuse.Attr) {
	out.Mode = syscall.S_IFDIR | 0o755
	out.Nlink = dirNlink(d)
	out.SetTimes(&fixedStatTime, &fixedStatTime, &fixedStatTime)
}

