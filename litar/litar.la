Items after "@@?" are defined by the block, and every item is carried, whichever control
introduces it; the controls may alternate, and may follow a pipeline.
@<parse test@:litar@:Language@/Go@/File@/functions@+
func TestDefiningItems(t *testing.T) {
	src := "" +
		"@@<a@@=x\n@@? K@@/one @@~ K@@/two @@? K@@/three @@\n" +
		"@@<b@@=y\n@@|f@@? K@@/one@@\n"
	arch, err := ParseArchive([]byte(src), "a.la")
	if err != nil {
		t.Fatal(err)
	}
	if arch.Text() != src {
		t.Fatalf("round trip %q", arch.Text())
	}
	a := arch.Blocks[0]
	if len(a.Items) != 3 || formatItem(a.Items[1]) != "K@@/two" {
		t.Fatalf("items %v", a.Items)
	}
	if len(a.Defines) != 2 || formatItem(a.Defines[0]) != "K@@/one" || formatItem(a.Defines[1]) != "K@@/three" {
		t.Fatalf("defines %v", a.Defines)
	}
	if got := referred(a); len(got) != 1 || formatItem(got[0]) != "K@@/two" {
		t.Fatalf("referred %v", got)
	}
	b := arch.Blocks[1]
	if len(b.Filters) != 1 || len(b.Items) != 1 || len(b.Defines) != 1 {
		t.Fatalf("after a pipeline %+v", b)
	}
	if _, err := ParseArchive([]byte("@@<a@@=x@@? @@"), "a.la"); err == nil {
		t.Fatal("an empty item was accepted")
	}
}

