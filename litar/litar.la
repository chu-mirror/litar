@<Project@/litar@/Web@/Script@/actions of the chunk 'e': new block, describe, rename, and delete@=
    h('div', {class: 'actions'},
      button('New block', () => newBlock(body, ctl('<') + name + ctl('+')), 'primary'),
      button('Describe', () => describeMeta(['Chunk', ...e.path], e.description)),
      button('Rename', () => renameEntry('chunk', chunkRef, e.path, false)),
      button('Delete', async () => {
        if (await sure('Delete the chunk ' + qualify([], e.path) + ' with every block applied to it in this node?'))
          act('delete_chunk', {chunk: chunkRef}, () => { location.hash = here(); });
      }, 'danger')),
@
@<Project@/litar@/Web@/Script@/actions of the file 'e': describe, move, and delete@=
    h('div', {class: 'actions'},
      button('Describe', () => describeMeta(['File', ...e.path], e.description)),
      button('Move', () => renameEntry('file', fileRef, e.path, false)),
      button('Delete', async () => {
        if (!await sure('Delete the file ' + path + (chunk ? ' with its blocks in this node?' : ' from the mappings of this node?'))) return;
        const gone = () => { location.hash = here(); };
        if (chunk) act('delete_file', {file: fileRef}, gone);
        else act('operate_files', {command: 'rm ' + quote(path)}, gone);
      }, 'danger')),
@
Text is shown with line numbers; any other content is only measured and offered as a download.
@<Project@/litar@/Web@/Script@/return the blocks of 'chunk' on the tab, or the content of the file 'fileRef'@=
    if (tab !== 'content') return blockList(await blocks(tab, chunk, ix.specRoot), {ix, labels: tab === 'depend' ? null : []});
    const response = await fetch(resourceURL(uri('file', state.c, state.n, fileRef)));
    if (!response.ok) throw new Error((await response.text()).trim());
    if (/^text\/|json/.test(response.headers.get('Content-Type') || '')) return numbered(await response.text());
    const size = (await response.arrayBuffer()).byteLength;
    return h('p', {}, 'A binary file of ' + size + ' bytes. ', h('a', {href: resourceURL(uri('file', state.c, state.n, fileRef)), download: e.path[e.path.length - 1]}, 'Download'));
@
@<Project@/litar@/Web@/Script@/actions of the node 'me'@=
    h('div', {class: 'actions'},
      button('New block', () => newBlock(body, ''), 'primary'),
      button('Describe', async () => {
        const v = await ask('Describe ' + me.name, [{name: 'd', label: 'Description', value: me.description, multiline: true}]);
        if (v) act('describe', {description: v.d.trim()});
      }),
      button('New node on this', newNode),
      h('a', {href: here('tools', 'map_file')}, 'Map a file'),
      button('Delete node', async () => {
        if (await sure('Delete the node ' + me.name + ', every node based on it, and their archive files?'))
          act('delete_node', {}, () => { location.hash = '#/' + state.c; });
      }, 'danger')),
@
@<Project@/litar@/Web@/Script@/actions of the composition 'comp'@=
    h('div', {class: 'actions'},
      button('Describe', async () => {
        const v = await ask('Describe the composition', [{name: 'd', label: 'Description', value: comp.description, multiline: true}]);
        if (v) act('describe', {node: undefined, description: v.d.trim()});
      }),
      button('Import a composition', importComposition),
      h('a', {href: here('tools', 'create_composition')}, 'New composition')),
@
@<Project@/litar@/Web@/Script@/call the tool 't' with the values of 'fields', then show the page again@=
      const args = {};
      for (const f of fields) {
        if (f.input.value !== '') args[f.k] = f.structured ? JSON.parse(f.input.value) : f.input.value;
        else if (need.has(f.k)) args[f.k] = f.nullable ? null : '';
      }
      toolResult = {name: t.name, text: await tool(t.name, args)};
      cache.clear();
      await route();
@
@<Project@/litar@/Web@/Script@/set the composition and the node of 'state' from 'parts'@=
    state.compositions = JSON.parse(await resource('list://composition'));
    state.c = (state.compositions.find(c => c.ref === parts[0]) || state.compositions[0] || {}).ref || null;
    state.flat = [];
    if (state.c) try { flatten(await json(uri('tree', 'node', state.c)), [], 0); } catch (e) { state.flat = []; }
    state.n = (state.flat.find(n => n.ref === parts[1]) || state.flat[state.flat.length - 1] || {}).ref || null;
    state.sel = null;
@
