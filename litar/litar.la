@

@<Project@/litar@/Web@/views@+
async function searchView(text = '') {
  $('search').elements.q.value = text;
  const body = h('div', {}, note(text ? 'Searching…' : 'Type a string to find in the comments and texts of the blocks.'));
  show(title('Search', [text || 'Blocks']), body);
  if (!text) return;
  const ix = await indexes();
  await fill(body, async () => {
    const found = JSON.parse(await tool('search_blocks', {composition: state.c, node: state.n, text}));
    return [h('p', {class: 'desc'}, found.length + (found.length === 1 ? ' block contains it.' : ' blocks contain it.')), blockList(found, {ix, labels: null})];
  });
}
async function evalView(expression = '') {
  const input = h('input', {value: expression, placeholder: 'A chunk reference, a file path, or a pipeline', 'aria-label': 'Expression', spellcheck: false});
  const body = h('div', {});
  const run = () => fill(body, async () => output(await tool('evaluate_expression', {composition: state.c, node: state.n, expression: input.value.trim()})));
  show(title('Evaluate', ['Expression']),
    h('p', {class: 'desc'}, 'Evaluating runs the filters of the expression on this machine.'),
    h('form', {class: 'actions', onsubmit: e => {
      e.preventDefault();
      const next = here('eval', input.value.trim());
      if (location.hash === next) run(); else location.hash = next;
    }}, input, h('button', {class: 'primary'}, 'Evaluate')), body);
  input.style.flex = '1 1 320px';
  if (expression) await run();
}

@

The page of a node is where the node and its composition are described, extended, and deleted;
its own blocks below are what a task node is reviewed by before it is digested.
@<Project@/litar@/Web@/views@+
async function nodeView() {
  const ix = await indexes(), me = state.flat.find(n => n.ref === state.n);
  const comp = state.compositions.find(c => c.ref === state.c), body = h('div', {}, note('Loading…'));
  show(title('Node', me.path, [], me.description),
    h('div', {class: 'actions'},
      button('New block', () => newBlock(body, ''), 'primary'),
      button('Describe', async () => {
        const v = await ask('Describe ' + me.name, [{name: 'd', label: 'Description', value: me.description, multiline: true}]);
        if (v) act('describe', {description: v.d.trim()});
      }),
      button('New node on this', newNode),
      h('a', {href: here('tools', 'map_file')}, 'Map a file'),
      button('Delete node', async () => {
        if (await sure('Delete the node ' + me.name + ', every node based on it, and their archive files?'))
          act('delete_node', {}, () => { location.hash = '#/' + state.c; });
      }, 'danger')),
    h('h2', {}, 'Composition'),
    h('p', {class: 'desc'}, comp.name, h('br'), comp.description || 'No description.'),
    h('div', {class: 'actions'},
      button('Describe', async () => {
        const v = await ask('Describe the composition', [{name: 'd', label: 'Description', value: comp.description, multiline: true}]);
        if (v) act('describe', {node: undefined, description: v.d.trim()});
      }),
      button('Import a composition', importComposition),
      h('a', {href: here('tools', 'create_composition')}, 'New composition')),
    h('h2', {}, 'Own blocks'), body);
