under lists the own files at p or below the directory p.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (ix fileIndex) under(p string) []string {
	var files []string
	for f := range ix.own {
		if f == p || strings.HasPrefix(f, p+"/") {
			files = append(files, f)
		}
	}
	sort.Strings(files)
	return files
}

@? Project@/litar@/Go@/methods@/litar.fileIndex.under @~ Project@/litar@/Go@/types@/litar.fileIndex @

foreign names the source of a file at or below p that the node does not hold itself, or of a mapped directory that p lies in.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (ix fileIndex) foreign(p string) (string, bool) {
	var keys []string
	for k := range ix.other {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	for _, k := range keys {
		f := strings.TrimSuffix(k, "/")
		inside := strings.HasSuffix(k, "/") && strings.HasPrefix(p, k)
		if f == p || strings.HasPrefix(f, p+"/") || inside {
			return ix.other[k], true
		}
	}
	return "", false
}

@? Project@/litar@/Go@/methods@/litar.fileIndex.foreign @~ Project@/litar@/Go@/types@/litar.fileIndex @

isDir reports whether some visible file lies below p.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (ix fileIndex) isDir(p string) bool {
	for f := range ix.own {
		if strings.HasPrefix(f, p+"/") {
			return true
		}
	}
	for f := range ix.other {
		if strings.HasPrefix(f, p+"/") {
			return true
		}
	}
	return false
}

@? Project@/litar@/Go@/methods@/litar.fileIndex.isDir @~ Project@/litar@/Go@/types@/litar.fileIndex @

source resolves an operand to the own files it names. dir is set when the operand is a directory.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (ix fileIndex) source(arg string) (p string, files []string, dir bool, err error) {
	if p, err = cleanPath(arg); err != nil {
		return "", nil, false, err
	}
	if where, ok := ix.foreign(p); ok {
		return "", nil, false, fmt.Errorf("'%s' comes from %s", p, where)
	}
	files = ix.under(p)
	return p, files, len(files) > 0 && !ix.own[p], nil
}

@~ Project@/litar@/Go@/functions@/litar.cleanPath @~ Project@/litar@/Go@/methods@/litar.fileIndex.foreign @? Project@/litar@/Go@/methods@/litar.fileIndex.source @~ Project@/litar@/Go@/methods@/litar.fileIndex.under @~ Project@/litar@/Go@/types@/litar.fileIndex @

OperateFiles interprets one rm or mv command on the files of the node, and returns a line for each file it changed.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (w *World) OperateFiles(nodeName, command string) (string, error) {
	n, err := w.requireLocal(nodeName)
	if err != nil {
		return "", err
	}
	words, err := shellWords(command)
	if err != nil {
		return "", err
	}
	if len(words) == 0 {
		return "", fmt.Errorf("empty command")
	}
	ix, err := w.indexFiles(n)
	if err != nil {
		return "", err
	}
	var lines []string
	switch words[0] {
	case "rm":
		lines, err = w.removeFiles(n, ix, words[1:])
	case "mv":
		lines, err = w.moveFiles(n, ix, words[1:])
	default:
		err = fmt.Errorf("unsupported command '%s'", words[0])
	}
	return joinLines(lines), err
}

