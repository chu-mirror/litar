edit replaces the names of a block that the renaming moves.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (r renaming) edit(bl Block, sp nameSpan) (string, bool) {
	switch sp.role {
	case spanHeader, spanFilter:
