func (p *parser) takeOp() (Op, error) {
	kind, n, ok := p.atControl()
	if !ok || n != 2 || (kind != '=' && kind != '+') {
		if !ok && p.i >= len(p.src) {
			return 0, p.fail("unterminated block")
		}
		if ok {
			return 0, p.unexpected(kind, n)
		}
		return 0, p.fail("unterminated block")
	}
	p.i += n
	return Op(kind), nil
}

