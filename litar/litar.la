{"description": "Verifies that an item or domain renaming targets something carried by `n` and not carried by any of `n`'s base nodes."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.checkRename@=
{"description": "Validates a renaming on node `n`, ensuring it is well-formed, affects chunks or items defined in `n` (not its bases), and causes no collisions."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.findIndex@=
{"description": "Returns the index in `w.Nodes` of the node whose formatted node path equals `ref`, or an error if not found."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.indexFiles@=
{"description": "Collects into a `fileIndex` the own files of node `n` alongside files from its base nodes and mappings."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.lookup@=
{"description": "Looks up a node in `w` by its full slash-joined node path and returns a pointer to it."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.moveFiles@=
{"description": "Executes a file `mv` command on node `n`, planning and settling the moves and rewriting headers, references, views, and descriptions across `n`'s local subtree."}
@
@<Index@/Project@/litar@/Go@/methods@/litar.World.removeFiles@=
{"description": "Executes a file `rm` command on node `n`, unmapping mapped paths or deleting own file blocks, root-chunk blocks, and descriptions, requiring `-r` for directories."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.requireLocal@=
{"description": "Looks up a node by path and fails if it is not found or is defined in the ground rather than the local composer file."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.rewriteNodes@=
{"description": "Rewrites and compacts the own blocks of all `nodes` using `edit`, writing archives only if every node succeeds."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.rewriteOwn@=
{"description": "Filters `n.Own` with predicate `keep` and stores the compacted archive, restoring `n`'s previous state on error."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.root@=
{"description": "Returns a pointer to the composition's single root node, or an error if none or more than one exists."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.rootIndex@=
{"description": "Returns the index in `w.Nodes` of the unique node with an empty base, failing if there are zero or multiple roots."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.rootName@=
{"description": "Returns the formatted node path of the composition's root node."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.save@=
{"description": "Serializes the composition's description, ground, and local nodes and writes them to `w.Composer`."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.storeCompact@=
{"description": "Compacts `n`'s own blocks, writes the archive preserving its file mode, and updates `n.Own` and `n.Trailing`."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.World.subtree@=
{"description": "Returns pointers to local node `n` and all local nodes whose node path has `n`'s path as a prefix."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.addWorld@=
{"description": "Acquires `a.mu` and registers or replaces `w` in the agent's composition map."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.addWorldLocked@=
{"description": "Registers or replaces `w` in `a.worlds` by directory, appending its directory to `a.order` if newly added."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.applyBlock@=
{"description": "MCP tool handler that parses block text, applies or overrides it on the target node, refreshes resources, and returns the applied block refs one per line."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.compositionByRef@=
{"description": "Resolves an imported composition `*World` by its MCP composition ref while `a.mu` is held."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.compositionList@=
{"description": "Builds the `listJSON` slice describing all imported compositions in list order."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.compositions@=
{"description": "Returns the imported `*World` values in `a.order` while `a.mu` is held."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.createComposition@=
{"description": "MCP tool handler that creates a new composition at `in.Path` with optional ground and description, registers it, and returns its ref."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.createNode@=
{"description": "MCP tool handler that creates a node (with optional mappings and selection), refreshes resources, and returns the new node's ref."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.createNodeLocked@=
{"description": "Creates a node with its mappings and selection while `a.mu` is held, rolling back the node on mapping or selection failure, and returns its ref."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.deleteBlock@=
{"description": "MCP tool handler that deletes a block by ref from the target node, refreshes resources, and returns the deleted block ref."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.deleteChunk@=
{"description": "MCP tool handler that resolves a chunk ref on the target node, deletes all its own blocks across specializations, refreshes resources, and returns the chunk ref."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.deleteFile@=
{"description": "MCP tool handler that resolves a file ref on the target node, deletes the file's blocks, refreshes resources, and returns the file ref."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.deleteNode@=
{"description": "MCP tool handler that deletes a node and its descendants, refreshes resources, and returns the deleted node ref."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.describe@=
{"description": "MCP tool handler that updates the description of a node (or of the composition when `in.Node` is empty), refreshes resources, and returns the described ref."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.evaluate@=
{"description": "MCP tool handler that parses and evaluates a print expression against a node's full chain and mappings, returning the evaluated text."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.handle@=
{"description": "MCP resource-read handler that renders a requested URI under `a.mu` and returns its text or blob content with MIME type."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.importComposition@=
{"description": "MCP tool handler that loads an existing composition from `in.Path`, registers it in the agent, and returns its composition ref."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.mapFile@=
{"description": "MCP tool handler that adds a file or directory mapping to the target node, refreshes resources, and returns the mapped path."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.moveBlock@=
{"description": "MCP tool handler that moves a block from one local node to another, refreshes resources, and returns the moved block ref."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.nodeChain@=
{"description": "Resolves a node ref and returns its full block chain and mappings while `a.mu` is held."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.operateFiles@=
{"description": "MCP tool handler that runs an `rm` or `mv` file command on the target node, refreshes resources, and returns the operation report."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.readChain@=
{"description": "Resolves a node ref and returns its reader-visible blocks (respecting `select`) and mappings while `a.mu` is held."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.refParts@=
