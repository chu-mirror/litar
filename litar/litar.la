// ownBlock finds a block of the node by its ref.
func ownBlock(n *Node, ref string) (int, error) {
	for i, bl := range n.Own {
		if blockRef(bl) == ref {
			return i, nil
		}
	}
	return 0, fmt.Errorf("unknown block '%s'", ref)
}

