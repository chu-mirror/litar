The agent serves until its input ends or it is cancelled; neither is an error.
@<Project@/litar@/serve agents in agent mode@=
if mode == "agent" {
	ag := newAgent()
	if world != nil {
		ag.addWorld(world)
		ag.refresh()
	}
	err := ag.serve(context.Background())
	if err != nil && !errors.Is(err, io.EOF) && !errors.Is(err, context.Canceled) {
		return fail("%s", err.Error())
	}
	return 0
}
