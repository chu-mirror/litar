continueLine adds text to a line of a block body: indent is the line so far and blank tells that it holds only spaces and tabs. It returns the same for the line that text ends in.
@<eval@:litar@:Language@/Go@/File@/functions@+
func continueLine(indent string, blank bool, text string) (string, bool) {
	if i := strings.LastIndexByte(text, '\n'); i >= 0 {
		indent, blank, text = "", true, text[i+1:]
	}
	if !blank || strings.Trim(text, " \t") != "" {
		return "", false
	}
	return indent + text, true
}

// indentLines writes indent before every line of text after the first.
// An empty line stays empty, and nothing follows a final line break.
func indentLines(text, indent string) string {
	var sb strings.Builder
	for {
		i := strings.IndexByte(text, '\n')
		if i < 0 {
			break
		}
		sb.WriteString(text[:i+1])
		text = text[i+1:]
		if text != "" && text[0] != '\n' && text[0] != '\r' {
			sb.WriteString(indent)
		}
	}
	sb.WriteString(text)
	return sb.String()
}

@? Project@/litar@/Go@/functions@/litar.continueLine @? Project@/litar@/Go@/functions@/litar.indentLines @

