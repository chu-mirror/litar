isEndControl reports whether a control ends a block: a lone @@ at EOF or @@ followed by whitespace.
@<parse@:litar@:Language@/Go@/File@/functions@+
func isEndControl(kind byte, n int) bool {
	if n == 1 {
		return true
	}
	if n != 2 {
		return false
	}
	return kind == ' ' || kind == '\t' || kind == '\n' || kind == '\r'
}

