@<mcp test@:litar@:Language@/Go@/File@/functions@+
func TestMCP(t *testing.T) {
	ctx := context.Background()
	session := connectMCP(t, ctx)
	var gotTools []string
	for _, tool := range listTools(t, ctx, session) {
		gotTools = append(gotTools, tool.Name)
	}
	if !sameStrings(gotTools, wantTools) {
		t.Fatalf("tools %v", gotTools)
	}
	assertMCPLists(t, ctx, session, wantResources, wantTemplates)
	callToolError(t, ctx, session, "import_composition", map[string]any{"path": filepath.Join(t.TempDir(), "missing.json")})
	f := newMCPFixture(t, "@@<msg@@=hello@@\n@@<msg@@=replaced@@\n")
	assertMCPLists(t, f.ctx, f.session, wantResources, wantTemplates)
	if text := f.tool("evaluate_expression", "expression", "msg"); text != "replaced" {
		t.Fatalf("eval text %q", text)
	}
	checkMCPRefs(t, f)
	checkMCPResources(t, f)
	if refs := f.tool("apply_block", "text", "@@<msg@@+!@@\n"); refs != refOf("block", "@@<msg@@+!@@") {
		t.Fatalf("apply answered %q", refs)
	}
	if text := f.tool("evaluate_expression", "expression", "msg"); text != "replaced!" {
		t.Fatalf("after apply %q", text)
	}
	if data := f.archive(); strings.Contains(data, "@@<msg@@=hello@@") || !strings.Contains(data, "@@<msg@@=replaced@@") || !strings.Contains(data, "@@<msg@@+!@@") {
		t.Fatalf("archive %s", data)
	}
	f.tool("delete_chunk", "chunk", f.ref("chunk", "msg"))
	if data := f.archive(); strings.Contains(data, "msg") {
		t.Fatalf("still has msg %s", data)
	}
	f.tool("delete_node")
	raw, _ := os.ReadFile(filepath.Join(f.dir, "composer.json"))
	if strings.TrimSpace(string(raw)) != strings.TrimSpace(string(emptyComposerBytes())) {
		t.Fatalf("composer %s", raw)
	}
	if _, err := os.Stat(f.arch); !os.IsNotExist(err) {
		t.Fatal("archive still present", err)
	}
	assertMCPLists(t, f.ctx, f.session, wantResources, wantTemplates)
}

