A filter reads a read-only mapped directory, but cannot create, change, or remove anything in it.
@<filter test@:litar@:Language@/Go@/File@/functions@+
func TestReadOnlyMappedDirectory(t *testing.T) {
	if !fuseAvailable() {
		t.Skip("no FUSE")
	}
	host := t.TempDir()
	writeFile(t, filepath.Join(host, "kept.txt"), "kept\n")
	src := "" +
		"@@<write@@=\n" +
		"#!/bin/sh\n" +
		"cat in/kept.txt\n" +
		"{ echo x > in/new.txt; } 2>/dev/null || echo refused\n" +
		"{ echo x >> in/kept.txt; } 2>/dev/null || echo refused\n" +
		"rm in/kept.txt 2>/dev/null || echo refused\n" +
		"@@\n" +
		"@@<run@@=\n" +
		"@@|write@@+ground@@\n"
	maps := []Mapping{{Path: "in/", FileSet: []string{"ground"}, Origin: host, ReadOnly: true}}
	got, err := NewEvaluator(mustArch(t, src), maps, nil).Eval(mustRef(t, "run"), nil)
	if err != nil || got != "kept\nrefused\nrefused\nrefused\n" {
		t.Fatalf("%v %q", err, got)
	}
	if _, err := os.Stat(filepath.Join(host, "new.txt")); !os.IsNotExist(err) {
		t.Fatal("a file was created in a read-only mapping")
	}
	if data, err := os.ReadFile(filepath.Join(host, "kept.txt")); err != nil || string(data) != "kept\n" {
		t.Fatalf("%v %q", err, data)
	}
}

