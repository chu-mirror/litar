selectBlocks picks from the chain the blocks that refs ask for: an item, a label path, or a chunk followed by a label path.
@<mcp@:litar@:Language@/Go@/File@/functions@+
func selectBlocks(kind string, chain []Block, maps []Mapping, refs []string) ([]Block, error) {
	var got []Block
	switch kind {
	@<Project@/litar@/MCP Server@/cases of 'kind' in 'selectBlocks' that take one ref@>
	}
	ref, err := chunkByRef(chain, maps, refs[0])
	if err != nil {
		return nil, err
	}
	if ref.Labels, err = labelsByRef(chain, maps, refs[1]); err != nil {
		return nil, err
	}
	switch kind {
	case "apply":
		return matchingBlocks(chain, ref), nil
	case "effective":
		got, _ = effectiveBlocks(chain, ref)
		return got, nil
	}
	for _, b := range chain {
		if blockDepends(b, ref) {
			got = append(got, b)
		}
	}
	return got, nil
}

