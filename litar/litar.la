@~ Project@/litar@/Go@/functions@/litar.orderOwn @~ Project@/litar@/Go@/types@/litar.Block @

@<Project@/litar@/index 'blocks' by chunk in 'keys' and 'byChunk'@=
for i, b := range blocks {
	keys[i] = chunkKey(b.Ref)
	byChunk[keys[i]] = append(byChunk[keys[i]], i)
}
@~ Project@/litar@/Go@/functions@/litar.chunkKey @

A reference is resolved against the module of the block that holds it;
a block referring to its own chunk does not include itself.
@<Project@/litar@/record in 'includers' the blocks whose content includes each block's chunk@=
for a, b := range blocks {
	for _, part := range b.Parts {
		if part.Ref == nil || part.Ref.Chunk == "" {
			continue
		}
		inner := resolveBody(part.Ref.ChunkRef, nil, b.Ref.Module)
		k := chunkKey(inner)
		if k == keys[a] {
			continue
		}
		for _, c := range byChunk[k] {
			if includers[c] == nil {
				includers[c] = map[int]bool{}
			}
			includers[c][a] = true
		}
	}
}
@~ Project@/litar@/Go@/functions@/litar.chunkKey @~ Project@/litar@/Go@/functions@/litar.resolveBody @

@<Project@/litar@/tell whether block 'i' can be placed, requiring its 'includers' if 'strict'@=
if placed[i] || (chainPrev[i] >= 0 && !placed[chainPrev[i]]) {
	return false
}
if !strict {
	return true
}
for a := range includers[i] {
	if !placed[a] {
		return false
	}
}
return true
@

When no block has all its includers placed, inclusion is circular,
and the first block whose chunk predecessor is placed goes next.
@<Project@/litar@/append to 'out' the first ready block, preferring one whose includers are placed@=
next := -1
for i := 0; i < n && next < 0; i++ {
	if ready(i, true) {
		next = i
	}
}
for i := 0; i < n && next < 0; i++ {
	if ready(i, false) {
		next = i
	}
}
placed[next] = true
out = append(out, blocks[next])
@

@<compose@:litar@:Language@/Go@/File@/methods@+
func (w *World) storeCompact(n *Node) error {
	data, arch, err := compactOwn(n)
	if err != nil {
		return err
	}
	if err := writeFileKeepMode(n.Archive, data); err != nil {
		return fmt.Errorf("could not write '%s'", n.Archive)
	}
	n.Own = arch.Blocks
	n.Trailing = arch.Trailing
	return nil
}

@~ Project@/litar@/Go@/functions@/litar.compactOwn @~ Project@/litar@/Go@/functions@/litar.writeFileKeepMode @~ Project@/litar@/Go@/methods@/litar.World.storeCompact @~ Project@/litar@/Go@/types@/litar.Node @~ Project@/litar@/Go@/types@/litar.World @

@<compose@:litar@:Language@/Go@/File@/methods@+
func (w *World) rewriteOwn(n *Node, keep func(Block, int) bool) error {
	var kept []Block
	for i, bl := range n.Own {
		if keep(bl, i) {
			kept = append(kept, bl)
		}
	}
	savedOwn, savedTrail := n.Own, n.Trailing
	n.Own = kept
	if err := w.storeCompact(n); err != nil {
		n.Own, n.Trailing = savedOwn, savedTrail
		return err
	}
	return nil
}

@~ Project@/litar@/Go@/methods@/litar.World.rewriteOwn @~ Project@/litar@/Go@/methods@/litar.World.storeCompact @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Node @~ Project@/litar@/Go@/types@/litar.World @

