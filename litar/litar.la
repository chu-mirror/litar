Mappings and file sets are written as empty arrays, never null, and an origin keeps the text it was read with.
A select field is written only for a node that has one.
@<Project@/litar@/Composer@/convert the nodes in 'local' to composer nodes in 'raw'@=
for i, n := range local {
	maps := make([]composerMapping, len(n.Mappings))
	for j, m := range n.Mappings {
		sets := m.FileSet
		if sets == nil {
			sets = []string{}
		}
		maps[j] = composerMapping{Path: m.Path, FileSet: sets, Origin: m.OriginSpec}
	}
	if maps == nil {
		maps = []composerMapping{}
	}
	var sel *[]string
	if n.Select != nil {
		entries := append([]string{}, n.Select...)
		sel = &entries
	}
	raw[i] = composerNode{
		Name:        n.Name,
		Archive:     n.ArchiveSpec,
		Description: n.Description,
		Mappings:    maps,
		Base:        basePath{names: copyPath(n.Base), set: true},
		Select:      sel,
	}
}
