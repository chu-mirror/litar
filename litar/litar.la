assignRefs gives every entry of a tree its ref. A branch and a leaf of the same path are different objects, so their kinds differ. includeRoot is as in indexTree.
@<mcp@:litar@:Language@/Go@/File@/functions@+
func assignRefs(t *treeJSON, branch, leaf string, includeRoot bool) {
	var walk func(*treeJSON, []string)
	walk = func(node *treeJSON, path []string) {
		kind := branch
		if node.Leaf {
			kind = leaf
		}
		node.Ref = refOf(kind, path...)
		for i := range node.SubTrees {
			sub := &node.SubTrees[i]
			walk(sub, append(append([]string{}, path...), sub.Name))
		}
	}
	var start []string
	if includeRoot && t.Name != "" {
		start = []string{t.Name}
	}
	walk(t, start)
}

