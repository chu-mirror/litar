func TestRenameModule(t *testing.T) {
	w, a, b := rewriteWorld(t, renameRoot, renameChild)
	if err := w.Rename("root", renaming{module: true, from: ModulePath{"Mod", "Sub"}, to: ModulePath{"Mod", "Part"}}); err != nil {
		t.Fatal(err)
	}
	text := archiveText(t, a)
	for _, want := range []string{
		"1 @@<Mod@@/Part@@/two@@> @@<x@@:Mod@@/three@@|Mod@@/Part@@/filter@@>\n@@| Mod@@/Part@@/filter @@",
		"@@<Mod@@/Part@@/two@@=\n2 @@<..@@/three@@> @@<other@@>",
		"@@<Chunk@@/Mod@@/Part@@=",
		"@@<Chunk@@/Mod@@/one@@=",
	} {
		if !strings.Contains(text, want) {
			t.Fatalf("missing %q in\n%s", want, text)
		}
	}
	if got := archiveText(t, b); !strings.Contains(got, "more @@<Mod@@/Part@@/two@@>") {
