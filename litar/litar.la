@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.render@=
{"description": "Dispatches an MCP resource URI (list://, tree://, blocks://, or file://) to its renderer and returns the text or binary content with its MIME type."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.renderBlocks@=
{"description": "Renders a blocks:// MCP resource as JSON by resolving the node and selecting either the node's own blocks or the matching blocks from its readable chain."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.renderFile@=
