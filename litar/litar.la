@<rewrite test@:litar@:Language@/Go@/File@/functions@+
// rewriteWorld loads a composition of a root node and a node based on it.
func rewriteWorld(t *testing.T, root, child string) (*World, string, string) {
	t.Helper()
	dir := t.TempDir()
	a, b := filepath.Join(dir, "a.la"), filepath.Join(dir, "b.la")
	writeFile(t, a, root)
	writeFile(t, b, child)
	comp := filepath.Join(dir, "composer.json")
	writeFile(t, comp, composerDoc(`[
{"name":"root","archive":"a.la","description":"","mappings":[{"path":"data/","fileset":[],"origin":"."}],"base":[]},
{"name":"child","archive":"b.la","description":"","mappings":[],"base":["root"]}]`))
	w, err := LoadComposer(comp)
	if err != nil {
		t.Fatal(err)
	}
	return w, a, b
}

