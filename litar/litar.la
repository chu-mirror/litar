"#!/bin/sh\n" +
	"if stat -c %i hello.txt >/dev/null 2>&1; then\n" +
	"  fstat() { stat -c '%i %s %f %h %X %Y %Z' \"$1\"; }\n" +
	"  dino() { stat -c %i \"$1\"; }\n" +
	"else\n" +
	"  fstat() { stat -f '%i %z %Xp %l %a %m %c' \"$1\"; }\n" +
