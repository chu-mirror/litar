Handles the create_composition MCP tool by creating a new composed archive with optional ground and description, saving it, and registering it with the agent.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) createComposition(ctx context.Context, _ *mcp.CallToolRequest, in createArchiveIn) (*mcp.CallToolResult, any, error) {
	if in.Path == "" {
		return toolErr(errString("missing path"))
	}
	ground := ""
	if in.Ground != nil {
		ground = *in.Ground
	}
	w, err := CreateComposedArchive(in.Path, ground)
	if err != nil {
		return toolErr(err)
	}
	if in.Description != "" {
		w.Description = in.Description
		if err := w.save(); err != nil {
			return toolErr(err)
		}
	}
	return a.useWorld(w)
}

