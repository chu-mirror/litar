Blanks after the interpreter do not make an argument; only a word before the line end does.
@<Project@/litar@/return 'interp' alone unless a word follows it at 'i'@=
if i < len(script) && script[i] == '\r' {
	i++
}
if i >= len(script) || script[i] == '\n' {
	return interp, "", false, true
}
for i < len(script) && (script[i] == ' ' || script[i] == '\t') {
	i++
}
if i >= len(script) || script[i] == '\n' || script[i] == '\r' {
	return interp, "", false, true
