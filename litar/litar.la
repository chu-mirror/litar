A relative origin is resolved against the composer's directory; the original text is kept for saving.
@<Project@/litar@/convert the mappings of 'n' to 'maps'@=
for j, m := range n.Mappings {
	origin := m.Origin
	if origin != "" && !filepath.IsAbs(origin) {
		origin = filepath.Join(dir, origin)
	}
	sets := m.FileSet
	if sets == nil {
		sets = []string{}
	}
	maps[j] = Mapping{
		Path:       m.Path,
		FileSet:    sets,
		Origin:     origin,
		OriginSpec: m.Origin,
	}
}
