@<rewrite@:litar@:Language@/Go@/File@/functions@+
func cleanPath(arg string) (string, error) {
	p := path.Clean(arg)
	if arg == "" || p == "." || p == ".." || strings.HasPrefix(p, "../") || path.IsAbs(p) {
		return "", fmt.Errorf("invalid path '%s'", arg)
	}
	return p, nil
}

