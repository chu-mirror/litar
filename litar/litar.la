// DeleteBlock removes one block of the node.
func (w *World) DeleteBlock(nodeName, ref string) error {
	n, err := w.requireLocal(nodeName)
	if err != nil {
		return err
	}
	i, err := ownBlock(n, ref)
	if err != nil {
		return err
	}
	return w.rewriteOwn(n, func(_ Block, at int) bool { return at != i })
}

