@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) addWorldLocked(w *World) {
	if _, ok := a.worlds[w.Dir]; !ok {
		a.order = append(a.order, w.Dir)
	}
	a.worlds[w.Dir] = w
}

@~ Project@/litar@/Go@/methods@/litar.agent.addWorldLocked @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) addWorld(w *World) {
	a.mu.Lock()
	a.addWorldLocked(w)
	a.mu.Unlock()
}

@~ Project@/litar@/Go@/methods@/litar.agent.addWorld @~ Project@/litar@/Go@/methods@/litar.agent.addWorldLocked @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) useWorld(w *World) (*mcp.CallToolResult, any, error) {
	a.addWorld(w)
	a.refresh()
	return toolText(compositionRef(w))
}

@~ Project@/litar@/Go@/functions@/litar.compositionRef @~ Project@/litar@/Go@/functions@/litar.toolText @~ Project@/litar@/Go@/methods@/litar.agent.addWorld @~ Project@/litar@/Go@/methods@/litar.agent.refresh @~ Project@/litar@/Go@/methods@/litar.agent.useWorld @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @

@<mcp@:litar@:Language@/Go@/File@/methods@+
// compositions is the imported compositions in list order.
// The caller holds a.mu.
func (a *agent) compositions() []*World {
	out := make([]*World, 0, len(a.order))
	for _, dir := range a.order {
		if w := a.worlds[dir]; w != nil {
			out = append(out, w)
		}
	}
	return out
}

@~ Project@/litar@/Go@/methods@/litar.agent.compositions @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) importComposition(ctx context.Context, _ *mcp.CallToolRequest, in importIn) (*mcp.CallToolResult, any, error) {
	if in.Path == "" {
		return toolErr(errString("missing path"))
	}
	w, err := SpecifyComposer(in.Path)
	if err != nil {
		return toolErr(err)
	}
	return a.useWorld(w)
}

@~ Project@/litar@/Go@/functions@/litar.SpecifyComposer @~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/methods@/litar.agent.importComposition @~ Project@/litar@/Go@/methods@/litar.agent.useWorld @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.errString @~ Project@/litar@/Go@/types@/litar.importIn @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) createComposition(ctx context.Context, _ *mcp.CallToolRequest, in createArchiveIn) (*mcp.CallToolResult, any, error) {
	if in.Path == "" {
		return toolErr(errString("missing path"))
	}
	ground := ""
	if in.Ground != nil {
		ground = *in.Ground
	}
	w, err := CreateComposedArchive(in.Path, ground)
	if err != nil {
		return toolErr(err)
	}
	if in.Description != "" {
		w.Description = in.Description
		if err := w.save(); err != nil {
			return toolErr(err)
		}
	}
	return a.useWorld(w)
}

@~ Project@/litar@/Go@/functions@/litar.CreateComposedArchive @~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/methods@/litar.World.save @~ Project@/litar@/Go@/methods@/litar.agent.createComposition @~ Project@/litar@/Go@/methods@/litar.agent.useWorld @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.createArchiveIn @~ Project@/litar@/Go@/types@/litar.errString @

