atControl reports a control at p.i. n == 1 is a final "@@" at end of input. n == 2 is "@@" plus the returned kind. "@@" followed by a letter or a byte >= 128 is text, not a control.
@<parse@:litar@:Language@/Go@/File@/methods@+
func (p *parser) atControl() (kind byte, n int, ok bool) {
	if p.i >= len(p.src) || p.src[p.i] != '@@' {
		return 0, 0, false
	}
	if p.i+1 >= len(p.src) {
		return 0, 1, true
	}
	next := p.src[p.i+1]
	if isLetter(next) || next >= 128 {
		return 0, 0, false
	}
	return next, 2, true
}

