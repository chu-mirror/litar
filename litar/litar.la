@

@<Index@/Project@/litar@/Go@/methods@/litar.parser.parseInnerRef@=
{"description": "Parses an inline chunk or pipeline reference after @@< up to its closing @@>, returning the resulting *Ref."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.parser.parseItems@=
{"description": "Parses @@~ (referred) and @@? (defined) item paths up to the block's end control, returning all carried items and the subset defined by the block."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.parser.parseNames@=
