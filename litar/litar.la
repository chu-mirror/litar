NewEvaluator creates an Evaluator for chain and mappings, indexing chain by module and chunk name and discarding filter stderr when stderr is nil.
@<eval@:litar@:Language@/Go@/File@/functions@+
func NewEvaluator(chain []Block, mappings []Mapping, stderr io.Writer) *Evaluator {
	if stderr == nil {
		stderr = io.Discard
	}
	byChunk := make(map[string][]Block, len(chain))
	for _, b := range chain {
		k := chunkKey(b.Ref)
		byChunk[k] = append(byChunk[k], b)
	}
	return &Evaluator{
		byChunk: byChunk,
		cat:     buildCatalog(chain, mappings),
		stderr:  stderr,
	}
}

@? Project@/litar@/Go@/functions@/litar.NewEvaluator @~ Project@/litar@/Go@/functions@/litar.buildCatalog @~ Project@/litar@/Go@/functions@/litar.chunkKey @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Evaluator @~ Project@/litar@/Go@/types@/litar.Mapping @

resolveBody resolves a body reference's labels (inheriting outerLabels if absent) and relative module path against header.
@<eval@:litar@:Language@/Go@/File@/functions@+
func resolveBody(ref ChunkRef, outerLabels []Name, header ModulePath) ChunkRef {
	labels := ref.Labels
	if len(labels) == 0 {
		labels = copyLabels(outerLabels)
	} else {
		labels = copyLabels(labels)
	}
	var mod ModulePath
	if hasRel(ref.Module) {
		mod = resolveModule(header, ref.Module)
	} else {
		mod = copyModule(ref.Module)
	}
	return ChunkRef{Labels: labels, Module: mod, Chunk: ref.Chunk}
}

@~ Project@/litar@/Go@/functions@/litar.copyLabels @~ Project@/litar@/Go@/functions@/litar.copyModule @~ Project@/litar@/Go@/functions@/litar.hasRel @? Project@/litar@/Go@/functions@/litar.resolveBody @~ Project@/litar@/Go@/functions@/litar.resolveModule @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.ModulePath @~ Project@/litar@/Go@/types@/litar.Name @

resolveFilter resolves a filter reference's labels, inheriting outerLabels when the filter specifies none.
@<eval@:litar@:Language@/Go@/File@/functions@+
func resolveFilter(ref ChunkRef, outerLabels []Name) ChunkRef {
	labels := ref.Labels
	if len(labels) == 0 {
		labels = copyLabels(outerLabels)
	} else {
		labels = copyLabels(labels)
	}
	return ChunkRef{Labels: labels, Module: copyModule(ref.Module), Chunk: ref.Chunk}
}

@~ Project@/litar@/Go@/functions@/litar.copyLabels @~ Project@/litar@/Go@/functions@/litar.copyModule @? Project@/litar@/Go@/functions@/litar.resolveFilter @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Name @

mustArch parses an archive string in tests and returns its blocks.
@<eval test@:litar@:Language@/Go@/File@/functions@+
func mustArch(t *testing.T, src string) []Block {
	t.Helper()
	arch, err := ParseArchive([]byte(src), "a.la")
	if err != nil {
		t.Fatal(err)
	}
	return arch.Blocks
}

@~ Project@/litar@/Go@/functions@/litar.ParseArchive @? Project@/litar@/Go@/functions@/litar.mustArch @~ Project@/litar@/Go@/types@/litar.Block @

mustEval evaluates a print expression against an archive string and asserts it equals want.
@<eval test@:litar@:Language@/Go@/File@/functions@+
func mustEval(t *testing.T, src, expr, want string) {
	t.Helper()
	blocks := mustArch(t, src)
	ref, filters, err := ParsePrint(expr)
	if err != nil {
		t.Fatal(err)
	}
	ev := NewEvaluator(blocks, nil, nil)
	got, err := ev.Eval(ref, filters)
	if err != nil {
		t.Fatalf("eval %s: %v", expr, err)
	}
	if got != want {
		t.Fatalf("eval %s\n got %q\nwant %q", expr, got, want)
	}
}

