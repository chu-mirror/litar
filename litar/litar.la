identityPath returns a cleaned absolute path with symlinks resolved when possible, used to compare file identities.
@<compose@:litar@:Language@/Go@/File@/functions@+
func identityPath(path string) (string, error) {
	abs, err := filepath.Abs(path)
	if err != nil {
		return "", err
	}
	abs = filepath.Clean(abs)
	if resolved, err := filepath.EvalSymlinks(abs); err == nil {
		return filepath.Clean(resolved), nil
	}
	return abs, nil
}

