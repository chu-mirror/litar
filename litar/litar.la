A loopback node of go-fuse resolves its paths from the root node of its data;
making the node that root lets it sit anywhere below the root of the view.
The device of the data is left zero, so the inode numbers of host files keep
their device in the high bits, apart from the small numbers of the view.
A read-only directory wraps the root node, and the wrapper wraps every child it creates.
@<fuse@:litar@:Language@/Go@/File@/functions@+
func hostNode(dir string, readOnly bool) fs.InodeEmbedder {
	data := &fs.LoopbackRoot{Path: dir}
	node := &fs.LoopbackNode{RootData: data}
	data.RootNode = node
	if readOnly {
		return &readOnlyNode{node}
	}
	return node
}

@? Project@/litar@/Go@/functions@/litar.hostNode @~ Project@/litar@/Go@/types@/litar.readOnlyNode @

Returns the POSIX regular-file mode bits for a view file, using 0555 if executable and 0444 otherwise.
@<fuse@:litar@:Language@/Go@/File@/functions@+
func modeOf(f *viewFile) uint32 {
	perm := uint32(0o444)
	if f != nil && f.executable {
		perm = 0o555
	}
	return syscall.S_IFREG | perm
}

@? Project@/litar@/Go@/functions@/litar.modeOf @~ Project@/litar@/Go@/types@/litar.viewFile @

Populates FUSE file attributes including mode, link count, fixed timestamps, and byte size from a viewFile.
@<fuse@:litar@:Language@/Go@/File@/functions@+
func setFileAttr(f *viewFile, out *fuse.Attr) {
	out.Mode = modeOf(f)
	out.Nlink = 1
	out.SetTimes(&fixedStatTime, &fixedStatTime, &fixedStatTime)
	if f != nil {
		out.Size = uint64(len(f.body))
	}
}

