// unmap takes the mapping of the path of arg away from maps.
func unmap(maps []Mapping, arg string) ([]Mapping, bool) {
	p := path.Clean(arg)
	for i, m := range maps {
		if strings.TrimSuffix(m.Path, "/") == p {
			return append(append([]Mapping{}, maps[:i]...), maps[i+1:]...), true
		}
	}
	return maps, false
}

