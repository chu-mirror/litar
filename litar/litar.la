	"echo \"$s1\"\n" +
	"echo \"$n1\"\n" +
@

@<Project@/litar@/Tests@/Filter@/probe lines that stat the files around reads and a copy@=
"s1=$(fstat hello.txt)\n" +
	"cat hello.txt >/dev/null\n" +
	"out=$(mktemp)\n" +
	"cp hello.txt \"$out\" || exit 1\n" +
	"cmp hello.txt \"$out\" || exit 1\n" +
	"rm -f \"$out\"\n" +
	"s2=$(fstat hello.txt)\n" +
	"d1=$(dino doc)\n" +
	"cat doc/note.txt >/dev/null\n" +
	"d2=$(dino doc)\n" +
