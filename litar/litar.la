@<mcp test@:litar@:Language@/Go@/File@/functions@+
func TestMCPMappings(t *testing.T) {
	f := newMCPFixture(t, "@@[a.txt@@=a@@\n")
	writeFile(t, filepath.Join(f.dir, "data.txt"), "mapped")
	child := callTool(t, f.ctx, f.session, "create_node", map[string]any{
		"composition": f.c, "name": "child", "archive": "b.la", "description": "", "base": f.n,
		"mappings": []any{map[string]any{"path": "in/data.txt", "origin": "data.txt", "fileset": []any{"data"}}},
	})
	uri := "file://" + f.c + "/" + child + "/" + refOf("file", "in", "data.txt")
	if got := readResource(t, f.ctx, f.session, uri); got != "mapped" {
		t.Fatalf("mapped file %q", got)
	}
	f.tool("map_file", "path", "copy.txt", "origin", "data.txt")
	f.fail("map_file", "path", "copy.txt", "origin", "data.txt")
	f.fail("map_file", "path", "../x", "origin", "data.txt")
	raw, _ := os.ReadFile(filepath.Join(f.dir, "composer.json"))
	if !strings.Contains(string(raw), `"path": "copy.txt"`) || !strings.Contains(string(raw), `"path": "in/data.txt"`) {
		t.Fatalf("composer %s", raw)
	}
	if got := f.tool("operate_files", "command", "rm copy.txt a.txt"); got != "unmapped copy.txt\nremoved a.txt\n" {
		t.Fatalf("rm answered %q", got)
	}
	raw, _ = os.ReadFile(filepath.Join(f.dir, "composer.json"))
	if strings.Contains(string(raw), "copy.txt") || strings.TrimSpace(f.archive()) != "" {
		t.Fatalf("composer %s\narchive %s", raw, f.archive())
	}
}

