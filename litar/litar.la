Returns a freshly copied slice of data starting at offset off and bounded by the length of dest, or nil if off is out of range.
@<fuse@:litar@:Language@/Go@/File@/functions@+
func window(data, dest []byte, off int64) []byte {
	if off < 0 || off >= int64(len(data)) {
		return nil
	}
	data = data[off:]
	if len(dest) < len(data) {
		data = data[:len(dest)]
	}
	out := make([]byte, len(data))
	copy(out, data)
	return out
}

