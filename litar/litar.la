A use without labels takes the labels of the reference it is evaluated under: 'outer',
and when 'open' any specialization of 'outer', because the blocks of a chunk reference
are also evaluated for its specializations. So such a use matches the query when one
label path continues the other.
@<list@:litar@:Language@/Go@/File@/functions@+
func useMatches(use ChunkRef, query ChunkRef, header ModulePath, outer []Name, open bool) bool {
	mod := use.Module
	if hasRel(mod) {
		mod = resolveModule(header, mod)
	}
	if use.Chunk != query.Chunk || !modulesEqual(mod, query.Module) {
		return false
	}
	if len(use.Labels) > 0 {
		return isSuffix(query.Labels, use.Labels)
	}
	return isSuffix(query.Labels, outer) || open && isSuffix(outer, query.Labels)
}

@~ Project@/litar@/Go@/functions@/litar.hasRel @~ Project@/litar@/Go@/functions@/litar.isSuffix @~ Project@/litar@/Go@/functions@/litar.modulesEqual @~ Project@/litar@/Go@/functions@/litar.resolveModule @? Project@/litar@/Go@/functions@/litar.useMatches @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.ModulePath @~ Project@/litar@/Go@/types@/litar.Name @

A reference in the content and a filter of the block are evaluated under the labels of
the block, or of a specialization of it; a file has no specialization.
A filter of a reference is evaluated under the labels of that reference.
@<list@:litar@:Language@/Go@/File@/functions@+
func blockDepends(b Block, query ChunkRef) bool {
	check := func(use ChunkRef, outer []Name, open bool) bool {
		return useMatches(use, query, b.Ref.Module, outer, open)
	}
	open := !b.IsFile
	for _, part := range b.Parts {
		if part.Ref == nil {
			continue
		}
		if check(part.Ref.ChunkRef, b.Ref.Labels, open) {
			return true
		}
		outer, inherits := b.Ref.Labels, open
		if len(part.Ref.Labels) > 0 {
			outer, inherits = part.Ref.Labels, false
		}
		for _, f := range part.Ref.Filters {
			if check(f.Ref, outer, inherits) {
				return true
			}
		}
	}
	for _, f := range b.Filters {
		if check(f.Ref, b.Ref.Labels, open) {
			return true
		}
	}
	return false
}

@? Project@/litar@/Go@/functions@/litar.blockDepends @~ Project@/litar@/Go@/functions@/litar.useMatches @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Name @

