@<rewrite@:litar@:Language@/Go@/File@/methods@+
// what names the kind of the renaming in a message.
func (r renaming) what() string {
	switch {
	case r.items && r.module:
		return "domain"
	case r.items:
		return "item"
	case r.module:
		return "module"
	}
	return "chunk"
}

