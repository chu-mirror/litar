@<rewrite@:litar@:Language@/Go@/File@/methods@+
// body reads the content, the pipeline, and the items.
func (s *spanScanner) body() error {
	p := &s.p
	for p.i < len(p.src) {
		kind, n, ok := p.atControl()
		switch {
		case !ok:
			p.i++
		case n == 2 && kind == '@@':
			p.i += 2
		case n == 2 && kind == '<':
			p.i += n
			if err := s.reference(); err != nil {
				return err
			}
		case n == 2 && kind == '|':
			p.i += n
			if err := s.filters(); err != nil {
				return err
			}
		case n == 2 && kind == '~':
			p.i += n
			return s.items()
		default:
			return nil
		}
	}
	return nil
}

@~ Project@/litar@/Go@/methods@/litar.parser.atControl @~ Project@/litar@/Go@/methods@/litar.spanScanner.body @~ Project@/litar@/Go@/methods@/litar.spanScanner.filters @~ Project@/litar@/Go@/methods@/litar.spanScanner.items @~ Project@/litar@/Go@/methods@/litar.spanScanner.reference @~ Project@/litar@/Go@/types@/litar.spanScanner @
@<rewrite@:litar@:Language@/Go@/File@/methods@+
// reference reads a reference in content. The caller has consumed "@@<".
func (s *spanScanner) reference() error {
	p := &s.p
	start := p.i
	ref, kind, n, err := p.parseQName(qOpt{dotOK: true})
	if err != nil {
		return err
	}
	// An invocation of a pipeline alone has no chunk.
	if ref.Chunk != "" {
		s.spans = append(s.spans, nameSpan{start: start, end: p.i, role: spanRef, ref: ref})
	}
	if kind == '|' && n == 2 {
		p.i += n
		if err := s.filters(); err != nil {
			return err
		}
	}
	p.i += 2
	return nil
}

