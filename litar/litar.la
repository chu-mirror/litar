@

@<Index@/Project@/litar@/Go@/methods@/litar.parser.unexpected@=
{"description": "Returns a *ParseError reporting an unexpected control sequence at the current parser position."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.readOnlyNode.Create@=
