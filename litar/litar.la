ParseArchive parses one archive. Comment+Raw of every block, then Trailing, reconstructs src.
@<parse@:litar@:Language@/Go@/File@/functions@+
func ParseArchive(src []byte, file string) (*Archive, error) {
	p := &parser{src: src, file: file}
	var blocks []Block
	for {
		commentStart := p.i
		p.skipToControl()
		if p.i >= len(p.src) {
			return &Archive{
				Blocks:   blocks,
				Trailing: string(src[commentStart:]),
				Source:   file,
			}, nil
		}
		kind, n, _ := p.atControl()
		comment := string(src[commentStart:p.i])
		rawStart := p.i
		var (
			b   Block
			err error
		)
		switch kind {
		@<Project@/litar@/Parser@/cases of the control 'kind' that opens the block 'b' in 'p'@>
		default:
			return nil, p.unexpected(kind, n)
		}
		if err != nil {
			return nil, err
		}
		b.Comment = comment
		b.Raw = string(src[rawStart:p.i])
		b.Source = file
		b.EndLine = p.line()
		blocks = append(blocks, b)
	}
}

@? Project@/litar@/Go@/functions@/litar.ParseArchive @~ Project@/litar@/Go@/methods@/litar.parser.atControl @~ Project@/litar@/Go@/methods@/litar.parser.line @~ Project@/litar@/Go@/methods@/litar.parser.skipToControl @~ Project@/litar@/Go@/methods@/litar.parser.unexpected @~ Project@/litar@/Go@/types@/litar.Archive @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.parser @

parseExpr parses a command-line chunk expression with an optional filter pipeline when allowPipeline is set.
@<parse@:litar@:Language@/Go@/File@/functions@+
func parseExpr(s string, allowPipeline bool) (ChunkRef, []Filter, error) {
	p := &parser{src: []byte(s), expr: true}
	ref, kind, n, err := p.parseQName(qOpt{allowEOF: true})
	if err != nil {
		return ChunkRef{}, nil, err
	}
	var filters []Filter
	if kind == '|' && n == 2 {
		if !allowPipeline {
			return ChunkRef{}, nil, p.unexpected(kind, n)
		}
		p.i += n
		filters, kind, n, err = p.parseFilterList(true)
		if err != nil {
			return ChunkRef{}, nil, err
		}
	}
	// Names end only at the end of the expression, where n is zero.
	if n != 0 {
		return ChunkRef{}, nil, p.unexpected(kind, n)
	}
	if ref.Chunk == "" && len(filters) == 0 {
		return ChunkRef{}, nil, p.fail("empty name")
	}
	if p.i != len(p.src) {
		return ChunkRef{}, nil, p.unexpected(kind, n)
	}
	return ref, filters, nil
}

