moveTarget reads the last operand of mv. It is the new path, or the directory that receives the sources when it holds files, ends with a slash, or follows several sources.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (ix fileIndex) moveTarget(args []string) (target string, into bool, err error) {
	if len(args) < 2 {
		return "", false, fmt.Errorf("mv needs a source and a target")
	}
	last := args[len(args)-1]
	if target, err = cleanPath(last); err != nil {
		return "", false, err
	}
	into = ix.isDir(target) || strings.HasSuffix(last, "/")
	if len(args) > 2 && !into {
		return "", false, fmt.Errorf("target '%s' is not a directory", target)
	}
	return target, into, nil
}

@~ Project@/litar@/Go@/functions@/litar.cleanPath @~ Project@/litar@/Go@/methods@/litar.fileIndex.isDir @? Project@/litar@/Go@/methods@/litar.fileIndex.moveTarget @~ Project@/litar@/Go@/types@/litar.fileIndex @

planMoves turns the sources of mv into moves.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (ix fileIndex) planMoves(sources []string, target string, into bool) (fileMoves, error) {
	var moves fileMoves
	for _, arg := range sources {
		p, files, dir, err := ix.source(arg)
		if err != nil {
			return nil, err
		}
		if len(files) == 0 {
			return nil, fmt.Errorf("no such file '%s'", p)
		}
		m := fileMove{from: p, to: target, dir: dir}
		if into {
			m.to = path.Join(target, path.Base(p))
		}
		if dir && strings.HasPrefix(m.to+"/", p+"/") {
			return nil, fmt.Errorf("cannot move '%s' into itself", p)
		}
		moves = append(moves, m)
	}
	return moves, nil
}

@? Project@/litar@/Go@/methods@/litar.fileIndex.planMoves @~ Project@/litar@/Go@/methods@/litar.fileIndex.source @~ Project@/litar@/Go@/types@/litar.fileIndex @~ Project@/litar@/Go@/types@/litar.fileMove @~ Project@/litar@/Go@/types@/litar.fileMoves @

settle lists each file that moves with its new path.
Unlike a shell, mv does not replace an existing file: its block would be lost silently.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (ix fileIndex) settle(moves fileMoves) ([]string, error) {
	moving := map[string]string{}
	var order []string
	for _, m := range moves {
		for _, f := range ix.under(m.from) {
			if _, ok := moving[f]; !ok {
				moving[f], _ = m.apply(f)
				order = append(order, f)
			}
		}
	}
	var lines []string
	taken := map[string]bool{}
	for _, f := range order {
		to := moving[f]
		_, leaves := moving[to]
		_, foreign := ix.foreign(to)
		if taken[to] || foreign || ix.own[to] && !leaves || ix.isDir(to) {
			return nil, fmt.Errorf("file '%s' already exists", to)
		}
		taken[to] = true
		lines = append(lines, f+" -> "+to)
	}
	return lines, nil
}

@~ Project@/litar@/Go@/methods@/litar.fileIndex.foreign @~ Project@/litar@/Go@/methods@/litar.fileIndex.isDir @? Project@/litar@/Go@/methods@/litar.fileIndex.settle @~ Project@/litar@/Go@/methods@/litar.fileIndex.under @~ Project@/litar@/Go@/types@/litar.fileIndex @~ Project@/litar@/Go@/types@/litar.fileMoves @

moveFiles is mv: file headers, references to the files, file operands of views, and descriptions follow, in the node and the local nodes based on it.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (w *World) moveFiles(n *Node, ix fileIndex, words []string) ([]string, error) {
	_, args, err := fileArgs(words, "f")
	if err != nil {
		return nil, err
	}
	target, into, err := ix.moveTarget(args)
	if err != nil {
		return nil, err
	}
	moves, err := ix.planMoves(args[:len(args)-1], target, into)
	if err != nil {
		return nil, err
	}
	lines, err := ix.settle(moves)
	if err != nil {
		return nil, err
	}
	return lines, w.rewriteNodes(w.subtree(n), moves.edit)
}

