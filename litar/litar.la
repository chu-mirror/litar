Helper that parses a composition and node ref from a tree resource URI, reads the node's chain, invokes the given tree builder, and marshals the result to JSON.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) renderTree(uri, prefix string, build func([]Block, []Mapping) (treeJSON, error)) (string, string, []byte, error) {
	w, refs, err := a.refParts(strings.TrimPrefix(uri, prefix), 2)
	if err != nil {
		return "", "", nil, err
	}
	chain, maps, err := a.readChain(w, refs[1])
	if err != nil {
		return "", "", nil, err
	}
	tree, err := build(chain, maps)
	if err != nil {
		return "", "", nil, err
	}
	raw, err := json.Marshal(tree)
	if err != nil {
		return "", "", nil, err
	}
	return string(raw), mimeOf(uri), nil, nil
}

