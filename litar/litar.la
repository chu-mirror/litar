func (e *ParseError) Error() string {
	if e.Expr {
		return e.Msg + " in expression"
	}
	if e.File != "" {
		return fmt.Sprintf("%s at line %d in '%s'", e.Msg, e.Line, e.File)
	}
	return e.Msg
}

@~ Project@/litar@/Go@/types@/litar.ParseError @

line is the line number of the parse position.
Every block asks for its start and end lines, so counting from the start of the archive each time
made a parse quadratic in the archive size; line counts on from the position it last counted to,
and starts over only when the position has moved back.
@<parse@:litar@:Language@/Go@/File@/methods@+
func (p *parser) line() int {
	end := min(p.i, len(p.src))
	if p.lineNo == 0 || end < p.lineAt {
		p.lineAt, p.lineNo = 0, 1
	}
	p.lineNo += bytes.Count(p.src[p.lineAt:end], []byte{'\n'})
	p.lineAt = end
	return p.lineNo
}

