@<rewrite test@:litar@:Language@/Go@/File@/functions@+
func TestRenameRefused(t *testing.T) {
	w, a, _ := rewriteWorld(t, renameRoot+"@@[f.c@@=x@@\n", renameChild)
	before := archiveText(t, a)
	wantError(t, w.Rename("root", renaming{module: false, from: ModulePath{"Mod", "none"}, to: ModulePath{"x"}}), "unknown chunk 'Mod@@/none'")
	wantError(t, w.Rename("root", renaming{module: true, from: ModulePath{"None"}, to: ModulePath{"x"}}), "unknown module 'None'")
	wantError(t, w.Rename("root", renaming{module: false, from: ModulePath{"Mod", "one"}, to: ModulePath{"other"}}), "chunk 'other' already exists")
	wantError(t, w.Rename("root", renaming{module: true, from: ModulePath{"Mod", "Sub"}, to: ModulePath{"Chunk", "x"}}), "'Chunk@@/x' is reserved")
	wantError(t, w.Rename("root", renaming{module: false, from: ModulePath{"f.c"}, to: ModulePath{"g.c"}}), "'f.c' is a file")
	wantError(t, w.Rename("root/child", renaming{module: false, from: ModulePath{"Mod", "one"}, to: ModulePath{"x"}}), "chunk 'Mod@@/one' is defined in node 'root'")
	wantError(t, w.Rename("root", renaming{module: false, from: nil, to: ModulePath{"x"}}), "empty name")
	if after := archiveText(t, a); after != before {
		t.Fatalf("archive changed\n%s", after)
	}
}

