@<Project@/litar@/set '_bad' when the status '_st' or the stdout '_got_out' differs from '_status' and '_out_file'@=
    if [ "$_st" -ne "$_status" ]; then
        echo "FAIL $_name: exit $_st, expected $_status" >&2
        _bad=1
    fi
    if [ -n "$_out_file" ]; then
        cp "$_out_file" "$_exp_out"
    fi
    if ! cmp -s "$_exp_out" "$_got_out"; then
        echo "FAIL $_name: stdout" >&2
        diff -u "$_exp_out" "$_got_out" >&2 || true
        _bad=1
    fi
@

Only a successful case requires an empty stderr. A failed check shows the stderr
once: the err file check has already shown it.
@<Project@/litar@/set '_bad' when the stderr '_got_err' does not match '_err_file', and show it@=
    if [ -n "$_err_file" ]; then
        _needle=$(cat "$_err_file")
        if ! grep -F -q -e "$_needle" "$_got_err"; then
            echo "FAIL $_name: stderr missing [$_needle]" >&2
            cat "$_got_err" >&2
            _bad=1
        fi
    elif [ "$_status" -eq 0 ] && [ -s "$_got_err" ]; then
        echo "FAIL $_name: unexpected stderr" >&2
        cat "$_got_err" >&2
        _bad=1
    fi
    if [ "$_bad" -ne 0 ] && [ -s "$_got_err" ] && [ -n "$_err_file" ]; then
        :
    elif [ "$_bad" -ne 0 ] && [ -s "$_got_err" ]; then
        echo "stderr:" >&2
        cat "$_got_err" >&2
    fi
@
Every filter run appends a line to count, so the count tells which runs started a process.
The pure run is started once and served from the cache the second time;
the run with a mapped file and the run that writes to stderr are started every time.
@<filter test@:litar@:Language@/Go@/File@/functions@+
func TestFilterCache(t *testing.T) {
if _, err := os.Stat("/dev/fuse"); err != nil {
	t.Skip("no /dev/fuse")
}
filterCacheDir = t.TempDir()
defer func() { filterCacheDir = "" }()
dir := t.TempDir()
count := filepath.Join(dir, "count")
origin := filepath.Join(dir, "origin.txt")
writeFile(t, origin, "mapped\n")
src := "" +
	"@@<tally@@=\n" +
	"#!/bin/sh\n" +
	"echo >> '" + count + "'\n" +
	"cat; echo; wc -l < '" + count + "' | tr -d ' '\n" +
	"@@\n" +
	"@@<loud@@=\n" +
	"#!/bin/sh\n" +
	"echo >> '" + count + "'\n" +
	"echo warning >&2; cat; echo\n" +
	"@@\n" +
	"@@<pure@@=\none\n@@|tally@@\n" +
	"@@<mapped@@=\none\n@@|tally@@,data.txt@@\n" +
	"@@<noisy@@=\none\n@@|loud@@\n"
blocks := mustArch(t, src)
maps := []Mapping{{Path: "data.txt", Origin: origin}}
for i, want := range []struct{ name, out string }{
	{"pure", "one\n1\n"},
	{"pure", "one\n1\n"},
	{"mapped", "one\n2\n"},
	{"mapped", "one\n3\n"},
	{"noisy", "one\n"},
	{"noisy", "one\n"},
} {
	got, err := NewEvaluator(blocks, maps, nil).Eval(mustRef(t, want.name), nil)
	if err != nil || got != want.out {
		t.Fatalf("%d %s %v %q", i, want.name, err, got)
	}
}
if data, err := os.ReadFile(count); err != nil || strings.Count(string(data), "\n") != 5 {
	t.Fatalf("%v %q", err, data)
}
}

@~ Project@/litar@/Go@/functions@/litar.NewEvaluator @~ Project@/litar@/Go@/functions@/litar.mustArch @~ Project@/litar@/Go@/functions@/litar.mustRef @~ Project@/litar@/Go@/functions@/litar.writeFile @~ Project@/litar@/Go@/types@/litar.Mapping @~ Project@/litar@/Go@/variables@/litar.filterCacheDir @
