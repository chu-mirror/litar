	t.Fatalf("modules / %q", got)
}
parent, _ := ParseModulePath("a")
if got := Modules(blocks, parent, meta); got != "a@@/b\n" {
	t.Fatalf("modules a %q", got)
}
if got := Modules(blocks, mustMod(t, "nope"), meta); got != "" {
