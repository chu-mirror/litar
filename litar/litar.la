func nodeByRef(w *World, ref string) (*Node, error) {
	for i := range w.Nodes {
		if nodeRef(w.Nodes[i]) == ref {
			return &w.Nodes[i], nil
		}
	}
	return nil, fmt.Errorf("unknown node '%s'", ref)
}

