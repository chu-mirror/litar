The description lives in the composer file, so only that file is written.
@<compose@:litar@:Language@/Go@/File@/methods@+
// Describe replaces the description of a node, or of the composition when nodeName is empty.
func (w *World) Describe(nodeName, description string) error {
	if nodeName == "" {
		w.Description = description
		return w.save()
	}
	n, err := w.requireLocal(nodeName)
	if err != nil {
		return err
	}
	n.Description = description
	return w.save()
}

@~ Project@/litar@/Go@/methods@/litar.World.Describe @~ Project@/litar@/Go@/methods@/litar.World.requireLocal @~ Project@/litar@/Go@/methods@/litar.World.save @~ Project@/litar@/Go@/types@/litar.World @

The answer is the ref of what was described, the node or else the composition.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) describe(ctx context.Context, _ *mcp.CallToolRequest, in describeIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	w, err := a.compositionByRef(in.Composition)
	name, described := "", in.Composition
	if err == nil && in.Node != "" {
		var n *Node
		if n, err = nodeByRef(w, in.Node); err == nil {
			name, described = formatNodePath(nodePath(*n)), in.Node
		}
	}
	if err == nil {
		err = w.Describe(name, in.Description)
	}
	a.mu.Unlock()
	if err != nil {
		return toolErr(err)
	}
	a.refresh()
	return toolText(described)
}

@~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodeByRef @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/functions@/litar.toolText @~ Project@/litar@/Go@/methods@/litar.World.Describe @~ Project@/litar@/Go@/methods@/litar.agent.compositionByRef @~ Project@/litar@/Go@/methods@/litar.agent.describe @~ Project@/litar@/Go@/methods@/litar.agent.refresh @~ Project@/litar@/Go@/types@/litar.describeIn @

A search is a plain substring match on the comment and the text of each block.
More than searchLimit matches is an error rather than a long answer:
the caller narrows the string, and the answer stays small enough to hold in context.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) searchBlocks(ctx context.Context, _ *mcp.CallToolRequest, in searchIn) (*mcp.CallToolResult, any, error) {
	if in.Text == "" {
		return toolErr(errString("the text to search for is empty"))
	}
	a.mu.Lock()
	defer a.mu.Unlock()
	w, n, err := a.worldNode(in.Composition, in.Node)
	if err != nil {
		return toolErr(err)
	}
	chain, _, err := a.nodeChain(w, in.Node)
	if err != nil {
		return toolErr(err)
	}
	got := []Block{}
	for _, b := range chain {
		if strings.Contains(b.Comment, in.Text) || strings.Contains(b.Raw, in.Text) {
			got = append(got, b)
		}
	}
	if len(got) > searchLimit {
		return toolErr(fmt.Errorf("%d blocks contain '%s'; search for a longer string", len(got), in.Text))
	}
	raw, err := json.Marshal(blockList(w, n, got))
	if err != nil {
		return toolErr(err)
	}
	return toolText(string(raw))
}

@~ Project@/litar@/Go@/constants@/litar.searchLimit @~ Project@/litar@/Go@/functions@/litar.blockList @~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/functions@/litar.toolText @~ Project@/litar@/Go@/methods@/litar.agent.nodeChain @~ Project@/litar@/Go@/methods@/litar.agent.searchBlocks @~ Project@/litar@/Go@/methods@/litar.agent.worldNode @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.errString @~ Project@/litar@/Go@/types@/litar.searchIn @

