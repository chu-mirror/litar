func (a *agent) compositionList() []listJSON {
	comps := a.compositions()
	out := make([]listJSON, 0, len(comps))
	for _, w := range comps {
		out = append(out, listJSON{
			Name:        w.Dir,
			Description: w.Description,
			Ref:         compositionRef(w),
		})
	}
	return out
}

