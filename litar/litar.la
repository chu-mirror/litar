parseFilterList reads one or more filters. The caller has consumed the opening "@@|". The terminating control is not consumed.
@<parse@:litar@:Language@/Go@/File@/methods@+
func (p *parser) parseFilterList(allowEOF bool) ([]Filter, byte, int, error) {
	var filters []Filter
	for {
		ref, kind, n, err := p.parseQName(qOpt{allowEOF: allowEOF})
		if err != nil {
