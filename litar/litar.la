}

@? Project@/litar@/Go@/types@/litar.composerFile @~ Project@/litar@/Go@/types@/litar.composerNode @

A node without a select field reads the whole chain, and one with an empty field
selects nothing, so the field is a pointer that tells the two apart.
@<compose@:litar@:Language@/Go@/File@/types@+
type composerNode struct {
	Name        string            `json:"name"`
	Archive     string            `json:"archive"`
	Description string            `json:"description"`
	Mappings    []composerMapping `json:"mappings"`
	Base        basePath          `json:"base"`
	Select      *[]string         `json:"select,omitempty"`
}

@~ Project@/litar@/Go@/types@/litar.basePath @~ Project@/litar@/Go@/types@/litar.composerMapping @? Project@/litar@/Go@/types@/litar.composerNode @

basePath is the path from the root to the direct parent. An empty array is the root. Null and a string are rejected.
@<compose@:litar@:Language@/Go@/File@/types@+
type basePath struct {
	names []string
	set   bool
}

@? Project@/litar@/Go@/types@/litar.basePath @

composerMapping is the on-disk JSON layout of a node's file mapping entry.
@<compose@:litar@:Language@/Go@/File@/types@+
type composerMapping struct {
	Path    string   `json:"path"`
	FileSet []string `json:"fileset"`
	Origin  string   `json:"origin"`
}

@? Project@/litar@/Go@/types@/litar.composerMapping @

groundFrame records a composer on the ground loading stack for cycle detection and error reporting.
