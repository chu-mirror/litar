tabPad returns the tabs needed to advance from column from to at least column col using tabWidth stops.
@<list@:litar@:Language@/Go@/File@/functions@+
func tabPad(from, col, tabWidth int) string {
	var b strings.Builder
	pos := from
	for pos < col {
		b.WriteByte('\t')
		pos += tabWidth - pos%tabWidth
	}
	return b.String()
}

