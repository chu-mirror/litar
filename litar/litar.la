Two nodes are the same when their full paths are equal, so equal names under different bases are allowed.
@<Project@/litar@/check that the names of 'nodes' are valid and distinct, indexing them in 'seen'@=
for i, n := range nodes {
	if n.Name == "" {
		return fmt.Errorf("empty name")
	}
	if strings.Contains(n.Name, "/") {
		return fmt.Errorf("invalid node name '%s'", n.Name)
	}
	key := formatNodePath(nodePath(n))
	if _, ok := seen[key]; ok {
		return fmt.Errorf("duplicate node '%s'", n.Name)
	}
	seen[key] = i
}
@~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodePath @

@<Project@/litar@/check that every base in 'nodes' is in 'seen' and there is one root@=
var roots int
for _, n := range nodes {
	if len(n.Base) == 0 {
		roots++
		continue
	}
	if _, ok := seen[formatNodePath(n.Base)]; !ok {
		return fmt.Errorf("base '%s' of node '%s' is not defined", formatNodePath(n.Base), n.Name)
	}
}
if roots == 0 {
	return fmt.Errorf("composer has no root")
}
if roots > 1 {
	return fmt.Errorf("composer has more than one root")
}
