@
@<Index@/Project@/litar@/Go@/methods@/litar.agent.renderTree@=
{"description": "Renders a tree:// MCP resource as JSON by reading the node's chain and applying the given tree builder function."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.searchBlocks@=
{"description": "MCP tool handler that searches a node's readable block chain for a plain substring in block comments or raw text, failing if the query is empty or matches exceed searchLimit."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.serve@=
{"description": "Runs the MCP server over standard I/O until the context is cancelled or the transport closes."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.useWorld@=
{"description": "Registers a world with the agent, refreshes published resources, and returns the composition ref as a tool result."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.worldNode@=
