@~ Project@/litar@/Go@/methods@/litar.World.lookup @~ Project@/litar@/Go@/methods@/litar.World.root @

A loaded composer has no cycles, but a node edited in memory could form one; the walk stops at a repeated node.
@<Project@/litar@/Composer@/collect 'n' and its bases up to the root@=
var rev []*Node
seen := map[string]bool{}
for {
	key := formatNodePath(nodePath(*n))
	if seen[key] {
		return nil, fmt.Errorf("cycle in node bases: %s", key)
	}
	seen[key] = true
	rev = append(rev, n)
	if len(n.Base) == 0 {
		return rev, nil
	}
	n, err = w.lookup(formatNodePath(n.Base))
	if err != nil {
		return nil, err
	}
}
@~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/methods@/litar.World.lookup @~ Project@/litar@/Go@/types@/litar.Node @

Chain is the base chain followed by the node's own blocks.
@<compose@:litar@:Language@/Go@/File@/methods@+
func (w *World) Chain(name string) ([]Block, error) {
	rev, err := w.ancestry(name)
	if err != nil {
		return nil, err
	}
	var blocks []Block
	for i := len(rev) - 1; i >= 0; i-- {
		blocks = append(blocks, rev[i].Own...)
	}
	return blocks, nil
}

