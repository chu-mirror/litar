@<mcp@:litar@:Language@/Go@/File@/methods@+
// compositionByRef resolves a ref from list://composition.
// The caller holds a.mu.
func (a *agent) compositionByRef(ref string) (*World, error) {
	for _, w := range a.compositions() {
		if compositionRef(w) == ref {
			return w, nil
		}
	}
	return nil, fmt.Errorf("unknown composition '%s'", ref)
}

@~ Project@/litar@/Go@/functions@/litar.compositionRef @~ Project@/litar@/Go@/methods@/litar.agent.compositionByRef @~ Project@/litar@/Go@/methods@/litar.agent.compositions @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @
@<mcp@:litar@:Language@/Go@/File@/methods@+
// createNodeLocked creates the node with its mappings and returns its ref.
// A mapping that fails takes the new node away again.
func (a *agent) createNodeLocked(in createIn) (string, error) {
	w, err := a.compositionByRef(in.Composition)
	if err != nil {
		return "", err
	}
	var base []string
	if in.Base != nil {
		parent, err := nodeByRef(w, *in.Base)
		if err != nil {
			return "", err
		}
		base = nodePath(*parent)
	}
	if err := w.CreateNode(in.Name, in.Archive, in.Description, base); err != nil {
		return "", err
	}
	path := append(base, in.Name)
	for _, m := range in.Mappings {
		if err := w.MapFile(formatNodePath(path), m.Path, m.Origin, m.FileSet); err != nil {
			_ = w.DeleteNode(formatNodePath(path))
			return "", err
		}
	}
	return refOf("node", path...), nil
}

@~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodeByRef @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/functions@/litar.refOf @~ Project@/litar@/Go@/methods@/litar.World.CreateNode @~ Project@/litar@/Go@/methods@/litar.World.DeleteNode @~ Project@/litar@/Go@/methods@/litar.World.MapFile @~ Project@/litar@/Go@/methods@/litar.agent.compositionByRef @~ Project@/litar@/Go@/methods@/litar.agent.createNodeLocked @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.createIn @
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) mapFile(ctx context.Context, _ *mcp.CallToolRequest, in mapIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	w, n, err := a.worldNode(in.Composition, in.Node)
	if err == nil {
		err = w.MapFile(formatNodePath(nodePath(*n)), in.Path, in.Origin, in.FileSet)
	}
	a.mu.Unlock()
	if err != nil {
		return toolErr(err)
	}
	a.refresh()
	return toolText(in.Path)
}

@~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/functions@/litar.toolText @~ Project@/litar@/Go@/methods@/litar.World.MapFile @~ Project@/litar@/Go@/methods@/litar.agent.mapFile @~ Project@/litar@/Go@/methods@/litar.agent.refresh @~ Project@/litar@/Go@/methods@/litar.agent.worldNode @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.mapIn @
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) deleteBlock(ctx context.Context, _ *mcp.CallToolRequest, in blockIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	w, n, err := a.worldNode(in.Composition, in.Node)
	if err == nil {
		err = w.DeleteBlock(formatNodePath(nodePath(*n)), in.Block)
	}
	a.mu.Unlock()
	if err != nil {
		return toolErr(err)
	}
	a.refresh()
	return toolText(in.Block)
}

@~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/functions@/litar.toolText @~ Project@/litar@/Go@/methods@/litar.World.DeleteBlock @~ Project@/litar@/Go@/methods@/litar.agent.deleteBlock @~ Project@/litar@/Go@/methods@/litar.agent.refresh @~ Project@/litar@/Go@/methods@/litar.agent.worldNode @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.blockIn @
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) moveBlock(ctx context.Context, _ *mcp.CallToolRequest, in moveIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	w, n, err := a.worldNode(in.Composition, in.Node)
	var to *Node
	if err == nil {
		to, err = nodeByRef(w, in.To)
	}
	if err == nil {
		err = w.MoveBlock(formatNodePath(nodePath(*n)), in.Block, formatNodePath(nodePath(*to)))
	}
	a.mu.Unlock()
	if err != nil {
		return toolErr(err)
	}
	a.refresh()
	return toolText(in.Block)
}

