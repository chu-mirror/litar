		panic(err)
	}
	return s
}

@? Project@/litar@/Go@/functions@/litar.inputSchema @

plainArrays publishes every slice as an array. A slice infers "type": ["null", "array"], and some clients accept only one type per schema; a missing slice already stands for an empty one.
@<mcp@:litar@:Language@/Go@/File@/functions@+
func plainArrays(s *jsonschema.Schema) *jsonschema.Schema {
	if len(s.Types) > 0 && slices.Contains(s.Types, "array") {
		s.Types, s.Type = nil, "array"
	}
	for _, prop := range s.Properties {
		plainArrays(prop)
	}
	if s.Items != nil {
		plainArrays(s.Items)
	}
	return s
}

