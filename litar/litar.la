  show(title(e.branch ? 'Domain' : 'Item', e.path, [], e.description),
    h('div', {class: 'actions'},
      button('Describe', () => describeMeta(['Index', ...e.path], e.description)),
      button('Rename', () => renameEntry('item', itemRef, e.path, e.branch))),
    h('h2', {}, 'Blocks carrying this item'), body);
  await fill(body, async () => blockList(await blocks('refer', itemRef), {ix, labels: null, item: key(e.path)}));
}
async function labelView(specRef) {
  const ix = await indexes(), e = ix.spec.byRef.get(specRef);
  if (!e) return show(note('This node has no such label path.'));
  select('specialization', specRef, e.path);
  const labels = [...e.path].reverse(), body = h('div', {}, note('Loading…'));
  show(title('Label path', [labels.join(ctl(':'))], [], e.description),
    h('div', {class: 'actions'}, button('Describe', () => describeMeta(['Specialization', ...e.path], e.description))),
    h('h2', {}, 'Blocks written under exactly this label path'), body);
  await fill(body, async () => blockList(await blocks('specialization', specRef), {ix, labels}));
