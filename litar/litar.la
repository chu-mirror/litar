Reports whether two string slices contain the same multiset of strings regardless of order.
@<mcp test@:litar@:Language@/Go@/File@/functions@+
func sameStrings(a, b []string) bool {
	aa := append([]string{}, a...)
	bb := append([]string{}, b...)
	slices.Sort(aa)
	slices.Sort(bb)
	return slices.Equal(aa, bb)
}

