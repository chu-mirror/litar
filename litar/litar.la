// worldNode resolves a composition ref and a node ref.
// The caller holds a.mu.
func (a *agent) worldNode(composition, node string) (*World, *Node, error) {
	w, err := a.compositionByRef(composition)
	if err != nil {
		return nil, nil, err
	}
	n, err := nodeByRef(w, node)
	if err != nil {
		return nil, nil, err
	}
	return w, n, nil
}

