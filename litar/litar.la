The node is appended before saving and dropped again if the composer cannot be written,
so memory and file stay in step.
@<Project@/litar@/Composer@/parse 'resolved' and append the new node to the composer@=
data, err := os.ReadFile(resolved)
if err != nil {
	removeCreated()
	return fmt.Errorf("could not read '%s'", resolved)
}
arch, err := ParseArchive(data, resolved)
if err != nil {
	removeCreated()
	return err
}
w.Nodes = append(w.Nodes, Node{
	Name:        name,
	Archive:     ident,
	ArchiveSpec: archive,
	Description: description,
	Mappings:    []Mapping{},
	Base:        base,
	Own:         arch.Blocks,
	Trailing:    arch.Trailing,
})
if err := w.save(); err != nil {
