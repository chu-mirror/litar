An inner reference takes the labels of the reference being expanded when it has none,
and its relative module is resolved against the block's header.
A missing inner chunk expands to nothing.
A reference that only spaces and tabs of the block precede on its line is indented:
its content, after the filters of the reference, gets them before each later line.
'indent' and 'blank' follow the line of the block the parts have reached.
@<Project@/litar@/Evaluator@/write each part of 'b' to 'sb', expanding its references@=
indent, blank := "", true
for _, part := range b.Parts {
	if part.Ref == nil {
		sb.WriteString(part.Text)
		indent, blank = continueLine(indent, blank, part.Text)
		continue
	}
	inner := resolveBody(part.Ref.ChunkRef, applied.Labels, b.Ref.Module)
	text, err := e.expandLocked(inner, false)
	if err != nil {
		return "", err
	}
	if len(part.Ref.Filters) > 0 {
		text, err = e.runFiltersLocked(text, part.Ref.Filters, inner)
		if err != nil {
			return "", err
		}
	}
	if blank && indent != "" {
		text = indentLines(text, indent)
	}
	blank = false
	sb.WriteString(text)
}
@~ Project@/litar@/Go@/functions@/litar.continueLine @~ Project@/litar@/Go@/functions@/litar.indentLines @~ Project@/litar@/Go@/functions@/litar.resolveBody @~ Project@/litar@/Go@/methods@/litar.Evaluator.expandLocked @~ Project@/litar@/Go@/methods@/litar.Evaluator.runFiltersLocked @

runFiltersLocked runs a sequence of filters, releasing e.mu during each filter execution and checking for FUSE errors.
@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) runFiltersLocked(text string, filters []Filter, attached ChunkRef) (string, error) {
	for _, f := range filters {
		resolved := resolveFilter(f.Ref, attached.Labels)
		script, err := e.expandLocked(resolved, true)
		if err != nil {
			return "", err
		}
		e.recordView(f.View)
		e.mu.Unlock()
		out, runErr := executeFilter(e, script, text, resolved, f.View)
		e.mu.Lock()
		if fuse := e.takeFuseErr(); fuse != nil {
			return "", fuse
		}
		if runErr != nil {
			return "", runErr
		}
		text = out
	}
	return text, nil
}

