The later set block of a does not break the cycle, because the cycle goes through the first.
@<Project@/litar@/Tests@/Evaluator@/check that the cycle between a and b is reported@=
src := "" +
	"@@<a@@=\n" +
	"@@<b@@>\n" +
	"@@\n" +
	"@@<b@@=\n" +
	"@@<a@@>\n" +
	"@@\n" +
	"@@<a@@=\n" +
	"ok\n" +
	"@@\n"
ev = NewEvaluator(mustArch(t, src), nil, nil)
_, err = ev.Eval(mustRef(t, "a"), nil)
if err == nil || !strings.Contains(err.Error(), "circular reference a -> b -> a") {
