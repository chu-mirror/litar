@<list@:litar@:Language@/Go@/File@/functions@+
// formatNamed prints one name per line.
// A description is `Name:` then tabs, then the description.
// Tab stops are eight columns apart, and every description in the list
// starts at the same column, past the longest `Name:`.
func formatNamed(rows []namedLine) string {
const tabWidth = 8
col := 0
@<Project@/litar@/set 'col' to the tab stop past the longest 'Name:' with a description@>
lines := make([]string, len(rows))
@<Project@/litar@/write each row to 'lines', its description padded to 'col'@>
return joinLines(lines)
}

@~ Project@/litar@/Go@/functions@/litar.formatNamed @~ Project@/litar@/Go@/functions@/litar.joinLines @~ Project@/litar@/Go@/types@/litar.namedLine @

Widths count runes, so names outside ASCII align as long as each rune takes one column.
@<Project@/litar@/set 'col' to the tab stop past the longest 'Name:' with a description@=
width := 0
for _, row := range rows {
	if row.desc == "" {
		continue
	}
	if n := utf8.RuneCountInString(row.name) + 1; n > width {
		width = n
	}
}
if width > 0 {
	col = (width/tabWidth + 1) * tabWidth
}
@

@<Project@/litar@/write each row to 'lines', its description padded to 'col'@=
for i, row := range rows {
	if row.desc == "" {
		lines[i] = row.name
		continue
	}
	lines[i] = row.name + ":" + tabPad(utf8.RuneCountInString(row.name)+1, col, tabWidth) + row.desc
}
@~ Project@/litar@/Go@/functions@/litar.tabPad @

@<list@:litar@:Language@/Go@/File@/functions@+
func tabPad(from, col, tabWidth int) string {
	var b strings.Builder
	pos := from
	for pos < col {
		b.WriteByte('\t')
		pos += tabWidth - pos%tabWidth
	}
	return b.String()
}

@~ Project@/litar@/Go@/functions@/litar.tabPad @

@<list@:litar@:Language@/Go@/File@/functions@+
func formatUnder(domain []Name, name Name) string {
	if len(domain) == 0 {
		return string(name)
	}
	return formatModule(domain) + "@@/" + string(name)
}

@~ Project@/litar@/Go@/functions@/litar.formatModule @~ Project@/litar@/Go@/functions@/litar.formatUnder @~ Project@/litar@/Go@/types@/litar.Name @

@<list@:litar@:Language@/Go@/File@/functions@+
// Subdomains lists the name that follows domain, once each.
func Subdomains(blocks []Block, domain []Name, meta metaInfo) string {
	seen := map[string]bool{}
	var rows []namedLine
	for _, b := range blocks {
		for _, it := range b.Items {
			if len(it) <= len(domain) || !namePrefix(it, domain) {
				continue
			}
			line := formatUnder(domain, it[len(domain)])
			if seen[line] {
				continue
			}
			seen[line] = true
			rows = append(rows, namedLine{line, meta.items[line]})
		}
	}
	return formatNamed(rows)
}

