@

@<Chunk@/Project@/litar@/Composer@/find the node 'n' named 'ref', the root if 'ref' is empty@=
{"description": "Looks up ref in w, falling back to w.root() when ref is empty."}
@

@<Chunk@/Project@/litar@/Composer@/collect 'n' and its bases up to the root@=
{"description": "Walks from n through each parent base to the root, returning an error if a cycle is encountered."}
@

@<Chunk@/Project@/litar@/Composer@/convert the nodes in 'local' to composer nodes in 'raw'@=
{"description": "Serializes local Node values back to composerNode structs, keeping empty slices non-nil and preserving Select only when set."}
@

@<Chunk@/Project@/litar@/Composer@/replace a directory 'path' with the composer.json inside it@=
{"description": "If path is a directory, resolves it to path/composer.json and verifies the result is not a directory."}
@

@<Chunk@/Project@/litar@/Composer@/check the 'ground' and keep its name in 'stored'@=
{"description": "When ground is non-empty, validates its name, checks that it can be found from dir, and stores a pointer to it."}
@

@<Chunk@/Project@/litar@/Composer@/create 'dir' for a new composer 'comp', noting 'createdDir'@=
{"description": "Verifies dir is absent or a directory, ensures comp does not exist, and creates dir if needed."}
@

@<Chunk@/Project@/litar@/Composer@/write and load the new composer 'comp', removing it on failure@=
{"description": "Writes an empty composer.json to comp and loads it via LoadComposerAllowEmpty, cleaning up on error."}
@

@<Chunk@/Project@/litar@/Composer@/check the 'name' and 'base' of the new node@=
{"description": "Validates the new node name, checks that a root does not already exist or that base is defined, and rejects duplicates."}
@

@<Chunk@/Project@/litar@/Composer@/set 'ident' to the identity of 'resolved' unless another node has it@=
{"description": "Computes the canonical path of resolved and fails (removing the created file) if any existing node shares it."}
@

@<Chunk@/Project@/litar@/Composer@/parse 'resolved' and append the new node to the composer@=
{"description": "Reads and parses resolved, appends the new Node to w.Nodes, and saves the composer, rolling back on error."}
@

@<Chunk@/Project@/litar@/Composer@/move the local nodes under 'targetPath' from 'keep' to 'archives'@=
{"description": "Partitions local nodes into those under targetPath (collecting their archive paths) and those to keep."}
@

@<Chunk@/Project@/litar@/Composer@/remove the files in 'archives'@=
{"description": "Removes every non-empty archive path, ignoring missing files and reporting all remaining removal errors together."}
@

@<Chunk@/Project@/litar@/Composer@/write 'kept' and the trailing text of 'n' to 'b'@=
{"description": "Writes each kept block's comment and raw text to b, inserting a newline when needed so an end control does not merge with following text, then appends Trailing."}
@

@<Chunk@/Project@/litar@/Composer@/index 'blocks' by chunk in 'keys' and 'byChunk'@=
{"description": "Computes each block's label-independent chunkKey and groups block indexes by chunk."}
@

@<Chunk@/Project@/litar@/Composer@/record in 'includers' the blocks whose content includes each block's chunk@=
{"description": "Maps each block index to the set of other-chunk blocks whose body references its chunk."}
@

@<Chunk@/Project@/litar@/Composer@/tell whether block 'i' can be placed, requiring its 'includers' if 'strict'@=
{"description": "Returns true if block i is unplaced, its same-chunk predecessor is placed, and (when strict) all its includers are placed."}
@

@<Chunk@/Project@/litar@/Composer@/append to 'out' the first ready block, preferring one whose includers are placed@=
{"description": "Selects the earliest strictly ready block, falling back to the earliest non-strictly ready block to break inclusion cycles."}
@

@<Chunk@/Project@/litar@/Composer@/compact every local node into 'all'@=
{"description": "Compacts all local nodes in memory before writing any archive to disk."}
@

@<Chunk@/Project@/litar@/Composer@/link each block to the earlier block of its chunk in 'chainPrev'@=
{"description": "Orders blocks of each chunk by specializationOrder and records each block's predecessor index in chainPrev."}
@

@<Chunk@/Project@/litar@/Composer@/keep the effective own blocks of 'n' in 'kept'@=
{"description": "Orders n.Own and retains only blocks that remain effective for their own chunk reference."}
@

@<Chunk@/Project@/litar@/Composer@/write each archive in 'all' and update its node@=
{"description": "Writes each compacted archive to disk preserving file permissions and updates the node's Own and Trailing fields."}
@

@<Chunk@/Project@/litar@/Composer@/set 'next' to the archive of 'n' followed by 'text'@=
{"description": "Reads n.Archive and appends text, inserting a newline if the archive does not end with whitespace."}
@

@<Chunk@/Project@/litar@/Composer@/replace the blocks of 'n' with those of 'arch', restoring them if the store fails@=
{"description": "Swaps n.Own and n.Trailing to arch and calls storeCompact, rolling back in memory on error."}
@

@<Chunk@/Project@/litar@/Evaluator@/fail if 'key' is already on the visit stack@=
{"description": "Checks e.stack for key and returns a cycleError tracing from the first occurrence to ref."}
@

@<Chunk@/Project@/litar@/Evaluator@/write each part of 'b' to 'sb', expanding its references@=
{"description": "Writes literal parts and expands inner references with inherited labels, filters, and line indentation tracking."}
@

@<Chunk@/Project@/litar@/Filter@/add 'path' to 'in' and 'order' if it names one defined file@=
{"description": "Validates path, rejects undefined or conflicting archive/mapping files, and records path in the view set."}
@

@<Chunk@/Project@/litar@/Filter@/cases of 'op' in 'catalog.apply'@=
{"description": "Handles AddSet, SubSet, AddFile, and DelFile view operations against the file catalog."}
@

@<Chunk@/Project@/litar@/Filter@/return the files of 'order' still in 'in' as view files@=
{"description": "Builds the deduplicated slice of viewFile entries in first-added order for paths remaining in the view."}
@

@<Chunk@/Project@/litar@/Filter@/add the archive files of 'chain' to 'c'@=
{"description": "Registers file blocks from chain in catalog c, updating executable bits and accumulating file sets."}
@

@<Chunk@/Project@/litar@/Filter@/add the 'mappings' to 'c', noting paths that are also archive files@=
{"description": "Registers mapped files and directories in catalog c and flags any path that conflicts with an archive file."}
@

@<Chunk@/Project@/litar@/Filter@/return 'interp' alone unless a word follows it at 'i'@=
{"description": "Skips horizontal whitespace after the shebang interpreter and returns early if no argument word follows on the line."}
@

@<Chunk@/Project@/litar@/Filter@/write 'script' to the temporary file 'scriptPath'@=
{"description": "Creates a temporary script file, writes script to it, closes it, and schedules its removal on return."}
@

@<Chunk@/Project@/litar@/Filter@/run 'args' in the view mounted at 'mnt' with 'input' on stdin@=
{"description": "Spawns /bin/sh to chdir into mnt.dir after fork and exec args, wiring environment, stderr counting, and stdio pipes."}
@

@<Chunk@/Project@/litar@/Filter@/start 'cmd', with status 127 if the interpreter is missing@=
{"description": "Starts cmd and maps os.IsNotExist startup failures to exit status 127."}
@

@<Chunk@/Project@/litar@/Filter@/send 'input' to 'stdin' and return what 'cmd' writes to 'stdout'@=
{"description": "Copies stdout concurrently while feeding input to stdin, checks exit status, and caches output if keyed and stderr is empty."}
@
@<Chunk@/Project@/litar@/FUSE View@/add 'part' of the path of 'f' under 'dir'@=
{"description": "Inserts a path component into the virtual directory tree, rejecting conflicts between files, mapped dirs, and directories."}
@

@<Chunk@/Project@/litar@/FUSE View@/number the children of 'd' from 'next' in name order, walking into directories@=
{"description": "Assigns deterministic sequential inode numbers to sorted children of d recursively."}
@

@<Chunk@/Project@/litar@/FUSE View@/mount 'tree' at 'dir' with new files in 'overlay', setting 'server' and 'direct'@=
{"description": "Configures go-fuse options with zero timeouts, current UID/GID, and discarded logging, then calls mountFUSE."}
@

@<Chunk@/Project@/litar@/FUSE View@/return the inode of the view entry 'ch'@=
{"description": "Creates a fileNode or dirNode inode for a virtual view entry with its preassigned inode number."}
@

@<Chunk@/Project@/litar@/FUSE View@/return the inode of the overlay entry 'name'@=
{"description": "Looks up name in the writable overlay directory on disk and returns a dirNode or overlayNode inode."}
@

@<Chunk@/Project@/litar@/FUSE View@/add the view entries of 'd' to 'names'@=
{"description": "Records file and directory entries from d.spec.kids into the directory listing map."}
@

@<Chunk@/Project@/litar@/FUSE View@/add the overlay entries of 'd' to 'names', unless the view has them@=
{"description": "Reads d.hostDir() and adds any overlay entries not already shadowed by the view."}
@

@<Chunk@/Project@/litar@/FUSE View@/return '.', '..', and 'names' sorted as a directory stream@=
{"description": "Builds a sorted fuse.DirEntry slice starting with '.' and '..' and returns it as a DirStream."}
@

@<Chunk@/Project@/litar@/FUSE View@/open the new overlay file 'host' as 'fh'@=
{"description": "Creates the overlay parent directory if needed and opens host exclusively with mode 0644."}
@

@<Chunk@/Project@/litar@/Listing@/collect in 'seen' each module of 'blocks' and its prefixes, in first order@=
{"description": "Walks blocks and records every module path and its non-empty prefixes in order of first appearance."}
@

@<Chunk@/Project@/litar@/Listing@/add to 'rows' the modules of 'seen' strictly under 'parent'@=
{"description": "Filters seen to non-reserved modules strictly below parent and appends each with its chunk description."}
@

@<Chunk@/Project@/litar@/Listing@/set 'col' to the tab stop past the longest 'Name:' with a description@=
{"description": "Computes the 8-column tab stop column needed to align descriptions past the longest described name."}
@

@<Chunk@/Project@/litar@/Listing@/write each row to 'lines', its description padded to 'col'@=
{"description": "Formats each row as either its bare name or 'Name:' tab-padded to col followed by its description."}
@

@<Chunk@/Project@/litar@/Command Line@/run the action chosen by 'mode'@=
{"description": "Loads the composition if an archive was given, runs agent mode if selected, or dispatches the CLI mode."}
@

@<Chunk@/Project@/litar@/Command Line@/load 'world' and 'node' from 'archive'@=
{"description": "Calls FindArchive when -f/--file was supplied, returning a formatted error exit status on failure."}
@

@<Chunk@/Project@/litar@/Command Line@/serve agents in agent mode@=
{"description": "Starts the MCP agent server on stdio, preloading world if present, and treats EOF or cancellation as exit 0."}
@

@<Chunk@/Project@/litar@/Command Line@/dispatch 'mode' and write the result to 'stdout'@=
{"description": "Calls dispatch for the chosen mode and writes the resulting text to stdout."}
@

@<Chunk@/Project@/litar@/Command Line@/choose 'mode' and 'operand' from the actions given in 'opts'@=
{"description": "Checks opts in modeOrder to ensure exactly one action flag was provided and extracts its operand."}
@

@<Chunk@/Project@/litar@/Command Line@/check that an archive is given unless 'mode' is agent@=
{"description": "Fails with missing -f, --file when a non-agent mode is invoked without an archive."}
@

@<Chunk@/Project@/litar@/Command Line@/resolve an empty 'node' to the root node@=
{"description": "Replaces an empty node path with world.rootName()."}
@

@<Chunk@/Project@/litar@/Command Line@/cases of 'mode' in 'dispatch'@=
{"description": "Dispatches print, literal, effective, depend, and reference modes by parsing the operand and invoking the corresponding engine function."}
@

