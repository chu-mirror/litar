@

@<Index@/Project@/litar@/Go@/methods@/litar.readOnlyNode.Mkdir@=
{"description": "Refuses directory creation on a read-only FUSE loopback node by returning syscall.EROFS."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.readOnlyNode.Mknod@=
