effectiveIndexes is effectiveBlocks by position in blocks.
@<list@:litar@:Language@/Go@/File@/functions@+
func effectiveIndexes(blocks []Block, ref ChunkRef) []int {
	var eff []int
	for i, b := range blocks {
		if !matchRef(b.Ref, ref) {
			continue
		}
		if b.Op == OpSet {
			eff = eff[:0]
		}
		eff = append(eff, i)
	}
	return eff
}

@~ Project@/litar@/Go@/constants@/litar.OpSet @? Project@/litar@/Go@/functions@/litar.effectiveIndexes @~ Project@/litar@/Go@/functions@/litar.matchRef @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @

A block refers to every item it carries but does not define.
@<list@:litar@:Language@/Go@/File@/functions@+
func referred(b Block) []Item {
	var out []Item
	for _, it := range b.Items {
		if !carries(b.Defines, it) {
			out = append(out, it)
		}
	}
	return out
}

func carries(items []Item, it Item) bool {
	for _, x := range items {
		if sameItem(x, it) {
			return true
		}
	}
	return false
}

@? Project@/litar@/Go@/functions@/litar.carries @? Project@/litar@/Go@/functions@/litar.referred @~ Project@/litar@/Go@/functions@/litar.sameItem @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Item @

itemsOf collects the items that the marked blocks define, or else refer to,
and markItems marks every block that defines, or else refers to, one of them:
together they follow R edges one step forward or one step back.
@<list@:litar@:Language@/Go@/File@/functions@+
func itemsOf(chain []Block, marked []bool, defined bool) map[string]bool {
	keys := map[string]bool{}
	for i, b := range chain {
		if marked[i] {
			for _, it := range itemsBy(b, defined) {
				keys[formatItem(it)] = true
			}
		}
	}
	return keys
}

func markItems(chain []Block, keys map[string]bool, defined bool, in []bool) {
	for i, b := range chain {
		for _, it := range itemsBy(b, defined) {
			if keys[formatItem(it)] {
				in[i] = true
				break
			}
		}
	}
}

func itemsBy(b Block, defined bool) []Item {
	if defined {
		return b.Defines
	}
	return referred(b)
}

@~ Project@/litar@/Go@/functions@/litar.formatItem @? Project@/litar@/Go@/functions@/litar.itemsBy @? Project@/litar@/Go@/functions@/litar.itemsOf @? Project@/litar@/Go@/functions@/litar.markItems @~ Project@/litar@/Go@/functions@/litar.referred @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Item @

markContainers steps back through Ca edges: it marks each block whose content refers to
a chunk reference that a block of from is applied to. The blocks of from are indexed by
chunk name, so each reference is matched only against blocks of its own chunk.
@<list@:litar@:Language@/Go@/File@/functions@+
func markContainers(chain []Block, from []bool, in []bool) {
	byChunk := map[Name][]ChunkRef{}
	for i, b := range chain {
		if from[i] {
			byChunk[b.Ref.Chunk] = append(byChunk[b.Ref.Chunk], b.Ref)
		}
	}
	for i, b := range chain {
		for _, part := range b.Parts {
			if part.Ref != nil && usesAny(b, part.Ref.ChunkRef, byChunk[part.Ref.Chunk]) {
				in[i] = true
				break
			}
		}
	}
}

func usesAny(b Block, use ChunkRef, applied []ChunkRef) bool {
	for _, ref := range applied {
		if useMatches(use, ref, b.Ref.Module, b.Ref.Labels, !b.IsFile) {
			return true
		}
	}
	return false
}

