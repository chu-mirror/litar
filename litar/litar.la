evalReporting runs without a.mu, since a filter may run for long; chain and maps are copies taken under it. A failed evaluation carries the stderr of its filters, which is the only report a client sees.
@<mcp@:litar@:Language@/Go@/File@/functions@+
func evalReporting(chain []Block, maps []Mapping, ref ChunkRef, filters []Filter) (string, error) {
	var stderr bytes.Buffer
	ev := NewEvaluator(chain, maps, &stderr)
	text, err := ev.Eval(ref, filters)
	if err != nil {
		if msg := strings.TrimRight(stderr.String(), "\n"); msg != "" {
			return "", fmt.Errorf("%w\n%s", err, msg)
		}
		return "", err
	}
	return text, nil
}

