func nodesFrom(composerPath string, raw []composerNode) ([]Node, error) {
dir := filepath.Dir(composerPath)
nodes := make([]Node, len(raw))
for i, n := range raw {
	base := copyPath(n.Base.names)
	var (
		ident string
		arch  *Archive
	)
	@<Project@/litar@/read the archive of 'n' into 'ident' and 'arch'@>
	maps := make([]Mapping, len(n.Mappings))
	@<Project@/litar@/convert the mappings of 'n' to 'maps'@>
	nodes[i] = Node{
		Name:        n.Name,
		Archive:     ident,
		ArchiveSpec: n.Archive,
		Description: n.Description,
		Mappings:    maps,
		Base:        base,
		Own:         arch.Blocks,
		Trailing:    arch.Trailing,
	}
}
return nodes, nil
}

