@<rewrite@:litar@:Language@/Go@/File@/methods@+
// items reads the items up to the end control. The caller has consumed "@@~".
func (s *spanScanner) items() error {
	p := &s.p
	start := p.i
	var item Item
	for {
		name, kind, n, err := p.readName(false)
		if err != nil {
			return err
		}
		item = append(item, name)
		if kind == '/' && n == 2 {
			p.i += n
			continue
		}
		s.spans = append(s.spans, nameSpan{start: start, end: p.i, role: spanItem, item: item})
		if kind != '~' || n != 2 {
			return nil
		}
		p.i += n
		start, item = p.i, nil
	}
}

@~ Project@/litar@/Go@/constants@/litar.spanItem @~ Project@/litar@/Go@/methods@/litar.parser.readName @~ Project@/litar@/Go@/methods@/litar.spanScanner.items @~ Project@/litar@/Go@/types@/litar.Item @~ Project@/litar@/Go@/types@/litar.nameSpan @~ Project@/litar@/Go@/types@/litar.spanScanner @
@<rewrite@:litar@:Language@/Go@/File@/methods@+
// namespace is the reserved module that holds the descriptions of what moves.
func (r renaming) namespace() Name {
	if r.items {
		return "Index"
	}
	return "Chunk"
}

@~ Project@/litar@/Go@/methods@/litar.renaming.namespace @~ Project@/litar@/Go@/types@/litar.Name @~ Project@/litar@/Go@/types@/litar.renaming @
@<rewrite@:litar@:Language@/Go@/File@/methods@+
// applyItem returns an item renamed.
func (r renaming) applyItem(it Item) (Item, bool) {
	exact := len(it) == len(r.from) && !r.module
	below := r.module && len(it) > len(r.from)
	if !r.items || !(exact || below) || !namePrefix(it, r.from) {
		return it, false
	}
	return append(append(Item{}, r.to...), it[len(r.from):]...), true
}

@~ Project@/litar@/Go@/functions@/litar.namePrefix @~ Project@/litar@/Go@/methods@/litar.renaming.applyItem @~ Project@/litar@/Go@/types@/litar.Item @~ Project@/litar@/Go@/types@/litar.renaming @
@<rewrite@:litar@:Language@/Go@/File@/methods@+
// carried reports whether a block carries an item that the renaming moves.
func (r renaming) carried(bl Block) bool {
	for _, it := range bl.Items {
		if _, ok := r.applyItem(it); ok {
			return true
		}
	}
	return false
}

@~ Project@/litar@/Go@/methods@/litar.renaming.applyItem @~ Project@/litar@/Go@/methods@/litar.renaming.carried @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.renaming @
@<rewrite@:litar@:Language@/Go@/File@/methods@+
// checkItems refuses to rename an item that the node does not carry, or that
// a base node carries: the base keeps its blocks, so the cross-reference
// would break in two.
func (w *World) checkItems(n *Node, r renaming) error {
	name := formatModule(ModulePath(r.from))
	rev, err := w.ancestry(formatNodePath(nodePath(*n)))
	if err != nil {
		return err
	}
	for _, base := range rev[1:] {
		for _, bl := range base.Own {
			if r.carried(bl) {
				return fmt.Errorf("%s '%s' is used in node '%s'", r.what(), name, base.Name)
			}
		}
	}
	for _, bl := range n.Own {
		if r.carried(bl) {
			return nil
		}
	}
	return fmt.Errorf("unknown %s '%s'", r.what(), name)
}

@~ Project@/litar@/Go@/functions@/litar.formatModule @~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/methods@/litar.World.ancestry @~ Project@/litar@/Go@/methods@/litar.World.checkItems @~ Project@/litar@/Go@/methods@/litar.renaming.carried @~ Project@/litar@/Go@/methods@/litar.renaming.what @~ Project@/litar@/Go@/types@/litar.ModulePath @~ Project@/litar@/Go@/types@/litar.Node @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.renaming @
