@<parse@:litar@:Language@/Go@/File@/methods@+
func (p *parser) finishBlock(ref ChunkRef, op Op, startLine int) (Block, error) {
	p.i += 2
	p.consumeLayout()
	b, err := p.parseBody()
	if err != nil {
		return Block{}, err
	}
	return Block{
		Ref:       ref,
		Op:        op,
		Parts:     b.parts,
		Filters:   b.filters,
		Items:     b.items,
		Defines:   b.defines,
		EndsLine:  b.endsLine,
		StartLine: startLine,
		EndLine:   p.line(),
	}, nil
}

