Track resource subscriptions per session so refresh only notifies URIs that a client has actually subscribed to.
@<Project@/litar@/MCP Server@/create the MCP server of 'a'@=
a.server = mcp.NewServer(
	&mcp.Implementation{Name: "litar", Version: "0.1.0"},
	&mcp.ServerOptions{
		SubscribeHandler: func(_ context.Context, req *mcp.SubscribeRequest) error {
			a.mu.Lock()
			sessions := a.subscribed[req.Params.URI]
			if sessions == nil {
				sessions = map[*mcp.ServerSession]bool{}
				a.subscribed[req.Params.URI] = sessions
			}
			sessions[req.Session] = true
			a.mu.Unlock()
			return nil
		},
		UnsubscribeHandler: func(_ context.Context, req *mcp.UnsubscribeRequest) error {
			a.mu.Lock()
			if sessions := a.subscribed[req.Params.URI]; sessions != nil {
				delete(sessions, req.Session)
				if len(sessions) == 0 {
					delete(a.subscribed, req.Params.URI)
				}
			}
			a.mu.Unlock()
			return nil
		},
		Capabilities: &mcp.ServerCapabilities{
			Tools:     &mcp.ToolCapabilities{ListChanged: true},
			Resources: &mcp.ResourceCapabilities{ListChanged: true, Subscribe: true},
		},
	},
)
@

The agent serves until its input ends or it is cancelled; neither is an error.
@<Project@/litar@/Command Line@/serve agents in agent mode@=
if mode == "agent" {
	ag := newAgent()
	if world != nil {
		ag.addWorld(world)
	}
	err := ag.serve(context.Background())
	if err != nil && !errors.Is(err, io.EOF) && !errors.Is(err, context.Canceled) {
		return fail("%s", err.Error())
	}
	return 0
}
