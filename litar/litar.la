Handles the evaluate_expression MCP tool by parsing the print expression, loading the node's block chain and mappings, and evaluating the expression outside the lock.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) evaluate(ctx context.Context, _ *mcp.CallToolRequest, in evalIn) (*mcp.CallToolResult, any, error) {
	ref, filters, err := ParsePrint(in.Expression)
	if err != nil {
		return toolErr(err)
	}
	a.mu.Lock()
	w, err := a.compositionByRef(in.Composition)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	chain, maps, err := a.nodeChain(w, in.Node)
	a.mu.Unlock()
	if err != nil {
		return toolErr(err)
	}
	text, err := evalReporting(chain, maps, ref, filters)
	if err != nil {
		return toolErr(err)
	}
	return toolText(text)
}

