@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.rename@=
{"description": "MCP tool handler that renames a chunk, module, item, or domain identified by its tree ref to a new module path and refreshes server resources."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.agent.renameLocked@=
