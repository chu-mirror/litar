@

Creating a node takes its base, not a node of its own, so the node that act would add is left out.
@<Project@/litar@/Web@/views@+
async function newNode() {
  const v = await ask('New node on ' + nodeName(state.n), [
    {name: 'name', label: 'Name'},
    {name: 'archive', label: 'Archive', hint: 'A new file, relative to the composition directory, such as task.la.'},
    {name: 'description', label: 'Description', multiline: true},
  ], 'Create');
  if (v) act('create_node', {node: undefined, name: v.name.trim(), archive: v.archive.trim(), description: v.description.trim(), base: state.n},
    ref => { location.hash = '#/' + state.c + '/' + ref; });
}
async function importComposition() {
  const v = await ask('Import a composition', [{name: 'path', label: 'Path', hint: 'The composition directory or its composer.json.'}], 'Import');
  if (!v) return;
  try {
    const ref = await tool('import_composition', {path: v.path.trim()});
    cache.clear();
    location.hash = '#/' + ref;
  } catch (e) {
    toast(e.message, true);
  }
}

@

The form of a tool is built from its input schema, so every tool of the server can be called
from the page, and a new tool needs no change here. A string is sent as typed; an array or
an object is typed as JSON; an empty required field is null where the schema allows it.
@<Project@/litar@/Web@/tool forms@+
let toolResult = null;
function toolForm(t) {
  const schema = t.inputSchema || {}, need = new Set(schema.required || []);
  const fields = Object.entries(schema.properties || {}).map(([k, s]) => {
    const structured = s.type === 'array' || s.type === 'object', nullable = Array.isArray(s.anyOf);
    const input = h(structured || k === 'text' ? 'textarea' : 'input',
      {name: k, rows: structured ? 3 : 8, spellcheck: false, placeholder: structured ? 'JSON' : nullable ? 'Leave empty for null' : ''});
    input.value = k === 'composition' ? state.c || '' : k === 'node' ? state.n || '' : '';
    const row = h('label', {}, h('span', {}, k, need.has(k) ? null : h('small', {}, ' (optional)')), input, h('small', {}, s.description || ''));
    return {k, structured, nullable, input, row};
  });
  const out = h('div', {}, toolResult && toolResult.name === t.name ? output(toolResult.text) : null);
  toolResult = null;
  return h('form', {onsubmit: async e => {
    e.preventDefault();
    try {
      const args = {};
      for (const f of fields) {
        if (f.input.value !== '') args[f.k] = f.structured ? JSON.parse(f.input.value) : f.input.value;
        else if (need.has(f.k)) args[f.k] = f.nullable ? null : '';
      }
      toolResult = {name: t.name, text: await tool(t.name, args)};
      cache.clear();
      await route();
    } catch (err) {
      out.replaceChildren(output(err.message, true));
    }
  }}, h('p', {class: 'desc'}, t.description || ''), fields.map(f => f.row),
    h('div', {class: 'buttons'}, h('button', {class: 'primary'}, 'Run ' + t.name)), out);
}

@

@<Project@/litar@/Web@/tool forms@+
async function toolsView(name, hint) {
  if (!state.tools) state.tools = JSON.parse(await fetch('/api/tools').then(answer));
  const t = state.tools.find(t => t.name === name) || state.tools[0];
  show(title('Tool', [t.name]),
    hint ? h('p', {}, hint) : null,
    h('div', {class: 'split'},
      h('nav', {}, state.tools.map(x => h('a', {href: here('tools', x.name), class: x === t ? 'on' : ''}, x.name))),
      toolForm(t)));
}

@

A location is #/composition/node/view/..., so every view has a link and history works.
The composition and the node fall back to the first composition and its last node.
With nothing to browse yet, the page offers the tool that makes the missing thing,
unless the location names a tool for that very state.
Showing the same location again, after an edit, keeps the scroll position.
Locations are shown one after another: a second request waits for the first,
so two of them never fill the page at once.
@<Project@/litar@/Web@/routing@+
const views = {chunk: chunkView, file: fileView, item: itemView, label: labelView, search: searchView, eval: evalView, tools: toolsView};
let lastHash = null, routing = Promise.resolve();
function route() {
  return routing = routing.then(showLocation, showLocation);
}
async function showLocation() {
  const parts = location.hash.replace(/^#\/?/, '').split('/').filter(Boolean).map(decodeURIComponent);
  const keep = lastHash === location.hash ? $('main').scrollTop : 0;
  lastHash = location.hash;
  document.body.classList.remove('nav');
  try {
    state.compositions = JSON.parse(await resource('list://composition'));
    state.c = (state.compositions.find(c => c.ref === parts[0]) || state.compositions[0] || {}).ref || null;
    state.flat = [];
    if (state.c) try { flatten(await json(uri('tree', 'node', state.c)), [], 0); } catch (e) { state.flat = []; }
    state.n = (state.flat.find(n => n.ref === parts[1]) || state.flat[state.flat.length - 1] || {}).ref || null;
    state.sel = null;
    const [view, ...args] = parts.slice(2);
    const asked = view === 'tools' && parts[0] === (state.c || '-') ? args[0] : undefined;
    showBar(view || '');
    if (state.n) await (views[view] || nodeView)(...args);
    else if (state.c) await toolsView(asked || 'create_node', 'This composition has no node yet. Create its root node: leave the base empty.');
    else await toolsView(asked || 'import_composition', 'No composition is imported. Import one, or make one with create_composition.');
    $('main').scrollTop = keep;
    if (state.n) await showSide(); else $('tree').replaceChildren();
  } catch (e) {
    show(h('p', {class: 'error'}, e.message));
  }
}

@

Changing the node keeps the rest of the location: refs are hashed from names,
so the same chunk, file, or item is shown in the other node.
@<Project@/litar@/Web@/routing@+
function showBar(view) {
  $('composition').replaceChildren(...state.compositions.map(c =>
    h('option', {value: c.ref, selected: c.ref === state.c, title: c.description}, c.name.split('/').slice(-2).join('/'))));
  $('node').replaceChildren(...state.flat.map(n =>
    h('option', {value: n.ref, selected: n.ref === state.n, title: n.description}, '  '.repeat(n.depth) + n.name)));
  $('pages').replaceChildren(...[['', 'Node'], ['eval', 'Evaluate'], ['tools', 'Tools']].map(([v, name]) =>
    h('a', {href: v ? here(v) : here(), class: view === v ? 'on' : ''}, name)));
}
$('composition').addEventListener('change', e => { location.hash = '#/' + e.target.value; });
$('node').addEventListener('change', e => {
  location.hash = '#/' + [state.c, e.target.value, ...location.hash.split('/').slice(3)].join('/');
});
$('search').addEventListener('submit', e => {
  e.preventDefault();
  location.hash = here('search', e.target.elements.q.value.trim());
});
$('filter').addEventListener('input', () => showSide());
$('menu').addEventListener('click', () => document.body.classList.toggle('nav'));

@

The page has its own litar process, so it does not see what an agent or an editor writes
to the archives. Importing a composition again reads it from disk: the page does that when
its window gets the focus, at most every five seconds and never under an open editor or dialog,
and on the reload button.
@<Project@/litar@/Web@/routing@+
let loadedAt = Date.now();
async function reload(asked) {
  if (!asked && (Date.now() - loadedAt < 5000 || document.querySelector('.editor, .veil'))) return;
  loadedAt = Date.now();
  try {
    for (const c of state.compositions) await tool('import_composition', {path: c.name});
    if (asked) toast('Loaded again from disk.');
  } catch (e) {
    toast(e.message, true);
  }
  cache.clear();
  await route();
}
$('reload').addEventListener('click', () => reload(true));
window.addEventListener('focus', () => reload(false));

@

The width of the navigator is dragged at its edge and remembered by the browser.
@<Project@/litar@/Web@/routing@+
const setSide = w => document.documentElement.style.setProperty('--side', w + 'px');
$('grip').addEventListener('pointerdown', e => {
  e.preventDefault();
  const move = m => {
    const w = Math.max(180, Math.min(m.clientX, window.innerWidth - 320));
    setSide(w);
    try { localStorage.setItem('side', w); } catch (err) {}
  };
  window.addEventListener('pointermove', move);
  window.addEventListener('pointerup', () => window.removeEventListener('pointermove', move), {once: true});
});
try { if (localStorage.getItem('side')) setSide(localStorage.getItem('side')); } catch (err) {}
window.addEventListener('hashchange', route);
route();

@

