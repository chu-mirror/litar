func composerFileBytes(description string, ground *string, nodes []composerNode) ([]byte, error) {
	if nodes == nil {
		nodes = []composerNode{}
	}
	data, err := json.MarshalIndent(composerFile{
		Description: description,
		Ground:      ground,
		Nodes:       nodes,
	}, "", "    ")
	if err != nil {
		return nil, err
	}
	return append(data, '\n'), nil
}

