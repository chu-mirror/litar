@<types@:litar@:Language@/Go@/File@/functions@+
// resolveModule applies "." and ".." against base when the path starts
// with one of them. Otherwise the path starts at the root, and a later
// "." or ".." still applies to the path built so far.
func resolveModule(base, path ModulePath) ModulePath {
	var cur ModulePath
	if len(path) > 0 && isRelName(path[0]) {
		cur = append(ModulePath(nil), base...)
	}
	for _, c := range path {
		switch c {
		case ".":
		case "..":
			if len(cur) > 0 {
				cur = cur[:len(cur)-1]
			}
		default:
			cur = append(cur, c)
		}
	}
	return cur
}

@~ Project@/litar@/Go@/functions@/litar.isRelName @~ Project@/litar@/Go@/functions@/litar.resolveModule @~ Project@/litar@/Go@/types@/litar.ModulePath @

