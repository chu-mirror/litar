resolved, err := resolveArchive(n.Archive, dir)
if err != nil {
	return nil, err
}
ident, err = identityPath(resolved)
if err != nil {
	return nil, fmt.Errorf("could not read '%s'", resolved)
}
data, err := os.ReadFile(resolved)
