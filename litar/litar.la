apply returns the new path of a file, or of a directory that moves.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (m fileMove) apply(p string) (string, bool) {
	if p == m.from {
		return m.to, true
	}
	if m.dir && strings.HasPrefix(p, m.from+"/") {
		return m.to + p[len(m.from):], true
	}
	return p, false
}

@? Project@/litar@/Go@/methods@/litar.fileMove.apply @~ Project@/litar@/Go@/types@/litar.fileMove @

apply applies the first matching move in ms to path p.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (ms fileMoves) apply(p string) (string, bool) {
	for _, m := range ms {
		if to, ok := m.apply(p); ok {
			return to, true
		}
	}
	return p, false
}

@? Project@/litar@/Go@/methods@/litar.fileMoves.apply @~ Project@/litar@/Go@/types@/litar.fileMoves @

applyRef moves the root chunk of a file and the description of a file or directory, File@@/dir@@/file.
A file is also a chunk of the root module, and its description lives in the namespace File,
so both follow the file.
@<rewrite@:litar@:Language@/Go@/File@/methods@+
func (ms fileMoves) applyRef(ref ChunkRef) (ChunkRef, bool) {
	if len(ref.Module) == 0 {
		to, ok := ms.apply(string(ref.Chunk))
		ref.Chunk = Name(to)
		return ref, ok
	}
	if ref.Module[0] != "File" {
		return ref, false
	}
	var parts []string
	for _, n := range refPath(ref)[1:] {
		parts = append(parts, string(n))
	}
	to, ok := ms.apply(strings.Join(parts, "/"))
	if !ok {
		return ref, false
	}
	parts = strings.Split(to, "/")
	ref.Module = ModulePath{"File"}
	for _, part := range parts[:len(parts)-1] {
		ref.Module = append(ref.Module, Name(part))
	}
	ref.Chunk = Name(parts[len(parts)-1])
	return ref, true
}

