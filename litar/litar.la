@<eval test@:litar@:Language@/Go@/File@/functions@+
func TestDepend(t *testing.T) {
	src := "" +
		"@@<chunk 1@@=\n" +
		"content\n" +
		"@@\n" +
		"\n" +
		"@@<chunk 2@@=\n" +
		"@@<label 1@@:chunk 1@@>\n" +
		"@@\n" +
		"\n" +
		"@@<chunk 3@@=\n" +
		"content\n" +
		"@@|label 2@@:chunk 2@@\n"
	blocks := mustArch(t, src)
	@<Project@/litar@/Tests@/Evaluator@/check the blocks of 'blocks' that depend on chunk 1 and chunk 2@>
}

@~ Project@/litar@/Go@/functions@/litar.mustArch @

chunk 2 includes label 1@@:chunk 1, and chunk 3 uses label 2@@:chunk 2 as a filter; a block does not depend on its own chunk,
and querying either the unlabeled chunk or the matching label path finds the dependent block.
@<Project@/litar@/Tests@/Evaluator@/check the blocks of 'blocks' that depend on chunk 1 and chunk 2@=
d1 := Depend(blocks, mustRef(t, "chunk 1"))
if !strings.Contains(d1, "@@<chunk 2@@=") || strings.Contains(d1, "@@<chunk 3@@=") || strings.Contains(d1, "@@<chunk 1@@=") {
	t.Fatalf("depend chunk 1\n%s", d1)
}
d1b := Depend(blocks, mustRef(t, "label 1@@:chunk 1"))
if d1b != d1 {
	t.Fatalf("label depend\n%s\n%s", d1b, d1)
}
d2 := Depend(blocks, mustRef(t, "chunk 2"))
if !strings.Contains(d2, "@@<chunk 3@@=") || strings.Contains(d2, "@@<chunk 2@@=") {
	t.Fatalf("depend chunk 2\n%s", d2)
}
if Depend(blocks, mustRef(t, "label 2@@:chunk 2")) != d2 {
	t.Fatal("label 2")
}
if Depend(blocks, mustRef(t, "nope")) != "" {
	t.Fatal("missing depend")
}
@~ Project@/litar@/Go@/functions@/litar.Depend @~ Project@/litar@/Go@/functions@/litar.mustRef @

@<eval test@:litar@:Language@/Go@/File@/functions@+
func TestLiteralGolden(t *testing.T) {
	src := "" +
		"@@<module@@/chunk1@@=\n" +
		"@@<substructure 1@@>\n" +
		"@@\n" +
		"\n" +
		"@@<module@@/chunk2@@=\n" +
		"@@<substructure 2@@>\n" +
		"@@\n" +
		"\n" +
		"Extend chunk through label.\n" +
		"@@<label@@:module@@/chunk1@@=\n" +
		"@@<substructure 3@@>\n" +
		"@@\n"
	want := "" +
		"@@<module@@/chunk1@@=\n" +
		"@@<substructure 1@@>\n" +
		"@@\n" +
		"\n" +
		"Extend chunk through label.\n" +
		"@@<label@@:module@@/chunk1@@=\n" +
		"@@<substructure 3@@>\n" +
		"@@\n"
	blocks := mustArch(t, src)
	got, err := Literal(blocks, mustRef(t, "label@@:module@@/chunk1"))
	if err != nil {
		t.Fatal(err)
	}
	if got != want {
		t.Fatalf("got %q\nwant %q", got, want)
	}
}

@~ Project@/litar@/Go@/functions@/litar.Literal @~ Project@/litar@/Go@/functions@/litar.mustArch @~ Project@/litar@/Go@/functions@/litar.mustRef @

@<eval test@:litar@:Language@/Go@/File@/functions@+
func TestResolveModule(t *testing.T) {
	base := ModulePath{"mod", "sub"}
	got := resolveModule(base, ModulePath{"..", "..", "x"})
	if formatModule(got) != "x" {
		t.Fatal(formatModule(got))
	}
	got = resolveModule(nil, ModulePath{"..", "x"})
	if formatModule(got) != "x" {
		t.Fatal(formatModule(got))
	}
	got = resolveModule(base, ModulePath{"a", "..", "b"})
	if formatModule(got) != "b" {
		t.Fatal(formatModule(got))
	}
}

@~ Project@/litar@/Go@/functions@/litar.formatModule @~ Project@/litar@/Go@/functions@/litar.resolveModule @~ Project@/litar@/Go@/types@/litar.ModulePath @

