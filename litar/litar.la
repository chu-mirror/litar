func TestExplicitRoot(t *testing.T) {
	arch, err := ParseArchive([]byte("@@<@@/chunk@@=z@@"), "a.la")
	if err != nil {
		t.Fatal(err)
	}
	if len(arch.Blocks[0].Ref.Module) != 0 || arch.Blocks[0].Ref.Chunk != "chunk" {
