@<mcp test@:litar@:Language@/Go@/File@/functions@+
func TestMCPBlocks(t *testing.T) {
	f := newMCPFixture(t, blocksArchive)
	two := refOf("block", "@@<seq@@+\ntwo\n@@")
	f.fail("apply_block", "text", "@@<other@@=x@@\n", "overrides", two)
	f.fail("apply_block", "text", "@@<seq@@+2@@\n", "overrides", "none")
	refs := f.tool("apply_block", "text", "Changed.\n@@<seq@@+\n2\n@@\n@@<seq@@+\n2b\n@@\n", "overrides", two)
	if refs != refOf("block", "@@<seq@@+\n2\n@@")+"\n"+refOf("block", "@@<seq@@+\n2b\n@@") {
		t.Fatalf("override answered %q", refs)
	}
	if text := f.tool("evaluate_expression", "expression", "seq"); text != "one\n2\n2b\nthree" {
		t.Fatalf("after override %q", text)
	}
	if data := f.archive(); strings.Contains(data, "Second.") || !strings.Contains(data, "@@\n\nChanged.\n@@<seq@@+\n2\n@@") {
		t.Fatalf("archive %s", data)
	}
	f.tool("delete_block", "block", strings.Split(refs, "\n")[1])
	f.fail("delete_block", "block", two)
	child := callTool(t, f.ctx, f.session, "create_node", map[string]any{
		"composition": f.c, "name": "child", "archive": "b.la", "description": "", "base": f.n,
	})
	f.fail("move_block", "block", refs[:10], "to", f.n)
	f.tool("move_block", "block", refs[:10], "to", child)
	if text := f.tool("evaluate_expression", "expression", "seq"); text != "one\nthree" {
		t.Fatalf("after move %q", text)
	}
	uri := "blocks://apply/" + f.c + "/" + child + "/" + f.ref("chunk", "seq") + "/" + refOf("labels")
	var applied []blockJSON
	if err := json.Unmarshal([]byte(readResource(t, f.ctx, f.session, uri)), &applied); err != nil {
		t.Fatal(err)
	}
	if len(applied) != 3 || applied[0].Node != f.n || applied[0].Comment != "First." || applied[2].Node != "" || applied[2].Comment != "Changed." {
		t.Fatalf("applied in child %+v", applied)
	}
}

@~ Project@/litar@/Go@/constants@/litar.blocksArchive @~ Project@/litar@/Go@/functions@/litar.TestMCPBlocks @~ Project@/litar@/Go@/functions@/litar.callTool @~ Project@/litar@/Go@/functions@/litar.newMCPFixture @~ Project@/litar@/Go@/functions@/litar.readResource @~ Project@/litar@/Go@/functions@/litar.refOf @~ Project@/litar@/Go@/methods@/litar.mcpFixture.archive @~ Project@/litar@/Go@/methods@/litar.mcpFixture.ref @~ Project@/litar@/Go@/methods@/litar.mcpFixture.tool @~ Project@/litar@/Go@/types@/litar.blockJSON @
@<mcp test@:litar@:Language@/Go@/File@/functions@+
func TestMCPSpecialization(t *testing.T) {
	f := newMCPFixture(t, blocksArchive)
	lab := f.ref("specialization", "lab")
	if got := blockTexts(f.blocks("specialization", lab)); !strings.HasPrefix(got, "@@<lab@@:seq@@+\nfour\n@@~") || strings.Count(got, "@@<") != 1 {
		t.Fatalf("derived %q", got)
	}
	if got := f.blocks("apply", f.ref("chunk", "seq"), lab); len(got) != 4 {
		t.Fatalf("applied %+v", got)
	}
	if got := f.blocks("specialization", refOf("labels")); len(got) != 5 {
		t.Fatalf("unlabelled %+v", got)
	}
	if got := f.blocks("refer", f.ref("item", "Dom", "b")); len(got) != 1 {
		t.Fatalf("refer %+v", got)
	}
}

