// ParseModulePath parses a module path or a domain.
// "/" is the root. "." and ".." are rejected.
func ParseModulePath(s string) (ModulePath, error) {
if s == "/" {
return nil, nil
}
p := &parser{src: []byte(s), expr: true}
names, err := p.parseNames(false)
return ModulePath(names), err
}

@~ Project@/litar@/Go@/functions@/litar.ParseModulePath @~ Project@/litar@/Go@/methods@/litar.parser.parseNames @~ Project@/litar@/Go@/types@/litar.ModulePath @~ Project@/litar@/Go@/types@/litar.parser @

@<parse@:litar@:Language@/Go@/File@/methods@+
// parseNames reads the names of an expression separated by "/".
// relOK allows the names "." and "..".
func (p *parser) parseNames(relOK bool) ([]Name, error) {
var names []Name
for {
name, kind, n, err := p.readName(true)
if err != nil {
return nil, err
}
if name == "" {
return nil, p.fail("empty name")
}
if !relOK && isRelName(name) {
return nil, p.fail("relative module name")
}
names = append(names, name)
if n == 0 {
return names, nil
}
if kind != '/' || n != 2 {
return nil, p.unexpected(kind, n)
}
p.i += n
if p.i >= len(p.src) {
return nil, p.fail("empty name")
}
}
}

@~ Project@/litar@/Go@/functions@/litar.isRelName @~ Project@/litar@/Go@/methods@/litar.parser.fail @~ Project@/litar@/Go@/methods@/litar.parser.parseNames @~ Project@/litar@/Go@/methods@/litar.parser.readName @~ Project@/litar@/Go@/methods@/litar.parser.unexpected @~ Project@/litar@/Go@/types@/litar.Name @~ Project@/litar@/Go@/types@/litar.parser @

@<parse@:litar@:Language@/Go@/File@/functions@+
// ParseItem parses an -r operand. The root marker "/" is not special.
func ParseItem(s string) (Item, error) {
if s == "" {
return nil, &ParseError{Msg: "empty name", Expr: true}
}
p := &parser{src: []byte(s), expr: true}
names, err := p.parseNames(true)
return Item(names), err
}

