composerDoc wraps a JSON nodes array in a composer document with a null ground.
@<compose test@:litar@:Language@/Go@/File@/functions@+
func composerDoc(nodes string) string {
	return "{\n    \"ground\": null,\n    \"nodes\": " + strings.TrimSpace(nodes) + "\n}\n"
}

