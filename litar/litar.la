refParts splits a URI tail of n refs and resolves the composition. The caller holds a.mu.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) refParts(rest string, n int) (*World, []string, error) {
	refs := strings.Split(rest, "/")
	if rest == "" || len(refs) != n {
		return nil, nil, errString("unknown resource")
	}
	w, err := a.compositionByRef(refs[0])
	if err != nil {
		return nil, nil, err
	}
	return w, refs, nil
}

