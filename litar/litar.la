@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) createNode(ctx context.Context, _ *mcp.CallToolRequest, in createIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	ref, err := a.createNodeLocked(in)
	a.mu.Unlock()
	if err != nil {
		return toolErr(err)
	}
	a.refresh()
	return toolText(ref)
}

@~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/functions@/litar.toolText @~ Project@/litar@/Go@/methods@/litar.agent.createNode @~ Project@/litar@/Go@/methods@/litar.agent.createNodeLocked @~ Project@/litar@/Go@/methods@/litar.agent.refresh @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.createIn @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) deleteNode(ctx context.Context, _ *mcp.CallToolRequest, in deleteNodeIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	w, n, err := a.worldNode(in.Composition, in.Node)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	if err := w.DeleteNode(formatNodePath(nodePath(*n))); err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	a.mu.Unlock()
	a.refresh()
	return toolText(in.Node)
}

@~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/functions@/litar.toolText @~ Project@/litar@/Go@/methods@/litar.World.DeleteNode @~ Project@/litar@/Go@/methods@/litar.agent.deleteNode @~ Project@/litar@/Go@/methods@/litar.agent.refresh @~ Project@/litar@/Go@/methods@/litar.agent.worldNode @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.deleteNodeIn @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) deleteChunk(ctx context.Context, _ *mcp.CallToolRequest, in deleteChunkIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	w, n, err := a.worldNode(in.Composition, in.Node)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	chain, maps, err := a.nodeChain(w, in.Node)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	ref, err := chunkByRef(chain, maps, in.Chunk)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	if err := w.DeleteChunkAll(formatNodePath(nodePath(*n)), ref); err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	a.mu.Unlock()
	a.refresh()
	return toolText(in.Chunk)
}

@~ Project@/litar@/Go@/functions@/litar.chunkByRef @~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/functions@/litar.toolErr @~ Project@/litar@/Go@/functions@/litar.toolText @~ Project@/litar@/Go@/methods@/litar.World.DeleteChunkAll @~ Project@/litar@/Go@/methods@/litar.agent.deleteChunk @~ Project@/litar@/Go@/methods@/litar.agent.nodeChain @~ Project@/litar@/Go@/methods@/litar.agent.refresh @~ Project@/litar@/Go@/methods@/litar.agent.worldNode @~ Project@/litar@/Go@/types@/litar.agent @~ Project@/litar@/Go@/types@/litar.deleteChunkIn @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) deleteFile(ctx context.Context, _ *mcp.CallToolRequest, in deleteFileIn) (*mcp.CallToolResult, any, error) {
	a.mu.Lock()
	w, n, err := a.worldNode(in.Composition, in.Node)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	chain, maps, err := a.nodeChain(w, in.Node)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	path, err := fileByRef(chain, maps, in.File)
	if err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	if err := w.DeleteFile(formatNodePath(nodePath(*n)), path); err != nil {
		a.mu.Unlock()
		return toolErr(err)
	}
	a.mu.Unlock()
	a.refresh()
	return toolText(in.File)
}

