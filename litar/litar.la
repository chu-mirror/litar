Splits a slash-separated path into components by delegating to splitSlash.
@<fuse@:litar@:Language@/Go@/File@/functions@+
func stringsSplit(p string) []string {
	return splitSlash(p)
}

@~ Project@/litar@/Go@/functions@/litar.splitSlash @? Project@/litar@/Go@/functions@/litar.stringsSplit @

Splits a string on forward-slash characters without importing the strings package.
@<fuse@:litar@:Language@/Go@/File@/functions@+
func splitSlash(p string) []string {
	var out []string
	start := 0
	for i := 0; i < len(p); i++ {
		if p[i] == '/' {
			out = append(out, p[start:i])
			start = i + 1
		}
	}
	out = append(out, p[start:])
	return out
}

@? Project@/litar@/Go@/functions@/litar.splitSlash @

DetachMounts lazily unmounts every filter view that is still mounted. A process that exits without it leaves a dead mount in the temporary directory.
@<fuse@:litar@:Language@/Go@/File@/functions@+
func DetachMounts() {
	liveMu.Lock()
	defer liveMu.Unlock()
	for m := range liveMounts {
		detach(m.dir, m.direct)
	}
}

@? Project@/litar@/Go@/functions@/litar.DetachMounts @~ Project@/litar@/Go@/functions@/litar.detach @~ Project@/litar@/Go@/variables@/litar.liveMounts @~ Project@/litar@/Go@/variables@/litar.liveMu @

Builds a virtual tree for the given view files, creates temporary mount and overlay directories, mounts the FUSE filesystem, and registers the live mount.
@<fuse@:litar@:Language@/Go@/File@/functions@+
func mountView(files []viewFile) (*mount, error) {
	tree, err := buildVTree(files)
	if err != nil {
		return nil, err
	}
	dir, err := os.MkdirTemp("", "litar-mnt-*")
	if err != nil {
		return nil, fmtMount(err)
	}
	overlay, err := os.MkdirTemp("", "litar-ovl-*")
	if err != nil {
		os.RemoveAll(dir)
		return nil, fmtMount(err)
	}
	var (
		server *fuse.Server
		direct bool
	)
	@<Project@/litar@/FUSE View@/mount 'tree' at 'dir' with new files in 'overlay', setting 'server' and 'direct'@>
	m := &mount{dir: dir, server: server, direct: direct, extra: []string{overlay}}
	liveMu.Lock()
	liveMounts[m] = struct{}{}
	liveMu.Unlock()
	return m, nil
}

