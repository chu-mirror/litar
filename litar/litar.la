@

A block is a card: its comment as prose, its header, its content, then its filters and items.
References are marked inside the content, and the items wrap below it as chips,
so neither stretches the card.
A reference that no block defines is dimmed with a dashed line, not alarmed:
an unused extension point of a structure is the common case.
@<Project@/litar@/Web@/style rules@+
.block { border: 1px solid var(--line); border-radius: 10px; margin: 12px 0; background: var(--raised); overflow: hidden; }
.block > .comment { padding: 10px 14px; white-space: pre-wrap; overflow-wrap: anywhere; border-bottom: 1px solid var(--line); }
.block > header { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 6px 14px; background: var(--panel); border-bottom: 1px solid var(--line); }
.block .op { font: 600 13px/20px var(--mono); width: 20px; text-align: center; border-radius: 6px; background: var(--accent-bg); color: var(--accent); flex: none; }
.block .title { font-weight: 600; color: var(--fg); overflow-wrap: anywhere; min-width: 0; }
.title .mod, .ref .mod, .filter .mod { color: var(--muted); font-weight: 400; }
.block .tools { margin-left: auto; display: flex; gap: 4px; opacity: 0; }
.block:hover > header .tools, .block:focus-within > header .tools { opacity: 1; }
.tools button, .tools select { padding: 0 8px; font-size: 12px; }
.code { font: 13px/1.55 var(--mono); padding: 10px 14px; background: var(--code); tab-size: 4; }
.line { white-space: pre-wrap; overflow-wrap: anywhere; min-height: 1.55em; }
.ref { background: var(--accent-bg); border-radius: 6px; padding: 1px 6px 1px 3px; font-family: system-ui, sans-serif; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
.ref .lab, .filter .lab, .title .lab { margin-right: 4px; }
a.missing { color: var(--muted); text-decoration: underline dashed; cursor: help; }
.fold { border: 0; background: none; padding: 0 3px; color: var(--accent); }
.nested { margin: 4px 0 8px 6px; padding-left: 12px; border-left: 2px solid var(--accent-bg); font: 14px/1.5 system-ui, sans-serif; }
.nested .block { margin: 6px 0; }
.pipe, .items { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 6px 14px; border-top: 1px solid var(--line); }
.pipe::before { content: 'filtered by'; color: var(--muted); font-size: 12px; }
.filter { color: var(--muted); }
.more { cursor: pointer; }
@media (hover: none) { .block .tools { opacity: 1; } .tree .pen { visibility: visible; } }

@

@<Project@/litar@/Web@/style rules@+
.editor { padding: 10px 14px; }
.veil { position: fixed; inset: 0; background: rgb(0 0 0 / .4); display: grid; place-items: center; padding: 16px; z-index: 10; }
.dialog { background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 20px; width: min(520px, 100%); box-shadow: 0 16px 48px rgb(0 0 0 / .25); }
.dialog h2 { margin: 0 0 12px; overflow-wrap: anywhere; }
label { display: block; margin: 10px 0; }
label > span { display: block; font-weight: 600; margin-bottom: 2px; }
label input, label textarea { width: 100%; }
label small { color: var(--muted); font-weight: 400; }
pre.out { font: 13px/1.55 var(--mono); background: var(--code); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px;
  white-space: pre-wrap; overflow-wrap: anywhere; tab-size: 4; margin: 12px 0; }
pre.numbered { counter-reset: n; padding-left: 0; }
.numbered .line { position: relative; padding-left: 4.5em; }
.numbered .line::before { counter-increment: n; content: counter(n); position: absolute; left: 0; width: 3.5em; text-align: right; color: var(--muted); }
#toasts { position: fixed; right: 16px; bottom: 16px; display: grid; gap: 8px; z-index: 20; max-width: min(480px, 90vw); }
.toast { background: var(--fg); color: var(--bg); padding: 8px 12px; border-radius: 8px; white-space: pre-wrap; overflow-wrap: anywhere; }
.toast.bad { background: var(--danger); }
.split { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 24px; }
.split nav a { display: block; padding: 3px 8px; border-radius: 6px; color: var(--fg); overflow-wrap: anywhere; }
.split nav a.on { background: var(--accent-bg); color: var(--accent); font-weight: 600; }

@

Below 820px the navigator leaves the grid and slides over the content from the menu button.
@<Project@/litar@/Web@/style rules@+
@media (max-width: 820px) {
  body { grid-template-columns: minmax(0, 1fr); }
  #menu { display: block; }
  #grip { display: none; }
  #side { position: fixed; z-index: 5; top: 0; bottom: 0; left: 0; width: min(320px, 85vw); transform: translateX(-100%); transition: transform .15s; }
  body.nav #side { transform: none; box-shadow: 0 0 40px rgb(0 0 0 / .3); }
  #content { padding: 16px 12px 48px; }
  .split { grid-template-columns: minmax(0, 1fr); }
}

@
The script never writes the control character of litar literally: AT stands for it,
so the text of the page needs no escaping in an archive.
Elements are built as DOM nodes, never as HTML text, so names and contents need no escaping either.
@<Project@/litar@/Web@/elements@+
const AT = '\x40';
const ctl = c => AT + c;
const $ = id => document.getElementById(id);
function h(tag, attrs, ...kids) {
  const e = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs || {})) {
    if (v === false || v === null || v === undefined) continue;
    if (k.startsWith('on')) e.addEventListener(k.slice(2), v);
    else if (k === 'class') e.className = v;
    else if (k in e) e[k] = v;
    else e.setAttribute(k, v);
  }
  e.append(...kids.flat(Infinity).filter(k => k !== null && k !== undefined && k !== false));
  return e;
}
const button = (text, onclick, cls) => h('button', {type: 'button', class: cls || '', onclick}, text);
const note = text => h('p', {class: 'note'}, text);
const show = (...kids) => $('content').replaceChildren(...kids.flat(Infinity).filter(Boolean));
function toast(text, bad) {
  const t = h('div', {class: 'toast' + (bad ? ' bad' : '')}, text);
  $('toasts').append(t);
  setTimeout(() => t.remove(), bad ? 8000 : 2500);
}

@

Resources are read once and kept until something changes: every tool that edits
goes through act, which drops all of them and shows the page again.
A failed read is not kept, so the next visit tries again.
@<Project@/litar@/Web@/resource access@+
const state = {c: null, n: null, compositions: [], flat: [], sel: null, tools: null};
const cache = new Map();
async function answer(response) {
  const text = await response.text();
  if (!response.ok) throw new Error(text.trim() || response.statusText);
  return text;
}
const resourceURL = uri => '/api/resource?uri=' + encodeURIComponent(uri);
const resource = uri => fetch(resourceURL(uri)).then(answer);
const tool = (name, args) => fetch('/api/tool', {
  method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({name, arguments: args}),
}).then(answer);
function json(uri) {
  if (!cache.has(uri)) {
    const read = resource(uri).then(JSON.parse);
    read.catch(() => cache.delete(uri));
    cache.set(uri, read);
  }
  return cache.get(uri);
}
const uri = (scheme, ...parts) => scheme + '://' + parts.join('/');
const tree = kind => json(uri('tree', kind, state.c, state.n));
const blocks = (kind, ...refs) => json(uri('blocks', kind, state.c, state.n, ...refs));
const here = (...parts) => '#/' + [state.c, state.n || '-', ...parts].map(encodeURIComponent).join('/');

@

@<Project@/litar@/Web@/resource access@+
// act calls an editing tool on the current node, unless args name another; done receives its answer.
async function act(name, args, done) {
  try {
    const out = await tool(name, {composition: state.c, node: state.n, ...args});
    cache.clear();
    await (done ? done(out) : route());
  } catch (e) {
    toast(e.message, true);
  }
}

@

One dialog serves every question: without fields it is a confirmation.
It answers the values by field name, or null when cancelled.
@<Project@/litar@/Web@/dialogs@+
function ask(title, fields, ok = 'Save') {
  return new Promise(done => {
    const inputs = fields.map(f => {
      const input = h(f.multiline ? 'textarea' : 'input', {name: f.name, rows: 4, spellcheck: false});
      input.value = f.value || '';
      return input;
    });
    const close = value => { veil.remove(); done(value); };
    const form = h('form', {class: 'dialog', onsubmit: e => {
      e.preventDefault();
      close(Object.fromEntries(inputs.map(i => [i.name, i.value])));
    }}, h('h2', {}, title),
      fields.map((f, k) => h('label', {}, h('span', {}, f.label), inputs[k], f.hint ? h('small', {}, f.hint) : null)),
      h('div', {class: 'buttons'}, h('button', {class: 'primary'}, ok), button('Cancel', () => close(null))));
    const veil = h('div', {class: 'veil', onkeydown: e => { if (e.key === 'Escape') close(null); }}, form);
    document.body.append(veil);
    (inputs[0] || form.querySelector('button')).focus();
  });
}
const sure = (question, ok = 'Delete') => ask(question, [], ok);

@

A tree is indexed three ways: leaves by path, branches by path, and every entry by ref.
A branch and a leaf may share a path (a module and a chunk), so they are kept apart.
@<Project@/litar@/Web@/trees@+
const subs = t => t['sub-trees'] || [];
const key = names => names.join('\0');
function index(t) {
  const ix = {at: new Map(), mod: new Map(), byRef: new Map()};
  (function walk(t, path) {
    for (const s of subs(t)) {
      const p = [...path, s.name], branch = subs(s).length > 0;
      (branch ? ix.mod : ix.at).set(key(p), s.ref);
      ix.byRef.set(s.ref, {path: p, branch, description: s.description || ''});
      walk(s, p);
    }
  })(t, []);
  return ix;
}
async function indexes() {
  const [chunk, file, item, spec] = await Promise.all(['chunk', 'file', 'item', 'specialization'].map(tree));
  return {chunk: index(chunk), file: index(file), item: index(item), spec: index(spec), specRoot: spec.ref};
}

@

A reference to a file names its path as one chunk of the root module; the chunk tree
lists that chunk below File, one branch per directory.
A label path is written with the most specific label first, and the specialization tree
holds it the other way round; no labels is the root of that tree.
@<Project@/litar@/Web@/trees@+
const findChunk = (ix, path) => ix.chunk.at.get(key(path))
  || (path.length === 1 ? ix.chunk.at.get(key(['File', ...path[0].split('/')])) : undefined);
function findSpec(ix, labels) {
  if (labels.length === 0) return ix.specRoot;
  const k = key([...labels].reverse());
  return ix.spec.at.get(k) || ix.spec.mod.get(k) || ix.specRoot;
}
function flatten(t, path, depth) {
  const p = [...path, t.name];
  state.flat.push({ref: t.ref, name: t.name, description: t.description || '', path: p, depth});
  for (const s of subs(t)) flatten(s, p, depth + 1);
}

@

The navigator shows one tree of the node at a time. A branch stays open once opened,
and the branches above the selected entry are opened for it.
While a filter is typed every match is shown open, without changing what is remembered.
@<Project@/litar@/Web@/navigator@+
const kinds = {chunk: 'Chunks', file: 'Files', item: 'Items', specialization: 'Labels'};
const links = {chunk: 'chunk', file: 'file', item: 'item', specialization: 'label'};
const side = {kind: 'chunk', open: new Set()};
function select(kind, ref, path) {
  state.sel = ref;
  side.kind = kind;
  for (let k = 1; k < path.length; k++) side.open.add(kind + '\0' + key(path.slice(0, k)));
}
async function showSide() {
  $('kinds').replaceChildren(...Object.keys(kinds).map(k =>
    button(kinds[k], () => { side.kind = k; showSide(); }, k === side.kind ? 'on' : '')));
  let list;
  try {
    list = treeList(await tree(side.kind), [], $('filter').value.trim().toLowerCase(), false);
  } catch (e) {
    list = h('p', {class: 'error'}, e.message);
  }
  $('tree').replaceChildren(list || note('Nothing here.'));
  const sel = $('tree').querySelector('.sel');
  if (sel && sel.scrollIntoView) sel.scrollIntoView({block: 'nearest'});
}

@

Branches come first, then names in order. An entry is listed when the filter matches it,
its description, a branch above it, or an entry below it.
In the specialization tree every entry is a label path of its own, so branches are links too.
The chunk tree leaves out the reserved module File: the files have a tree of their own.
@<Project@/litar@/Web@/navigator@+
function treeList(t, path, q, shown) {
  const kind = side.kind, rows = [];
  const order = (a, b) => (subs(b).length > 0) - (subs(a).length > 0) || a.name.localeCompare(b.name);
  for (const s of [...subs(t)].sort(order)) {
    const p = [...path, s.name];
    if (kind === 'chunk' && p.length === 1 && s.name === 'File') continue;
    const hit = shown || !q || (s.name + '\n' + (s.description || '')).toLowerCase().includes(q);
    const kids = subs(s).length ? treeList(s, p, q, hit) : null;
    if (!hit && !kids) continue;
    const pen = kind === 'specialization' ? null : h('button', {type: 'button', class: 'pen', title: 'Rename', 'aria-label': 'Rename', onclick: e => {
      e.preventDefault();
      renameEntry(kind, s.ref, p, kids !== null);
    }}, '✎');
    const leaf = () => h('div', {class: 'leaf' + (s.ref === state.sel ? ' sel' : ''), title: s.description || ''},
      h('a', {href: here(links[kind], s.ref)}, s.name), pen);
    if (!kids) rows.push(h('li', {}, leaf()));
    else if (kind === 'specialization') rows.push(h('li', {}, leaf(), kids));
    else {
      const id = kind + '\0' + key(p);
      const d = h('details', {open: Boolean(q) || side.open.has(id), ontoggle: () => {
        if (!q) d.open ? side.open.add(id) : side.open.delete(id);
      }}, h('summary', {title: s.description || ''}, h('span', {class: 'name'}, s.name), pen), kids);
      rows.push(h('li', {}, d));
    }
  }
  return rows.length ? h('ul', {class: 'tree'}, rows) : null;
}

@

Chunks, modules, items, and domains are renamed by the rename tool; files and directories
are moved by the mv of operate_files. When the entry on show was renamed, the page follows it to its new ref.
@<Project@/litar@/Web@/navigator@+
const quote = s => /^[\w.\/-]+$/.test(s) ? s : "'" + s.replaceAll("'", "'\\''") + "'";
async function renameEntry(kind, ref, path, branch) {
  const file = kind === 'file', old = path.join(file ? '/' : ctl('/'));
  const v = await ask(file ? 'Move ' + old : 'Rename ' + old, [{name: 'to', label: 'New path', value: old,
    hint: file ? 'A path in the node.' : 'Names separated by ' + ctl('/') + '; references, filters, and descriptions follow.'}], file ? 'Move' : 'Rename');
  if (!v || v.to.trim() === old) return;
  const to = v.to.trim();
  const follow = async () => {
    const names = to.split(file ? '/' : ctl('/')).map(s => s.trim());
    const next = branch ? undefined : index(await tree(kind)).at.get(key(names));
    if (next && state.sel === ref) location.hash = here(links[kind], next);
    else await route();
  };
  if (file) await act('operate_files', {command: 'mv ' + quote(old) + ' ' + quote(to)}, follow);
  else await act('rename', {object: ref, to}, follow);
}

@
The control character before a letter is text, twice it is itself, and before a blank
or at the end of the text it closes the expression; anything else is a control.
@<Project@/litar@/Web@/block syntax@+
function scan(text) {
  const out = [];
  let buf = '';
  const flush = () => { if (buf !== '') out.push({text: buf}); buf = ''; };
  for (let i = 0; i < text.length; i++) {
    const c = text[i], d = text[i + 1];
    if (c !== AT || (d !== undefined && /[A-Za-z]/.test(d))) { buf += c; continue; }
    if (d === AT) { buf += AT; i++; continue; }
    flush();
    if (d === undefined || /\s/.test(d)) { out.push({ctl: ''}); return out; }
    out.push({ctl: d});
    i++;
  }
  flush();
  return out;
}
const qualify = (labels, path) => labels.map(l => l + ctl(':')).join('') + path.join(ctl('/'));
// resolve gives the module path of a reference written in a block of the module base.
function resolve(base, path) {
  if (path[0] !== '.' && path[0] !== '..') return path;
  const out = [...base];
  for (const name of path) {
    if (name === '..') out.pop();
    else if (name !== '.') out.push(name);
  }
  return out;
}

@

A parsed block has the labels and the path of its header (a file has its path as the only name),
its file sets and operation, the body as texts and references, then its filters and its items.
The page shows a block that it cannot parse as plain text, so parsing never throws.
@<Project@/litar@/Web@/block syntax@+
function parseBlock(text) {
  const toks = scan(text);
  let i = 0;
  const b = {file: false, exec: false, labels: [], path: [], sets: [], op: '', body: [], filters: [], items: []};
  const at = () => toks[i] ? toks[i].ctl : undefined;
  const name = () => (toks[i] && toks[i].text !== undefined ? toks[i++].text : '').trim();
  @<.@/operand: the names and the view of a reference or a filter@>
  @<.@/read the header of 'b'@>
  @<.@/read the body, the filters, and the items of 'b'@>
  return b;
}

@

@<Project@/litar@/Web@/operand: the names and the view of a reference or a filter@=
const operand = () => {
  const r = {labels: [], path: [], view: [], filters: []};
  let op = '';
  for (;;) {
    const n = name(), c = at();
    if (op) r.view.push({op, name: n});
    else if (c === ':') r.labels.push(n);
    else if (n !== '') r.path.push(n);
    if (!op && (c === ':' || c === '/')) i++;
    else if (c && '+-,!'.includes(c)) { op = c; i++; }
    else return r;
  }
};
@

A file header has its path, then a file set after each backquote control.
@<Project@/litar@/Web@/read the header of 'b'@=
const open = toks[i++];
b.file = Boolean(open) && open.ctl !== '<';
b.exec = Boolean(open) && open.ctl === '(';
for (let inSet = false; ;) {
  const n = name(), c = at();
  i++;
  if (c === undefined || c === '') return b;
  if (inSet) b.sets.push(n);
  else if (c === ':') b.labels.push(n);
  else b.path.push(n);
  if (c === '`') inSet = true;
  else if (c === '=' || c === '+') { b.op = c; break; }
  else if (c !== ':' && c !== '/') return b;
}
@

After the first filter or item of the block, the text between the controls is layout, not content.
@<Project@/litar@/Web@/read the body, the filters, and the items of 'b'@=
for (let tail = false; ;) {
  const t = toks[i++];
  if (!t || t.ctl === '') break;
  if (t.text !== undefined) { if (!tail) b.body.push(t.text); }
  else if (t.ctl === '<') {
    const r = operand();
    while (at() === '|') { i++; r.filters.push(operand()); }
    if (at() === '>') i++;
    b.body.push(r);
  } else if (t.ctl === '|') { tail = true; b.filters.push(operand()); }
  else if (t.ctl === '~') {
    tail = true;
    const item = [name()];
    while (at() === '/') { i++; item.push(name()); }
    b.items.push(item);
  } else if (!tail) b.body.push(ctl(t.ctl));
}
@

A reference without labels inherits the labels under which its block is read: those of the
page when it shows one chunk reference, else the labels of the block itself.
A reference that no block defines expands to nothing when evaluated, so the page marks it.
@<Project@/litar@/Web@/block rendering@+
function target(b, r, ctx) {
  const labels = r.labels.length ? r.labels : ctx.labels || b.labels;
  const path = resolve(b.file ? [] : b.path.slice(0, -1), r.path);
  return {labels, path, chunk: findChunk(ctx.ix, path), spec: findSpec(ctx.ix, labels)};
}
const nameParts = (labels, names) => [
  labels.map(l => h('span', {class: 'lab'}, l)),
  names.length > 1 ? h('span', {class: 'mod'}, names.slice(0, -1).join(' / ') + ' / ') : null,
  names[names.length - 1] || '',
];
function chunkLink(r, t) {
  const full = qualify(t.labels, t.path);
  return t.chunk
    ? h('a', {href: here('chunk', t.chunk, t.spec), title: full}, nameParts(r.labels, r.path))
    : h('a', {class: 'missing', title: 'No block defines ' + full}, nameParts(r.labels, r.path));
}
const viewOps = {'+': 'adds a file set to the view', '-': 'removes a file set from the view',
  ',': 'adds a file to the view', '!': 'removes a file from the view'};
const filterSpan = (b, f, ctx) => h('span', {class: 'filter'}, ' | ', chunkLink(f, target(b, f, ctx)),
  f.view.map(v => [' ', h('span', {class: 'view', title: viewOps[v.op]}, v.op + v.name)]));

@

A reference can be opened where it stands: the effective blocks of its chunk are shown
below its line, read under the labels the reference has there, and they open the same way.
So a structure is read top down without leaving the page.
@<Project@/litar@/Web@/block rendering@+
function refSpan(b, r, ctx, line) {
  const t = target(b, r, ctx), span = h('span', {class: 'ref'});
  if (r.path.length === 0) return h('span', {class: 'ref'}, r.filters.map(f => filterSpan(b, f, ctx)));
  if (t.chunk) span.append(h('button', {type: 'button', class: 'fold', title: 'Show the blocks of this chunk here', onclick: e => expand(e.currentTarget, line(), t, ctx)}, '▸'));
  span.append(chunkLink(r, t), ...r.filters.map(f => filterSpan(b, f, ctx)));
  return span;
}
async function expand(fold, line, t, ctx) {
  if (fold.nest) {
    fold.nest.remove();
    fold.nest = null;
    fold.textContent = '▸';
    return;
  }
  fold.textContent = '▾';
  fold.nest = h('div', {class: 'nested'}, note('Loading…'));
  line.after(fold.nest);
  try {
    fold.nest.replaceChildren(blockList(await blocks('effective', t.chunk, t.spec), {...ctx, labels: t.labels, item: null}));
  } catch (e) {
    fold.nest.replaceChildren(h('p', {class: 'error'}, e.message));
  }
}

@

The content is laid out as lines, so the blocks of an opened reference fit below its line.
The line break after the operation and the one before the end are layout, as in the language.
@<Project@/litar@/Web@/block rendering@+
function codeLines(b, ctx) {
  let line = h('div', {class: 'line'});
  const code = h('div', {class: 'code'}, line), segs = [...b.body], last = segs.length - 1;
  if (typeof segs[0] === 'string') segs[0] = segs[0].replace(/^\r?\n/, '');
  if (typeof segs[last] === 'string') segs[last] = segs[last].replace(/\r?\n$/, '');
  for (const s of segs) {
    if (typeof s !== 'string') { const mine = line; line.append(refSpan(b, s, ctx, () => mine)); continue; }
    s.split('\n').forEach((part, k) => {
      if (k > 0) code.append(line = h('div', {class: 'line'}));
      line.append(part);
    });
  }
  return code;
}

@

The items of a block are chips with the last name of each; the title has the whole path.
Past eight they fold, since a block may carry dozens. On the page of an item, that item comes first.
@<Project@/litar@/Web@/block rendering@+
function itemChips(items, ctx) {
  const mine = it => key(it) === ctx.item;
  const chip = it => {
    const ref = ctx.ix.item.at.get(key(it));
    return h('a', {class: 'item' + (mine(it) ? ' on' : ''), href: ref ? here('item', ref) : null, title: it.join(' / ')}, it[it.length - 1]);
  };
  const sorted = [...items].sort((a, b) => mine(b) - mine(a));
  const box = h('div', {class: 'items'}, sorted.slice(0, 8).map(chip));
  if (sorted.length > 8) box.append(h('button', {type: 'button', class: 'more', title: 'Show every item', onclick: e => e.currentTarget.replaceWith(...sorted.slice(8).map(chip))}, '+' + (sorted.length - 8)));
  return box;
}
function headName(b, ctx) {
  let href = null;
  if (b.file) {
    const f = ctx.ix.file.at.get(key((b.path[0] || '').split('/')));
    href = f ? here('file', f, 'effective') : null;
  } else {
    const c = findChunk(ctx.ix, b.path);
    href = c ? here('chunk', c, findSpec(ctx.ix, b.labels)) : null;
  }
  return h('a', {class: 'title', href, title: qualify(b.labels, b.path)}, nameParts(b.labels, b.file ? [b.path[0] || ''] : b.path));
}

@

A block of a base node says which node owns it, and its actions go to that node.
@<Project@/litar@/Web@/block rendering@+
function blockCard(j, ctx) {
  const card = h('article', {class: 'block'}), owner = j.node || state.n;
  let b;
  try { b = parseBlock(j.text); } catch (e) { b = null; }
  const render = () => card.replaceChildren(...[
    j.comment ? h('div', {class: 'comment'}, j.comment) : null,
    h('header', {},
      b && b.op ? h('span', {class: 'op', title: b.op === '=' ? 'Sets the chunk' : 'Extends the chunk'}, b.op) : null,
      b ? headName(b, ctx) : null,
      b && b.exec ? h('span', {class: 'set', title: 'An executable file'}, 'executable') : null,
      b ? b.sets.map(s => h('span', {class: 'set', title: 'File set'}, s)) : null,
      j.node ? h('a', {class: 'owner', href: '#/' + state.c + '/' + j.node, title: 'The node this block belongs to'}, nodeName(j.node)) : null,
      blockTools(card, j, b, owner, render)),
    b && b.op ? codeLines(b, ctx) : h('div', {class: 'code'}, h('div', {class: 'line'}, j.text)),
    b && b.filters.length ? h('div', {class: 'pipe'}, b.filters.map(f => filterSpan(b, f, ctx))) : null,
    b && b.items.length ? itemChips(b.items, ctx) : null,
  ].filter(Boolean));
  render();
  return card;
}
const nodeName = ref => (state.flat.find(n => n.ref === ref) || {name: ref}).name;

@

A long list is shown forty blocks at a time: the own blocks of a node may be thousands.
@<Project@/litar@/Web@/block rendering@+
function blockList(list, ctx) {
  const box = h('div', {class: 'blocks'});
  if (list.length === 0) return h('div', {class: 'blocks'}, note('No block.'));
  let shown = 0;
  const more = button('', () => add());
  const add = () => {
    more.remove();
    for (const j of list.slice(shown, shown + 40)) box.append(blockCard(j, ctx));
    shown += 40;
    if (shown < list.length) {
      more.textContent = 'Show more (' + (list.length - shown) + ' left)';
      box.append(more);
    }
  };
  add();
  return box;
}

@

The editor holds a block as the archive does: its comment, then its text.
Ctrl+Enter saves and Escape cancels; Tab types a tab, since code is indented with it.
@<Project@/litar@/Web@/block actions@+
function editor(text, save, cancel) {
  const area = h('textarea', {spellcheck: false, rows: Math.min(40, Math.max(6, text.split('\n').length + 1))});
  area.value = text;
  const done = () => save(area.value.endsWith('\n') ? area.value : area.value + '\n');
  area.addEventListener('keydown', e => {
    if (e.key === 'Tab' && !e.shiftKey) { e.preventDefault(); area.setRangeText('\t', area.selectionStart, area.selectionEnd, 'end'); }
    else if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); done(); }
    else if (e.key === 'Escape') cancel();
  });
  return h('div', {class: 'editor'}, area, h('div', {class: 'buttons'},
    button('Save', done, 'primary'), button('Cancel', cancel),
    h('span', {class: 'note'}, 'The comment goes before the block. Ctrl+Enter saves, Esc cancels.')));
}
function newBlock(where, header) {
  const box = h('article', {class: 'block'});
  box.append(editor(header ? header + '\n\n' + AT + '\n' : '', text => act('apply_block', {text}), () => box.remove()));
  where.prepend(box);
  box.querySelector('textarea').focus();
}

@

Saving an edited block overrides the old one, so it keeps its place among the blocks of its chunk.
@<Project@/litar@/Web@/block actions@+
function blockTools(card, j, b, owner, render) {
  const name = b ? qualify(b.labels, b.path) : 'this block';
  const edit = () => {
    card.replaceChildren(editor((j.comment ? j.comment + '\n' : '') + j.text + '\n',
      text => act('apply_block', {node: owner, text, overrides: j.ref}), render));
    card.querySelector('textarea').focus();
  };
  const move = e => {
    const pick = h('select', {onchange: () => { if (pick.value) act('move_block', {node: owner, block: j.ref, to: pick.value}); }},
      h('option', {value: ''}, 'Move to…'),
      state.flat.filter(n => n.ref !== owner).map(n => h('option', {value: n.ref}, n.path.join(' / '))));
    e.currentTarget.replaceWith(pick);
    pick.focus();
  };
  const remove = async () => {
    if (await sure('Delete this block of ' + name + '?')) act('delete_block', {node: owner, block: j.ref});
  };
  return h('span', {class: 'tools'}, button('Edit', edit), button('Move', move), button('Delete', remove, 'danger'));
}

@
Every view starts with the same heading: the kind of object, its path with the modules
dimmed, and its description.
@<Project@/litar@/Web@/views@+
const title = (kind, path, labels, description) => [
  h('div', {class: 'kind'}, kind),
  h('h1', {}, nameParts(labels || [], path)),
  description ? h('p', {class: 'desc'}, description) : null,
];
const tabBar = (tabs, on, link) => h('nav', {class: 'tabs'},
  Object.keys(tabs).map(t => h('a', {href: link(t), class: t === on ? 'on' : ''}, tabs[t])));
const output = (text, bad) => h('pre', {class: 'out' + (bad ? ' error' : '')}, text === '' ? h('span', {class: 'note'}, '(empty)') : text);
const numbered = text => h('pre', {class: 'out numbered'}, text.replace(/\n$/, '').split('\n').map(l => h('div', {class: 'line'}, l)));
// A description is the JSON of a meta chunk: Chunk, File, Index, or Specialization, then the path.
async function describeMeta(meta, current) {
  const v = await ask('Describe ' + meta.slice(1).join(' / '), [{name: 'd', label: 'Description', value: current, multiline: true}]);
  if (!v) return;
  const body = JSON.stringify({description: v.d.trim()}).replaceAll(AT, AT + AT);
  await act('apply_block', {text: ctl('<') + meta.join(ctl('/')) + ctl('=') + '\n' + body + '\n' + AT + '\n'});
}

@

A chunk is shown under one label path. Its tabs are the questions asked of a chunk:
which blocks make it, which were ever applied, which blocks use it, and what it evaluates to.
The chunk of a file belongs to the view of that file.
@<Project@/litar@/Web@/views@+
async function chunkView(chunkRef, specRef, tab = 'effective') {
  const ix = await indexes(), e = ix.chunk.byRef.get(chunkRef);
  if (!e || e.branch) return show(note('This node has no such chunk; it may have been renamed or deleted.'));
  if (e.path[0] === 'File') {
    const f = ix.file.at.get(key(e.path.slice(1)));
    if (f) return fileView(f, tab);
  }
  select('chunk', chunkRef, e.path);
  const spec = ix.spec.byRef.get(specRef), labels = spec ? [...spec.path].reverse() : [];
  if (!spec) specRef = ix.specRoot;
  const name = qualify(labels, e.path), body = h('div', {}, note('Loading…'));
  show(title('Chunk', e.path, labels, e.description),
    h('div', {class: 'actions'},
      button('New block', () => newBlock(body, ctl('<') + name + ctl('+')), 'primary'),
      button('Describe', () => describeMeta(['Chunk', ...e.path], e.description)),
      button('Rename', () => renameEntry('chunk', chunkRef, e.path, false)),
      button('Delete', async () => {
        if (await sure('Delete the chunk ' + qualify([], e.path) + ' with every block applied to it in this node?'))
          act('delete_chunk', {chunk: chunkRef}, () => { location.hash = here(); });
      }, 'danger')),
    specBar(ix, e.path, chunkRef, specRef, labels, tab),
    tabBar({effective: 'Effective', apply: 'Applied', depend: 'Used by', result: 'Result'}, tab, t => here('chunk', chunkRef, specRef, t)),
    body);
  await fill(body, async () => tab === 'result'
    ? output(await tool('evaluate_expression', {composition: state.c, node: state.n, expression: name}))
    : blockList(await blocks(tab, chunkRef, specRef), {ix, labels: tab === 'depend' ? null : labels}));
}
// fill puts what make answers, an element or several, into body; a failure is shown there.
async function fill(body, make) {
  try {
    body.replaceChildren(...[await make()].flat());
  } catch (e) {
    body.replaceChildren(output(e.message, true));
  }
}

@

A chunk without labels may have nothing but labelled blocks, so the bar offers the label paths
that blocks of this chunk are written under. They are found by searching for the chunk name
after a label control; when the search has too many matches, the list of every label path
of the node still leads there.
@<Project@/litar@/Web@/views@+
function specBar(ix, path, chunkRef, specRef, labels, tab) {
  if (ix.spec.byRef.size === 0) return null;
  const chip = (ref, ls) => h('a', {class: 'lab' + (ref === specRef ? ' on' : ''), href: here('chunk', chunkRef, ref, tab)},
    ls.length ? ls.join(ctl(':')) : 'no label');
  const pick = h('select', {'aria-label': 'Label path', onchange: () => { if (pick.value) location.hash = here('chunk', chunkRef, pick.value, tab); }},
    h('option', {value: ''}, 'Other label path…'),
    [...ix.spec.byRef].map(([ref, s]) => h('option', {value: ref}, [...s.path].reverse().join(ctl(':')))));
  const bar = h('div', {class: 'chips'}, h('span', {class: 'note'}, 'Read under'), chip(ix.specRoot, []),
    specRef === ix.specRoot ? null : chip(specRef, labels), pick);
  tool('search_blocks', {composition: state.c, node: state.n, text: ctl(':') + path.join(ctl('/')) + AT}).then(found => {
    const seen = new Set([ix.specRoot, specRef]);
    for (const j of JSON.parse(found)) {
      const b = parseBlock(j.text), ref = findSpec(ix, b.labels);
      if (b.file || key(b.path) !== key(path) || seen.has(ref)) continue;
      seen.add(ref);
      pick.before(chip(ref, b.labels));
    }
  }).catch(() => {});
  return bar;
}

@

A file shows what it evaluates to, with line numbers, and the blocks of its chunk.
A file mapped from outside the archives has content only, and is removed by rm.
@<Project@/litar@/Web@/views@+
async function fileView(fileRef, tab = 'content') {
  const ix = await indexes(), e = ix.file.byRef.get(fileRef);
  if (!e || e.branch) return show(note('This node has no such file; it may have been moved or deleted.'));
  select('file', fileRef, e.path);
  const path = e.path.join('/'), chunk = ix.chunk.at.get(key(['File', ...e.path]));
  const body = h('div', {}, note('Loading…'));
  if (!chunk || !['effective', 'apply', 'depend'].includes(tab)) tab = 'content';
  show(title('File', [path], [], e.description),
    h('div', {class: 'actions'},
      button('Describe', () => describeMeta(['File', ...e.path], e.description)),
      button('Move', () => renameEntry('file', fileRef, e.path, false)),
      button('Delete', async () => {
        if (!await sure('Delete the file ' + path + (chunk ? ' with its blocks in this node?' : ' from the mappings of this node?'))) return;
        const gone = () => { location.hash = here(); };
        if (chunk) act('delete_file', {file: fileRef}, gone);
        else act('operate_files', {command: 'rm ' + quote(path)}, gone);
      }, 'danger')),
    tabBar(chunk ? {content: 'Content', effective: 'Blocks', apply: 'Applied', depend: 'Used by'} : {content: 'Content'}, tab, t => here('file', fileRef, t)),
    body);
  await fill(body, async () => {
    if (tab !== 'content') return blockList(await blocks(tab, chunk, ix.specRoot), {ix, labels: tab === 'depend' ? null : []});
    const response = await fetch(resourceURL(uri('file', state.c, state.n, fileRef)));
    if (!response.ok) throw new Error((await response.text()).trim());
    if (/^text\/|json/.test(response.headers.get('Content-Type') || '')) return numbered(await response.text());
    const size = (await response.arrayBuffer()).byteLength;
    return h('p', {}, 'A binary file of ' + size + ' bytes. ', h('a', {href: resourceURL(uri('file', state.c, state.n, fileRef)), download: e.path[e.path.length - 1]}, 'Download'));
  });
}

@

An item connects the blocks that carry it; a label path lists the blocks written under exactly it,
which is often one source file.
@<Project@/litar@/Web@/views@+
async function itemView(itemRef) {
  const ix = await indexes(), e = ix.item.byRef.get(itemRef);
  if (!e) return show(note('This node has no such item; it may have been renamed.'));
  select('item', itemRef, e.path);
