@

@<Index@/Project@/litar@/Go@/methods@/litar.readOnlyNode.Rename@=
{"description": "Refuses renaming entries on a read-only FUSE loopback node by returning syscall.EROFS."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.readOnlyNode.Rmdir@=
