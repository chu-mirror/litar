isLetter reports whether b is an ASCII letter; @@ followed by a letter is ordinary text, not a control.
@<parse@:litar@:Language@/Go@/File@/functions@+
func isLetter(b byte) bool {
	return (b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z')
}

