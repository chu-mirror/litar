{"description": "Test helper that reads and returns the contents of the fixture's archive file."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.mcpFixture.args@=
{"description": "Test helper that builds an MCP tool argument map pre-populated with the fixture's composition and root node refs plus extra key-value pairs."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.mcpFixture.blocks@=
{"description": "Test helper that reads a blocks:// resource of the given kind and unmarshals it into a slice of blockJSON."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.mcpFixture.fail@=
