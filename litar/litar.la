@

The page builds a form for each tool from this list, so a tool added to litar
appears in the page without a change here.
@<litar-web@:command@:Language@/Go@/File@/functions@+
func toolsHandler(session *mcp.ClientSession) http.HandlerFunc {
	return func(w http.ResponseWriter, r *http.Request) {
		res, err := session.ListTools(r.Context(), nil)
		if err != nil {
			http.Error(w, err.Error(), http.StatusBadGateway)
			return
		}
		w.Header().Set("Content-Type", "application/json; charset=utf-8")
		json.NewEncoder(w).Encode(res.Tools)
	}
}

@~ Project@/litar@/Go@/functions@/litar-web.toolsHandler @

The page writes archives and runs filters, so a request must come from the page itself.
A host that is a name other than localhost may be another site's name resolved to this
server (DNS rebinding), and an origin other than the host is another site's page.
@<litar-web@:command@:Language@/Go@/File@/functions@+
func guard(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if !localHost(r.Host) {
			http.Error(w, "host '"+r.Host+"' is not an address of this server", http.StatusForbidden)
			return
		}
		if origin := r.Header.Get("Origin"); origin != "" {
			if u, err := url.Parse(origin); err != nil || u.Host != r.Host {
				http.Error(w, "origin '"+origin+"' is not this server", http.StatusForbidden)
				return
			}
		}
		next.ServeHTTP(w, r)
	})
}

// localHost tells whether the host of a request is localhost or an IP address.
func localHost(hostport string) bool {
	host := hostport
	if h, _, err := net.SplitHostPort(hostport); err == nil {
		host = h
	}
	return host == "localhost" || net.ParseIP(strings.Trim(host, "[]")) != nil
}

@~ Project@/litar@/Go@/functions@/litar-web.guard @~ Project@/litar@/Go@/functions@/litar-web.localHost @
