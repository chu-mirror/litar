readChain is nodeChain for reading: the blocks of the node that a worker sees, which a
select field narrows, with the mappings. Evaluation keeps using nodeChain, so a file read
through file:// is the same with or without a selection. The caller holds a.mu.
@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) readChain(w *World, ref string) ([]Block, []Mapping, error) {
	n, err := nodeByRef(w, ref)
	if err != nil {
		return nil, nil, err
	}
	np := formatNodePath(nodePath(*n))
	chain, err := w.Visible(np)
	if err != nil {
		return nil, nil, err
	}
	maps, err := w.Mappings(np)
	if err != nil {
		return nil, nil, err
	}
	return chain, maps, nil
}

