@~ Project@/litar@/Go@/functions@/litar.assignRefs @? Project@/litar@/Go@/functions@/litar.specializationTreeWith @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.ChunkRef @~ Project@/litar@/Go@/types@/litar.Name @~ Project@/litar@/Go@/types@/litar.metaInfo @~ Project@/litar@/Go@/types@/litar.treeJSON @

Labels are written most specific first, so the walk from the root reads them backward.
@<Project@/litar@/MCP Server@/add the label path of 'labels' under 'root', the last label first@=
cur := root
for i := len(labels) - 1; i >= 0; i-- {
	name := string(labels[i])
	child := cur.index[name]
	if child == nil {
		path := append(append([]string{}, cur.path...), name)
		child = &specNode{name: name, path: path, index: map[string]*specNode{}}
		cur.index[name] = child
		cur.kids = append(cur.kids, child)
	}
	cur = child
}
@

The description key is the specialization as written, most specific label first.
@<Project@/litar@/MCP Server@/build the tree of the specialization 'n', described from 'meta'@=
key := ""
if len(n.path) > 0 {
	rev := make([]string, len(n.path))
	for i, part := range n.path {
		rev[len(n.path)-1-i] = part
	}
	key = strings.Join(rev, "@@:")
}
t := treeJSON{
	Name:        n.name,
	Description: meta.specs[key],
	SubTrees:    emptySub(),
	Leaf:        true,
}
for _, c := range n.kids {
	t.SubTrees = append(t.SubTrees, build(c))
}
return t
