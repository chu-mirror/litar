}
if got := Chunks(blocks, nil, meta); got != "z\nhello.c\n" {
	t.Fatalf("chunks / %q", got)
}
ab, _ := ParseModulePath("a@@/b")
if got := Chunks(blocks, ab, meta); got != "c\n" {
