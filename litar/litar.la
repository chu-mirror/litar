selectOf copies the select field of a composer node, so a bad entry fails when the
composer is read rather than when the node is listed.
@<compose@:litar@:Language@/Go@/File@/functions@+
func selectOf(n composerNode) ([]string, error) {
	if n.Select == nil {
		return nil, nil
	}
	sel := append([]string{}, *n.Select...)
	if _, err := parseUnits(sel); err != nil {
		return nil, err
	}
	return sel, nil
}

