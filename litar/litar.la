@<fuse@:litar@:Language@/Go@/File@/functions@+
func splitSlash(p string) []string {
	var out []string
	start := 0
	for i := 0; i < len(p); i++ {
		if p[i] == '/' {
			out = append(out, p[start:i])
			start = i + 1
		}
	}
	out = append(out, p[start:])
	return out
}

@~ Project@/litar@/Go@/functions@/litar.splitSlash @

@<fuse@:litar@:Language@/Go@/File@/types@+
type mount struct {
	dir    string
	server *fuse.Server
	direct bool
	extra  []string
}

@~ Project@/litar@/Go@/types@/litar.mount @

@<fuse@:litar@:Language@/Go@/File@/variables@+
var (
	liveMu     sync.Mutex
	liveMounts = map[*mount]struct{}{}
)

@~ Project@/litar@/Go@/types@/litar.mount @~ Project@/litar@/Go@/variables@/litar.liveMounts @~ Project@/litar@/Go@/variables@/litar.liveMu @

@<fuse@:litar@:Language@/Go@/File@/methods@+
func (m *mount) close() {
	if m == nil {
		return
	}
	liveMu.Lock()
	delete(liveMounts, m)
	liveMu.Unlock()
	if m.server != nil {
		// Unmount gives up while a process the filter left behind
		// still uses the mount, and Wait would then block forever.
		// A lazy unmount removes the mount now; the server stops
		// when the kernel drops the last use.
		if err := m.server.Unmount(); err != nil {
			detach(m.dir, m.direct)
		}
	}
	if m.dir != "" {
		_ = os.RemoveAll(m.dir)
	}
	for _, p := range m.extra {
		_ = os.RemoveAll(p)
	}
}

@~ Project@/litar@/Go@/functions@/litar.detach @~ Project@/litar@/Go@/methods@/litar.mount.close @~ Project@/litar@/Go@/types@/litar.mount @~ Project@/litar@/Go@/variables@/litar.liveMounts @~ Project@/litar@/Go@/variables@/litar.liveMu @

@<fuse@:litar@:Language@/Go@/File@/functions@+
func detach(dir string, direct bool) {
	if direct && syscall.Unmount(dir, syscall.MNT_DETACH) == nil {
		return
	}
	for _, prog := range []string{"fusermount3", "fusermount"} {
		if exec.Command(prog, "-u", "-z", dir).Run() == nil {
			return
		}
	}
}

@~ Project@/litar@/Go@/functions@/litar.detach @

@<fuse@:litar@:Language@/Go@/File@/functions@+
// DetachMounts lazily unmounts every filter view that is still mounted.
// A process that exits without it leaves a dead mount in the temporary directory.
func DetachMounts() {
	liveMu.Lock()
	defer liveMu.Unlock()
	for m := range liveMounts {
		detach(m.dir, m.direct)
	}
}

@~ Project@/litar@/Go@/functions@/litar.DetachMounts @~ Project@/litar@/Go@/functions@/litar.detach @~ Project@/litar@/Go@/variables@/litar.liveMounts @~ Project@/litar@/Go@/variables@/litar.liveMu @

@<fuse@:litar@:Language@/Go@/File@/functions@+
func mountView(files []viewFile) (*mount, error) {
tree, err := buildVTree(files)
if err != nil {
	return nil, err
}
dir, err := os.MkdirTemp("", "litar-mnt-*")
if err != nil {
	return nil, fmtMount(err)
}
overlay, err := os.MkdirTemp("", "litar-ovl-*")
if err != nil {
	os.RemoveAll(dir)
	return nil, fmtMount(err)
}
var (
	server *fuse.Server
	direct bool
)
@<Project@/litar@/mount 'tree' at 'dir' with new files in 'overlay', setting 'server' and 'direct'@>
m := &mount{dir: dir, server: server, direct: direct, extra: []string{overlay}}
liveMu.Lock()
liveMounts[m] = struct{}{}
liveMu.Unlock()
return m, nil
}

