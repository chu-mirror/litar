refOf is the ref of an object: ten hex digits of a hash over its kind and its names. A ref depends on nothing else, so it stays the same until the object is renamed.
@<mcp@:litar@:Language@/Go@/File@/functions@+
func refOf(kind string, names ...string) string {
	h := sha256.New()
	h.Write([]byte(kind))
	for _, name := range names {
		h.Write([]byte{0})
		h.Write([]byte(name))
	}
	return hex.EncodeToString(h.Sum(nil))[:10]
}

