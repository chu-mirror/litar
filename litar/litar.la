#pages a.on, #pages a:hover { background: var(--accent-bg); color: var(--accent); text-decoration: none; }
#menu { display: none; }
#side { position: relative; display: flex; flex-direction: column; min-height: 0; background: var(--panel); border-right: 1px solid var(--line); }
#kinds { display: flex; gap: 2px; padding: 8px 8px 0; }
#kinds button { flex: 1; border: 0; background: none; padding: 4px 0; color: var(--muted); }
#kinds button.on { background: var(--accent-bg); color: var(--accent); font-weight: 600; }
#filter { margin: 8px; }
#tree { flex: 1; overflow: auto; padding: 0 8px 16px; }
#grip { position: absolute; top: 0; right: -3px; width: 6px; height: 100%; cursor: col-resize; }
#main { overflow: auto; min-width: 0; }
#content { max-width: 1040px; margin: 0 auto; padding: 20px 24px 64px; }

