Formats a reversed specialization label path back into its @@:-separated display name.
@<mcp@:litar@:Language@/Go@/File@/functions@+
func specName(reversed []Name) string {
	parts := make([]string, len(reversed))
	for i, n := range reversed {
		parts[len(reversed)-1-i] = string(n)
	}
	return strings.Join(parts, "@@:")
}

