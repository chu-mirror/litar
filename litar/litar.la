A composer that fails to load is passed over; its error is reported only when no composer
further up declares the archive. A ground node with the archive does not count.
@<Project@/litar@/return the composition in 'dir' if it declares 'ident', keeping the first 'loadErr'@=
comp := filepath.Join(dir, "composer.json")
if isRegular(comp) {
	w, err := LoadComposer(comp)
	if err != nil {
		if loadErr == nil {
			loadErr = err
		}
	} else {
		for i := w.localAt; i < len(w.Nodes); i++ {
			if w.Nodes[i].Archive == ident {
				return w, formatNodePath(nodePath(w.Nodes[i])), nil
			}
		}
	}
}
