@<Project@/litar@/Rewrite@/save 'kept' as the mappings of 'n', restoring them if the composer cannot be written@=
if err == nil && len(kept) != len(n.Mappings) {
	saved := n.Mappings
	n.Mappings = kept
	if err = w.save(); err != nil {
		n.Mappings = saved
		err = fmt.Errorf("could not write '%s'", w.Composer)
	}
}
