readChunk evaluates a root-module file chunk on the current visit stack. Tangling calls it before the filter process starts, so the lock is not already held.
@<eval@:litar@:Language@/Go@/File@/methods@+
func (e *Evaluator) readChunk(chunk Name) ([]byte, error) {
	e.mu.Lock()
	defer e.mu.Unlock()
	text, err := e.expandLocked(ChunkRef{Chunk: chunk}, false)
	if err != nil {
		if e.fuseErr == nil {
			e.fuseErr = err
		}
		return nil, err
	}
	return []byte(text), nil
}

