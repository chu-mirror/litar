@~ Project@/litar@/Go@/constants@/litar.filesChild @
@<rewrite test@:litar@:Language@/Go@/File@/functions@+
func TestMoveFiles(t *testing.T) {
	w, a, b := rewriteWorld(t, filesRoot, filesChild)
	report, err := w.OperateFiles("root", "mv src/a.c 'lib/a b.c'")
	if err != nil || report != "src/a.c -> lib/a b.c\n" {
		t.Fatalf("report %q %v", report, err)
	}
	text := archiveText(t, a)
	for _, want := range []string{
		"@@[lib/a b.c@@`sources@@=\na\n@@",
		"@@<lib/a b.c@@+\nmore\n@@",
		"@@<File@@/lib@@/a b.c@@=",
		"@@<File@@/src@@=",
		"@@<lib/a b.c@@> @@<@@|cat@@,lib/a b.c@@!src/sub/b.sh@@+sources@@>",
	} {
		if !strings.Contains(text, want) {
			t.Fatalf("missing %q in\n%s", want, text)
		}
	}
	if got := archiveText(t, b); !strings.Contains(got, "@@<lib/a b.c@@>") {
		t.Fatalf("child %s", got)
	}
	report, err = w.OperateFiles("root", "mv src lib keep.txt top/")
	want := "src/sub/b.sh -> top/src/sub/b.sh\nlib/a b.c -> top/lib/a b.c\nkeep.txt -> top/keep.txt\n"
	if err != nil || report != want {
		t.Fatalf("report %q %v", report, err)
	}
	text = archiveText(t, a)
	for _, want := range []string{"@@(top/src/sub/b.sh@@=", "@@<File@@/top@@/src@@=", "@@[top/keep.txt@@=", "@@!top/src/sub/b.sh@@+sources"} {
		if !strings.Contains(text, want) {
			t.Fatalf("missing %q in\n%s", want, text)
		}
	}
	if report, err = w.OperateFiles("root", "mv top/src root"); err != nil || report != "top/src/sub/b.sh -> root/sub/b.sh\n" {
		t.Fatalf("report %q %v", report, err)
	}
}

@~ Project@/litar@/Go@/constants@/litar.filesChild @~ Project@/litar@/Go@/functions@/litar.TestMoveFiles @~ Project@/litar@/Go@/functions@/litar.archiveText @~ Project@/litar@/Go@/functions@/litar.rewriteWorld @~ Project@/litar@/Go@/methods@/litar.World.OperateFiles @~ Project@/litar@/Go@/variables@/litar.filesRoot @
@<rewrite test@:litar@:Language@/Go@/File@/functions@+
func TestRemoveFiles(t *testing.T) {
	w, a, _ := rewriteWorld(t, filesRoot, filesChild)
	_, err := w.OperateFiles("root", "rm src")
	wantError(t, err, "'src' is a directory")
	report, err := w.OperateFiles("root", "rm -rf src missing")
	if err != nil || report != "removed src/a.c\nremoved src/sub/b.sh\n" {
		t.Fatalf("report %q %v", report, err)
	}
	text := archiveText(t, a)
	if strings.Contains(text, "src/a.c@@`") || strings.Contains(text, "more") || strings.Contains(text, "File@@/") || !strings.Contains(text, "@@[keep.txt@@=k@@") {
		t.Fatalf("rm left\n%s", text)
	}
}

@~ Project@/litar@/Go@/constants@/litar.filesChild @~ Project@/litar@/Go@/functions@/litar.TestRemoveFiles @~ Project@/litar@/Go@/functions@/litar.archiveText @~ Project@/litar@/Go@/functions@/litar.rewriteWorld @~ Project@/litar@/Go@/functions@/litar.wantError @~ Project@/litar@/Go@/methods@/litar.World.OperateFiles @~ Project@/litar@/Go@/variables@/litar.filesRoot @
@<rewrite test@:litar@:Language@/Go@/File@/functions@+
func TestOperateFilesRefused(t *testing.T) {
	w, a, _ := rewriteWorld(t, filesRoot, filesChild)
	before := archiveText(t, a)
	for command, part := range map[string]string{
		"":                      "empty command",
		"cp src/a.c x":          "unsupported command 'cp'",
		"rm -x src/a.c":         "unsupported option '-x'",
		"rm missing":            "no such file 'missing'",
		"rm ../x":               "invalid path '../x'",
		"rm data/x":             "'data/x' comes from a mapping",
		"rm 'src/a.c":           "unterminated quote",
		"mv src/a.c":            "mv needs a source and a target",
		"mv src/a.c keep.txt":   "file 'keep.txt' already exists",
		"mv src/a.c keep.txt x": "target 'x' is not a directory",
		"mv src src/sub":        "cannot move 'src' into itself",
		"mv src/a.c data/":      "file 'data/a.c' already exists",
	} {
		_, err := w.OperateFiles("root", command)
		wantError(t, err, part)
	}
	_, err := w.OperateFiles("root/child", "rm keep.txt")
	wantError(t, err, "'keep.txt' comes from node 'root'")
	if after := archiveText(t, a); after != before {
		t.Fatalf("archive changed\n%s", after)
	}
}

