// nodeChain loads the block chain and mappings of a node ref.
// The caller holds a.mu.
func (a *agent) nodeChain(w *World, ref string) ([]Block, []Mapping, error) {
	n, err := nodeByRef(w, ref)
	if err != nil {
		return nil, nil, err
	}
	np := formatNodePath(nodePath(*n))
	chain, err := w.Chain(np)
	if err != nil {
		return nil, nil, err
	}
	maps, err := w.Mappings(np)
	if err != nil {
		return nil, nil, err
	}
	return chain, maps, nil
}

@~ Project@/litar@/Go@/functions@/litar.formatNodePath @~ Project@/litar@/Go@/functions@/litar.nodeByRef @~ Project@/litar@/Go@/functions@/litar.nodePath @~ Project@/litar@/Go@/methods@/litar.World.Chain @~ Project@/litar@/Go@/methods@/litar.World.Mappings @~ Project@/litar@/Go@/methods@/litar.agent.nodeChain @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.Mapping @~ Project@/litar@/Go@/types@/litar.World @~ Project@/litar@/Go@/types@/litar.agent @

@<mcp@:litar@:Language@/Go@/File@/methods@+
func (a *agent) renderTree(uri, prefix string, build func([]Block, []Mapping) (treeJSON, error)) (string, string, []byte, error) {
	w, refs, err := a.refParts(strings.TrimPrefix(uri, prefix), 2)
	if err != nil {
		return "", "", nil, err
	}
	chain, maps, err := a.nodeChain(w, refs[1])
	if err != nil {
		return "", "", nil, err
	}
	tree, err := build(chain, maps)
	if err != nil {
		return "", "", nil, err
	}
	raw, err := json.Marshal(tree)
	if err != nil {
		return "", "", nil, err
	}
	return string(raw), mimeOf(uri), nil, nil
}

