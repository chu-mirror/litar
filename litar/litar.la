@

@<Index@/Project@/litar@/Go@/methods@/litar.parser.line@=
{"description": "Returns the 1-based line number of the current parser position, incrementally counting newlines from the last cached offset."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.parser.parseBlock@=
{"description": "Parses a chunk block starting at @@<, reading its qualified chunk name, validating the = or + operation, and finishing the body."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.parser.parseBody@=
{"description": "Parses a block's content, inner references, filters, and items up to its end control, stripping a trailing layout line break into endsLine."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.parser.parseFile@=
{"description": "Parses a file block starting at @@[ or @@(, reading its path, optional file sets, operation, and body into a Block with file metadata set."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.parser.parseFilterList@=
