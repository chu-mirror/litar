@<meta test@:litar@:Language@/Go@/File@/functions@+
func TestProgramHelloModuleSpecializations(t *testing.T) {
	chain, maps := exampleChain(t, "Standard/Program Hello")
	chunk := ChunkRef{Module: ModulePath{"Language", "C", "Module"}, Chunk: "module"}
	tree, err := specializationTree(chain, maps, &chunk)
	if err != nil {
		t.Fatal(err)
	}
	exec, ok := findTree(tree, "executable")
	if !ok {
		t.Fatalf("missing executable: %s", mustTree(t, tree))
	}
	hello, ok := findTree(tree, "executable", "hello")
	if !ok {
		t.Fatalf("missing hello: %s", mustTree(t, tree))
	}
	if exec.Ref == hello.Ref {
		t.Fatalf("refs %+v", tree)
	}
	labels, err := labelsByRef(chain, maps, hello.Ref)
	if err != nil {
		t.Fatal(err)
	}
	if labelsText(labels) != "hello@@:executable" {
		t.Fatalf("labels %q ref %s", labelsText(labels), hello.Ref)
	}
}

