Resolves a chunk ref against the node's chunk tree and returns the corresponding ChunkRef, rejecting non-leaf or unknown refs.
@<mcp@:litar@:Language@/Go@/File@/functions@+
func chunkByRef(blocks []Block, maps []Mapping, ref string) (ChunkRef, error) {
	tree := chunkTreeWith(blocks, metaInfo{})
	place, ok := indexTree(tree, false)[ref]
	if !ok || !place.leaf {
		return ChunkRef{}, fmt.Errorf("unknown chunk '%s'", ref)
	}
	return chunkRefOf(place), nil
}

