The C example and its grounds are read from testdata beside this source file,
so the tests do not depend on the working directory.
The node maps examples and grounds of the repository there, as the file set test data.
A view without that file set has no testdata, and the tests of the example are skipped.
@<meta test@:litar@:Language@/Go@/File@/functions@+
func exampleChain(t *testing.T, np string) ([]Block, []Mapping) {
t.Helper()
_, file, _, ok := runtime.Caller(0)
if !ok {
t.Fatal("caller")
}
root := filepath.Join(filepath.Dir(file), "testdata")
if _, err := os.Stat(filepath.Join(root, "examples")); err != nil {
t.Skip("no testdata/examples")
}
t.Setenv("LITAR_LIBRARY", filepath.Join(root, "grounds"))
w, err := LoadComposer(filepath.Join(root, "examples", "c", "composer.json"))
if err != nil {
t.Fatal(err)
}
chain, err := w.Chain(np)
if err != nil {
t.Fatal(err)
}
maps, err := w.Mappings(np)
if err != nil {
t.Fatal(err)
}
return chain, maps
}

