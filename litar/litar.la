A directory that is missing or cannot be read is an empty branch: a filter creates it
when it first runs, and the tree must not fail before that.
@<Project@/litar@/MCP Server@/add the files below the origin of 'f' to the branch 'last' of 'cur'@=
dir := cur.addSub(last)
_ = filepath.WalkDir(f.origin, func(p string, d os.DirEntry, err error) error {
	rel, relErr := filepath.Rel(f.origin, p)
	if err != nil || relErr != nil || rel == "." {
		return nil
	}
	names := strings.Split(filepath.ToSlash(rel), "/")
	at := dir
	for _, name := range names[:len(names)-1] {
		at = at.addSub(name)
	}
	if d.IsDir() {
		at.addSub(names[len(names)-1])
	} else {
		at.addLeaf(names[len(names)-1])
	}
	return nil
})
