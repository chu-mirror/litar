@<parse@:litar@:Language@/Go@/File@/methods@+
// flush moves the pending content text into a text part.
func (b *body) flush(text *strings.Builder) {
if text.Len() == 0 {
return
}
b.parts = append(b.parts, Part{Text: text.String()})
text.Reset()
}

@~ Project@/litar@/Go@/methods@/litar.body.flush @~ Project@/litar@/Go@/types@/litar.Part @~ Project@/litar@/Go@/types@/litar.body @

@<parse@:litar@:Language@/Go@/File@/methods@+
// endContent flushes the content text without the one line break that
// ends it, and records that break in endsLine.
func (b *body) endContent(text *strings.Builder) {
s := text.String()
switch {
case strings.HasSuffix(s, "\r\n"):
s = s[:len(s)-2]
case strings.HasSuffix(s, "\n"):
s = s[:len(s)-1]
default:
b.flush(text)
return
}
b.endsLine = true
text.Reset()
text.WriteString(s)
b.flush(text)
}

@~ Project@/litar@/Go@/methods@/litar.body.endContent @~ Project@/litar@/Go@/methods@/litar.body.flush @~ Project@/litar@/Go@/types@/litar.body @

@<parse@:litar@:Language@/Go@/File@/methods@+
func (p *parser) parseItems() ([]Item, error) {
var items []Item
var item Item
for {
name, kind, n, err := p.readName(false)
if err != nil {
return nil, err
}
if name == "" {
return nil, p.fail("empty name")
}
item = append(item, name)
switch {
case kind == '/' && n == 2:
p.i += n
case kind == '~' && n == 2:
items = append(items, item)
item = nil
p.i += n
case isEndControl(kind, n):
p.i += n
return append(items, item), nil
default:
return nil, p.unexpected(kind, n)
}
}
}

