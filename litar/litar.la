exitStatus is the status of a failed wait: the exit code, or 128 plus the signal for a process killed by a signal.
A process killed by a signal gets the status a shell reports for it.
@<filter@:litar@:Language@/Go@/File@/functions@+
func exitStatus(err error) int {
	code := 1
	if ee, ok := err.(*exec.ExitError); ok {
		code = ee.ExitCode()
		if code < 0 {
			if ws, ok := ee.Sys().(syscall.WaitStatus); ok && ws.Signaled() {
				code = 128 + int(ws.Signal())
			} else {
				code = 1
			}
		}
	}
	return code
}

@? Project@/litar@/Go@/functions@/litar.exitStatus @

Main runs litar with a parsed command line and returns the exit status.
The command keeps filter outputs in the cache that LITAR_CACHE names; run alone, as the tests call it, keeps none.
@<cli@:litar@:Language@/Go@/File@/functions@=
func Main(opts Options) int {
	sigs := make(chan os.Signal, 1)
	signal.Notify(sigs, syscall.SIGINT, syscall.SIGTERM, syscall.SIGHUP)
	go func() {
		sig := <-sigs
		DetachMounts()
		os.Exit(128 + int(sig.(syscall.Signal)))
	}()
	filterCacheDir = cacheDirFromEnv()
	return run(opts, os.Stdout, os.Stderr)
}

