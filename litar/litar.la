func TestParseRoundTrip(t *testing.T) {
src := "" +
@<Project@/litar@/archive text of two chunks of module and a label extending one, between a lead and a tail@>
""
arch, err := ParseArchive([]byte(src), "a.la")
if err != nil {
t.Fatal(err)
}
if got := arch.Text(); got != src {
