@

@<Index@/Project@/litar@/Go@/methods@/litar.parser.consumeLayout@=
{"description": "Consumes a single optional line break (\\r\\n, \\r, or \\n) at the current parser position."}
@

@<Index@/Project@/litar@/Go@/methods@/litar.parser.fail@=
{"description": "Constructs a *ParseError with the given message, tagging it either as an expression error or with the current archive file and line number."}
@
@<Index@/Project@/litar@/Go@/methods@/litar.parser.finishBlock@=
