	@<Project@/litar@/Parser@/check that the control 'kind' after the sets is the operation of a file@>
	b, err := p.finishBlock(ChunkRef{Chunk: path}, Op(kind), startLine)
	if err != nil {
		return Block{}, err
	}
	b.IsFile = true
	b.Path = path
	b.Executable = executable
	b.Sets = sets
	return b, nil
