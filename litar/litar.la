rewriteRaw is the text of a block with the names that edit replaces. The spans are replaced from the last one, so the earlier offsets stay valid, and a new name keeps the blanks that surrounded the old one.
@<rewrite@:litar@:Language@/Go@/File@/functions@+
func rewriteRaw(bl Block, edit func(Block, nameSpan) (string, bool)) (string, error) {
	spans, err := scanSpans(bl.Raw)
	if err != nil {
		return "", err
	}
	raw := bl.Raw
	for i := len(spans) - 1; i >= 0; i-- {
		sp := spans[i]
		if text, ok := edit(bl, sp); ok {
			old := raw[sp.start:sp.end]
			inner := strings.TrimLeft(old, " \t\r\n")
			lead := old[:len(old)-len(inner)]
			trail := inner[len(strings.TrimRight(inner, " \t\r\n")):]
			raw = raw[:sp.start] + lead + text + trail + raw[sp.end:]
		}
	}
	return raw, nil
}

@? Project@/litar@/Go@/functions@/litar.rewriteRaw @~ Project@/litar@/Go@/functions@/litar.scanSpans @~ Project@/litar@/Go@/types@/litar.Block @~ Project@/litar@/Go@/types@/litar.nameSpan @

shellWords splits a command into words the way a shell splits plain words: blanks separate them, and quotes or a backslash keep the next bytes literal.
@<rewrite@:litar@:Language@/Go@/File@/functions@+
func shellWords(cmd string) ([]string, error) {
	var words []string
	var word strings.Builder
	open := false
	quote := byte(0)
	for i := 0; i < len(cmd); i++ {
		c := cmd[i]
		switch {
		case quote != 0 && c == quote:
			quote = 0
		case quote == '\'', quote == '"' && c != '\\':
			word.WriteByte(c)
		case c == '\\':
			if i+1 == len(cmd) {
				return nil, fmt.Errorf("unterminated escape in command")
			}
			i++
			word.WriteByte(cmd[i])
			open = true
		case c == '\'' || c == '"':
			quote = c
			open = true
		case isWS(c):
			if open {
				words = append(words, word.String())
				word.Reset()
				open = false
			}
		default:
			word.WriteByte(c)
			open = true
		}
	}
	if quote != 0 {
		return nil, fmt.Errorf("unterminated quote in command")
	}
	if open {
		words = append(words, word.String())
	}
	return words, nil
}

@~ Project@/litar@/Go@/functions@/litar.isWS @? Project@/litar@/Go@/functions@/litar.shellWords @~ Project@/litar@/Go@/methods@/litar.ChunkRef.String @

fileArgs separates the option letters of a command from its operands. Only the letters of allowed are options of the command.
@<rewrite@:litar@:Language@/Go@/File@/functions@+
func fileArgs(words []string, allowed string) (flags string, args []string, err error) {
	i := 0
	for ; i < len(words); i++ {
		w := words[i]
		if w == "--" {
			i++
			break
		}
		if len(w) < 2 || w[0] != '-' {
			break
		}
		for _, c := range w[1:] {
			if !strings.ContainsRune(allowed, c) {
				return "", nil, fmt.Errorf("unsupported option '%s'", w)
			}
		}
		flags += w[1:]
	}
	return flags, words[i:], nil
}

@? Project@/litar@/Go@/functions@/litar.fileArgs @

