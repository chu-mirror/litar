@|Tool@/evaluate@
getopt_long finds the end of the options at an entry of zeros.
@<UI@/Command Line@/C@/getopt long options@=
@<Tool@/Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>


def option_to_longopt(opt):
    has_arg = 'required_argument' if opt.type == 'string' else 'no_argument'
    val = f"'{opt.short}'" if opt.short else '0'
    return f'{{"{opt.name}",{has_arg},NULL,{val}}},'


syntax = configuration(CSyntax, r'''
@<UI@/Command Line@/invocation syntax@>
''')
print(''.join(map(option_to_longopt, all_options(syntax))) + '{0,0,0,0},', end='')
@|Tool@/evaluate@
@<UI@/Command Line@/C@/getopt string@=
@<Tool@/Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>
syntax = configuration(CSyntax, r'''
@<UI@/Command Line@/invocation syntax@>
''')
print(''.join(opt.short + (':' if opt.type == 'string' else '')
              for opt in all_options(syntax) if opt.short), end='')
@|Tool@/evaluate@
@<UI@/Command Line@/C@/handle long option of index "idx"@=
@<Tool@/Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>


def long_option_handling(opt):
    if opt.short:
        return ''
    value = 'optarg' if opt.type == 'string' else '1'
    return f'''
            if (strcmp(long_options[idx].name, "{opt.name}") == 0) {{
                command.options.{option_field(opt)} = {value};
            }}
        '''


syntax = configuration(CSyntax, r'''
@<UI@/Command Line@/invocation syntax@>
''')
print(''.join(map(long_option_handling, all_options(syntax))), end='')
@|Tool@/evaluate@
@<UI@/Command Line@/C@/cases for short options@=
@<Tool@/Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>


def short_opt_case(opt):
    if not opt.short:
        return ''
    value = 'optarg' if opt.type == 'string' else '1'
    return f'''
            case '{opt.short}':
                command.options.{option_field(opt)} = {value};
                break;
        '''


syntax = configuration(CSyntax, r'''
@<UI@/Command Line@/invocation syntax@>
''')
print(''.join(map(short_opt_case, all_options(syntax))), end='')
@|Tool@/evaluate@
@<UI@/Command Line@/C@/choose usage and store arguments@=
@<Tool@/Text Processing@/basic python settings@>
@<.@/invocation syntax helpers@>


def look_option_of_usage(opt, usage):
    constant = enum_constant(usage)
    short_opt = f' -{opt.short}' if opt.short else ''
    return f'''
        if (command.options.{option_field(opt)}) {{
            if (!found_usage) {{
                found_usage = 1;
                command.usage = {constant};
            }} else if (command.usage != {constant}) {{
                fprintf(stderr, "Conflict option: --{opt.name}{short_opt}\\n");
                exit(1);
            }}
        }}
    '''


def look_usage_argument_number(usage):
    return f'''
        if (!found_usage && argc - optind == {len(usage.arguments)}) {{
            found_usage = 1;
            command.usage = {enum_constant(usage)};
        }}
    '''


def store_arguments_for_usage(usage):
    store = ''.join(f'command.arguments.{argument_field(arg)} = argv[optind + {idx}];'
                    for idx, arg in enumerate(usage.arguments))
    return f'''
        case {enum_constant(usage)}:
            if (argc - optind != {len(usage.arguments)}) {{
                fprintf(stderr, "Unmatched argument number, see --help for usage\\n");
                exit(1);
            }}
            {store}
            break;
    '''


syntax = configuration(CSyntax, r'''
@<UI@/Command Line@/invocation syntax@>
''')
text = 'do { int found_usage = 0;'
text += ''.join(look_option_of_usage(opt, usage)
                for usage in syntax.usages for opt in usage.options)
text += '\n'.join(map(look_usage_argument_number, syntax.usages))
text += '''
    if (!found_usage) {
        fprintf(stderr, "Invalid usage, see --help for usage\\n");
        exit(1);
    }
'''
text += 'switch (command.usage) {'
text += '\n'.join(map(store_arguments_for_usage, syntax.usages))
text += '}} while (0);'
print(text, end='')
@|Tool@/evaluate@
The generators include this chunk as one fragment, on top of the shared models.
getopt_long stores an option in a field of its own: an int for a switch and a string for a value,
so an option is bool or string, and it has no default.
@<UI@/Command Line@/C@/invocation syntax helpers@=
@<UI@/Command Line@/invocation syntax helpers@>


class CSyntax(InvocationSyntax):
    @pydantic.model_validator(mode='after')
    def check_c_options(self):
        for opt in all_options(self):
            if opt.type not in ('bool', 'string'):
                raise ValueError(f'option {opt.name!r} has type {opt.type}; C takes bool or string')
            if opt.default is not None:
                raise ValueError(f'option {opt.name!r} has a default, which C does not take')
        return self
@
Every generator names a field with these functions, so they agree on each field.
@<UI@/Command Line@/C@/invocation syntax helpers@+
def enum_constant(usage):
    return 'COMMAND_USAGE_' + usage.name.replace(' ', '_').replace('-', '_').upper()


def option_field(opt):
    return opt.name.replace('-', '_').lower()


def argument_field(arg):
    return arg.replace(' ', '_').replace('-', '_').lower()
@

There are some idioms to make life a bit easier.

@<lightlib@:Language@/C@/Module@/exported macros@+
#define GLUE_TOKENS_INNER(a, b) a ## b
#define GLUE_TOKENS(a, b) GLUE_TOKENS_INNER(a, b)

#define ZEROFY(p, n) memset((p), 0, sizeof(*p) * (n))
#define ZEROFY_SINGLE(p) ZEROFY(p, 1)

#define COPY(dest, src) memcpy((dest), (src), sizeof(*(src)))

#define SIGN(v) (((v) > 0) - ((v) < 0))
#define ABS(v) ((v) * SIGN(v))
#define BETWEEN(v, l, r)                                             \
    ((((l) <= (v)) && ((v) < (r))) || (((r) <= (v)) && ((v) < (l))))
#define SWAP(a, b)                             \
    do {                                       \
        typeof(a) *a_r = &(a), *b_r = &(b), t; \
        t = *a_r;                              \
        *a_r = *b_r;                           \
        *b_r = t;                              \
    } while (0)
@

Copied from linux kernel.

@<lightlib@:Language@/C@/Module@/exported macros@+
#define container_of(ptr, type, member) \
    _Generic(ptr, \
        const typeof(*(ptr)) *: ((const type *)((uint8_t *)(ptr) - offsetof(type, member))), \
        default: ((type *)((uint8_t *)(ptr) - offsetof(type, member))) \
    )
@
@<lightlib@:Language@/C@/Module@/exported data types@+
struct list {
    struct list *next;
};
@
@<lightlib@:Language@/C@/Module@/exported static inline functions@+
static inline struct list *
cons(struct list *elm, struct list *l)
{
    elm->next = l;
    return elm;
}
static inline struct list *
cdr(const struct list *l)
{
    return l->next;
}
@
@<lightlib@:Language@/C@/Module@/functions@+
int list_length(const struct list *l)
{
    int n = 0;
    while (l) {
        l = cdr(l);
        ++n;
    }
    return n;
}

void reverse(struct list **l_r)
{
    struct list *l, *ll;

    l = *l_r;
    ll = NULL;

    while (l) {
        struct list *l_t = l->next;
        l->next = ll;
        ll = l;
        l = l_t;
    }

    *l_r = ll;
}
@
@<lightlib@:Language@/C@/Module@/exported data types@+
struct tail_list {
    struct list *head;
    struct list *tail;
};
@
@<lightlib@:Language@/C@/Module@/exported static inline functions@+
static inline void list_extend(struct tail_list *tl, struct list *l)
{
    if (tl->tail) {
        tl->tail->next = l;
    } else {
        tl->head = l;
        tl->tail = l;
    }
    while (tl->tail->next) {
        tl->tail = tl->tail->next;
    }
}
@
@<lightlib@:Language@/C@/Module@/exported data types@+
struct bi_list {
    struct bi_list *previous;
    struct bi_list *next;
};
@
@<lightlib@:Language@/C@/Module@/exported static inline functions@+
static inline void bi_list_init(struct bi_list *l)
{
    l->previous = l;
    l->next = l;
}

static inline void bi_list_connect(struct bi_list *nd1, struct bi_list *nd2)
{
    nd1->next = nd2;
    nd2->previous = nd1;
}

static inline struct bi_list *bi_list_insert(struct bi_list *nd1, struct bi_list *nd2)
{
    if (!nd2) {
        bi_list_connect(nd1, nd1);
    } else {
        struct bi_list *pre_nd2 = nd2->previous;
        bi_list_connect(pre_nd2, nd1);
        bi_list_connect(nd1, nd2);
    }
    return nd1;
}

static inline struct bi_list *bi_list_remove(struct bi_list *nd)
{
    if (nd->next == nd && nd->previous == nd) {
        return NULL;
    }
    bi_list_connect(nd->previous, nd->next);
    return nd->next;
}
@
@<lightlib@:Language@/C@/Module@/exported macros@+
#define FOREACH(elm, lst) for (elm = lst; elm; elm = cdr(elm))
#define FOREACH_BI(elm, lst) \
    for (elm = NULL; (elm && (elm != lst)) || (!elm && (elm = lst)); elm = elm->next)
