@<UI@/Command Line@/C@/parse command line arguments@=
do {
    int opt, idx;
    while ((opt = getopt_long(argc, argv, "@<.@/getopt string@>", long_options, &idx)) != -1) {
        switch (opt) {
        case 0:
            @<.@/handle long option of index "idx"@>
            break;
        @<.@/cases for short options@>
        case '?':
            break;
        default:
            fprintf(stderr, "getopt return unexpected value %d", opt);
            exit(1);
        }
    }
    @<.@/choose usage and store arguments@>
} while (0);
