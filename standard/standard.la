@<lightlib@:Language@/C@/Module@/exported data type declarations@+
typedef struct heap *Heap;
@
@<lightlib@:Language@/C@/Module@/macros@+
#define HEAP_LABEL_TYPE unsigned int
#define HEAP_LABEL_SIZE (sizeof(HEAP_LABEL_TYPE) * 8)
@
@<lightlib@:Language@/C@/Module@/functions@+
Heap new_heap(size_t len, size_t unit_size)
{
    Heap hp;
    NEW(hp);
    if (!hp) {
        return NULL;
    }
    hp->length = len;
    hp->unit_size = unit_size;
    hp->space = salloc(len * unit_size);
    if (!hp->space) {
        return NULL;
    }

    int w_n = 1;
    while (w_n < len) {
        w_n *= HEAP_LABEL_SIZE;
    }

    hp->first_direct = (w_n-1)/(HEAP_LABEL_SIZE-1);
    CALLOC(
        hp->labels,
        hp->first_direct + (len+HEAP_LABEL_SIZE-1)/HEAP_LABEL_SIZE
    );

    if (!hp->labels) {
        return NULL;
    }

    return hp;
}

void *heap_alloc(Heap hp)
{
    int p = 0;
    while (p < hp->first_direct) {
        p = HEAP_LABEL_SIZE * p + 1 + __builtin_clzg(~hp->labels[p], (int)HEAP_LABEL_SIZE);
    }

    int n = __builtin_clzg(~hp->labels[p], (int)HEAP_LABEL_SIZE);
    int idx = (p - hp->first_direct) * HEAP_LABEL_SIZE + n;

    if (idx >= hp->length) {
        return NULL;
    }

    hp->labels[p] |= (HEAP_LABEL_TYPE) 1 << (HEAP_LABEL_SIZE - n - 1);

    while (__builtin_popcountg(hp->labels[p]) == HEAP_LABEL_SIZE) {
        int _p = (p - 1) / HEAP_LABEL_SIZE;
        hp->labels[_p] |=
            (HEAP_LABEL_TYPE) 1 << (HEAP_LABEL_SIZE - 1 - (p - (_p * HEAP_LABEL_SIZE + 1)));
        if (_p == 0) {
            break;
        }
        p = _p;
    }

    return hp->space + (idx * hp->unit_size);
}

void heap_free(Heap hp, void *elm)
{
    uint8_t *_elm = elm;
    if (_elm < hp->space || _elm >= hp->space + hp->length * hp->unit_size) {
        return;
    }
    size_t idx = (_elm - hp->space) / hp->unit_size;
    int p = hp->first_direct + idx/HEAP_LABEL_SIZE;
    hp->labels[p] &= ~((HEAP_LABEL_TYPE) 1 << (HEAP_LABEL_SIZE - 1 - (idx % HEAP_LABEL_SIZE)));
    do {
        int _p = (p - 1) /HEAP_LABEL_SIZE;
        hp->labels[_p] &= ~(
            (HEAP_LABEL_TYPE) 1 << (HEAP_LABEL_SIZE - 1 - (p - (_p * HEAP_LABEL_SIZE + 1)))
        );
        if (__builtin_popcountg(hp->labels[_p]) < HEAP_LABEL_SIZE - 1) {
            break;
        }
        p = _p;
    } while (p);
}
