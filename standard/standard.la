@<lightlib@:Language@/C@/Module@/exported data type declarations@+
typedef enum {
    LOG_LEVEL_INFO,
    LOG_LEVEL_WARNING,
    LOG_LEVEL_ERROR,
} LogLevel;
@
@<lightlib@:Language@/C@/Module@/functions@+
void _light_log(LogLevel base, LogLevel lv, const char *format, ...)
{
    if (lv < base) {
        return;
    }

    switch (lv) {
    case LOG_LEVEL_INFO:
        fputs("INFO: ", stderr);
        break;
    case LOG_LEVEL_WARNING:
        fputs("WARNING: ", stderr);
        break;
    case LOG_LEVEL_ERROR:
        fputs("ERROR: ", stderr);
        break;
    default:
        return;
    }

    va_list args;

    va_start(args, format);
    vfprintf(stderr, format, args);
    va_end(args);

    do {
        struct context *ctx = _light_top_context;
        fputs(" (", stderr);
        fputs(ctx->name, stderr);
        ctx = ctx->parent;
        while (ctx) {
            fputs(" -> ", stderr);
            fputs(ctx->name, stderr);
            ctx = ctx->parent;
        }
    } while (0);
    fputs(")\n", stderr);
}
