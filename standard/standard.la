@<.@/build constraints@>
@<.@/Header@/package clause@>
@<.@/Header@/imports@>
@<.@/constants@>
@<.@/variables@>
@<.@/types@>
@<.@/methods@>
@<.@/functions@>
@|Language@/Go@/File@/Format@/format Go code@

